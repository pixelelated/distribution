#!/bin/bash
# commit-msg: the message, against the same two lists as the tree. A message
# is in history for good and is the one place pre-commit does not reach; the
# push guard reads the messages of a range too, but a refusal here costs one
# edit and there it costs a rewrite. Every line is scanned, comment lines
# included: git keeps a # line given with -m, and refusing a line the editor
# path would have stripped is the safe branch (T10 S1, #938). Fails closed
# in .githooks/guard-lib (2026-09-28).
set -uo pipefail
. "$(dirname "$(readlink -f "$0")")/guard-lib" || exit 1
guard_load commit-msg || exit 1
lines="$(mktemp)" || { echo "✖ commit-msg: mktemp failed; refused" >&2; exit 1; }
trap 'rm -f "${lines}"' EXIT
# The message file must be readable (an unreadable one passed, the audit of
# the fixes, claude G3-E-02 / gpt G3-E-05).
[ -r "${1:-}" ] || { echo "✖ commit-msg: the message file is unreadable; refused" >&2; exit 1; }
guard_numbered message < "$1" > "${lines}" || { echo "✖ commit-msg: the message could not be numbered; refused" >&2; exit 1; }
status=0
guard_scan commit-msg "${lines}" "the commit message carries a credential-shaped line" '' "${SECRET_PATTERNS}" redact || status=1
guard_scan commit-msg "${lines}" "the commit message carries a listed word (the wordlist outside the tree)" -i "${FORBIDDEN_PATTERNS}" where || status=1
exit "${status}"
