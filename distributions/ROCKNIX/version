# Package/build-root version; image identity is derived in config/build-identity.
  DISTRO_VERSION="devel"

# Release target. Rolling engineering builds default to the dev qualifier.
# BUILD_QUALIFIER may be empty for a release, or rc.N with N >= 1 (#532).
# Naming does not confer release qualification.
# OS_VERSION: base semantic version
  OS_VERSION="0.0.1"

# RC2 accepts an adoption tar whose name still contains ROCKNIX (D-WORKFLOW-128).
  IMAGE_SUFFIX="from-ROCKNIX"
