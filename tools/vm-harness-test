@case
def flushed_exact(c):
    import re, shlex
    text = (c.tools_from / 'ra-offline-test').read_text()
    fn = re.search(r'^field_is\(\).*$', text, re.M)
    line = [l for l in text.splitlines() if 'proxy: ${fltext}' in l][0]
    expr = re.search(r'check "\$\((.*?)\)" "proxy:', line).group(1)
    def judged(sample):
        script = (fn.group(0) + '\n' if fn else '') + 'fl=%s; %s' % (shlex.quote(sample), expr)
        return subprocess.run(['bash', '-c', script], capture_output=True, text=True).stdout.strip()
    ten, one = judged('INFO Flush complete: flushed=10 failed=0'), judged('INFO Flush complete: flushed=1 failed=0')
    aline = [l for l in text.splitlines() if l.strip().startswith('n=$(SER "grep -c')][0]
    m = re.search(r"grep (-c(?: -E)?) '([^']*)'", aline)
    pat = m.group(2).replace('${AID}', '100359').replace('$AID', '100359').replace('\\$', '$')
    r = subprocess.run(['grep', '-c'] + (['-E'] if '-E' in m.group(1) else []) + [pat], input='Awarding achievement 1003590\n',
                       capture_output=True, text=True)
    longer_id = r.stdout.strip()
    ok = ten != '0' and one == '0' and longer_id == '0'
    return ok, f'flushed=10 judged {ten!r}, flushed=1 judged {one!r} (0 is accepted); achievement 1003590 counted as 100359: {longer_id} (want rejected, accepted, 0)'


