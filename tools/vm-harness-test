def rehearsal_rows(backups='settings-1.zip', after_hash_of_state1=None):
    """A guest that seeds, updates and comes back as the rehearsal expects, call by call."""
    h = ['%064x' % n for n in (1, 2, 3, 4)]
    names = ['savestates/nes/Rehearsal.state.auto', 'savestates/nes/Rehearsal.state1',
             'savestates/nes/Rehearsal.state2', 'nes/Rehearsal.srm']
    sizes = [300000, 200000, 100000, 8192]
    before = '\\n'.join('%s  %s %d' % (x, n, z) for x, n, z in zip(h, names, sizes))
    after_h = list(h)
    if after_hash_of_state1:
        after_h[1] = after_hash_of_state1
    after = '\\n'.join('%s  %s %d' % (x, n, z) for x, n, z in zip(after_h, names, sizes))
    count = '1' if backups else '0'
    return [
        ('systemctl is-active rocknix-autostart', 0, '@seq:B1 active||B2 active'),
        ('random/boot_id', 0, '@seq:B1||B1||B2'),
        ('grep ^BUILD_ID=', 0, '@seq:oldbuild00||newbuild00'),
        ('cd /storage/roms && ', 0, '@seq:%s||%s' % (before, after)),
        ('command -v set_setting', 0, 'yes'),
        ('get_setting rehearsal.marker', 0, 'newbuild00'),
        ('cat /storage/.config/rehearsal-marker', 0, 'rehearsal-marker'),
        ('cloud_remote active', 0, 'qa-cloud:'),
        ('active-connection; else echo absent', 0, 'absent'),
        ('rclone lsd', 0, 'ok'),
        ('ls /storage/.config/cloud_sync.conf', 0, '/storage/.config/cloud_sync.conf'),
        ("grep -E '^SAVES_REMOTE='", 0, 'SAVES_REMOTE="/Rehearsal/Saves"'),
        ("grep -cE '^(CONTENT_REMOTE|SAVES_REMOTE)='", 0, '2'),
        ('backup/ 2>/dev/null | wc -l', 0, count),
        ('ls -1 /storage/roms/backup/', 0, backups),
        ('ls /storage/.update | wc -l', 0, '0'),
        ('readlink .config/system.d/emergency.target', 0, '5\\n/dev/null'),
        ('[ -L .config/system.d/emergency.target ]', 0, '0\\nunmasked'),
        ('cat /storage/.config/tmpfiles.d/50-rehearsal-owner.conf', 0, "# the owner's own (vm-upgrade-rehearsal)"),
        # Joined by the guest's own `tr '\\n' ' '` in that command, so one line with a trailing space.
        ("grep -E '^(video_fullscreen_x", 0, '@seq:video_driver = "vulkan" video_fullscreen_x = "1024" video_fullscreen_y = "768" ||video_driver = "gl" video_fullscreen_x = "1024" video_fullscreen_y = "768" '),
        ('ls /usr/lib/libcairo.so.2.* | wc -l', 0, '1'),
        ('readlink /usr/lib/libcairo.so.2', 0, 'libcairo.so.2.11805.5'),
        ('basename $(ls /usr/lib/libcairo.so.2.*)', 0, 'libcairo.so.2.11805.5'),
    ]


