def image(c, build):
    """A stand-in image path whose name carries build; vm-pair's double never reads it."""
    img = c.dir / f'pixelelated-GENERIC_X64.x86_64-0.0.1-dev+20261024T000000Z.g{build}-from-ROCKNIX.img.gz'
    img.write_bytes(b'')
    return img


def pair_calls(c):
    return [l.split()[1] for l in c.log.read_text().splitlines() if l.startswith('vm-pair ')]


def green(c):
    rep = c.reports()
    return bool(rep) and '**PASSED** -- every suite that ran passed' in rep[0].read_text()


@case
def up_fails_guest_answers(c):
    vmqa = c.tool('vm-qa')
    c.rows([('os-release', 0, f'"{GUEST_ID}"')] + FRESH_ROWS)
    r = c.run([str(vmqa), str(image(c, GUEST_ID[:12])), '--only', 'fresh'], VMHT_PAIR_UP_RC=1)
    ok = r.returncode == 1 and 'vm-pair up' in r.stderr and not green(c)
