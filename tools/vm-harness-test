@case
def es_src_mismatch(c):
    vmqa = c.tool('vm-qa')
    executable(c.root / 'tools' / 'vocabulary-check', PASS_DOUBLE)
    git = ['git', '-c', 'user.name=vmht', '-c', 'user.email=vmht@invalid', '-c', 'commit.gpgsign=false']
    pin = 'a' * 40
    mk = c.root / 'projects' / 'ROCKNIX' / 'packages' / 'ui' / 'emulationstation' / 'package.mk'
    mk.parent.mkdir(parents=True)
    mk.write_text(f'PKG_NAME="emulationstation"\nPKG_VERSION="{pin}"\n')
    subprocess.run(git + ['init', '-q', str(c.root)], check=True)
    subprocess.run(git + ['-C', str(c.root), 'add', 'projects'], check=True)
    subprocess.run(git + ['-C', str(c.root), 'commit', '-q', '-m', 'build'], check=True)
    build = subprocess.run(['git', '-C', str(c.root), 'rev-parse', 'HEAD'], capture_output=True, text=True, check=True).stdout.strip()
    es = c.dir / 'es'
