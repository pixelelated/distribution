@case
def remote_not_qa(c):
    secret = 'STANDIN-SECRET-9f3e'
    r, text, walked = run_walk(c, walk_rows(endpoint=f'type = webdav\\nurl = http://203.0.113.9/\\npass = {secret}'))
    log = (c.reports()[0].parent / 'walks.log').read_text() if c.reports() else ''
