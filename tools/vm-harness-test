def vnc_double(c, rects):
    """A VNC server for one client: a 4x2 frame, then the given rectangles (x, y, w, h)."""
    import socket, struct, threading
    srv = socket.socket()
    srv.bind(('127.0.0.1', 0))
    srv.listen(1)
    srv.settimeout(5)

    def run():
        try:
            conn, _ = srv.accept()
        except OSError:
            return
        with conn:
            conn.sendall(b'RFB 003.008\n'); conn.recv(12)
            conn.sendall(b'\x01\x01'); conn.recv(1)
            conn.sendall(struct.pack('>I', 0)); conn.recv(1)
            conn.sendall(struct.pack('>HH', 4, 2) + b'\x00' * 16 + struct.pack('>I', 4) + b'vmht')
            got = b''
            while len(got) < 20 + 8 + 10:
                chunk = conn.recv(64)
                if not chunk:
                    return
                got += chunk
            body = b''.join(struct.pack('>HHHHi', x, y, w, h, 0) + b'\x7f' * (w * h * 4) for x, y, w, h in rects)
            conn.sendall(b'\x00\x00' + struct.pack('>H', len(rects)) + body)
    threading.Thread(target=run, daemon=True).start()
    c.cleanup.append(srv.close)
    return srv.getsockname()[1]


