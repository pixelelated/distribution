# --- S3: the walks' preconditions and the ES sources (#973, #974, #981) ----------

WALK = 'back-up-page'
QA_ENDPOINT = 'type = webdav\\nurl = http://10.0.2.2:19999/'


def walk_rows(*first, boot='@count', endpoint=QA_ENDPOINT):
    """The guest as a walk sees it: the QA remote active, its endpoint the backend's, a new boot after each reboot."""
    return list(first) + [('rclone config show', 0, endpoint), ('cloud_remote active', 0, 'qa-cloud:'),
                          ('os-release', 0, f'"{GUEST_ID}"'), ('boot_id', 0, boot)]


def run_walk(c, rows, **extra):
    vmqa = c.tool('vm-qa')
    c.walks()
    c.rows(rows)
    r = c.run([str(vmqa), '--skip-up', '--only', 'walks', '--walk', WALK], **extra)
    rep = c.reports()
    return r, (rep[0].read_text() if rep else ''), c.calls('visual-qa')


@case
def reboot_same_boot_id(c):
    r, text, walked = run_walk(c, walk_rows(boot='same-boot'))
    log = (c.reports()[0].parent / 'walks.log').read_text() if c.reports() else ''
    ok = r.returncode == 1 and not walked and 'no new boot' in log
    return ok, f'rc {r.returncode}, walked {len(walked)}, "no new boot" in walks.log {"no new boot" in log} (want rc 1, no walk)'


@case
def reboot_es_silent(c):
    r, text, walked = run_walk(c, walk_rows(('pgrep -x emulationstation', 1, '')))
    log = (c.reports()[0].parent / 'walks.log').read_text() if c.reports() else ''
    ok = r.returncode == 1 and not walked and 'EmulationStation did not answer' in log
    return ok, f'rc {r.returncode}, walked {len(walked)}, the reason in walks.log {"EmulationStation did not answer" in log} (want rc 1, no walk)'


