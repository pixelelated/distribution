def executable(path, text):
    path.write_text(text)
    path.chmod(0o755)


class Case:
    def __init__(self, name, tools_from):
        self.name = name
        self.dir = SCRATCH / name
        if self.dir.exists():
            shutil.rmtree(self.dir)
        self.root = self.dir / 'root'
        (self.root / 'tools').mkdir(parents=True)
        self.bin = self.dir / 'bin'
        self.bin.mkdir()
        self.tmp = self.dir / 'tmp'
        self.tmp.mkdir()
        self.art = self.dir / 'artifacts'
        self.art.mkdir()
        self.log = self.dir / 'calls.log'
        self.log.write_text('')
        self.table = self.dir / 'table.tsv'
        self.cleanup = []
        self.tools_from = tools_from
        executable(self.bin / 'ssh', SSH_DOUBLE)
        executable(self.bin / 'scp', SCP_DOUBLE)
        executable(self.root / 'tools' / 'cloud-test-backend', BACKEND_DOUBLE)
        executable(self.root / 'tools' / 'vm-pair', PAIR_DOUBLE)
        self.rows([('os-release', 0, '"0123456789abcdef0123456789abcdef01234567"')])

    def tool(self, name):
        src = self.tools_from / name
        dst = self.root / 'tools' / name
        shutil.copy2(src, dst)
        dst.chmod(0o755)
        return dst

    def walks(self):
        """The walks as the runner reads them, the step files and suite.txt; vm-visual-qa as a double."""
        shutil.copytree(self.tools_from / 'vm-walks', self.root / 'tools' / 'vm-walks')
        executable(self.root / 'tools' / 'vm-visual-qa', VISUAL_DOUBLE)
        executable(self.bin / 'sleep', SLEEP_DOUBLE)

    def calls(self, prefix):
        return [l for l in self.log.read_text().splitlines() if l.startswith(prefix)]

    def rows(self, rows):
        self.table.write_text(''.join(f'{p}\t{rc}\t{out}\n' for p, rc, out in rows))

    def env(self, drop=(), **extra):
        e = {'PATH': f'{self.bin}:{os.environ["PATH"]}', 'HOME': str(self.dir), 'LC_ALL': 'C',
             'TMPDIR': str(self.tmp), 'VMHT_LOG': str(self.log), 'VMHT_TABLE': str(self.table),
             'VMHT_SCP_FAIL': str(self.dir / 'scp-fail'),
             'ROCKNIX_ARTIFACTS': str(self.art), 'VM_PAIR_DIR': str(self.dir / 'pair'),
             'VM_QEMU_RUNTIME_DIR': str(self.dir / 'runtime'), 'CLOUD_QA_STATE': str(self.dir / 'cloud-qa')}
        for k in drop:  # the defaults a case leaves unset; what it passes is set after
            e.pop(k, None)
        e.update({k: str(v) for k, v in extra.items()})
        return e

    def run(self, argv, timeout=60, drop=(), **extra):
        return subprocess.run(argv, cwd=self.root, env=self.env(drop, **extra), capture_output=True,
                              text=True, timeout=timeout)

    def reports(self):
        return sorted(self.art.glob('rocknix-images/qa-*/report.md'))


CASES = {}


def case(fn):
    CASES[fn.__name__.replace('_', '-')] = fn
    return fn


