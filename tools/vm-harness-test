    subprocess.run(git + ['init', '-q', str(es)], check=True)
    subprocess.run(git + ['-C', str(es), 'commit', '-q', '--allow-empty', '-m', 'other'], check=True)
    head = subprocess.run(['git', '-C', str(es), 'rev-parse', 'HEAD'], capture_output=True, text=True, check=True).stdout.strip()
    c.rows([('os-release', 0, f'"{build}"')])
    r = c.run([str(vmqa), '--skip-up', '--only', 'vocabulary'], ES_SRC=es)
    text = c.reports()[0].read_text() if c.reports() else ''
    row = f'| vocabulary | SKIP (ES_SRC {head[:10]}, image pins {pin[:10]}) |'
    ok = r.returncode == 3 and row in text and not c.calls('vocabulary-check')
    return ok, f'rc {r.returncode}, SKIP row with both hashes {row in text}, check ran {bool(c.calls("vocabulary-check"))} (want rc 3, the row, not run)'


