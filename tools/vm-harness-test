SSH_DOUBLE = r'''#!/bin/bash
# ssh double: log the call, answer from $VMHT_TABLE (substring<TAB>rc<TAB>stdout).
printf '%s\n' "$*" >> "$VMHT_LOG"
cmd="${@: -1}"
if [ -f "$VMHT_TABLE" ]; then
  while IFS=$'\t' read -r pat rc out; do
    [ -n "$pat" ] || continue
    case "$cmd" in *"$pat"*)
      # @count answers how many times this row has matched: a boot id that changes.
      # @sh:<command> runs the command (a case that changes the world mid-run), then answers nothing.
      if [ "${out#@sh:}" != "$out" ]; then eval "${out#@sh:}"
      elif [ "${out#@sleep:}" != "$out" ]; then sleep "${out#@sleep:}"
      # @seq:a||b||c answers a, then b, then c on later matches, and keeps the last.
      elif [ "${out#@seq:}" != "$out" ]; then c="$VMHT_LOG.seq.$(printf '%s' "$pat" | cksum | cut -d' ' -f1)"
        n=$(( $(cat "$c" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$c"
        rest=${out#@seq:}; i=1; item=$rest
        while [ "$i" -lt "$n" ] && [ "${rest#*||}" != "$rest" ]; do rest=${rest#*||}; i=$((i+1)); done
        item=${rest%%||*}; printf '%b\n' "$item"
      elif [ "$out" = @count ]; then c="$VMHT_LOG.count.$(printf '%s' "$pat" | cksum | cut -d' ' -f1)"
        n=$(( $(cat "$c" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$c"; echo "boot-$n"
      elif [ -n "$out" ]; then printf '%b\n' "$out"; fi
      exit "$rc" ;; esac
  done < "$VMHT_TABLE"
fi
exit 0
'''
