    ok = r.returncode == 1 and not walked and not seeded and 'not this run\'s QA cloud' in log and not leaked
    return ok, (f'rc {r.returncode}, walked {len(walked)}, seeded {len(seeded)}, refusal in walks.log '
                f'{"not this run" in log}, stand-in value leaked {leaked} (want rc 1, nothing seeded or walked, no leak)')


