@case
def png_zero(c):
    import struct, zlib
    def chunk(kind, body):
        return struct.pack('>I', len(body)) + kind + body + struct.pack('>I', zlib.crc32(kind + body) & 0xFFFFFFFF)
    zero = b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', 0, 0, 8, 2, 0, 0, 0)) + chunk(b'IDAT', zlib.compress(b'')) + chunk(b'IEND', b'')
    base = c.dir / 'base'
    (base / 'w').mkdir(parents=True)
    (base / 'w' / '01.png').write_bytes(zero)
    (base / 'BASELINE.txt').write_text('build b0\n')
    (c.dir / 'run' / 'w').mkdir(parents=True)
    (c.dir / 'run' / 'w' / '01.png').write_bytes(zero)
    rc, out = fd(c, 'compare', base, c.dir / 'run')
    return rc == 1 and 'no image' in out, f'rc {rc}, {out.strip().splitlines()[-1:]} (want 1: a 0x0 PNG is no frame)'



