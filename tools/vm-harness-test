def short_dir(c):
    """A directory for unix sockets: a case's own path is past the 107-byte cap."""
    import tempfile
    base = os.environ.get('XDG_RUNTIME_DIR') or str(c.dir)
    d = Path(tempfile.mkdtemp(prefix='vmht-', dir=base))
    c.cleanup.append(lambda: shutil.rmtree(d, ignore_errors=True))
    return d


def serve_unix(c, path, handle):
    """A threaded unix-socket server calling handle(conn) per connection; stopped at the case's end."""
    import socket, threading
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(str(path))
    srv.listen(4)
    srv.settimeout(0.2)
    stop = threading.Event()

    def loop():
        while not stop.is_set():
            try:
                conn, _ = srv.accept()
            except OSError:
                continue
            threading.Thread(target=handle, args=(conn,), daemon=True).start()
    threading.Thread(target=loop, daemon=True).start()
    c.cleanup.append(lambda: (stop.set(), srv.close()))


def monitor_double(c, dumps_that_work):
    """QEMU's monitor: sendkey answered; screendump writes a P6 frame for the first
    dumps_that_work calls and then answers an error; no VNC server."""
    path = short_dir(c) / 'mon.sock'
    state = {'dumps': 0, 'keys': 0}

    def handle(conn):
        conn.sendall(b'QEMU 10.2.1 monitor\r\n(qemu) ')
        buf = b''
        while True:
            try:
                chunk = conn.recv(4096)
            except OSError:
                return
            if not chunk:
                return
            buf += chunk
            while b'\n' in buf:
                line, buf = buf.split(b'\n', 1)
                words = line.decode().split()
                reply = b''
                if words[:1] == ['sendkey']:
                    state['keys'] += 1
                elif words[:1] == ['screendump']:
                    state['dumps'] += 1
                    if state['dumps'] <= dumps_that_work:
                        Path(words[1]).write_bytes(b'P6\n2 2\n255\n' + bytes([state['dumps'] % 256] * 12))
                    else:
                        reply = b'Error: dump failed\r\n'
                elif words[:2] == ['info', 'vnc']:
                    reply = b'Server: disabled\r\n'
                conn.sendall(reply + b'(qemu) ')
    serve_unix(c, path, handle)
    return path, state


