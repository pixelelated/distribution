def serial_marker_double(c, path):
    """A serial console that answers vm-serial's markers and runs nothing; `echo serial-ok` says serial-ok."""
    import re

    def handle(conn):
        buf = b''
        while True:
            try:
                chunk = conn.recv(4096)
            except OSError:
                return
            if not chunk:
                return
            buf += chunk
            while b'\n' in buf:
                line, buf = buf.split(b'\n', 1)
                m = re.search(r'echo (BEG\w+); \(? ?(.*?) ?\)?; echo (END\w+)', line.decode(errors='replace'))
                if m:
                    out = 'serial-ok' if m.group(2).strip() == 'echo serial-ok' else ''
                    conn.sendall(('%s\r\n%s\r\n%s:0\r\n' % (m.group(1), out, m.group(3))).encode())
    serve_unix(c, path, handle)


def ra_tree(c, guest_argv_port=10026, serial_leaf='rocknix-qemu-serial-d.sock'):
    """ra-offline-test under test, beside vm-serial, the doubles, and a fixture guest d behind its pidfile."""
    tool = c.tool('ra-offline-test')
    c.tool('vm-serial')
    executable(c.root / 'tools' / 'qa-accounts', QA_ACCOUNTS_DOUBLE)
    executable(c.bin / 'curl', CURL_DOUBLE)
    rt = short_dir(c)
    mon, ser = rt / 'rocknix-qemu-monitor-d.sock', rt / 'rocknix-qemu-serial-d.sock'
    serve_unix(c, mon, lambda conn: conn.recv(65536))
    serial_marker_double(c, ser)
    guest = subprocess.Popen(['qemu-system-fixture', '-c', FIXTURE_GUEST, '-monitor', 'unix:%s,server,nowait' % mon,
                              '-serial', 'unix:%s,server,nowait' % (rt / serial_leaf),
                              '-netdev', 'user,id=net0,hostfwd=tcp:127.0.0.1:%d-:22' % guest_argv_port],
                             executable=sys.executable)
    c.cleanup.append(lambda: (guest.terminate(), guest.wait(timeout=5)))
    (rt / 'rocknix-qemu-d.pid').write_text('%d\n' % guest.pid)
    roms = c.dir / 'roms'
    for rel in ('tobu/Tobu Tobu Girl Deluxe.gb', 'ninoid/Ninoid.gb', 'bobl/Bobl (v1.2)-unpacked/böbl-1.2.nes'):
        (roms / rel).parent.mkdir(parents=True, exist_ok=True)
        (roms / rel).write_bytes(b'stand-in rom')
    acct = c.dir / 'qa-accounts.standin'
    acct.write_text('export RA_QA_USER=standin-user\nexport RA_QA_WEBKEY=standin-key\n')
    acct.chmod(0o600)
    rows = [('os-release', 0, f'"{GUEST_ID}"'), ('raofflineproxy-ctl status', 0, 'enabled=0 marker=0 service=inactive')]
    rows += [(name, 0, sha) for name, sha in RA_SHA.items()]
    env = dict(VM_QEMU_RUNTIME_DIR=rt, QA_ACCOUNTS=acct)
    # The sockets named outright: both versions take the flags, and an old default under /tmp
    # would stop the unfixed run at its preconditions, before the code under test.
    argv = [str(tool), '--roms', str(roms), '--control', '--port', '10026', '--monitor', str(mon), '--serial', str(rt / serial_leaf)]
    return tool, rt, rows, env, argv


def run_until(c, argv, marker, timeout=90, **extra):
    """Read the tool's output until a line holding marker (or its end), then stop its process group."""
    import signal, select, time
    p = subprocess.Popen(argv, cwd=c.root, env=c.env(**extra), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                         text=True, start_new_session=True)
    lines, end = [], time.monotonic() + timeout
    try:
        while time.monotonic() < end:
            r, _, _ = select.select([p.stdout], [], [], 1)
            if r:
                line = p.stdout.readline()
                if not line:
                    break
                lines.append(line.rstrip('\n'))
                if marker and marker in line:
                    break
    finally:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        p.wait(timeout=10)
    return lines


