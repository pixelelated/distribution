SSH_DOUBLE = r'''#!/bin/bash
# ssh double: log the call, answer from $VMHT_TABLE (substring<TAB>rc<TAB>stdout).
printf '%s\n' "$*" >> "$VMHT_LOG"
cmd="${@: -1}"
if [ -f "$VMHT_TABLE" ]; then
  while IFS=$'\t' read -r pat rc out; do
    [ -n "$pat" ] || continue
    case "$cmd" in *"$pat"*)
      # @count answers how many times this row has matched: a boot id that changes.
      if [ "$out" = @count ]; then c="$VMHT_LOG.count.$(printf '%s' "$pat" | cksum | cut -d' ' -f1)"
        n=$(( $(cat "$c" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$c"; echo "boot-$n"
      elif [ -n "$out" ]; then printf '%b\n' "$out"; fi
      exit "$rc" ;; esac
  done < "$VMHT_TABLE"
fi
exit 0
'''
