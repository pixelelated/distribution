def fixture_pids(*dirs):
    """Every fixture guest's pid from the pidfiles under the given directories, wherever a tool put them."""
    pids = []
    for d in dirs:
        for f in Path(d).rglob('rocknix-qemu*.pid') if Path(d).is_dir() else []:
            try:
                pids.append(int(f.read_text().strip()))
            except (OSError, ValueError):
                pass
    return pids


def fixture_alive(pid):
    try:
        return Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')[0] == b'qemu-system-fixture'
    except OSError:
        return False


def reap_fixtures(pids):
    import signal
    for pid in pids:
        if fixture_alive(pid):
            os.kill(pid, signal.SIGTERM)


