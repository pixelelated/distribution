def pair_tree(c):
    """vm-pair and vm-stop under test, a launcher that starts fixture guests, a gz image."""
    c.tool('vm-pair'); c.tool('vm-stop')
    executable(c.root / 'tools' / 'vm-serial', SERIAL_DOUBLE)
    vm = c.root / 'projects' / 'ROCKNIX' / 'devices' / 'GENERIC_X64' / 'vm'
    vm.mkdir(parents=True)
    executable(vm / 'generic-x64-vm', LAUNCHER_DOUBLE)
    executable(c.bin / 'qemu-img', QEMU_IMG_DOUBLE)
    executable(c.bin / 'sleep', SLEEP_DOUBLE)
    img = c.dir / 'image.img.gz'
    subprocess.run(['bash', '-c', 'printf image | gzip > "$1"', 'gz', str(img)], check=True)
    c.rows([('BUILD_ID=', 0, '0123456789')])
    return img


def fixture_pids(*dirs):
    """Every fixture guest's pid from the pidfiles under the given directories, wherever a tool put them."""
    pids = []
    for d in dirs:
        for f in Path(d).rglob('rocknix-qemu*.pid') if Path(d).is_dir() else []:
            try:
                pids.append(int(f.read_text().strip()))
            except (OSError, ValueError):
                pass
    return pids


def fixture_alive(pid):
    try:
        return Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')[0] == b'qemu-system-fixture'
    except OSError:
        return False


def reap_fixtures(pids):
    import signal
    for pid in pids:
        if fixture_alive(pid):
            os.kill(pid, signal.SIGTERM)


@case
def two_checkouts_two_states(c):
    outs = []
    for name in ('one', 'two'):
        root = c.dir / name / 'checkout'
        (root / 'tools').mkdir(parents=True)
        shutil.copy2(c.tools_from / 'vm-pair', root / 'tools' / 'vm-pair')
        r = subprocess.run([str(root / 'tools' / 'vm-pair'), 'info'], cwd=root, capture_output=True, text=True,
                           env=c.env(DEFAULTS, XDG_RUNTIME_DIR=c.dir / 'xdg'), timeout=30)
        outs.append(r.stdout)
    shared = sorted(set(outs[0].split()) & set(outs[1].split()) & {w for w in outs[0].split() if '/' in w})
    in_tmp = [w for o in outs for w in o.split() if w.startswith('/tmp/')]
    ok = outs[0] != outs[1] and not shared and not in_tmp
    return ok, f'paths shared by the two checkouts {shared[:3]}, paths under /tmp {in_tmp[:2]} (want none of either)'


@case
def runtime_recorded(c):
    img = pair_tree(c)
    explicit = c.dir / 'rt-explicit'
    env = dict(VMHT_GUEST=FIXTURE_GUEST, XDG_RUNTIME_DIR=c.dir / 'xdg')
    pids = []
    try:
        up = c.run([str(c.root / 'tools' / 'vm-pair'), 'up', str(img)], drop=('VM_QEMU_RUNTIME_DIR',),
                   VM_QEMU_RUNTIME_DIR=explicit, **env)
        pids = fixture_pids(explicit)
        recorded = (c.dir / 'pair' / 'RUNTIME').read_text().strip() if (c.dir / 'pair' / 'RUNTIME').exists() else ''
        if recorded != str(explicit):
            # Never run the unfixed down: its default runtime directory is /tmp, another session's.
            return False, f'up rc {up.returncode}, RUNTIME recorded {recorded!r} (want {str(explicit)!r}); down not run'
        down = c.run([str(c.root / 'tools' / 'vm-pair'), 'down'], drop=('VM_QEMU_RUNTIME_DIR',), **env)
        import time; time.sleep(0.3)
        alive = [p for p in pids if fixture_alive(p)]
        ok = up.returncode == 0 and down.returncode == 0 and len(pids) == 2 and not alive
        return ok, f'up rc {up.returncode}, recorded {recorded == str(explicit)}, down rc {down.returncode}, guests {len(pids)}, still running {len(alive)}'
    finally:
        reap_fixtures(set(pids) | set(fixture_pids(c.dir)))


@case
def port_held_refused(c):
    import socket
    img = pair_tree(c)
    rt = c.dir / 'rt'
    listener = socket.socket()
    try:
        listener.bind(('127.0.0.1', 10022))
    except OSError as error:
        return False, f'10022 is already held on this host ({error}); the case cannot run, so it has not passed'
    listener.listen()
    pids = []
    try:
        r = c.run([str(c.root / 'tools' / 'vm-pair'), 'up', str(img)], VM_QEMU_RUNTIME_DIR=rt, VMHT_GUEST=FIXTURE_GUEST)
        pids = fixture_pids(rt)
        launched = c.calls('launch ')
        ok = r.returncode != 0 and not launched and f'pid {os.getpid()}' in r.stderr
        return ok, f'rc {r.returncode}, launches {len(launched)}, holder named {f"pid {os.getpid()}" in r.stderr} (want a refusal naming this pid, nothing launched)'
    finally:
        listener.close()
        reap_fixtures(set(pids) | set(fixture_pids(c.dir)))


@case
def no_tmp_writes(c):
    import time
    executable(c.bin / 'mktemp', MKTEMP_DOUBLE)
    marker = time.time()
    vmqa = c.tool('vm-qa')
    c.walks()
    # A guest with no remote and no saved state, so the runner seeds one: its mktemp is the write in question.
    c.rows([('test -s /storage/.config/rclone/rclone.conf', 1, ''), ('cloud_remote active', 0, ''),
            ('os-release', 0, f'"{GUEST_ID}"'), ('boot_id', 0, '@count')])
    c.run([str(vmqa), '--skip-up', '--only', 'walks', '--walk', WALK], drop=DEFAULTS, XDG_RUNTIME_DIR=c.dir / 'xdg', VMHT_CASE=c.dir)
    made = [l.split(' ', 1)[1] for l in c.calls('mktemp ')]
    keys = sorted({a for l in c.calls('') for a in l.split() if a.endswith('/qa-key')})
    fixed_names = ('rocknix-vm-pair', 'rocknix-qemu', 'ttp-cm-', 'ra-offline-', 'vm-qa-')
    found = [str(p) for p in Path('/tmp').iterdir() if p.name.startswith(fixed_names)
             and p.stat().st_mtime >= marker and p.owner() == Path.home().owner()] if Path('/tmp').is_dir() else []
    in_tmp = [m for m in made if m.startswith('/tmp/')] + [k for k in keys if k.startswith('/tmp/')] + found
    ok = bool(made) and not in_tmp
    return ok, f'{len(made)} temp files asked for, key {keys}, aimed at /tmp: {in_tmp[:3]} (want temp files and none aimed at /tmp)'


@case
def rehearsal_artifacts_root(c):
    reh = c.tool('vm-upgrade-rehearsal')
    executable(c.bin / 'mkdir', MKDIR_LOGGING)
    old = c.dir / 'old' / 'pixelelated-GENERIC_X64-old.img.gz'
    old.parent.mkdir()
    old.write_bytes(b'')
    new = c.dir / 'new.tar'
    new.write_bytes(b'')
    r = c.run([str(reh), str(old), str(new), '0123456789'], VMHT_PAIR_UP_RC=1, VMHT_CASE=c.dir)
    dirs = [l.split()[-1] for l in c.calls('mkdir ') if 'upgrade-from' in l]
    outside = [d for d in dirs if not d.startswith(str(c.art))]
    ok = bool(dirs) and not outside
    return ok, f'the report directory it made: {dirs[:1]} (want it under ROCKNIX_ARTIFACTS={c.art.name}/)'


def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    ap.add_argument('--case', action='append', help='run only this case (repeatable)')
    ap.add_argument('--tools-from', type=Path, default=HERE, help='the directory holding the tools under test')
    ap.add_argument('--list', action='store_true')
    a = ap.parse_args()
    if a.list:
        print('\n'.join(CASES)); return 0
    names = a.case or list(CASES)
    unknown = [n for n in names if n not in CASES]
    if unknown:
        ap.error('unknown case: ' + ', '.join(unknown))
    SCRATCH.mkdir(parents=True, exist_ok=True)
    failed = 0
    for n in names:
        c = Case(n, a.tools_from.resolve())
        try:
            ok, why = CASES[n](c)
        except Exception as error:  # a case that cannot run has not passed
            ok, why = False, f'{type(error).__name__}: {error}'
        print(('PASS ' if ok else 'FAIL ') + n + ': ' + why, flush=True)
        failed += not ok
    print(f'{len(names) - failed} PASS; {failed} FAIL')
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main())
