class Escalation(unittest.TestCase):
    def setUp(self):
        self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.cleanup)
        self.inbox=Path(self.tmp.name)/'inbox';self.inbox.mkdir();os.chmod(self.inbox,0o700)
        self.c=dict(root_pane='root',root_session='r',workers={'worker':'w'},
                    human_session='h',herdr='herdr',state='/fixture/state',monitor_state='/fixture/monitor',
                    inbox=str(self.inbox))
        self.s=dict(schema='human-escalation-v1',incidents={})
        self.m={'recovery':{'tracking':{'root':dict(pane='root',session='r',disposition='blocked',
              blocked_on='actual refusal',recorded_at=1,next_action='prepare request',evidence='/evidence')}}}
        self.calls=[];self.saved=[]
    def cleanup(self):
        if self.inbox.exists():os.chmod(self.inbox,0o700)
        self.tmp.cleanup()
    def persist(self):self.saved.append(copy.deepcopy(self.s))
    def call(self,argv):
        self.calls.append(argv)
        if argv[1:3]==['agent','get']:
            return subprocess.CompletedProcess(argv,0,'{"result":{"agent":{"agent_session":{"value":"h"},"agent_status":"idle"}}}','')
        return subprocess.CompletedProcess(argv,0,'accepted','')
    def detect(self):
        e.detect(self.s,self.m,self.c,10);return next(iter(self.s['incidents']))
    def deliver(self,now=10,call=None):e.deliver(self.s,self.c,call or self.call,self.persist,now)
    def files(self):return sorted(p.name for p in self.inbox.iterdir()) if self.inbox.exists() else []
    def prompts(self):
        """Delivered notice bodies in delivery order; every inbox file belongs to one attempt."""
        rows=sorted((r for r in self.s['incidents'].values() if (r.get('attempt') or {}).get('file')),
                    key=lambda r:r['attempt']['at'])
        self.assertEqual(sorted(r['attempt']['file'] for r in rows),self.files())
        self.assertFalse(any(a[1:3]==['agent','prompt'] for a in self.calls))
        return [(self.inbox/r['attempt']['file']).read_text().split('\n',2)[2].strip() for r in rows]
