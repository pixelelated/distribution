    def test_followup_receipts_preserve_originals_and_are_idempotent(self):
        i=self.detect();self.deliver()
        e.receipt(self.s,i,'consumed','h','/original-read',self.c,20)
        e.receipt(self.s,i,'user_facing','h','/original-publication',self.c,30)
        e.receipt(self.s,i,'update','r','/update-submission',self.c,40)
        before=copy.deepcopy(self.s['incidents'][i]);calls=len(self.calls)
        spec=dict(update_id='late-2240',submission_evidence='/update-submission',
                  consumed=dict(actor='h',observed_at='22:42 UTC',evidence='/read'),
                  user_facing=dict(actor='h',observed_at='after consumption; exact time unknown',evidence='/publication'),
                  next_update='23:10 UTC')
        e.followup_receipt(self.s,i,spec,self.c,50)
        saved=copy.deepcopy(self.s)
        e.followup_receipt(self.s,i,spec,self.c,60)
        self.assertEqual(saved,self.s);self.assertEqual(len(self.calls),calls)
        for field in ('consumed','user_facing','update','resolved','spec'):
            self.assertEqual(self.s['incidents'][i][field],before[field])
        with tempfile.TemporaryDirectory() as t:
            p=Path(t)/'state';e.save(p,self.s);self.assertEqual(e.read(p),self.s)
        for change in (dict(next_update='different'),dict(submission_evidence='/wrong'),
                       dict(consumed=None),dict(user_facing=dict(actor='other'))):
            with self.assertRaises(ValueError):e.followup_receipt(self.s,i,dict(spec,**change),self.c,70)
        self.assertEqual(saved,self.s)
        e.receipt(self.s,i,'update','r','/second-submission',self.c,80,update_id='late-2310')
        second=dict(spec,update_id='late-2310',submission_evidence='/second-submission',next_update='23:40 UTC')
