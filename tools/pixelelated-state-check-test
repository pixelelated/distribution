        ("unused-slots-without-dots", "ls -p /lost+found", slots, 2),
        ("zero-inode-named-entry", "ls -p /lost+found", lost + "/0/000000/0/0/" + CANARY + "/0/\n", 2),
        ("zero-inode-live-mode", "ls -p /lost+found", lost + "/0/100644/0/0//0/\n", 2),
        ("zero-inode-owner", "ls -p /lost+found", lost + "/0/000000/1/0//0/\n", 2),
        ("zero-inode-size", "ls -p /lost+found", lost + "/0/000000/0/0//1/\n", 2),
        ("zero-inode-short-record", "ls -p /lost+found", lost + "/0/000000/0//0/\n", 2),
        ("zero-inode-alternate-spelling", "ls -p /lost+found", lost + "/00/000000/0/0//0/\n", 2),
        ("unused-slot-trailing-data", "ls -p /lost+found", lost + "/0/000000/0/0//0/extra\n", 2),
        ("live-entry-beside-unused-slots", "ls -p /lost+found",
         lost + slots + "/13/100644/0/0/" + CANARY + "/0/\n", 1),
    )
    rows = []
    for name, directory, output, expected in cases:
        responses = {"ls -p /": root, "ls -p /lost+found": lost}
        responses[directory] = output
        response = put(work, "debugfs-shim/response.json", json.dumps(responses))
        env = {**os.environ, "PATH": str(shim.parent) + os.pathsep + os.environ.get("PATH", ""),
               "PIX565_DEBUGFS_RESPONSE": str(response)}
        invoke(["--payload", str(image)], expected,
               "storage-seed-residue" if expected == 1 else None, env=env)
        rows.append({"case": "debugfs-" + name, "status": "pass", "synthetic_reader_output": True})
    return rows


def payload_controls(work):
    rows = []
    for name, contaminated in (("clean", False), ("contaminated", True)):
        root = work / (name + "-root")
        root.mkdir()
        clean(root, runtime=False)
        shipped_locale(root)
        put(root, "etc/retroarch.cfg", '# Synthetic upstream-style defaults\n# video_driver = "gl"\n')
        if contaminated:
            put(root, "usr/config/system/configs/system.cfg",
                "global.retroachievements.username=" + CANARY + "\n")
        tar = work / (name + ".tar")
        system = make_tar(root, tar)
        report = invoke(["--payload", str(tar)], 1 if contaminated else 0,
                        "player-account" if contaminated else None)
        require(any(row["category"] == "runtime-locale-deferred" and row["status"] == "clear"
                    for row in report["checks"]))
        rows.append({"case": "tar-" + name + "-shipped-locale", "status": "pass"})
        if not contaminated:
            invoke(["--payload", str(tar)], 2, env={**os.environ, "PATH": "/nonexistent"})
            rows.append({"case": "missing-payload-reader", "status": "pass"})
        parent = work / (name + "-bundle")
        parent.mkdir()
        bundle = release_bundle(parent, tar)
        p = subprocess.run([sys.executable, "-B", str(HERE / "fork-publish-release"),
                            "--prepare", str(bundle)], capture_output=True, timeout=180)
        require(CANARY.encode() not in p.stdout + p.stderr)
        require(p.returncode == (1 if contaminated else 0))
        if not contaminated:
            plan = json.loads(p.stdout)
            require(plan["publication_performed"] is False and plan["draft"] is True)
            require(len(plan["selected_state_inspection"]) == 1)
            for dirty_storage in (False, True):
                image = work / ("dirty-storage.img.gz" if dirty_storage else "clean.img.gz")
                make_image(system, image, dirty_storage)
                invoke(["--payload", str(image)], 1 if dirty_storage else 0,
                       "storage-seed-residue" if dirty_storage else None)
                rows.append({"case": "image-dirty-storage" if dirty_storage else "image-clean",
                             "status": "pass"})
            rows += ext4_listing_controls(work, work / "clean.img.gz")
        rows.append({"case": "prepare-" + name, "status": "pass"})
    for name, mutate in (("locale-altered-second-hop", lambda r: shipped_locale(
            r, second="/storage/.config/other")), ("locale-target-escape", locale_target_escape)):
        root = work / (name + "-payload-root")
        root.mkdir()
        clean(root, runtime=False)
        mutate(root)
        path = work / (name + ".tar")
        make_tar(root, path)
        invoke(["--payload", str(path)], 2)
        rows.append({"case": "tar-" + name, "status": "pass"})
    root = work / "preseeded-scrub-root"
    root.mkdir()
    clean(root, runtime=False)
    shipped_locale(root)
    scrub_marker(root, boot=False)
    path = work / "preseeded-scrub.tar"
    make_tar(root, path)
    invoke(["--payload", str(path)], 1, "preseeded-log-scrub")
    rows.append({"case": "tar-zero-work-scrub-preseed-refused", "status": "pass"})
    # Regression for unsquashfs cat_scan fnmatch: bracketed and matching literal
    # sibling coexist, but only the bracketed file is contaminated. Reading the
    # clean match or skipping the unsupported spelling must not produce a pass.
    root = work / "literal-reader-root"
    root.mkdir()
    clean(root, runtime=False)
    shipped_locale(root)
    put(root, "usr/config/system/configs/system.cfg.bak[1]",
        "global.retroachievements.token=" + CANARY + "\n")
    put(root, "usr/config/system/configs/system.cfg.bak1",
        "global.retroachievements.token=\n")
    path = work / "literal-reader.tar"
    make_tar(root, path)
    report = invoke(["--payload", str(path)], 1, "player-account")
    require(any(row["path"] == "/usr/config/system/configs/system.cfg.*" and
                row["category"] == "player-account" and row["count"] == 1 and
                row["status"] == "blocked" for row in report["checks"]))
    rows.append({"case": "tar-literal-bracketed-recovery-file", "status": "pass"})
    parent = work / "literal-reader-bundle"
    parent.mkdir()
    bundle = release_bundle(parent, path)
    p = subprocess.run([sys.executable, "-B", str(HERE / "fork-publish-release"),
                        "--prepare", str(bundle)], capture_output=True, timeout=180)
    require(p.returncode == 1 and CANARY.encode() not in p.stdout + p.stderr)
    rows.append({"case": "prepare-literal-bracketed-recovery-file", "status": "pass"})
    for name, members in (("missing-system", [("synthetic/target/KERNEL", b"not-system")]),
                          ("invalid-squashfs", [("synthetic/target/SYSTEM", b"not-system")]),
                          ("traversal", [("../SYSTEM", b"not-system")]),
                          ("duplicate-system", [("synthetic/target/SYSTEM", b"x")] * 2)):
        path = work / (name + ".tar")
        with tarfile.open(path, "w") as archive:
            for member_name, data in members:
                member = tarfile.TarInfo(member_name)
                member.size = len(data)
                archive.addfile(member, io.BytesIO(data))
        invoke(["--payload", str(path)], 2)
        rows.append({"case": name, "status": "pass"})
    bad = put(work, "invalid.img.gz", b"not-gzip")
    invoke(["--payload", str(bad)], 2)
    unknown = put(work, "unknown.bin", b"synthetic")
    invoke(["--payload", str(unknown)], 2)
    rows.extend({"case": n, "status": "pass"} for n in ("invalid-gzip", "unsupported-payload"))
    return rows


def prepare_guest(path):
    # Source travels inline through the serial helper, leaving no fixture in /storage.
    encoded = base64.b64encode(GATE.read_bytes()).decode()
    script = """#!/bin/sh
set -u
python3 -B -c 'import base64; exec(compile(base64.b64decode(""" + json.dumps(encoded) + """), "<state-check>", "exec"))' --root / --mode first-boot --require-ready
rc=$?
echo "PIX_STATE_565_RC=$rc"
exit "$rc"
"""
    with path.open("x") as stream:
        stream.write(script)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--self-test", action="store_true")
    mode.add_argument("--payload-tests", action="store_true")
    mode.add_argument("--prepare-guest-script", type=Path)
    args = parser.parse_args()
    if args.prepare_guest_script:
        prepare_guest(args.prepare_guest_script)
        print("prepared first-boot script; not executed")
        return 0
    if args.payload_tests:
        require(all(shutil.which(name) for name in ("mksquashfs", "unsquashfs", "sfdisk", "mcopy",
                                                  "mkfs.vfat", "mkfs.ext4", "e2fsck", "debugfs")))
    with tempfile.TemporaryDirectory(prefix="pix565-controls-") as directory:
        work = Path(directory)
        rows = root_controls(work) + exec_start_controls()
        names = [row["case"] for row in rows]
        require(len(names) == len(set(names)) and set(names) == SELF_TEST_CONTROLS)
        if args.payload_tests:
            rows += payload_controls(work)
    print(json.dumps({"schema": 1, "status": "pass", "control_count": len(rows), "controls": rows}, indent=2))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        print('{"schema":1,"status":"error","category":"fixture-or-reader-failure"}')
        sys.exit(2)
