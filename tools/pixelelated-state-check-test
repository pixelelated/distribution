def exec_start_controls():
    """The readiness predicate, on systemctl-show values shaped as systemd 255
    prints them, and the tree's unit against the gate's constant (#1000)."""
    def entry(path, argv):
        return ("{ path=" + path + " ; argv[]=" + argv + " ; ignore_errors=no ; start_time=[n/a] ; "
                "stop_time=[n/a] ; pid=0 ; code=exited ; status=0 }")
    cases = [("exec-start-shipped-wrapper", entry("/bin/bash", "/bin/bash -a -c source /etc/profile && exec /usr/bin/autostart"), True),
             ("exec-start-command-word", entry("/usr/bin/autostart", "/usr/bin/autostart"), True),
             ("exec-start-autostart-as-argument", entry("/usr/bin/env", "/usr/bin/env /usr/bin/autostart"), False),
             ("exec-start-other-shell-script", entry("/bin/sh", "/bin/sh -c exec /usr/bin/autostart"), False),
             ("exec-start-wrapper-other-script", entry("/bin/bash", "/bin/bash -a -c source /etc/profile && exec /usr/bin/autostart --other"), False),
             ("exec-start-unparsed", "/usr/bin/autostart", False)]
    probe = subprocess.run([sys.executable, "-I", "-B", "-c", EXEC_PROBE, str(GATE),
                            json.dumps([value for _, value, _ in cases])], capture_output=True, text=True, timeout=30)
    require(probe.returncode == 0 and not probe.stderr)
    answer = json.loads(probe.stdout)
    rows = []
    for (name, _, expected), verdict in zip(cases, answer["verdicts"], strict=True):
        require(verdict is expected)
        rows.append({"case": name, "status": "pass", "ready": expected})
    lines = [l for l in UNIT.read_text().splitlines() if l.startswith("ExecStart=")]
    require(len(lines) == 1)
    require(shlex.split(lines[0][len("ExecStart="):]) == answer["wrapper"])
    rows.append({"case": "exec-start-tree-unit-matches-gate", "status": "pass"})
    return rows


