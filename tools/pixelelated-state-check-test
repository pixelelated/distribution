def scrub_marker(root, first=SCRUB_EPOCH + 10, second=SCRUB_EPOCH + 11,
                 files1=0, lines1=0, files2=0, lines2=0, boot=True):
    if boot:
        put(root, "proc/stat", "cpu 0 0 0 0\nbtime " + str(SCRUB_EPOCH) + "\nprocesses 1\n")
        put(root, "proc/uptime", "100.00 175.00\n")
    return put(root, "storage/.cache/cloud_sync/log-scrubbed",
               f"scrubbed={first} files={files1} lines={lines1}\n"
               f"es_log_scrubbed={second} files={files2} lines={lines2}\n")


def no_adapter_scrub(root, *, data=None, mtime=SCRUB_EPOCH + 9, **marker):
    scrub_marker(root, files1=1, **marker)
    # Public fixed diagnostic from cloud_device_id, with a synthetic calendar
    # value. Its file mtime, not the fixture host's timezone, binds the boot.
    normal = ("[2033-05-18 03:33:29] [INFO] [cloud_device_id] "
              "no stored id and no adapter to derive one from yet; not seeding the identity "
              "from machine-id at this caller's request (--if-present)\n")
    log = put(root, "storage/.cache/log/cloud_sync.log", normal if data is None else data)
    os.utime(log, ns=(mtime * 1000000000, mtime * 1000000000))
    return log


def alter_scrub(root, rewrite):
    path = scrub_marker(root)
    path.write_text(rewrite(path.read_text()))


def snapshot(root):
    # Compare synthetic fixture bytes directly in memory, never hash credentials.
    result = {}
    for p in root.rglob("*"):
        meta = p.lstat()
        if stat.S_ISLNK(meta.st_mode):
            value = os.readlink(p)
        elif stat.S_ISREG(meta.st_mode):
            value = p.read_bytes() if meta.st_mode & 0o444 else None
        else:
            value = None
        result[str(p.relative_to(root))] = (meta.st_mode, value)
    return result


def invoke(args, expected, category=None, env=None):
    p = subprocess.run([sys.executable, "-B", str(GATE), *args], capture_output=True, timeout=45, env=env)
    require(p.returncode == expected and not p.stderr)
    output = p.stdout.decode()
    require(CANARY not in output)
    require(all(str(epoch) not in output for epoch in
                (SCRUB_EPOCH, SCRUB_EPOCH + 10, SCRUB_EPOCH + 11)))
    report = json.loads(output)
    require(report["status"] == {0: "pass", 1: "blocked", 2: "error"}[expected])
    if expected == 2:
        # A refusal, never a crash: the gate names a fault in itself
        # `reader-failure`, and a control it satisfies proves nothing (#1001).
        errors = [row["category"] for row in report["checks"] if row["status"] == "error"]
        require(errors and "reader-failure" not in errors)
    if category:
        require(any(row["category"] == category and row.get("count", 0) > 0
                    for row in report["checks"]))
    return report


