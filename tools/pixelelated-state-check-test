def put(root, path, data):
    p = root / path.lstrip("/")
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_bytes(data.encode() if isinstance(data, str) else data)
    return p


def clean(root, runtime=True):
    defaults = {
        "system/configs/system.cfg": 'global.retroachievements.username=\nglobal.retroachievements.password=\n',
        "emulationstation/es_settings.cfg": '<config/>\n',
        "retroarch/retroarch.cfg": 'cheevos_username = ""\ncheevos_password = ""\ncheevos_token = ""\n',
        "cloud_sync.conf": CLOUD,
    }
    for prefix in ("usr/config", "storage/.config") if runtime else ("usr/config",):
        for name, data in defaults.items():
            put(root, prefix + "/" + name, data)
    put(root, "usr/config/cloud_sync.conf.defaults",
        "".join("DEFAULT_" + line + "\n" for line in CLOUD.splitlines()))
    put(root, "etc/retroarch.cfg", 'video_driver = "gl"\n')
    # A parser fixture with an ELF header, not a functional ES executable.
    put(root, "usr/bin/emulationstation", b"\x7fELF\x02" + b"\0" * 59)
    if runtime:
        put(root, "storage/roms/synthetic/gamelist.xml",
