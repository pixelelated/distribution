def shipped_locale(root, first="/usr/share/locale", second="/storage/.config/locale"):
    # Exact ES post_install chain: absent storage target in an immutable SYSTEM.
    (root / "usr/share").mkdir(parents=True, exist_ok=True)
    (root / "usr/config/emulationstation/locale").symlink_to(first)
    (root / "usr/share/locale").symlink_to(second)


