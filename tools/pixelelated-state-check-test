def run(argv, stdin=None):
    p = subprocess.run(argv, input=stdin, capture_output=True, timeout=180)
    require(p.returncode == 0)
    return p.stdout


def make_tar(root, destination):
    system = destination.with_suffix(".system")
    run(["mksquashfs", str(root), str(system), "-noappend", "-processors", "1", "-no-progress"])
    with tarfile.open(destination, "w") as archive:
        archive.add(system, arcname="synthetic/target/SYSTEM", recursive=False)
    return system


def make_image(system, destination, contaminated=False):
    disk = destination.with_suffix("")
    with disk.open("xb") as stream:
        stream.truncate(80 * 1024**2)
    run(["sfdisk", str(disk)], b"label: dos\nstart=2048,size=65536,type=c\nstart=67584,size=65536,type=83\n")
    fat = destination.with_suffix(".fat")
    with fat.open("xb") as stream:
        stream.truncate(32 * 1024**2)
    run(["mkfs.vfat", str(fat)])
    run(["mcopy", "-i", str(fat), str(system), "::/SYSTEM"])
    ext = destination.with_suffix(".ext4")
    seed = destination.with_suffix(".seed")
    seed.mkdir()
    (seed / ".please_resize_me").touch()
    if contaminated:
        (seed / "qa-state").write_text("synthetic")
    with ext.open("xb") as stream:
        stream.truncate(32 * 1024**2)
    run(["mkfs.ext4", "-F", "-q", "-d", str(seed), str(ext)])
    with disk.open("r+b") as output:
        for source, offset in ((fat, 2048 * 512), (ext, 67584 * 512)):
            output.seek(offset)
            with source.open("rb") as stream:
                shutil.copyfileobj(stream, output)
    with disk.open("rb") as stream, gzip.open(destination, "wb") as output:
        shutil.copyfileobj(stream, output)


def release_bundle(parent, payload_path):
    # Whole synthetic artifact hashes are required by the existing candidate store;
    # no credential-field hash is computed or written.
    commit, stamp, version = "1" * 40, "20261013T000000Z", "0.0.1-rc.1"
    build = version + "+" + stamp + ".g" + commit[:12]
    base = "pixelelated-GENERIC_X64.x86_64-" + build
    bundle = parent / "incoming"
    bundle.mkdir()
    name = base + ".tar"
    shutil.copyfile(payload_path, bundle / name)
    identity = {"schema": 1, "name": "pixelelated", "dirty": "no", "release_version": version,
                "build_timestamp": stamp, "build_commit": commit, "build_version": build,
                "image_name": base, "device": "GENERIC_X64", "arch": "x86_64"}
    put(bundle, base + ".identity.json", json.dumps(identity))
    digest = hashlib.sha256((bundle / name).read_bytes()).hexdigest()
    put(bundle, name + ".sha256", digest + "  " + name + "\n")
    files = {p.name: {"sha256": hashlib.sha256(p.read_bytes()).hexdigest(), "bytes": p.stat().st_size}
             for p in bundle.iterdir()}
    manifest = json.dumps({"schema": 1, "inputs": {"distribution_commit": commit}, "files": files})
    put(bundle, "manifest.json", manifest)
    dest = parent / hashlib.sha256(manifest.encode()).hexdigest()
    bundle.rename(dest)
    return dest


