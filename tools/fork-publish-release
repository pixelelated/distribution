"""Prepare GitHub release identity from an explicit immutable candidate bundle.

No upload, tag creation, asset replacement or publication occurs. The previous
newest-file/date/undraft path is retired (#265, #530). Actual publication needs
the independent qualification/source/credential gates and named approval.
"""
import argparse
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys
from datetime import datetime


def prepare(bundle):
    store = Path(__file__).resolve().with_name("rasteratops-candidate-store")
    subprocess.run([str(store), "verify", str(bundle)], check=True,
                   stdout=sys.stderr)
    manifest = json.loads((bundle / "manifest.json").read_text())
    identities = [name for name in manifest["files"] if name.endswith(".identity.json")]
    if not identities:
        raise ValueError("bundle has no build identity; do not relabel historical firmware")
    common = None
    assets = {}
    for name in identities:
        item = json.loads((bundle / name).read_text())
        if item["schema"] != 1 or item["name"] != "pixelelated" or item["dirty"] != "no":
            raise ValueError("unsupported or dirty build identity")
        version = item["release_version"]
        num = r"(?:0|[1-9][0-9]*)"
        if not re.fullmatch(rf"{num}\.{num}\.{num}(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?", version):
            raise ValueError("invalid semantic release version")
        if "-" in version:
            for part in version.split("-", 1)[1].split("."):
                if part.isdigit() and len(part) > 1 and part.startswith("0"):
                    raise ValueError("invalid numeric prerelease identifier")
        stamp, commit = item["build_timestamp"], item["build_commit"]
        if not re.fullmatch(r"[0-9]{8}T[0-9]{6}Z", stamp) or not re.fullmatch(r"[0-9a-f]{40}", commit):
            raise ValueError("invalid timestamp or source identity")
        datetime.strptime(stamp, "%Y%m%dT%H%M%SZ")
        build = f"{version}+{stamp}.g{commit[:12]}"
        if build != item["build_version"]:
            raise ValueError("build identity fields disagree")
        if manifest["inputs"].get("distribution_commit") != commit:
            raise ValueError("source commit differs from manifest inputs")
        key = (version, stamp, commit, build)
        if common is not None and common != key:
            raise ValueError("bundle mixes build identities")
        common = key
        base = item["image_name"]
        if not re.fullmatch(r"[A-Z0-9_]+", item["device"]) or not re.fullmatch(r"[a-z0-9_]+", item["arch"]):
            raise ValueError("invalid target identity")
        prefix = f"pixelelated-{item['device']}.{item['arch']}-{build}"
        if base != prefix and not base.startswith(prefix + "-"):
            raise ValueError("image name disagrees with build identity")
        if name != base + ".identity.json":
            raise ValueError("sidecar name disagrees with image identity")
        found = False
        for asset, record in manifest["files"].items():
            if not asset.startswith(base + ".") and not asset.startswith(base + "-"):
                continue
            if not asset.endswith((".img.gz", ".tar")):
                continue
            checksum = asset + ".sha256"
            if checksum not in manifest["files"]:
                raise ValueError("missing artifact checksum: " + asset)
            line = (bundle / checksum).read_text().strip()
            if line not in (record["sha256"] + "  " + asset, record["sha256"] + " *" + asset):
                raise ValueError("checksum file disagrees with manifest: " + asset)
            assets[asset] = record
            assets[checksum] = manifest["files"][checksum]
            found = True
        if not found:
            raise ValueError("identity has no firmware assets")
        assets[name] = manifest["files"][name]
    firmware = {n for n in manifest["files"] if n.endswith((".img.gz", ".tar"))}
    if firmware != {n for n in assets if n.endswith((".img.gz", ".tar"))}:
        raise ValueError("bundle contains firmware without matching identity")
    version, stamp, commit, build = common
    prerelease = "-" in version
    return {"schema": 1, "repository": "pixelelated/distribution",
            "bundle_sha256": bundle.name, "release_version": version,
            "build_version": build, "target_commitish": commit,
            "tag": "v" + (build if prerelease else version),
            "title": "pixelelated " + (build if prerelease else version),
            "prerelease": prerelease, "draft": True, "assets": assets,
            "publication_performed": False, "qualification": "not assessed",
            "remaining_gates": ["candidate qualification", "source/licence custody",
                                "artifact credential inspection", "named publication approval"]}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prepare", type=Path, required=True, metavar="BUNDLE")
    args = parser.parse_args()
    try:
        print(json.dumps(prepare(args.prepare.resolve()), indent=2, sort_keys=True))
    except (OSError, ValueError, KeyError, TypeError, subprocess.CalledProcessError) as error:
        print("release preparation: " + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
