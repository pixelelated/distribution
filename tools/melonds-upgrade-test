#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""#526: preserve melonDS configuration while adding missing hotkey defaults.

Runs the actual post-update function with owned paths and candidate BusyBox
applets. An older post-update runs its exact legacy tail with those paths
relocated into the fixture; its failures are discriminating negative controls.

The busybox must be the candidate's (#997): a path under a build root's
image/system/ (its BUILD_ID read from that root's etc/os-release), or one
whose origin --busybox-from names (a BUILD_ID, or `image` on the candidate
itself, as a guest run passes /usr/bin/busybox). Any other is refused, exit 2;
--unverified-busybox runs it anyway and marks every line "host busybox, not the
candidate's": it exits 3 when every case passed, because a run that could not
qualify the candidate has not passed, and 1 when a case failed, because a
defect found under another busybox is still a defect. Every applet that busybox lists is shimmed (sh aside), and
the receipt hashes the bytes that ran.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

UNVERIFIED = "host busybox, not the candidate's"


def cannot(why):
    print('melonds-upgrade-test: CANNOT -- ' + why, file=sys.stderr)
    raise SystemExit(2)


def busybox_origin(path, declared, unverified):
    """Where the busybox came from: a build root's image, a named origin, or
    nowhere known (only with --unverified-busybox)."""
    for directory in path.resolve().parents:
        if directory.name == 'system' and directory.parent.name == 'image':
            release = directory / 'etc/os-release'
            ids = []
            if release.is_file() and not release.is_symlink():
                ids = re.findall(r'^BUILD_ID="?([^"\n]*)"?$', release.read_text(), re.M)
            if not ids or not ids[-1]:
                cannot(f'{path} is under {directory} but {release} names no BUILD_ID')
            return {'kind': 'build-root', 'root': str(directory.parent.parent), 'build_id': ids[-1]}
    if declared:
        return {'kind': 'declared', 'from': declared}
    if unverified:
        return {'kind': 'unverified', 'marker': UNVERIFIED}
    cannot(f"{path} is not under a build root's image/system/; name its origin with "
           '--busybox-from <BUILD_ID|image>, or pass --unverified-busybox (exit 3)')


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--post-update', required=True, type=Path)
    parser.add_argument('--busybox', required=True, type=Path)
    parser.add_argument('--busybox-from', help="the busybox's origin when it is not under a build root: a BUILD_ID, or image")
    parser.add_argument('--unverified-busybox', action='store_true',
                        help='run a busybox of no known origin: every line is marked; exit 3 when every case passed, 1 when one failed')
    parser.add_argument('--output', required=True, type=Path)
    args = parser.parse_args()
    origin = busybox_origin(args.busybox, args.busybox_from, args.unverified_busybox)
    mark = ' -- ' + UNVERIFIED if origin['kind'] == 'unverified' else ''
    if origin['kind'] == 'build-root':
        print(f"busybox: build root {origin['root']}, BUILD_ID {origin['build_id']}", flush=True)
    else:
        print('busybox: ' + (f"declared from {origin['from']}" if origin['kind'] == 'declared' else UNVERIFIED), flush=True)
    source = args.post_update.read_text()
    function = re.search(r'^update_melonds_hotkeys\(\) \{.*?^\}', source, re.M | re.S)
    legacy = re.search(r'^rm -rf /storage/\.config/melonDS\ncp -r /usr/config/melondDS /storage/\.config/\s*$', source, re.M)
    if not function and not legacy:
        parser.error('no recognized current function or historical update block')
    rows = []
    cases = ['missing-defaults', 'missing-config', 'empty-defaults', 'add-missing',
             'already-current', 'no-final-newline', 'empty-config', 'file-link',
             'directory-link', 'whitespace-key', 'non-hotkey-defaults',
             'copy-failure', 'producer-failure', 'rename-failure', 'temp-failure']
    with tempfile.TemporaryDirectory(prefix='pixelelated-melonds-') as temporary:
        root = Path(temporary)
        busybox = root / 'busybox'
        shutil.copy2(args.busybox, busybox)
        busybox_sha256 = hashlib.sha256(busybox.read_bytes()).hexdigest()
        binary = root / 'bin'
        binary.mkdir()
        applets = [a for a in subprocess.run([str(busybox), '--list'], capture_output=True, text=True).stdout.split() if a != 'sh']
        if not {'mktemp', 'cp', 'awk', 'mv', 'rm'} <= set(applets):
            cannot(f"{args.busybox} --list lacks the function's applets")
        for applet in applets:
            wrapper = binary / applet
            wrapper.write_text('#!/bin/sh\nexec ' + shlex.quote(str(busybox)) + ' ' + applet + ' "$@"\n')
            wrapper.chmod(0o700)
        for name in cases:
            case = root / (name + ' with spaces')
            defaults = case / 'usr/config/melonDS/melonDS.ini'
            config = case / 'storage/.config/melonDS/melonDS.ini'
            defaults.parent.mkdir(parents=True)
            config.parent.mkdir(parents=True)
            defaults.write_text('HKKey_New=-1\nHKJoy_Custom=5\nHKJoy_New=4\nScreenLayout=2\n')
            original = '# owner settings\nHKJoy_Custom=99\nScreenLayout=7\nOwnerUnknown=yes\n'
            config.write_text(original)
            config.chmod(0o600)
            sentinel = config.parent / 'owner-extra.txt'
            sentinel.write_text('keep extra file\n')
            expected = original + 'HKKey_New=-1\nHKJoy_New=4\n'
            injected = ''
            expected_rc = 0
            if name == 'missing-defaults':
                defaults.unlink(); expected = original
            elif name == 'missing-config':
                config.unlink(); expected = None
            elif name == 'empty-defaults':
                defaults.write_text(''); expected = original
            elif name == 'already-current':
                config.write_text(expected); original = expected
            elif name == 'no-final-newline':
                config.write_text(original.rstrip('\n'))
            elif name == 'empty-config':
                config.write_text(''); expected = 'HKKey_New=-1\nHKJoy_Custom=5\nHKJoy_New=4\n'
            elif name == 'file-link':
                target = case / 'owner-target.ini'; config.rename(target); config.symlink_to(target); expected = original
            elif name == 'directory-link':
                target = case / 'owner-directory'; config.parent.rename(target); config.parent.symlink_to(target); expected = original
            elif name == 'whitespace-key':
                original = original.replace('HKJoy_Custom=99', ' HKJoy_Custom = 99')
                config.write_text(original); expected = original + 'HKKey_New=-1\nHKJoy_New=4\n'
            elif name == 'non-hotkey-defaults':
                defaults.write_text('ScreenLayout=2\n'); config.write_text(original.rstrip('\n')); expected = original.rstrip('\n')
            elif name.endswith('-failure'):
                injected = {'copy-failure': 'cp() { return 1; }',
                            'producer-failure': 'awk() { printf "partial output\\n"; return 1; }',
                            'rename-failure': 'mv() { return 1; }',
                            'temp-failure': 'mktemp() { return 1; }'}[name]
                expected = original; expected_rc = 1
            inode = config.stat().st_ino if config.exists() else None
            if function:
                command = function.group() + '\n' + injected + '\nupdate_melonds_hotkeys ' + shlex.quote(str(defaults)) + ' ' + shlex.quote(str(config))
            else:
                command = legacy.group().replace('/storage/', shlex.quote(str(case / 'storage')) + '/').replace('/usr/config/', shlex.quote(str(case / 'usr/config')) + '/')
            result = subprocess.run(['bash', '-c', command], capture_output=True, text=True,
                                    timeout=15, env={**os.environ, 'PATH': str(binary) + ':/usr/bin:/bin'})
            actual = config.read_text() if config.exists() else None
            okay = result.returncode == expected_rc and actual == expected
            okay = okay and sentinel.exists() and sentinel.read_text() == 'keep extra file\n'
            okay = okay and not list(config.parent.glob('melonDS.ini.??????'))
            if config.exists():
                okay = okay and config.stat().st_mode & 0o777 == 0o600
            if name == 'file-link':
                okay = okay and config.is_symlink()
            if name == 'directory-link':
                okay = okay and config.parent.is_symlink()
            if name in ['already-current', 'non-hotkey-defaults'] and config.exists():
                okay = okay and config.stat().st_ino == inode
            if okay and name == 'add-missing':
                after = config.stat().st_ino
                repeat = subprocess.run(['bash', '-c', command], capture_output=True, text=True,
                                        timeout=15, env={**os.environ, 'PATH': str(binary) + ':/usr/bin:/bin'})
                okay = repeat.returncode == 0 and config.read_text() == expected and config.stat().st_ino == after
            rows.append({'case': name, 'pass': okay, 'rc': result.returncode, 'stderr': result.stderr})
            print(('PASS ' if okay else 'FAIL ') + name + mark, flush=True)
    report = {'pass': all(row['pass'] for row in rows), 'checks': rows,
              'legacy_negative_control': not bool(function),
              'post_update_sha256': hashlib.sha256(args.post_update.read_bytes()).hexdigest(),
              'busybox_sha256': busybox_sha256, 'busybox_origin': origin,
              'shimmed_applets': len(applets)}
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(report, indent=2) + '\n')
    return 1 if not report['pass'] else 3 if mark else 0


if __name__ == '__main__':
    raise SystemExit(main())
