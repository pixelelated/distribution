"""Stop the exact owned QEMU, awaiting exit before its ports may be reused.

Exits 0 when the owned QEMU exited (or had already); 1 when it refused or
could not finish; 3 when there is no pidfile -- nothing to stop, and nothing
verified, so a caller that removes files next must not read it as a stop (#970).

A QEMU is identified by its argv: a qemu-system-* first word and the exact
-drive argument for the disk. No hostile process is in the threat model -- a
process that names itself qemu-system-* and carries that argument is accepted,
as vm-stop-test's renamed python is (G-26 recorded as a design, not a defect).
"""
import argparse
import os
from pathlib import Path
import select
import signal
import sys


class NothingToStop(Exception):
    pass


def stop(pidfile, disk, timeout):
    # One descriptor from the read to the unlink (#970): the content compared
    # at the end is read through it, and the path is unlinked only while it
    # still names the inode the descriptor holds.
    try:
        fd = os.open(pidfile, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        raise NothingToStop('no pidfile at %s: nothing to stop, nothing verified' % pidfile)
    try:
        return stop_fd(fd, pidfile, disk, timeout)
    finally:
        os.close(fd)


def stop_fd(fd, pidfile, disk, timeout):
    held = os.fstat(fd)
    recorded = os.pread(fd, 64, 0).decode()
    pid = int(recorded.strip())
    if pid <= 1:
        raise ValueError('invalid guest PID')
    proc = Path('/proc') / str(pid)
    handle = None
    try:
        args = (proc / 'cmdline').read_bytes().split(b'\0')
        stat = (proc / 'stat').read_text()
        start = stat[stat.rfind(')') + 2:].split()[19]
        if args and args[0]:
            if not Path(os.fsdecode(args[0])).name.startswith('qemu-system-'):
                raise ValueError('PID is not QEMU; refusing to signal it')
            drive = os.fsencode('if=none,id=rocknix,format=qcow2,file=' + str(disk))
            if not any(args[i] == b'-drive' and args[i + 1] == drive
                       for i in range(len(args) - 1)):
                raise ValueError('QEMU does not own the expected disk; refusing to signal it')
            handle = os.pidfd_open(pid)
            current = (proc / 'stat').read_text()
            if (current[current.rfind(')') + 2:].split()[19] != start or
                    (proc / 'cmdline').read_bytes().split(b'\0') != args):
                raise ValueError('process identity changed; refusing to signal it')
            signal.pidfd_send_signal(handle, signal.SIGTERM)
            poller = select.poll()
            poller.register(handle, select.POLLIN)
            if not poller.poll(round(timeout * 1000)):
                raise TimeoutError('owned QEMU has not exited; retaining pidfile')
        # Empty cmdline is an exited zombie: its ports are already released.
    except (FileNotFoundError, ProcessLookupError):
        pass
    finally:
        if handle is not None:
            os.close(handle)
    try:
        now = os.stat(pidfile, follow_symlinks=False)
    except FileNotFoundError:
        now = None  # Daemonized QEMU removes its own pidfile during normal shutdown.
    if now is not None:
        if (now.st_dev, now.st_ino) != (held.st_dev, held.st_ino):
            raise ValueError('pidfile was replaced while the guest stopped (another owner?); retaining it')
        if os.pread(fd, 64, 0).decode() != recorded:
            raise ValueError('pidfile changed; retaining it')
        # The window that remains: a rename onto this path between the stat
        # above and the unlink below. Nothing in this harness renames a
        # pidfile, and Python has no unlink-if-inode.
        pidfile.unlink()
    print('down: owned QEMU exited (pid %d)' % pid)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--timeout', type=float, default=20)
    parser.add_argument('pidfile', type=Path)
    parser.add_argument('disk', type=Path)
    args = parser.parse_args()
    if not 0 < args.timeout <= 60:
        parser.error('timeout must be greater than zero and at most 60 seconds')
    try:
        stop(args.pidfile, args.disk, args.timeout)
    except NothingToStop as nothing:
        print('vm-stop: ' + str(nothing), file=sys.stderr)
        return 3
    except (OSError, ValueError, TimeoutError) as error:
        print('vm-stop: ' + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
