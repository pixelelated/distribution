"""Exercise the rehearsal's actual wait and guest query with disposable guest-query fixtures."""
import argparse
from pathlib import Path
import subprocess
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--rehearsal', type=Path,
                    default=Path(__file__).with_name('vm-upgrade-rehearsal'))
args = parser.parse_args()
try:
    source = args.rehearsal.read_text()
except (OSError, UnicodeError) as error:
    parser.error(f'cannot read rehearsal {args.rehearsal}: {error}')
_, start, remainder = source.partition('wait_for_storage() {')
body, end, _ = remainder.partition('\n}\n')
if not start or not end:
    parser.error(f'{args.rehearsal}: missing or incomplete wait_for_storage function')
function = start + body + end

with tempfile.TemporaryDirectory(prefix='upgrade-ready-') as directory:
    root = Path(directory)
    (root / 'shim').mkdir()
    unit = root / 'shim/systemctl'
    unit.write_text('''#!/bin/bash
[ "$*" = 'is-active rocknix-autostart.service' ] || exit 64
state=$(cat "$FIXTURE_G/state")
printf '%s\\n' "$state"
[ "$state" = active ]
''')
    unit.chmod(0o755)
    reader = root / 'shim/cat'
    reader.write_text('''#!/bin/bash
case "$*" in
    /proc/sys/kernel/random/boot_id) exec /usr/bin/cat "$FIXTURE_G/boot_id" ;;
    /var/log/boot.log) exec /usr/bin/cat "$FIXTURE_G/var/log/boot.log" ;;
    *) exec /usr/bin/cat "$@" ;;
esac
''')
    reader.chmod(0o755)
    shell = '''set -u
G=$1; FINISH=$2; READY=$3; EXPECTED=$4; TRANSPORT=$5
LOG="$G/log"
sleep() { :; }
ssha() {
    local n
    n=$(( $(cat "$G/polls") + 1 )); echo "$n" > "$G/polls"
    [ "$TRANSPORT" = absent ] && return 1
    if [ "$FINISH" != never ] && [ "$n" -ge "$FINISH" ]; then
        echo "$READY" > "$G/state"
    fi
    # Execute the source's unchanged query; only cat's two guest paths and
    # systemctl are fixture-backed. CI needs no namespace privilege/package.
    FIXTURE_G="$G" PATH="$G/../shim:$PATH" bash -c "$*"
}
''' + function + '\nwait_for_storage "$EXPECTED"\n'
    cases = [
        # case, guest boot, finish poll, final state, expected boot, transport, rc, polls
        ('ready', 'current', '1', 'active', 'current', 'present', 0, 1),
        ('old-boot', 'previous', '1', 'active', 'current', 'present', 1, 30),
        ('failed', 'current', '1', 'failed', 'current', 'present', 1, 1),
        ('delayed', 'current', '4', 'active', 'current', 'present', 0, 4),
        ('never-ready', 'current', 'never', 'active', 'current', 'present', 1, 30),
        ('absent', 'current', '1', 'active', 'current', 'absent', 1, 30),
        ('no-identity', 'current', '1', 'active', '', 'present', 1, 0),
    ]
    for case, boot, finish, state, expected, transport, code, polls in cases:
        p = root / case
        (p / 'var/log').mkdir(parents=True)
        # A stale success must not short-circuit the current boot's unit check.
        (p / 'var/log/boot.log').write_text('Previous boot: Autostart complete...\n')
        (p / 'boot_id').write_text(boot+'\n')
        (p / 'state').write_text('activating\n')
        (p / 'polls').write_text('0\n')
        result = subprocess.run(
            ['bash', '-c', shell, 'fixture', str(p), finish, state, expected, transport],
            capture_output=True, text=True, timeout=15)
        observed_polls = int((p / 'polls').read_text())
        assert (result.returncode, observed_polls) == (code, polls), (
            case, result.returncode, observed_polls, result.stdout, result.stderr)
        assert not result.stderr, (case, result.stderr)
        assert ('PASS storage ready' if code == 0 else 'FAIL storage readiness') in result.stdout, (case, result.stdout)
        print(f'PASS {case}: return {code}, polls {polls}', flush=True)
print('PASS 7 storage-readiness controls; actual guest query, synthetic states, no boot claim')
