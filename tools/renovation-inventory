def area_texts(rows, dist, es, pkg_unit):
    """{area: [(path, text)]} over reached, non-vendor code files; {area: identifiers}."""
    texts, ids = defaultdict(list), defaultdict(set)
    for r in rows:
        if r["area"] == "records" or r["language"] not in CODE or r["tier"] == "vendor-carried" or r["reach"] == "unreached":
            continue
        root = es if r["tree"] == "es" else dist
        try:
            with open(os.path.join(root, r["path"]), errors="replace") as f:
                texts[r["area"]].append((r["path"], f.read()))
        except OSError:
            continue
        leaf = read_unit([r["tree"], r["path"]], pkg_unit).rsplit("/", 1)[-1]
        stem = r["path"].rsplit("/", 1)[-1].split(".")[0]
        for x in (leaf, stem):
            if len(x) >= 6 and x not in STOP_IDS and re.match(r"[A-Za-z][\w.-]*\Z", x):
                ids[r["area"]].add(x)
    return texts, ids


def cross(args):
    """docs/reviews/cross-reference.md: every area against every other (pass 4)."""
    dist, es = os.path.realpath(args.distribution), os.path.realpath(args.es)
    with open(os.path.join(dist, args.out)) as f:
        inv = json.load(f)
    rows = [dict(zip(inv["columns"], r)) for r in inv["rows"]]
    pkgdirs = package_dirs([r["path"] for r in rows if r["tree"] == "distribution"])
    pkg_unit = {r["path"]: owning_dir(r["path"], pkgdirs) for r in rows if r["tree"] == "distribution"}
    texts, ids = area_texts(rows, dist, es, pkg_unit)
    areas = sorted(texts)
    owner = defaultdict(set)
    for a in areas:
        for i in ids[a]:
            owner[i].add(a)
    own = {a: {i for i in ids[a] if owner[i] == {a}} for a in areas}  # an identifier two areas share proves no edge
    rx = {a: re.compile(r"(?<![\w-])(%s)(?![\w-])" % "|".join(re.escape(i) for i in sorted(own[a], key=len, reverse=True)))
          for a in areas if own[a]}
    matrix, evidence = {}, {}
    for a in areas:
        for b in areas:
            if a == b or b not in rx:
                continue
            files, names = 0, Counter()
            for path, text in texts[a]:
                found = set(rx[b].findall(text))
                if found:
                    files += 1
                    names.update(found)
            matrix[(a, b)] = files
            evidence[(a, b)] = [n for n, _ in names.most_common(3)]
    # doctrine -> area: each rule's paths: globs resolved against the inventory (no paths: = every area)
    area_of = {(r["tree"], r["path"]): r["area"] for r in rows}
    rule_edges = Counter()
    rules_dir = os.path.join(dist, ".claude/rules")
    for fn in sorted(os.listdir(rules_dir)):
        if not fn.endswith(".md"):
            continue
        with open(os.path.join(rules_dir, fn)) as f:
            head = f.read().split("\n---", 1)[0]
        globs = re.findall(r'(?m)^\s*-\s*"([^"]+)"', head) if "paths:" in head else []
        hit_areas = set()
        if not globs or "**" in globs:
            hit_areas = set(areas)
        else:
            res = [glob_re(g) for g in globs]
            hit_areas = {area_of[k] for k in area_of if k[0] == "distribution" and any(x.match(k[1]) for x in res)} & set(areas)
        for a in hit_areas:
            rule_edges[a] += 1
    # patches -> area of the package they patch
    patch_edges = Counter()
    pkg_area = {r["path"][:-len("/package.mk")]: r["area"] for r in rows if r["tree"] == "distribution" and r["path"].endswith("/package.mk")}
    for r in rows:
        if r["tree"] == "distribution" and r["area"] == "patches-and-configs":
            own = owning_dir(r["path"], pkgdirs)
            m = re.match(r"projects/ROCKNIX/patches/([^/]+)/", r["path"])
            if own:
                patch_edges[pkg_area.get(own, "(unknown)")] += 1
            elif m:  # projects/ROCKNIX/patches/<package>/: the area of that package's local or global recipe
                cand = [d for d in pkg_area if d.rsplit("/", 1)[-1] == m.group(1)]
                local = [d for d in cand if d.startswith("projects/ROCKNIX/")]
                patch_edges[pkg_area[(local or cand)[0]] if cand else "(unknown)"] += 1
            else:  # a device's or another project's own patch directory, or its kernel config
                patch_edges["devices"] += 1
    state = {}
    for label, srx in SHARED_STATE:
        state[label] = {a: sum(1 for _, t in texts[a] if srx.search(t)) for a in areas}
    fmt = lambda n: "{:,}".format(n)
    short = {a: a.split("-")[0] for a in areas}
    w = ["# Renovation cross-reference: every area against every other", "",
         "Generated by `tools/renovation-inventory --cross` from `inventory.json` (distribution `%s`, ES `%s`); never "
         "hand-edited. Pass 4 of the survey draws slice boundaries from these edges (`p1-tracking.md`)." % (
             inv["header"]["distribution"]["head"][:10], inv["header"]["es"]["head"][:10]), "",
         "**Call edges.** A cell is the number of the row area's code files (reached, not vendor-carried) that name, "
         "as a whole word, an identifier only the column area owns: its units' and code files' names, six characters "
         "or more, generic names excluded, and an identifier two areas share dropped. A search, so a lead.", "",
         "| from \\ to | " + " | ".join(short[b] for b in areas) + " |",
         "| --- | " + " | ".join("---:" for _ in areas) + " |"]
    for a in areas:
        w.append("| %s | " % a + " | ".join("--" if a == b else fmt(matrix.get((a, b), 0)) for b in areas) + " |")
    w += ["", "Column keys: " + ", ".join("`%s` %s" % (short[b], b) for b in areas) + ".", "",
          "**The strongest edges**, each with the identifiers named most:", "",
          "| From | To | Files | Named most |", "| --- | --- | ---: | --- |"]
    for (a, b), n in sorted(matrix.items(), key=lambda kv: -kv[1]):
        if n >= 3:
            w.append("| %s | %s | %d | %s |" % (a, b, n, ", ".join("`%s`" % x for x in evidence[(a, b)])))
    w += ["", "**Shared state.** Code files per area touching each piece of state several areas may read or write.", "",
          "| State | " + " | ".join(short[a] for a in areas) + " |", "| --- | " + " | ".join("---:" for _ in areas) + " |"]
    for label, _ in SHARED_STATE:
        w.append("| %s | " % label + " | ".join(fmt(state[label][a]) or "0" for a in areas) + " |")
    w += ["", "**Doctrine to area.** Rule files under `.claude/rules/` whose `paths:` globs match the area's paths "
          "(a rule with no `paths:`, or `**`, governs every area):", "",
          "| Area | Rules |", "| --- | ---: |"]
    for a in areas:
        w.append("| %s | %d |" % (a, rule_edges[a]))
    w += ["", "**Patches to area.** Each `*.patch` and kernel config counted against the area of the package directory "
          "it sits in:", "", "| Area of the patched package | Patches and configs |", "| --- | ---: |"]
    for a, n in sorted(patch_edges.items(), key=lambda kv: -kv[1]):
        w.append("| %s | %s |" % (a, fmt(n)))
    w += ["", "**Areas with no edge either way:** %s" % (
        ", ".join(a for a in areas if not any(matrix.get((a, b), 0) or matrix.get((b, a), 0) for b in areas if b != a)) or "none")]
    with open(os.path.join(dist, "docs/reviews/cross-reference.md"), "w") as f:
        f.write("\n".join(w) + "\n")
    print("wrote docs/reviews/cross-reference.md (%d areas, %d directed pairs with an edge)" % (
        len(areas), sum(1 for v in matrix.values() if v)))
    return 0


ORDER_BEGIN, ORDER_END = "<!-- renovation-inventory --order: begin -->", "<!-- renovation-inventory --order: end -->"


def load_slices(dist, path="docs/reviews/slices.json"):
    """slices.json: {"sensitive": {kind: [globs]}, "slices": [{k, id, area, title, lens, select, ...}]}.

    A row belongs to a slice when its area is in select.areas (default: the slice's area), it
    matches one of select.globs (default: all; `es:` for the ES tree; `!` excludes), its reach
    is in select.reach and its tier in select.tier when those are given. select may be a list,
    read as a union; a `rest` selector takes only rows no other selector claims."""
    with open(os.path.join(dist, path)) as f:
        doc = json.load(f)
    out = []
    for sl in doc["slices"]:
        if "gate" in sl:  # D-WORKFLOW-187: the renovation gates no release; a stale field is refused, not dropped
            sys.exit("renovation-inventory: slice %s carries a release gate; D-WORKFLOW-187 retired them "
                     "(a reading-order prerequisite is `read_before`)" % sl.get("id"))
        sels = sl.get("select", {})
        compiled = []
        for sel in (sels if isinstance(sels, list) else [sels]):  # a list is a union of selectors
            globs = sel.get("globs")
            compiled.append((set(sel.get("areas", [sl["area"]])),
                             load_areas([{"area": sl["id"], "globs": globs}])[0] if globs else None,
                             set(sel["reach"]) if sel.get("reach") else None, bool(sel.get("rest")),
                             set(sel["tier"]) if sel.get("tier") else None))
        out.append((sl, compiled))
    return doc, out


def slice_of(row, slices):
    """The slices a row belongs to. A `rest` selector takes, within its areas, only rows no other selector claims."""
    def match(areas, comp, reach, tier):
        if row["area"] not in areas or (reach and row["reach"] not in reach) or (tier and row["tier"] not in tier):
            return False
        return not comp or bool(assign([comp], row["tree"], row["path"]))
    hits = [sl["id"] for sl, sels in slices if any(not rest and match(a, c, r, t) for a, c, r, rest, t in sels)]
    if hits:
        return hits
    return [sl["id"] for sl, sels in slices if any(rest and match(a, c, r, t) for a, c, r, rest, t in sels)]


def order(args):
    """Size every slice from inventory.json, check the slices partition the tree, render order.md's table."""
    dist = os.path.realpath(args.distribution)
    with open(os.path.join(dist, args.out)) as f:
        inv = json.load(f)
    rows = [dict(zip(inv["columns"], r)) for r in inv["rows"]]
    doc, slices = load_slices(dist)
    ks = [sl["k"] for sl, _ in slices]
    if ks != list(range(1, len(ks) + 1)) or len({sl["id"] for sl, _ in slices}) != len(ks):
        raise CannotRun("slices must be numbered 1..N in order, with unique ids")
    size = defaultdict(Counter)
    paths = defaultdict(list)
    unassigned, ambiguous = [], []
    for r in rows:
        hits = slice_of(r, slices)
        if not hits:
            unassigned.append(r)
            continue
        if len(hits) > 1:
            ambiguous.append((r, hits))
            continue
        c = size[hits[0]]
        ln = r["lines"] or 0
        c["paths"] += 1
        c["lines"] += ln
        if r["language"] in CODE and r["tier"] != "vendor-carried" and r["reach"] != "unreached":
            c["read"] += ln
            c["read:" + r["tier"]] += ln
        if r["tier"] == "vendor-carried":
            c["vendor"] += 1
            c["vendor_lines"] += ln
        c["reach:" + r["reach"]] += 1
        paths[hits[0]].append(r["path"])
    fmt = lambda n: "{:,}".format(n)
    print("slices: %d" % len(slices))
    print("rows: %d (inventory: %d)" % (sum(c["paths"] for c in size.values()), len(rows)))
    print("unassigned: %d" % len(unassigned))
    print("ambiguous: %d" % len(ambiguous))
    for r in unassigned[:10]:
        print("  unassigned %s %s:%s" % (r["area"], r["tree"], r["path"]))
    for r, h in ambiguous[:10]:
        print("  ambiguous %s:%s -> %s" % (r["tree"], r["path"], ", ".join(h)))
    over, empty = [], []
    for sl, _ in slices:
        c, kind = size[sl["id"]], sl.get("kind", "read")
        bound = {"read": c["read"], "currency": c["read:fork-own"], "prose": c["lines"]}.get(kind, 0)
        print("%3d %-34s %-22s %6d paths %9s lines %8s read %8s fork-own %8s patch  %-8s%s" % (
            sl["k"], sl["id"], sl["area"], c["paths"], fmt(c["lines"]), fmt(c["read"]), fmt(c["read:fork-own"]),
            fmt(c["vendor_lines"]), kind, "  OVER 12,000" if bound > 12000 else ""))
        if bound > 12000 and sl["k"] <= 3:
            over.append(sl["id"])
        if not c["paths"]:
            empty.append(sl["id"])
    for x in over:
        print("  first-three slice %s reads more than 12,000 lines" % x)
    for x in empty:
        print("  slice %s holds no path" % x)
    lines = [ORDER_BEGIN, "",
             "Generated by `tools/renovation-inventory --order` from `slices.json` and `inventory.json` "
             "(distribution `%s`, ES `%s`); edit `slices.json`, never this block. Every tracked path is in exactly one "
             "slice: `unassigned: %d`, `ambiguous: %d` over %s rows. *Read* is code lines a slice reads line by line "
             "(code languages, not vendor-carried, not unreached); a *currency* slice reads its fork-own files line by line "
             "and checks the rest for reachability and currency (plan § 2), so its size is its fork-own lines; a table "
             "slice reads rows, one per path, not lines; a *prose* slice (the doctrine) reads its text, so its size is its "
             "lines. *Patch and config lines* are the vendor-carried files the slice "
             "holds (fork-written ones are read with their code, the rest by provenance), counted apart from *Read*." % (
                 inv["header"]["distribution"]["head"][:10], inv["header"]["es"]["head"][:10],
                 len(unassigned), len(ambiguous), fmt(len(rows))), "",
             "| k | Slice | Area | Kind | Lens | Paths | Lines | Read (fork-own) | Patch and config lines | Depth |",
             "| ---: | --- | --- | --- | --- | ---: | ---: | --- | ---: | --- |"]
    for sl, _ in slices:
        c, kind = size[sl["id"]], sl.get("kind", "read")
        lines.append("| %d | %s | %s | %s | %s | %s | %s | %s | %s | %s |" % (
            sl["k"], sl["title"], sl["area"], kind, sl["lens"], fmt(c["paths"]), fmt(c["lines"]),
            "-- (%s rows)" % fmt(c["paths"]) if kind == "table" else "%s of prose" % fmt(c["lines"]) if kind == "prose"
            else "%s (%s)" % (fmt(c["read"]), fmt(c["read:fork-own"])),
            fmt(c["vendor_lines"]), sl["depth"]))
    def describe(sl):
        sels = sl.get("select", {})
        parts = []
        for sel in (sels if isinstance(sels, list) else [sels]):
            parts.append("areas %s; globs %s%s%s" % (
                ", ".join("`%s`" % a for a in sel.get("areas", [sl["area"]])),
                ", ".join("`%s`" % g for g in sel.get("globs", ["(all)"])),
                ("; reach %s" % ", ".join("`%s`" % x for x in sel["reach"])) if sel.get("reach") else "",
                "; the rest of these areas" if sel.get("rest") else ""))
        return " **plus** ".join(parts)
    for sl, _ in slices:
        c = size[sl["id"]]
        lines += ["", "### T%d. %s: %s" % (sl["k"], sl["area"], sl["title"]), "",
                  "- **id**: `%s`; **kind**: %s; **lens**: %s" % (sl["id"], sl.get("kind", "read"), sl["lens"]),
                  "- **why here**: %s" % sl["why"],
                  "- **paths** (%s paths, %s lines, %s read, of which %s fork-own; %s patch and config lines; reach %s): %s" % (
                      fmt(c["paths"]), fmt(c["lines"]),
                      "--" if sl.get("kind") == "table" else fmt(c["read"]),
                      "--" if sl.get("kind") == "table" else fmt(c["read:fork-own"]), fmt(c["vendor_lines"]),
                      ", ".join("%s %d" % (x.split(":", 1)[1], n) for x, n in sorted(c.items()) if x.startswith("reach:")),
                      describe(sl)),
                  "- **read before**: %s" % ("%s (a reading order, D-WORKFLOW-187)" % sl["read_before"] if sl.get("read_before") else "none"),
                  "- **depth**: %s -- %s" % (sl["depth"], sl["depth_reason"]),
                  "- **interacting subsystems** (read-only context): %s" % sl["interacting"],
                  "- **closing evidence**: %s" % sl["closing"]]
    lines += ["", "### The security, state-preservation and launch-path files", "",
              "`tools/renovation-drift` reads these globs from `slices.json` (`sensitive`): a closed slice whose drift "
              "touches one re-opens at its depth, whatever its size (plan § 8)."]
    for kind, globs in doc.get("sensitive", {}).items():
        n = sum(1 for r in rows if any(x.match(r["path"]) for x in load_areas([{"area": kind, "globs": globs}])[0][1].get(
            "es" if r["tree"] == "es" else "distribution", [])))
        lines.append("- **%s** (%d paths): %s" % (kind, n, ", ".join("`%s`" % g for g in globs)))
    lines += ["", ORDER_END]
    target = os.path.join(dist, "docs/reviews/order.md")
    if not args.no_write:
        with open(target) as f:
            text = f.read()
        if ORDER_BEGIN not in text or ORDER_END not in text:
            raise CannotRun("order.md has no generated block markers")
        a, b = text.index(ORDER_BEGIN), text.index(ORDER_END) + len(ORDER_END)
        with open(target, "w") as f:
            f.write(text[:a] + "\n".join(lines) + text[b:])
        print("wrote the generated block of docs/reviews/order.md")
    return EX_FAIL if unassigned or ambiguous or over or empty else 0


ISSUE_BODY = """Slice T{k} of the renovation order: `docs/reviews/order.md` § T{k}, id `{id}` in `docs/reviews/slices.json`. Phase M6.P2, under epic #339 until this area's epic is filed at its first dispatch (then re-parented and retitled `E<epic>/T{k}`, `milestone-phase-naming.md`). Proposed by the survey (#641); the order is {order_row}. Run under the per-slice procedure of `docs/reviews/plan-for-the-plan.md` § 6b, from the brief the planner writes before dispatch (§ 7).

## Scope

- **Area:** {area}; **kind:** {kind}; **lens:** {lens}
- **Why here:** {why}
- **Paths:** {desc}. {paths} paths, {lines} lines; {read} lines read, {fork} of them fork-own (inventory at `{head}`). The exact list is `tools/renovation-inventory --order`'s membership of `{id}`.
- **Provenance tiers:** {tiers}
- **Read before:** {read_before}
- **Review depth:** {depth} -- {reason}
- **Interacting subsystems (read-only context):** {inter}

reviewed-at:
fixed-at:

{vm}

## Acceptance criteria

