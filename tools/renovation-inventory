def language(root, path):
    base = path.rsplit("/", 1)[-1]
    if base in NAMES:
        return NAMES[base]
    if re.match(r"linux.*\.conf\Z", base) and (path.startswith("packages/") or path.startswith("projects/")):
        return "kernel-config"
    stem, dot, ext = base.rpartition(".")
    if dot and stem and ext:
        lang = EXT.get("." + ext) or EXT.get("." + ext.lower())
        if lang:
            return lang
    full = os.path.join(root, path)
    try:
        if os.path.islink(full):
            return "symlink"
        with open(full, "rb") as f:
            head = f.read(96)
    except OSError:
        return "unknown"
    if head.startswith(b"#!"):
        first = head.split(b"\n", 1)[0].decode("utf-8", "replace")
        for key, lang in SHEBANGS:
            if key in first:
                return lang
        return "script"
    return "other" if dot else "none"


def is_vendor(path):
    if not (path.startswith("packages/") or path.startswith("projects/")):
        return False
    base = path.rsplit("/", 1)[-1]
    return base.endswith(".patch") or bool(re.match(r"linux.*\.conf\Z", base))


# ---- reachability ------------------------------------------------------------

def makefile_configs(dist):
    """[(device, arch)] in Makefile order, from its PROJECT=ROCKNIX DEVICE= ARCH= build_distro lines."""
    with open(os.path.join(dist, "Makefile")) as f:
        text = f.read()
    seen = []
    for dev, arch in re.findall(r"PROJECT=ROCKNIX DEVICE=(\S+) ARCH=(\S+) \./scripts/build_distro", text):
        if (dev, arch) not in seen:
            seen.append((dev, arch))
    return seen


def plan_env(dist, device, arch, build_dir):
    env = {k: v for k, v in os.environ.items()
           if k not in ("PROJECT", "DEVICE", "ARCH", "DEVICE_ROOT", "BUILD_DIR", "DISTRO")
           and not k.startswith("_CACHE_PACKAGE") and not k.startswith("_DEBUG_")}
    env.update(PROJECT="ROCKNIX", DEVICE=device, ARCH=arch, BUILD_DIR=build_dir)
    for var in ("PROJECT", "DEVICE", "ARCH"):  # config/options defaults DEVICE to SM8550 when unset
        if not env.get(var):
            raise CannotRun("%s unset for a plan run" % var)
    return env


def pinned_image(dist):
    """The build container the Makefile pins, by digest; it must already be local (never pulled here)."""
    with open(os.path.join(dist, "Makefile")) as f:
        m = re.search(r"DOCKER_IMAGE_DIGEST\s*:=\s*(sha256:[0-9a-f]{64})", f.read())
    if not m:
        raise CannotRun("no DOCKER_IMAGE_DIGEST in the Makefile")
    r = subprocess.run(["docker", "image", "inspect", "--format", "{{.Id}}", m.group(1)], capture_output=True, text=True)
    if r.returncode != 0 or r.stdout.strip() != m.group(1):
        raise CannotRun("the pinned build image %s is not local (make docker-image-pull), or use --runner host" % m.group(1))
    return m.group(1)


class Runner:
    """Runs a command in the build's own environment: the pinned container (default) or this host.

    The container gets the checkout and the main repository's .git read-only at their own paths,
    no network, the caller's uid, and BUILD_DIR in its own /tmp, so nothing it does can land in
    the checkout. The host runner sets BUILD_DIR to a directory this tool owns."""

    def __init__(self, mode, dist, scratch):
        self.mode, self.dist, self.scratch = mode, dist, scratch
        if mode == "container":
            self.image = pinned_image(dist)
            common = git(dist, "rev-parse", "--path-format=absolute", "--git-common-dir").strip()
            self.mounts = ["-v", "%s:%s:ro" % (dist, dist), "-v", "%s:%s:ro" % (common, common)]
        else:
            self.image = None

    def run(self, device, arch, argv, stdin=""):
        if self.mode == "container":
            env = plan_env(self.dist, device, arch, "/tmp/renovation-plan")
            cmd = ["docker", "run", "--rm", "-i", "--network", "none", "--user", "%d:%d" % (os.getuid(), os.getgid()),
                   *self.mounts, "-w", self.dist, "-e", "HOME=/tmp"]
            for k in ("PROJECT", "DEVICE", "ARCH", "BUILD_DIR"):
                cmd += ["-e", "%s=%s" % (k, env[k])]
            return subprocess.run(cmd + [self.image] + argv, input=stdin, capture_output=True, text=True)
        build_dir = tempfile.mkdtemp(prefix="plan-%s-%s-" % (device, arch), dir=self.scratch)
        env = plan_env(self.dist, device, arch, build_dir)
        return subprocess.run(argv, cwd=self.dist, env=env, input=stdin, capture_output=True, text=True)


def one_plan(dist, device, arch, runner, plans_dir):
    meta = runner.run(device, arch, ["bash", "-c", SOURCE_HELPER], "")
    m = [l.split("\t") for l in meta.stdout.splitlines() if l.startswith("META")]
    if not m or m[0][0] != "META":
        raise CannotRun("config/options for %s-%s: %s" % (device, arch, meta.stdout[:200]))
    enable32, root = m[0][1], m[0][2]
    if os.path.realpath(root) != dist:  # PKG_DIR is reported under ROOT; a different ROOT reaches nothing
        raise CannotRun("config/options ROOT %s is not the distribution %s" % (root, dist))
    if arch == "arm" and enable32 != "true":
        return {"config": "%s-%s" % (device, arch), "skipped": "ENABLE_32BIT=%s" % enable32}
    root_pkg = "arm" if arch == "arm" else "image"
    plan_file = os.path.join(plans_dir, "plan-%s-%s.txt" % (device, arch)) if plans_dir else None
    if plan_file and os.path.exists(plan_file):
        with open(plan_file) as f:
            plan_text = f.read()
    else:
        r = runner.run(device, arch, ["tools/viewplan", root_pkg])
        if r.returncode != 0:
            raise CannotRun("viewplan %s for %s-%s exited %d: %s" % (root_pkg, device, arch, r.returncode, r.stderr[-300:]))
        plan_text = r.stdout
        if plan_file:
            with open(plan_file, "w") as f:
                f.write(plan_text)
    names, actions = set(), Counter()
    for line in plan_text.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] in ("build", "install", "unpack"):
            names.add(parts[1].split(":", 1)[0])  # "build openssl:host", "install rclone"
            actions[parts[0]] += 1
    if root_pkg not in names:  # "install image" in a 64-bit plan; "build arm" in a 32-bit one
        raise CannotRun("plan for %s-%s has no install of %s (actions %s)" % (device, arch, root_pkg, dict(actions)))
    r = runner.run(device, arch, ["bash", "-c", SOURCE_HELPER], "\n".join(sorted(names)) + "\n")
    pkgs, skipped = {}, []
    for line in r.stdout.splitlines():
        f = line.split("\t")
        if f[0] == "PKG":
            if not f[3].startswith(dist + "/"):
                raise CannotRun("%s-%s: PKG_DIR %s is outside the distribution" % (device, arch, f[3]))
            pkgs[f[1]] = {"pkg_name": f[2], "dir": f[3], "version": f[4], "patch_arch": f[5], "patch_dirs": f[6].split()}
        elif f[0] == "SKIP":
            skipped.append(f[1])
    if not pkgs:
        raise CannotRun("no package of %s-%s could be sourced" % (device, arch))
    return {"config": "%s-%s" % (device, arch), "device": device, "arch": arch,
            "root": root_pkg, "packages": pkgs, "unsourced": sorted(skipped),
            "plan_lines": len(plan_text.splitlines())}


def selected_patch_dirs(info, device, root):
    """The directories scripts/unpack globs *.patch in, as tree-relative paths."""
    d, name = info["dir"], info["pkg_name"]
    v, pa = info["version"], info["patch_arch"]
    prj = os.path.join(root, "projects", "ROCKNIX")
    dirs = [d + "/patches", d + "/patches/" + pa, d + "/patches/" + v, d + "/patches/%s/%s" % (v, pa),
            prj + "/patches/" + name, prj + "/patches/%s/%s" % (name, pa), prj + "/patches/%s/%s" % (name, v),
            prj + "/devices/%s/patches/%s" % (device, name)]
    for p in info["patch_dirs"]:
        if p.startswith("/"):
            dirs.append(p)
        else:
            dirs += [d + "/patches/" + p, prj + "/patches/%s/%s" % (name, p),
                     prj + "/devices/%s/patches/%s/%s" % (device, name, p)]
    out = set()
    for x in dirs:
        x = os.path.normpath(x)
        if x.startswith(root + "/"):
            out.add(x[len(root) + 1:])
    return out


def package_dirs(paths):
    return {p[:-len("/package.mk")] for p in paths if p.endswith("/package.mk")}


def owning_dir(path, pkgdirs):
    parts = path.split("/")
    for i in range(len(parts) - 1, 0, -1):
        cand = "/".join(parts[:i])
        if cand in pkgdirs:
            return cand
    return None


SOURCED = re.compile(r"\$\{?ROOT\}?/((?:packages|projects)/[^\s\"']*?)/package\.mk")


def compute_reach(dist, paths, plans, devices):
    """{path: set(configs)} for distribution paths; None for n/a paths."""
    pkgdirs = package_dirs(paths)
    sourced = {}
    for d in pkgdirs:
        try:
            with open(os.path.join(dist, d, "package.mk"), errors="replace") as f:
                sourced[d] = {m for m in SOURCED.findall(f.read()) if m in pkgdirs and m != d}
        except OSError:
            sourced[d] = set()
    built = defaultdict(set)          # package name -> the PKG_DIRs plans resolved it to
    reached_dir = defaultdict(set)    # package dir -> configs (non-patch files)
    reached_pdir = defaultdict(set)   # patch directory -> configs
    project_wide, by_device, es_configs = set(), defaultdict(set), set()
    for p in plans:
        if p.get("skipped"):
            continue
        cfg = p["config"]
        project_wide.add(cfg)
        by_device[p["device"]].add(cfg)
        for name, info in p["packages"].items():
            d = info["dir"]
            rel = d[len(dist) + 1:] if d.startswith(dist + "/") else d
            reached_dir[rel].add(cfg)
            built[name].add(rel)
            for s in sourced.get(rel, ()):
                reached_dir[s + "/package.mk"].add(cfg)  # only the sourced recipe itself
            for pd in selected_patch_dirs(info, p["device"], dist):
                reached_pdir[pd].add(cfg)
            if name == "emulationstation":
                es_configs.add(cfg)
    reach = {}
    for path in paths:
        if path.startswith("distributions/") and not path.startswith("distributions/ROCKNIX/"):
            reach[path] = set()  # config/options: DISTRO defaults to ROCKNIX and nothing sets another
            continue
        if not (path.startswith("packages/") or path.startswith("projects/")):
            reach[path] = None
            continue
        if path.startswith("projects/") and not path.startswith("projects/ROCKNIX/"):
            reach[path] = set()  # other projects: no Makefile target sets their PROJECT
            continue
        if path.endswith(".patch"):
            reach[path] = set(reached_pdir.get(path.rsplit("/", 1)[0], ()))
            continue
        own = owning_dir(path, pkgdirs)
        if own:
            got = set(reached_dir.get(own, ())) | set(reached_dir.get(path, ()))
            reach[path] = got
            continue
        m = re.match(r"projects/ROCKNIX/devices/([^/]+)/", path)
        if m:
            reach[path] = set(by_device.get(m.group(1), ())) if m.group(1) in devices else set()
            continue
        if re.match(r"projects/ROCKNIX/(bootloader/|filesystem/|options\Z|config\.xml\Z)", path):
            reach[path] = set(project_wide)
            continue
        reach[path] = None  # README, templates and other non-package paths under packages/
    # A package directory whose name a plan builds from another directory is shadowed: the package
    # is live, this copy of it is not (get_pkg_directory resolves the override). Removing a shadowed
    # copy is a duplicate's removal (engineering-practices.md § Before deleting a duplicate).
    shadow = {d: sorted(built[d.rsplit("/", 1)[-1]])[0] for d in pkgdirs
              if built.get(d.rsplit("/", 1)[-1]) and d not in built[d.rsplit("/", 1)[-1]]}
    return reach, es_configs, shadow


def split_reach(configs):
    """reach, reachable_by (the shipped and test configs), buildable_by (the rest)."""
    shipped = sorted(c for c in configs if c.rsplit("-", 1)[0] in SHIPPED)
    test = sorted(c for c in configs if c.rsplit("-", 1)[0] in TEST)
    other = sorted(c for c in configs if c.rsplit("-", 1)[0] not in SHIPPED + TEST)
    if shipped:
        return "shipped", sorted(shipped + test), other
    if test:
        return "test", test, other
    if other:
        return "unshipped", [], other
    return "unreached", [], []


def ignored_set(repo):
    return git(repo, "status", "--porcelain", "--ignored", "-z")


# ---- assembly ---------------------------------------------------------------

def build(args):
    dist = os.path.realpath(args.distribution)
    es = os.path.realpath(args.es)
    with open(os.path.join(dist, args.areas) if not os.path.isabs(args.areas) else args.areas) as f:
        compiled = load_areas(json.load(f))
    t0 = time.time()

    upstream = "upstream/next"
    mb = git(dist, "merge-base", "HEAD", upstream).strip()
    head = git(dist, "rev-parse", "HEAD").strip()
    dpaths, d_index = tracked(dist)
    dlines = line_counts(dist)
    fork = set(zsplit(git(dist, "diff", "--name-only", "-z", "--no-renames", mb, "HEAD")))
    up_only = set(zsplit(git(dist, "diff", "--name-only", "-z", "--no-renames", mb, upstream)))
    d_last_fork = last_commits(dist, "%s..HEAD" % mb)
    d_last_up = last_commits(dist, upstream)

    es_head = git(es, "rev-parse", "HEAD").strip()
    es_up = "rocknix/master"
    emb = git(es, "merge-base", es_up, "HEAD").strip()
    epaths, e_index = tracked(es)
    elines = line_counts(es)
    efork = set(zsplit(git(es, "diff", "--name-only", "-z", "--no-renames", emb, "HEAD")))
    eup_only = set(zsplit(git(es, "diff", "--name-only", "-z", "--no-renames", emb, es_up)))
    e_last_fork = last_commits(es, "%s..HEAD" % emb)
    e_last_up = last_commits(es, es_up)
    t_git = time.time() - t0

    # reachability
    configs = makefile_configs(dist)
    devices = sorted({d for d, _ in configs})
    before = ignored_set(dist)
    scratch = tempfile.mkdtemp(prefix="renovation-inventory-")
    plans = []
    t1 = time.time()
    try:
        runner = Runner(args.runner, dist, scratch)
        with concurrent.futures.ThreadPoolExecutor(max_workers=4) as ex:
            futs = [ex.submit(one_plan, dist, d, a, runner, args.plans) for d, a in configs]
            for fu in futs:
                plans.append(fu.result())
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
    t_plans = time.time() - t1
    if ignored_set(dist) != before:
        raise CannotRun("the checkout's ignored set changed across the plan runs: something wrote into it")
    reach, es_configs, shadow = compute_reach(dist, dpaths, plans, devices)
    dirs_for_shadow = package_dirs(dpaths)

    rows, unassigned, ambiguous = [], [], []
    injected = list(args.inject_path or [])
    for tree, paths, lines, forkset, uponly, lf, lu, root in (
            ("distribution", dpaths + injected, dlines, fork, up_only, d_last_fork, d_last_up, dist),
            ("es", epaths, elines, efork, eup_only, e_last_fork, e_last_up, es)):
        for path in paths:
            hits = assign(compiled, tree, path)
            if not hits:
                unassigned.append((tree, path))
            elif len(hits) > 1:
                ambiguous.append((tree, path, hits))
            area = hits[0] if len(hits) == 1 else None
            vendor = tree == "distribution" and is_vendor(path)
            fork_own = path in forkset
            tier = "vendor-carried" if vendor else ("fork-own" if fork_own else "upstream-carried")
            note = "fork-written" if vendor and fork_own else None
            if tree == "es":
                rs, rb, bb = split_reach(es_configs)
            else:
                cfgs = reach.get(path)
                if cfgs is None:
                    rs, rb, bb = "n/a", [], []
                else:
                    rs, rb, bb = split_reach(cfgs)
            sh = None
            if tree == "distribution" and rs == "unreached":
                own = owning_dir(path, dirs_for_shadow)
                sh = shadow.get(own) if own else None
            rows.append([tree, path, area, tier, note, bool(fork_own and path in uponly),
                         language(root, path), lines.get(path), None, lf.get(path), lu.get(path),
                         rs, rb, bb, sh])

    # patches per package.mk: count of *.patch under its own directory
    patch_paths = [r[1] for r in rows if r[0] == "distribution" and r[1].endswith(".patch")
                   and (r[1].startswith("packages/") or r[1].startswith("projects/"))]
    pkgdirs = package_dirs(dpaths)
    per_dir = Counter()
    for p in patch_paths:
        own = owning_dir(p, pkgdirs)
        if own:
            per_dir[own] += 1
    for r in rows:
        if r[0] == "distribution" and r[1].endswith("/package.mk"):
            r[8] = per_dir.get(r[1][:-len("/package.mk")], 0)

    found = 0
    for base in ("packages", "projects"):
        for dp, _dn, fn in os.walk(os.path.join(dist, base)):
            found += sum(1 for n in fn if n.endswith(".patch"))

    header = {
        "generated": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "generator": "tools/renovation-inventory",
        "distribution": {"head": head, "upstream": upstream, "upstream_head": git(dist, "rev-parse", upstream).strip(),
                         "merge_base": mb},
        "es": {"head": es_head, "upstream": es_up, "upstream_head": git(es, "rev-parse", es_up).strip(),
               "merge_base": emb, "batocera_master": git(es, "rev-parse", "batocera/master").strip()},
        "configs": [{k: v for k, v in p.items() if k != "packages"} | ({"packages": len(p["packages"])} if "packages" in p else {})
                    for p in plans],
        "shipped_devices": list(SHIPPED),
        "test_devices": list(TEST),
        "plan_runner": {"mode": args.runner, "image": runner.image},
        "seconds": {"git": round(t_git, 1), "plans": round(t_plans, 1)},
    }
    counts = {"paths": (len(dpaths) + len(injected), len(d_index)), "es-paths": (len(epaths), len(e_index)),
              "paths-differ": index_differs(dpaths, d_index), "es-paths-differ": index_differs(epaths, e_index),
              "patches": (len(patch_paths), found), "unassigned": len(unassigned), "ambiguous": len(ambiguous)}
    return header, rows, counts, unassigned, ambiguous


def secret_patterns(dist):
    """The pre-commit and push guards' own credential patterns (.githooks/secret-patterns)."""
    r = subprocess.run(["bash", "-c", '. .githooks/secret-patterns && printf %s "$SECRET_PATTERNS"'],
                       cwd=dist, capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout:
        raise CannotRun("cannot read .githooks/secret-patterns")
    return re.compile(r.stdout)


def json_rows(rows, guard):
    """One JSON line per row. A tracked path whose name happens to match a credential
    pattern (a kernel patch "ma-sk-..." name read as an API key) is written with its
    hyphens as \\u002d: decoded, the path is byte-identical; at rest, no guard misreads a
    file name as a secret. A line that still matches fails the run."""
    out, escaped = [], []
    for r in sorted(rows, key=lambda r: (r[0], r[1])):
        line = json.dumps(r, separators=(",", ":"))
        if guard.search(line):
            line = line.replace("-", "\\u002d")
            if guard.search(line) or json.loads(line) != r:
                raise CannotRun("row %s:%s matches a credential pattern even escaped" % (r[0], r[1]))
            escaped.append("%s:%s" % (r[0], r[1]))
        out.append(line)
    return out, escaped


def write_json(path, header, lines, guard):
    head = json.dumps(header, sort_keys=True)
    if guard.search(head):  # escaped_rows names those paths too
        head = head.replace("-", "\\u002d")
        if guard.search(head) or json.loads(head) != json.loads(json.dumps(header)):
            raise CannotRun("the header matches a credential pattern even escaped")
    with open(path, "w") as f:
        f.write('{"header": %s,\n "columns": %s,\n "rows": [\n' % (head, json.dumps(COLUMNS)))
        f.write(",\n".join(lines))
        f.write("\n]}\n")


def unit_of(row):
    tree, path = row[0], row[1]
    if tree == "es":
        return "es:" + "/".join(path.split("/")[:2])
    parts = path.split("/")
    if parts[0] == "projects" and len(parts) > 2 and parts[1] != "ROCKNIX":
        return "/".join(parts[:2])
    if path.endswith(".patch"):
        return path.rsplit("/", 1)[0]
    return None


CODE = {"shell", "python", "recipe", "c", "c++", "c-header", "c++-header", "javascript", "typescript", "make",
        "cmake", "systemd", "udev", "script", "perl", "lua", "rust", "go", "assembly", "shader", "docker",
        "kconfig", "html", "css"}


def read_unit(row, pkg_unit):
    """The unit a slice is cut from: a package directory, a device, a tool, an ES source directory."""
    tree, path = row[0], row[1]
    parts = path.split("/")
    if tree == "es":
        return "es:" + "/".join(parts[:3]) if len(parts) > 3 else "es:" + path
    if parts[0] in ("packages", "projects"):
        if parts[0] == "projects" and len(parts) > 1 and parts[1] != "ROCKNIX":
            return "/".join(parts[:2])
        if len(parts) > 3 and parts[2] == "devices" and not pkg_unit.get(path):
            return "/".join(parts[:4])
        return pkg_unit.get(path) or "/".join(parts[:-1])
    if parts[0] in ("tools", "scripts", ".github", ".claude", "docs", "config", "distributions", "research"):
        return "/".join(parts[:2]) if len(parts) > 2 else path
    return path


