def slice_issues(args, out):
    """Write T<k>.title and T<k>.md for every slice: the slice issues' titles and bodies (pass 7; no tracker)."""
    dist = os.path.realpath(args.distribution)
    os.makedirs(out, exist_ok=True)
    with open(os.path.join(dist, args.out)) as f:
        inv = json.load(f)
    rows = [dict(zip(inv["columns"], r)) for r in inv["rows"]]
    doc, slices = load_slices(dist)
    size = defaultdict(Counter)
    for r in rows:
        h = slice_of(r, slices)
        if len(h) == 1:
            c = size[h[0]]
            ln = r["lines"] or 0
            c["paths"] += 1
            c["lines"] += ln
            c["tier:" + r["tier"]] += 1
            if r["language"] in CODE and r["tier"] != "vendor-carried" and r["reach"] != "unreached":
                c["read"] += ln
                if r["tier"] == "fork-own":
                    c["fork"] += ln
    fmt = lambda n: "{:,}".format(n)
    head = inv["header"]["distribution"]["head"][:10]
    for sl, _ in slices:
        c = size[sl["id"]]
        sels = sl.get("select", {})
        desc = []
        for sel in (sels if isinstance(sels, list) else [sels]):
            desc.append("areas %s; globs %s%s%s" % (
                ", ".join("`%s`" % a for a in sel.get("areas", [sl["area"]])),
                ", ".join("`%s`" % g for g in sel.get("globs", ["(all)"])),
                ("; reach %s" % ", ".join("`%s`" % x for x in sel["reach"])) if sel.get("reach") else "",
                "; the rest of these areas" if sel.get("rest") else ""))
        kind = sl.get("kind", "read")
        vm = ("Can this be done on the VM? Yes -- every behaviour claim this slice makes is proven on the GENERIC_X64 "
              "guest (`vm-first.md`, `generic-x64-vm-testing.md` § headless); reading and tables need no guest."
              if kind != "table" else
              "Can this be done on the VM? No test is proposed: a table slice is host analysis of the tree; a removal "
              "it proposes is proven on the GENERIC_X64 guest before it is a punch item.")
        if sl["depth"] == "Local":
            opinion = ("The review depth is recorded as Local in `second-opinions/review-plan.json` (no reviewer: the "
                       "lint and the counts are the check, plan § 6c).")
        elif sl["depth"] == "Independent":
            opinion = ("`second-opinions/review-plan.json` records Independent depth and one reviewer from another lab, "
                       "and that reviewer's provenance names its served model (plan § 6c, D-WORKFLOW-137).")
        else:
            opinion = ("`second-opinions/review-plan.json` records Extended depth and two reviewers from two other labs, "
                       "and each reviewer's provenance names its served model (plan § 6c, D-WORKFLOW-137).")
        title = "M6.P2 E339/T%d: %s: %s" % (sl["k"], sl["area"], sl["title"])
        body = ISSUE_BODY.format(
            k=sl["k"], id=sl["id"], area=sl["area"], kind=kind, lens=sl["lens"], why=sl["why"],
            desc=" **plus** ".join(desc), paths=fmt(c["paths"]), lines=fmt(c["lines"]), read=fmt(c["read"]),
            fork=fmt(c["fork"]), head=head,
            tiers=", ".join("%s %s" % (k.split(":", 1)[1], fmt(n)) for k, n in sorted(c.items()) if k.startswith("tier:")),
            read_before=("%s (a reading order; the renovation gates no release, D-WORKFLOW-187)" % sl["read_before"]
                         if sl.get("read_before") else "none (the renovation gates no release, D-WORKFLOW-187)"), depth=sl["depth"], reason=sl["depth_reason"], inter=sl["interacting"],
            vm=vm, opinion=opinion, order_row=args.order_row)
        with open(os.path.join(out, "T%d.title" % sl["k"]), "w") as f:
            f.write(title)
        with open(os.path.join(out, "T%d.md" % sl["k"]), "w") as f:
            f.write(body)
    print("wrote %d slice issue bodies to %s" % (len(slices), out))
    return 0


def self_test():
    """The counters can fail: a path in no area, a path in two, a catch-all refused."""
    areas = [{"area": "a", "globs": ["x/**", "!x/skip/**"]}, {"area": "b", "globs": ["x/both/*", "es:**"]}]
    c = load_areas(areas)
    cases = [("distribution", "y/none", 0), ("distribution", "x/skip/f", 0), ("distribution", "x/both/f", 2),
             ("distribution", "x/one/f", 1), ("es", "anything/at/all", 1)]
    bad = 0
    for tree, p, want in cases:
        got = len(assign(c, tree, p))
        ok = got == want
        bad += not ok
        print("%s %s:%s -> %d area(s), want %d" % ("PASS" if ok else "FAIL", tree, p, got, want))
    try:
        load_areas([{"area": "all", "globs": ["**"]}])
        print("FAIL a bare ** was accepted")
        bad += 1
    except CannotRun:
        print("PASS a bare ** is refused")
    g = glob_re("scripts/{council-*,verify-*.ts,owner-queue-lint.mjs}")
    for p, want in (("scripts/council-invoke.ts", True), ("scripts/verify-pins.ts", True),
                    ("scripts/owner-queue-lint.mjs", True), ("scripts/build", False)):
        ok = bool(g.match(p)) == want
        bad += not ok
        print("%s brace glob %s" % ("PASS" if ok else "FAIL", p))
    g = glob_re("{packages,projects}/**/linux*.conf")
    for p, want in (("projects/ROCKNIX/devices/H700/linux/linux.aarch64.conf", True),
                    ("packages/linux.conf", True), ("packages/a/linuxish.txt", False)):
        ok = bool(g.match(p)) == want
        bad += not ok
        print("%s glob %s" % ("PASS" if ok else "FAIL", p))
    for cfgs, want in ((["H700-aarch64", "GENERIC_X64-x86_64", "RK3566-aarch64"], "shipped"),  # D-WORKFLOW-185
                       (["GENERIC_X64-x86_64", "RK3326-aarch64"], "test"), (["RK3566-aarch64"], "unshipped"), ([], "unreached")):
        ok = split_reach(cfgs)[0] == want
        bad += not ok
        print("%s reach %s -> %s" % ("PASS" if ok else "FAIL", ",".join(cfgs) or "(no plan)", want))
    print("self-test: %s" % ("PASS" if not bad else "FAIL (%d)" % bad))
    return 0 if not bad else EX_FAIL


