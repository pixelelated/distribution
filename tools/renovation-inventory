SOURCE_HELPER = r'''
. config/options "" >/dev/null 2>&1 || { echo "META-FAIL config/options"; exit 0; }
printf 'META\t%s\t%s\n' "${ENABLE_32BIT}" "${ROOT}"
while read -r name; do
  [ -n "${name}" ] || continue
  exited=0
  exit() { exited=1; }
  if source_package "${name}" >/dev/null 2>&1 && [ ${exited} -eq 0 ]; then
    if [ "${TARGET_ARCH}" = "x86_64" ]; then
      PATCH_ARCH="x86"
    elif [ "${PKG_IS_KERNEL_PKG}" = "yes" ]; then
      PATCH_ARCH="${TARGET_KERNEL_PATCH_ARCH:-${TARGET_ARCH}}"
    else
      PATCH_ARCH="${TARGET_PATCH_ARCH:-${TARGET_ARCH}}"
    fi
    printf 'PKG\t%s\t%s\t%s\t%s\t%s\t%s\n' "${name}" "${PKG_NAME}" "${PKG_DIR}" \
      "${PKG_VERSION}" "${PATCH_ARCH}" "${PKG_PATCH_DIRS}"
  else
    printf 'SKIP\t%s\n' "${name}"
  fi
  unset -f exit
done
'''


class CannotRun(Exception):
    pass


def git(repo, *args, text=True):
    r = subprocess.run(["git", "-C", repo, "-c", "core.quotePath=false", *args],
                       capture_output=True, text=text)
    if r.returncode != 0:
        raise CannotRun("git %s: %s" % (" ".join(args[:3]), (r.stderr or "").strip()[:300]))
    return r.stdout


def zsplit(out):
    return [p for p in out.split("\0") if p]


# ---- globs and areas -------------------------------------------------------

def glob_re(g):
    out, i = "", 0
    while i < len(g):
        if g.startswith("**/", i):
            out += "(?:.*/)?"
            i += 3
        elif g.startswith("**", i):
            out += ".*"
            i += 2
        elif g[i] == "*":
            out += "[^/]*"
            i += 1
        elif g[i] == "?":
            out += "[^/]"
            i += 1
        elif g[i] == "{":
            j = g.index("}", i)
            out += "(?:" + "|".join(re.escape(x) for x in g[i + 1:j].split(",")) + ")"
            i = j + 1
        else:
            out += re.escape(g[i])
            i += 1
    return re.compile(out + r"\Z")


def load_areas(areas):
    """[(name, {tree: [include re]}, {tree: [exclude re]})]; refuses a catch-all."""
    compiled = []
    for a in areas:
        inc, exc = defaultdict(list), defaultdict(list)
        for g in a["globs"]:
            neg = g.startswith("!")
            g = g[1:] if neg else g
            tree = "es" if g.startswith("es:") else "distribution"
            g = g[3:] if tree == "es" else g
            if not neg and tree == "distribution" and g == "**":
                raise CannotRun("area %s: a bare ** on the distribution would hide every unassigned path" % a["area"])
            (exc if neg else inc)[tree].append(glob_re(g))
        compiled.append((a["area"], inc, exc))
    return compiled


def assign(compiled, tree, path):
    hits = [name for name, inc, exc in compiled
            if any(r.match(path) for r in inc.get(tree, ()))
            and not any(r.match(path) for r in exc.get(tree, ()))]
    return hits


# ---- per-tree facts ----------------------------------------------------------

def tracked(repo):
    head = zsplit(git(repo, "ls-tree", "-r", "-z", "--name-only", "HEAD"))
    index = zsplit(git(repo, "ls-files", "-z"))
    return head, len(index)


def line_counts(repo):
    lines = {}
    out = zsplit(git(repo, "diff-tree", "-r", "--numstat", "-z", "--no-renames", EMPTY_TREE, "HEAD"))
    for rec in out:
        added, _deleted, path = rec.split("\t", 2)
        lines[path] = None if added == "-" else int(added)
    return lines


def last_commits(repo, rev):
    """{path: "<hash10> <yyyy-mm-dd>"} for the newest commit in rev touching it."""
    out = git(repo, "log", "--no-renames", "--format=%x01%H %cs", "--name-only", rev)
    seen, current = {}, None
    for line in out.split("\n"):
        if line.startswith("\x01"):
            h, d = line[1:].split(" ", 1)
            current = "%s %s" % (h[:10], d)
        elif line and current:
            if line.startswith('"') and line.endswith('"'):
                line = line[1:-1].encode("latin-1", "backslashreplace").decode("unicode_escape").encode("latin-1").decode("utf-8", "replace")
            seen.setdefault(line, current)
    return seen


