"""renovation-status -- one table of the renovation: every slice, its size, depth, state and drift
(plan § 9; M6.P1, #641).

  tools/renovation-status [--write docs/reviews/status.md] [--no-issues]

Reads docs/reviews/slices.json (the order), docs/reviews/inventory.json (the
slices' sizes, by the membership `tools/renovation-inventory --order` uses),
docs/reviews/order.md (the preliminary review's status line) and the slice
issues on pixelelated/distribution (one bounded `gh issue list` on milestone
"M6: Codebase renovation", titles `M6.P2 E<epic>/T<k>: ...`, with `reviewed-at:`,
`fixed-at:` and, for EmulationStation paths, `fixed-at-es:` lines in the body;
the run fails if the list reaches its limit). A slice's state:

  unreviewed   no issue yet, or an issue with no audit folder and no reviewed-at
  reading      an audit folder docs/audits/*-epic-m6-<slice id>/ exists, reviewed-at empty
  remediating  reviewed-at set, fixed-at empty
  closed       the issue closed with fixed-at set
  drifted      closed, and `tools/renovation-drift` says re-open for it

The first row is `order: reviewed|unreviewed|pending`, from order.md.
Exit 0 on success, 2 when it cannot run. `--no-issues` skips the tracker
(every slice then reads `unreviewed` unless an audit folder exists) and says so.
"""

import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
from collections import Counter

EX_CANNOT = 2
LIMIT = 400


def load(dist, name, path):
    loader = importlib.machinery.SourceFileLoader(name, os.path.join(dist, path))
    spec = importlib.util.spec_from_loader(name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def field(body, name):
    m = re.search(r"(?im)^[-*\s`]*%s:\s*`?([0-9a-f]{7,40})?`?\s*$" % re.escape(name), body or "")
    return m.group(1) if m and m.group(1) else None


def run(args):
    dist = os.path.realpath(args.distribution)
    inv_mod = load(dist, "renovation_inventory", "tools/renovation-inventory")
    with open(os.path.join(dist, "docs/reviews/inventory.json")) as f:
        inv = json.load(f)
    rows = [dict(zip(inv["columns"], r)) for r in inv["rows"]]
    doc, slices = inv_mod.load_slices(dist)
    size = Counter()
    for r in rows:
        hits = inv_mod.slice_of(r, slices)
        if len(hits) == 1:
            size[hits[0]] += r["lines"] or 0
    with open(os.path.join(dist, "docs/reviews/order.md")) as f:
        text = f.read()
    sec = text.split("## The preliminary review of this order", 1)
    m = re.search(r"Status: \*\*(reviewed|unreviewed|pending)\*\*", sec[1] if len(sec) > 1 else "")
    order_state = m.group(1) if m else "unknown"
    issues = {}
    note = ""
    if args.no_issues:
        note = "The tracker was not read (`--no-issues`)."
    else:
        r = subprocess.run(["gh", "issue", "list", "--repo", "pixelelated/distribution", "--milestone",
                            "M6: Codebase renovation", "--state", "all", "--limit", str(LIMIT),
                            "--json", "number,title,state,body"], capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError("gh issue list: %s" % r.stderr.strip()[:200])
        got = json.loads(r.stdout)
        if len(got) >= LIMIT:
            raise RuntimeError("the issue list reached its limit of %d" % LIMIT)
        for i in got:
            t = re.match(r"M6\.P2 E\d+/T(\d+): ", i["title"])
            if t:
                issues[int(t.group(1))] = i
        note = "Slice issues read from the tracker: %d of %d M6 issues." % (len(issues), len(got))
    audits = os.listdir(os.path.join(dist, "docs/audits"))
    out = ["# Renovation status", "",
           "Generated by `tools/renovation-status`; never hand-edited. %s Lines are the slice's lines in "
           "`inventory.json` (`%s`)." % (note, inv["header"]["distribution"]["head"][:10]), "",
           "| Row | Value |", "| --- | --- |", "| order | %s |" % order_state, "",
           "| k | Area | Slice | Lines | Depth | State | Issue | reviewed-at | fixed-at | Drift since |",
           "| ---: | --- | --- | ---: | --- | --- | --- | --- | --- | --- |"]
    states = Counter()
    for sl, _ in slices:
        i = issues.get(sl["k"])
        body = i["body"] if i else ""
        rev, fix = field(body, "reviewed-at"), field(body, "fixed-at")
        folder = any(a.endswith("-epic-m6-" + sl["id"]) for a in audits)
        drift = "--"
        if i and i["state"] == "CLOSED" and fix:
            fix_es = field(body, "fixed-at-es")  # an EmulationStation slice also records the ES commit
            d = subprocess.run([os.path.join(dist, "tools/renovation-drift"), "--distribution", dist,
                                "--pretend", "%s=%s%s" % (sl["id"], fix, ",es=" + fix_es if fix_es else "")],
                               capture_output=True, text=True)
            if d.returncode == 2:
                raise RuntimeError("renovation-drift for %s: %s" % (sl["id"], d.stderr.strip()[:200]))
            line = [l for l in d.stdout.splitlines() if l.startswith("| %d |" % sl["k"])]
            drift = line[0].split("|")[7].strip() if line else "--"
            state = "drifted" if d.returncode == 1 else "closed"
        elif rev and not fix:
            state = "remediating"
        elif folder:
            state = "reading"
        else:
            state = "unreviewed"
        states[state] += 1
        out.append("| %d | %s | %s | %s | %s | %s | %s | %s | %s | %s |" % (
            sl["k"], sl["area"], sl["id"], "{:,}".format(size[sl["id"]]), sl["depth"], state,
            "#%d" % i["number"] if i else "--", rev or "", fix or "", drift))
    out += ["", "States: " + ", ".join("%s %d" % kv for kv in sorted(states.items())) + "."]
    text = "\n".join(out) + "\n"
    print(text, end="")
    if args.write:
        with open(os.path.join(dist, args.write), "w") as f:
            f.write(text)
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--distribution", default=".")
    ap.add_argument("--write", help="also write the table here (docs/reviews/status.md)")
    ap.add_argument("--no-issues", action="store_true")
    args = ap.parse_args()
    try:
        return run(args)
    except (RuntimeError, OSError, ValueError, KeyError) as e:
        print("renovation-status: cannot run: %s" % e, file=sys.stderr)
        return EX_CANNOT


if __name__ == "__main__":
    sys.exit(main())
