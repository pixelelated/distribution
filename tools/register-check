#
# register-check - the decision register is a lookup table; this refuses the
# two ways it stops being one (D-WORKFLOW-013, audit #129 PL-08):
#
#   1. an ID issued twice: `D-INFRA-008` named two decisions for a week, and a
#      citation of it resolved to whichever the reader found first;
#   2. a citation that names no row: the live documents, the rule files, the
#      two script trees and (when ES_SRC points at a checkout) EmulationStation's
#      sources may cite `D-<AREA>-<n>` only for a row that exists.
#
# A citation is any `D-<LETTERS>-<DIGITS>` at a word boundary -- any area, any
# width. It was `D-(CLOUD|UI|...)-[0-9]{3}`, so a citation under an area not in
# that list (a THEME row, say) was never looked up, and a four-digit ID was
# read as its first three digits and passed (audit #151 PL-11). This file is
# itself an input, which is why the two examples are not spelled out here.
#
# Dated records are not checked for citations -- audit artifacts, work logs and
# dated reports describe the register as it was -- but the register itself is
# always checked whole. Every input listed below has to be readable: a document
# that cannot be read has not been checked, and this says so and fails rather
# than passing over it (engineering-practices.md, guards fail closed). Runs on
# the host as tools/vm-qa's `register` suite, beside `vocabulary`.
# Since T10 S9 (#947) it also reads the second ID of a slash shorthand (a
# pair written with one area and two numbers), fails a file inside a listed
# directory that grep could not read, fails a row whose cell count differs
# from its table's header (an unescaped pipe in a decided row; the open
# table's header against its rows), and reports, without failing, a decided
# row whose text changed after the commit that added it (a decided row is
# append-only; history cannot be undone, so it is named for the record).
# Exit 0 when clean, 1 with every problem listed.
set -u
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
REG="${ROOT}/docs/decision-register.md"
[ -r "${REG}" ] || { echo "register-check: no ${REG}" >&2; exit 2; }
FAIL=0
CITE='D-[A-Z]+-[0-9]+\b'

# 1. every ID once, across both tables
dups=$(grep -o -E '^\| D-[A-Z]+-[0-9]+ ' "${REG}" | tr -d '| ' | sort | uniq -d)
if [ -n "${dups}" ]; then
    for d in ${dups}; do
        echo "DUPLICATE ${d}: $(grep -n -E "^\| ${d} \|" "${REG}" | cut -d: -f1 | tr '\n' ' ')lines"
    done
    FAIL=1
fi
ids=$(grep -o -E '^\| D-[A-Z]+-[0-9]+ ' "${REG}" | tr -d '| ' | sort -u)

# 2. every citation resolves. Live documents only; the register's own rows
#    cite earlier rows and are included.
LIVE=(
    "${REG}"
    "${ROOT}/CLAUDE.md" "${ROOT}/AGENTS.md"
    "${ROOT}/.claude/rules" "${ROOT}/.claude/skills"
    "${ROOT}/docs/blindspot-register.md" "${ROOT}/docs/cloud-sync-changelog.md"
    "${ROOT}/docs/es-menu-map.md" "${ROOT}/docs/device-testing-policy.md"
    "${ROOT}/docs/device-flashing-runbook.md"
    "${ROOT}/docs/conflict-wizard-ia.md" "${ROOT}/NAMING.md"
    "${ROOT}/docs/releases/device-facts.md" "${ROOT}/docs/releases/versioning.md"
    "${ROOT}/docs/pixelelated/rename-plan.md" "${ROOT}/docs/reviews/README.md"
    "${ROOT}/docs/upstream/README.md"
    "${ROOT}/projects/ROCKNIX/packages/network/rclone/sources"
    "${ROOT}/projects/ROCKNIX/packages/network/raofflineproxy/sources"
    "${ROOT}/projects/ROCKNIX/packages/network/raofflineproxy/patches"
    "${ROOT}/projects/ROCKNIX/packages/rocknix/sources/scripts"
    "${ROOT}/projects/ROCKNIX/packages/sysutils/systemd/scripts"
    "${ROOT}/tools"
)
# EmulationStation's sources are optional -- the checkout is not part of this
# tree -- but once ES_SRC names one, it is an input like the others.
if [ -n "${ES_SRC:-}" ]; then
    LIVE+=("${ES_SRC}/es-app/src" "${ES_SRC}/es-core/src")
fi
for p in "${LIVE[@]}"; do
    if [ ! -r "${p}" ]; then
        echo "UNREADABLE ${p#${ROOT}/}: it is a live document and was not checked"
        FAIL=1
    fi
done
missing=0
# The citations, with grep's own errors kept: a file inside a listed
# directory that cannot be read used to vanish into 2>/dev/null.
cites="$(mktemp)" && gerr="$(mktemp)" || exit 2
trap 'rm -f "${cites}" "${gerr}"' EXIT
grep -rnI -o -E "${CITE}" "${LIVE[@]}" > "${cites}" 2> "${gerr}"; grc=$?   # -I: a binary file holds no citation
if [ "${grc}" -gt 1 ] || [ -s "${gerr}" ]; then
    sed -E "s|^grep: ||; s|${ROOT}/||" "${gerr}" | while IFS= read -r e; do echo "UNREADABLE ${e}: it is in a live document's tree and was not checked"; done
    FAIL=1
fi
# A slash shorthand names two rows with one area: the second number is a
# citation too (D-<AREA>-<n>/<m>, as written in four rules).
grep -rnI -o -E 'D-[A-Z]+-[0-9]+(/[0-9]+)+' "${LIVE[@]}" 2>/dev/null \
    | awk -F: '{ n = split($3, part, "/"); area = part[1]; sub(/-[0-9]+$/, "", area); for (i = 2; i <= n; i++) print $1 ":" $2 ":" area "-" part[i] }' >> "${cites}"
while IFS=: read -r file line cite; do
    [ -n "${cite}" ] || continue
    case "${cite}" in *-000) continue ;; esac            # a placeholder in prose ("D-CLOUD-000")
    if ! grep -qx "${cite}" <<< "${ids}"; then
        echo "MISSING ${cite}: ${file#${ROOT}/}:${line}"
        missing=$((missing + 1))
    fi
done < <(grep -v -F "${REG}:" "${cites}" \
         | sed -E 's/^([^:]+):([0-9]+):(.*)$/\1:\2:\3/' | sort -u)
# the register's own cross-references (a row citing an earlier row)
while IFS= read -r cite; do
    grep -qx "${cite}" <<< "${ids}" || { echo "MISSING ${cite}: cited inside the register"; missing=$((missing + 1)); }
done < <(grep -o -E "${CITE}" "${REG}" | sort -u)
# 3. a placeholder that was never filled in: an ID ending in "0" and two
# letters shipped in the image-cache helper's header for six days, because
# letters after the digit are not [0-9]+\b and the citation pattern walked
# past it (audit #258 PL-011). A letter where the number goes is a row
# somebody meant to write; name it. (The shape is not spelled out here: this
# file is one of the inputs.)
while IFS=: read -r file line cite; do
    [ -n "${cite}" ] || continue
    echo "PLACEHOLDER ${cite}: ${file#${ROOT}/}:${line} -- a decision ID with letters where its number goes"
    missing=$((missing + 1))
done < <(grep -rn -o -E 'D-[A-Z]+-[0-9]*[a-z?]+[0-9a-z?]*\b' "${LIVE[@]}" 2>/dev/null | grep -v -F "${REG}:" | sort -u)
[ "${missing}" -eq 0 ] || FAIL=1

# 4. a decided row in the open table. A row appended at the end of the file
# lands under "## Open decisions", and nine renovation rows sat there for a
# day while this check passed (#646, 2026-10-23). An open row asks: its bold
# text begins "Open:" or carries a question mark. A statement there is a
# decided row in the wrong table; name it.
open_at=$(grep -n -m1 '^## Open decisions' "${REG}" | cut -d: -f1)
if [ -n "${open_at}" ]; then
    while IFS= read -r row; do
        id=$(printf '%s' "${row}" | grep -o -E '^\| D-[A-Z]+-[0-9]+ ' | tr -d '| ')
        bold=$(printf '%s' "${row}" | sed -nE 's/^[^*]*\*\*(.*)$/\1/p' | sed -E 's/\*\*.*$//')
        case "${bold}" in
            'Open:'*|*'?'*) ;;
            *) echo "MISPLACED ${id}: a statement under '## Open decisions' is a decided row in the wrong table (#646)"; FAIL=1 ;;
        esac
    done < <(tail -n +"${open_at}" "${REG}" | grep -E '^\| D-[A-Z]+-[0-9]+ ')
fi

# 5. every row has its table's cell count. An unescaped pipe in a cell
# splits it, and a header that lists fewer columns than its rows carry
# misreads every row; both break the column a reader or a tool looks in.
# Named for the register's owner to fix by a clerical row; never edited here.
while IFS=: read -r ln id n want; do
    echo "SHAPE ${id}: line ${ln} has ${n} unescaped pipes where its table's header has ${want}"
    FAIL=1
done < <(awk '
    /^## Decided/ { t = "decided"; h = 0; next }
    /^## Open decisions/ { t = "open"; h = 0; next }
    /^## / { t = ""; next }
    t != "" && /^\|/ {
        line = $0; gsub(/\\\|/, "", line); n = gsub(/\|/, "|", line)
        if (!h) { h = n; next }
        if ($0 ~ /^\|[ ]*-/) next
        if (n != h) { id = $0; sub(/^\| */, "", id); sub(/ *\|.*/, "", id); print NR ":" id ":" n ":" h }
    }' "${REG}")

# 6. a decided row whose text differs from the commit that added it. A
# decided row is append-only (decision-register.md); a change made in place
# cannot be undone, so it is reported, not failed. Needs the register's
# history; without it, says so.
if git -C "${ROOT}" rev-parse --git-dir >/dev/null 2>&1; then
    edited="$(git -C "${ROOT}" log --reverse -p --no-renames --format='commit %H' -- docs/decision-register.md 2>/dev/null \
        | awk -v reg="${REG}" '
            /^\+\| D-[A-Z]+-[0-9]+ \|/ { r = substr($0, 2); id = r; sub(/^\| /, "", id); sub(/ \|.*/, "", id); if (!(id in first)) first[id] = r }
            END {
                while ((getline l < reg) > 0) {
                    if (l ~ /^## Decided/) d = 1; else if (l ~ /^## /) d = 0
                    if (d && l ~ /^\| D-[A-Z]+-[0-9]+ \|/) { id = l; sub(/^\| /, "", id); sub(/ \|.*/, "", id); if ((id in first) && first[id] != l) print id }
                }
            }')"
    for id in ${edited}; do
        echo "EDITED ${id}: its text differs from the commit that added it (reported, not failed)"
    done
else
    echo "note: no git history here, so in-place edits of decided rows were not looked for"
fi

n_rows=$(printf '%s\n' "${ids}" | grep -c .)
if [ "${FAIL}" -eq 0 ]; then
    echo "register-check: ${n_rows} IDs, each once; every citation in the live documents names a row"
    exit 0
fi
echo "register-check: FAILED"
exit 1
