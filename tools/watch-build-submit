"""Submit a durable watch-build process. Submission success is NOT job success.

Run from the frozen worktree. --owner must be a fresh QA/build owner. The
standard runner retains build.rc/status; this launcher retains tool-wrapper.rc.
Actively read both until completion. Disconnected notification is separate.
"""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import stat


def write_json(path, data):
    with path.open('x') as stream:
        json.dump(data, stream, indent=2)
        stream.write('\n')


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def worker(owner, command):
    owner = Path(owner)
    write_json(owner / 'launcher-start.json', {
        'utc': now(), 'pid': os.getpid(), 'cwd': str(Path.cwd()),
        'start_ticks': Path('/proc/self/stat').read_text().rsplit(')', 1)[1].split()[19],
    })
    try:
        environment = os.environ.copy()
        environment['PIXELELATED_SUBMISSION_OWNER'] = str(owner)
        result = subprocess.run(command, env=environment).returncode
        result = result if result >= 0 else 128 - result
    except OSError:
        result = 125
    # Never manufacture the runner's build.rc, or the job's own inner/outer rc.
    with (owner / 'tool-wrapper.rc').open('x') as stream:
        stream.write(str(result) + '\n')
    write_json(owner / 'launcher-result.json', {
        'utc': now(), 'pid': os.getpid(), 'runner_returncode': result,
        'submission_is_not_completion': True,
    })
    return result


def artifact_reference(path):
    """Hash stable regular bytes once; retain originals by reference, not copies."""
    path = Path(path).absolute()
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        before = os.fstat(fd)
        if not stat.S_ISREG(before.st_mode):
            raise ValueError('reference must be a regular file: ' + str(path))
        digest = hashlib.sha256()
        while chunk := os.read(fd, 1024 * 1024):
            digest.update(chunk)
        after = os.fstat(fd)
        identity = lambda v: (v.st_dev, v.st_ino, v.st_size, v.st_mtime_ns, v.st_ctime_ns)
        if identity(before) != identity(after) or identity(after) != identity(path.lstat()):
            raise ValueError('reference changed while reading: ' + str(path))
        return {'path': str(path), 'bytes': after.st_size, 'sha256': digest.hexdigest()}
    finally:
        os.close(fd)


def record_result(argv):
    parser = argparse.ArgumentParser(description='Save compact outcome references; never infer job success.')
    parser.add_argument('--owner', required=True, type=Path)
    parser.add_argument('--status', required=True)
    parser.add_argument('--next-action', required=True)
    parser.add_argument('--reference', action='append', required=True, type=Path)
    parser.add_argument('--current', type=Path)
    args = parser.parse_args(argv)
    owner = args.owner.absolute()
    if owner.resolve(strict=True) != owner or not owner.is_dir() or owner.stat().st_uid != os.getuid():
        raise ValueError('canonical owned result directory required')
    record = {'schema': 'watch-build-result-references-v1', 'observed_at': now(),
              'owner': str(owner), 'status': args.status, 'next_action': args.next_action,
              'references': [artifact_reference(p) for p in args.reference],
              'status_is_owner_assertion': True, 'originals_copied': False}
    output = owner / 'result-reference.json'
    raw = (json.dumps(record, indent=2) + '\n').encode()
    fd = os.open(output, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(raw); stream.flush(); os.fsync(stream.fileno())
    saved = artifact_reference(output)
    if saved['sha256'] != hashlib.sha256(raw).hexdigest():
        raise ValueError('result readback mismatch')
    if args.current:
        current = args.current.absolute()
        if current.parent.resolve(strict=True) != current.parent or current.is_symlink():
            raise ValueError('current result path aliases are forbidden')
        if current.exists() and (not current.is_file() or current.stat().st_uid != os.getuid()):
            raise ValueError('current result must be owned regular file')
        temp = current.with_name(current.name + '.tmp-' + str(os.getpid()))
        data = (json.dumps({'status': args.status, 'next_action': args.next_action,
                           'observed_at': record['observed_at'], 'result': saved}, indent=2) + '\n').encode()
        with temp.open('xb') as stream:
            stream.write(data); stream.flush(); os.fsync(stream.fileno())
        os.replace(temp, current)
    for directory in {output.parent, args.current.absolute().parent if args.current else output.parent}:
        fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try: os.fsync(fd)
        finally: os.close(fd)
    print(json.dumps(saved))
    return 0


def main():
    if len(sys.argv) > 1 and sys.argv[1] == '--record-result':
        return record_result(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == '--worker':
        return worker(sys.argv[2], sys.argv[3:])
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--owner', required=True, type=Path)
    parser.add_argument('runner_args', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    runner_args = args.runner_args
    if runner_args and runner_args[0] == '--':
        runner_args = runner_args[1:]
    owner = args.owner.resolve(strict=True)
    runner = Path.cwd() / 'tools/watch-build'
    if not owner.is_dir() or not runner.is_file() or not os.access(runner, os.X_OK):
        parser.error('existing owner and executable cwd/tools/watch-build required')
    if not runner_args or os.environ.get('RASTERATOPS_BUILD_RUN'):
        parser.error('runner arguments required; inherited active runs cannot be submitted')
    for name in ['qa.start', 'start', 'inner.rc', 'outer.rc', 'tool-wrapper.rc', 'console.log']:
        if (owner / name).exists():
            parser.error('owner has already started: ' + name)
    os.umask(0o077)
    # Exclusive reservation is permanent even if launch fails. Use a fresh owner.
    write_json(owner / 'launcher-submission.json', {
        'utc': now(), 'cwd': str(Path.cwd()), 'runner': str(runner),
        'runner_sha256': hashlib.sha256(runner.read_bytes()).hexdigest(),
        'submission_is_not_completion': True,
    })
    copy = owner / 'watch-build-submit.py'
    with copy.open('xb') as output:
        output.write(Path(__file__).read_bytes())
    copy.chmod(0o500)
    with (owner / 'console.log').open('xb', buffering=0) as log:
        child = subprocess.Popen(
            [sys.executable, '-I', str(copy), '--worker', str(owner),
             str(runner), *runner_args], stdin=subprocess.DEVNULL,
            stdout=log, stderr=subprocess.STDOUT,
            start_new_session=True, close_fds=True)
    write_json(owner / 'launcher-pid.json', {'pid': child.pid, 'utc': now()})
    print(json.dumps({'state': 'submitted', 'pid': child.pid, 'owner': str(owner),
                      'completion': str(owner / 'launcher-result.json'),
                      'submission_is_not_completion': True}))
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print('watch-build-submit: ' + str(error), file=sys.stderr)
        sys.exit(2)
