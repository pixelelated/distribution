#
# Remove a worktree without destroying a build root.
#
# `git worktree remove --force` treats every worktree alike. In this repo they
# are not alike: a feature worktree is a few hundred MB of checkout, while a
# build worktree holds build.ROCKNIX-<DEVICE>.<ARCH> directories that cost
# hours each and are not in git. The command that cleans up the first silently
# targets the second, and --force is the flag you reach for when the first
# attempt complains.
#
# It is also not reliably atomic. Told to force-remove a worktree holding
# hundreds of GB, git unregistered it and left the contents behind - a
# directory that is no longer a worktree, whose build roots are now orphaned,
# reported only as a non-zero exit nobody reads in a loop.
#
#   ./tools/fork-worktree list                    # what each worktree is holding
#   ./tools/fork-worktree remove <path>           # refuses if build output is present
#   ./tools/fork-worktree remove <path> --preserve <dir>   # move build output out first
#   ./tools/fork-worktree remove <path> --force   # destroy it anyway, having been told
#   ./tools/fork-worktree repair <path>           # re-register an orphaned directory
#   ./tools/fork-worktree sync                    # fast-forward every build/* worktree to next
set -uo pipefail

# Every git read below is about the repository this tool lives in, never the
# one the shell happens to be standing in. Run with the shell inside the
# EmulationStation repo (2026-09-12) it read that repo's config, warned that
# the pre-push guard was unset, listed that repo's worktrees and synced
# nothing -- while saying nothing untrue about the repo it looked at.
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# The gitignored build outputs, per CLAUDE.md. Presence of any of these means
# the directory is worth more than the checkout it sits in.
is_build_artifact() {
    case "${1}" in
        build.*|target|sources|release) return 0 ;;
        *) return 1 ;;
    esac
}

# du over a 345 GB tree is slow and cold-cache slower. The refusal does not
# depend on the number, so treat it as a nicety that is allowed to give up.
cheap_size() {
    local out
    out="$(timeout 10 du -sh "${1}" 2>/dev/null | cut -f1)"
    [ -n "${out}" ] && echo "${out}" || echo "too large to measure in 10s"
}

artifacts_in() {
    local wt="${1}" found=""
    for entry in "${wt}"/* ; do
        [ -e "${entry}" ] || continue
        local base; base="$(basename "${entry}")"
        is_build_artifact "${base}" && found+="${base}"$'\n'
    done
    printf '%s' "${found}"
}

git_dir() { git -C "${ROOT}" rev-parse --git-common-dir 2>/dev/null; }

# The pre-push guard is installed by absolute path (see .githooks/pre-push for
# why). Git says nothing when that path stops existing -- it just runs no
# hooks -- which is what happened for a day after the tree moved to /workspace.
# This runs from the two subcommands people actually use, so the gap is loud.
check_hooks_path() {
    local hp
    hp="$(git -C "${ROOT}" config --get core.hooksPath 2>/dev/null || true)"
    case "${hp}" in
        '')  echo "⚠ core.hooksPath is not set: the pre-push guard is not running." >&2
             echo "  git config core.hooksPath /workspace/repos/rocknix/.githooks" >&2 ;;
        /*)  [ -d "${hp}" ] || { echo "⚠ core.hooksPath names a directory that does not exist (${hp}): the pre-push guard is not running." >&2
                                 echo "  git config core.hooksPath /workspace/repos/rocknix/.githooks" >&2; } ;;
        *)   echo "⚠ core.hooksPath is relative (${hp}); pr/* pushes from a worktree run unguarded." >&2 ;;
    esac
}

cmd_list() {
    check_hooks_path
    git -C "${ROOT}" worktree list --porcelain | awk '/^worktree /{sub(/^worktree /, ""); print}' | while read -r wt; do
        local_art="$(artifacts_in "${wt}")"
        if [ -n "${local_art}" ]; then
            echo "  ${wt}"
            echo "      HOLDS BUILD OUTPUT ($(cheap_size "${wt}")):"
            printf '%s\n' "${local_art}" | sed 's/^/        /'
        else
            echo "  ${wt}"
            echo "      checkout only"
        fi
    done
}

# Go's downloaded modules contain owner-owned 0555 directories. Git starts
# deleting before it encounters them, then unregisters the partially removed
# tree even on failure (#460). Inspect the entire directory tree first, then
# grant only the directory owner's write/search bits needed for this removal.
# File permissions and symlink targets are never changed.
prepare_forced_removal() {
    python3 - "${1}" <<'PY'
import os
import stat
import sys
import time

def fail(error):
    raise error

root = os.open(sys.argv[1], os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    device = os.fstat(root).st_dev
    pending = {}
    count = 0
    last = time.monotonic()
    for path, dirs, files, fd in os.fwalk('.', dir_fd=root,
                                         follow_symlinks=False, onerror=fail):
        info = os.fstat(fd)
        if info.st_dev != device:
            raise RuntimeError('refusing removal across a filesystem: ' + path)
        # An empty directory is removed through its parent; its own write bit
        # is irrelevant. Docker may leave an empty root-owned sources mountpoint.
        if (dirs or files) and not os.access('.', os.W_OK | os.X_OK, dir_fd=fd):
            if info.st_uid != os.geteuid():
                raise PermissionError('directory is not writable or owned by this user: ' + path)
            pending[path] = (info.st_dev, info.st_ino, stat.S_IMODE(info.st_mode))
        count += 1
        if time.monotonic() - last >= 10:
            print('  inspected removal permissions:', count, 'directories', flush=True)
            last = time.monotonic()
    changed = 0
    if pending:
        for path, dirs, files, fd in os.fwalk('.', dir_fd=root,
                                             follow_symlinks=False, onerror=fail):
            if path not in pending:
                continue
            info = os.fstat(fd)
            expected = pending.pop(path)
            if (info.st_dev, info.st_ino, stat.S_IMODE(info.st_mode)) != expected:
                raise RuntimeError('directory changed during permission inspection: ' + path)
            if info.st_uid != os.geteuid():
                raise PermissionError('directory ownership changed: ' + path)
            os.fchmod(fd, expected[2] | stat.S_IWUSR | stat.S_IXUSR)
            changed += 1
        if pending:
            raise RuntimeError('directories disappeared during permission inspection')
    print('  removal permissions:', count, 'directories checked;', changed,
          'owner-write/search repairs', flush=True)
except (OSError, RuntimeError) as error:
    print('error: removal permission preflight failed:', error, file=sys.stderr)
    sys.exit(1)
finally:
    os.close(root)
PY
}

cmd_remove() {
    local wt="" preserve="" force=0
    while [ $# -gt 0 ]; do
        case "${1}" in
            --preserve)
                # A bare --preserve used to loop for ever: shift 2 with one
                # argument left shifts nothing (T10 S4, #940).
                [ $# -ge 2 ] && [ -n "${2}" ] || { echo "usage: fork-worktree remove <path> [--preserve <dir>] [--force]" >&2; exit 2; }
                preserve="${2}"; shift 2 ;;
            --force) force=1; shift ;;
            *) wt="${1}"; shift ;;
        esac
    done
    [ -n "${wt}" ] || { echo "usage: fork-worktree remove <path> [--preserve <dir>] [--force]" >&2; exit 1; }
    wt="$(cd "${wt}" 2>/dev/null && pwd -P)" || { echo "error: no such directory" >&2; exit 1; }

    # Refusing to delete the ground you are standing on: the shell's cwd would
    # vanish mid-command and every later step would fail for an unrelated-looking
    # reason.
    local here; here="$(pwd -P)"
    case "${here}/" in
        "${wt}"/*) echo "error: you are inside ${wt}; run this from elsewhere" >&2; exit 1 ;;
    esac

    local art; art="$(artifacts_in "${wt}")"
    if [ -n "${art}" ] && [ -z "${preserve}" ] && [ "${force}" -eq 0 ]; then
        {
            echo "refusing: ${wt} holds build output that is not in git ($(cheap_size "${wt}")):"
            printf '%s\n' "${art}" | sed 's/^/    /'
            echo "  Each build.* directory is hours of work and cannot be recovered from a clone."
            echo "  Keep it:     fork-worktree remove ${wt} --preserve <dir>"
            echo "  Destroy it:  fork-worktree remove ${wt} --force"
        } >&2
        exit 1
    fi

    if [ -n "${preserve}" ]; then
        # Every move is checked before anything is removed: a failed move used
        # to be ignored and the worktree forced away with the output still in
        # it (T10 S4, #939). The destination may not lie inside the worktree,
        # and an existing name in it is never overwritten.
        mkdir -p "${preserve}" || exit 1
        local pdir; pdir="$(cd "${preserve}" && pwd -P)" || exit 1
        case "${pdir}/" in
            "${wt}"/*) echo "refusing: --preserve ${preserve} is inside ${wt}, which is about to be removed" >&2; exit 1 ;;
        esac
        while IFS= read -r base; do
            [ -n "${base}" ] || continue
            if [ -e "${pdir}/${base}" ] || [ -L "${pdir}/${base}" ]; then
                echo "refusing: ${pdir}/${base} already exists; nothing was removed (move it aside, or choose another --preserve)" >&2; exit 1
            fi
            if ! mv -T "${wt}/${base}" "${pdir}/${base}"; then
                echo "refusing: could not move ${wt}/${base} to ${pdir}/; nothing was removed" >&2; exit 1
            fi
            echo "  preserved: ${base} -> ${pdir}/"
        done <<< "${art}"
        art="$(artifacts_in "${wt}")"
        [ -z "${art}" ] || { echo "refusing: build output is still in ${wt} after the moves; nothing was removed" >&2; exit 1; }
    elif [ -n "${art}" ]; then
        echo "  destroying build output as instructed:"; printf '%s\n' "${art}" | sed 's/^/    /'
    fi

    # git's own refusal of uncommitted or untracked files is a second guard,
    # given --force only when the user gave it (D-WORKFLOW-201, #940; the
    # unconditional --force since bcf03f7338 had no recorded reason, against
    # blindspot 15). Ignored files alone do not stop git, which is why the
    # build-output refusal above always runs first.
    local gforce=()
    if [ "${force}" -eq 1 ]; then
        prepare_forced_removal "${wt}" || exit 1
        gforce=(--force)
    fi
    git -C "${ROOT}" worktree remove "${gforce[@]}" "${wt}"
    local rc=$?

    if [ "${rc}" -ne 0 ] && git -C "${ROOT}" worktree list --porcelain | awk '/^worktree /{sub(/^worktree /, ""); print}' | grep -qxF "${wt}"; then
        echo "refusing: git kept ${wt} (uncommitted or untracked files); commit or stash them, or remove with --force to destroy them" >&2
        exit "${rc}"
    fi
    # git can unregister and still leave the directory. Say so plainly rather
    # than letting a non-zero exit disappear into a loop.
    if [ -d "${wt}" ]; then
        echo "warning: ${wt} still exists on disk after removal (git exit ${rc})." >&2
        echo "  It is no longer a registered worktree. Re-register it with:" >&2
        echo "    fork-worktree repair ${wt}" >&2
        exit 1
    fi
    [ "${rc}" -eq 0 ] || exit "${rc}"
    echo "  removed: ${wt}"
}

# carry <src-dir> <dst-dir>: every entry of src into dst. An entry dst lacks
# is moved whole (a build root is one rename); a directory both hold is
# entered; a file both hold is replaced by src's, which is what the worktree
# held. A move that fails is named and counted, and its source is kept.
carry() {
    local src="${1}" dst="${2}" e base rc=0
    for e in "${src}"/* "${src}"/.[!.]* "${src}"/..?*; do
        [ -e "${e}" ] || [ -L "${e}" ] || continue
        base="${e##*/}"
        if [ -d "${e}" ] && [ ! -L "${e}" ] && [ -d "${dst}/${base}" ] && [ ! -L "${dst}/${base}" ]; then
            carry "${e}" "${dst}/${base}" || rc=1
        elif mv -f -T "${e}" "${dst}/${base}" 2>/dev/null; then
            moved=$((moved + 1))
        else
            echo "  could not carry back: ${e#"${orphan}"/} (kept in ${orphan})" >&2; rc=1
        fi
    done
    return ${rc}
}

# The recovery for a directory git unregistered but did not delete: stand up a
# fresh worktree at the same path and carry every path back, untracked files
# inside tracked directories included (T10 S4, #940: the top-level-only loop
# left them in the orphan, then deleted it with rm -rf). What cannot be
# carried stays in the orphan, which is then kept, never deleted.
cmd_repair() {
    local wt="${1:-}" ref="${2:-next}"
    [ -n "${wt}" ] || { echo "usage: fork-worktree repair <path> [ref]" >&2; exit 1; }
    wt="$(cd "${wt}" 2>/dev/null && pwd -P)" || { echo "error: no such directory" >&2; exit 1; }
    if git -C "${ROOT}" worktree list --porcelain | awk '/^worktree /{sub(/^worktree /, ""); print}' | grep -qxF "${wt}"; then
        echo "  ${wt} is already a registered worktree; nothing to repair"; exit 0
    fi
    orphan="${wt}.orphan.$$"
    mv "${wt}" "${orphan}" || exit 1
    if ! git -C "${ROOT}" worktree add -q --detach "${wt}" "${ref}"; then
        mv "${orphan}" "${wt}"; echo "error: could not create worktree; directory restored" >&2; exit 1
    fi
    moved=0
    local ok=0
    # The orphan's .git is the old pointer file, not content; the new worktree has its own.
    [ -f "${orphan}/.git" ] && mv "${orphan}/.git" "${orphan}.git-pointer"
    carry "${orphan}" "${wt}" && ok=1
    find "${orphan}" -depth -type d -empty -delete 2>/dev/null
    if [ -e "${orphan}" ]; then
        echo "  repaired: ${wt} at ${ref}, ${moved} item(s) carried over; ${orphan} kept with what could not be carried" >&2
        exit 1
    fi
    [ -f "${orphan}.git-pointer" ] && rm -f -- "${orphan}.git-pointer"
    [ "${ok}" -eq 1 ] || exit 1
    echo "  repaired: ${wt} at ${ref}, ${moved} item(s) carried over"
}

# Bring every build worktree up to next. A branch does not follow next by
# itself any more than a detached HEAD does, so this is the step that would
# otherwise be three manual checkouts nobody remembers to run before a build.
#
# Only build/* branches are touched. A feature branch has work on it and is
# nobody's to fast-forward; next itself is the thing being followed.
cmd_sync() {
    check_hooks_path
    # No target argument on purpose. This walks every build worktree, so an
    # arbitrary ref moves all of them at once -- which is exactly how, while
    # testing this function, a throwaway commit was fast-forwarded onto two real
    # build checkouts without anyone noticing. The only ref worth following here
    # is next; testing against something else is not worth that edge.
    local target="next" rc=0
    # Read through a process substitution, not a pipe, so the loop runs in this
    # shell and rc reaches the return (T10 S4, #940: it was always 0).
    while read -r wt; do
        local br; br="$(git -C "${wt}" branch --show-current)"
        case "${br}" in
            build/*) ;;
            "")  echo "  skip ${wt##*/}: detached HEAD, not a build worktree"; continue ;;
            *)   echo "  skip ${wt##*/}: on ${br}, not a build/* branch"; continue ;;
        esac
        # A build rewrites a tracked doc as one of its outputs
        # (documentation/PER_DEVICE_DOCUMENTATION/<DEVICE>/SUPPORTED_EMULATORS_AND_CORES.md),
        # so every build worktree is "dirty" after every build, and the skip
        # below refused to move both of them on 2026-09-11 -- the next image
        # was built from the old tree, and only noticed because BUILD_ID did
        # not change. That file is not a change anyone made here: put it
        # back before asking whether the tree is clean. Never run under a
        # build (see the header) -- the build would rewrite it again anyway.
        git -C "${wt}" checkout -q -- 'documentation/PER_DEVICE_DOCUMENTATION/*/SUPPORTED_EMULATORS_AND_CORES.md' 2>/dev/null || true
        if [ -n "$(git -C "${wt}" status --porcelain=v1 --untracked-files=no)" ]; then
            # Name the files: the skip read as a mystery until someone ran
            # git status by hand (2026-09-07).
            echo "  SKIP ${wt##*/}: uncommitted changes on ${br} - resolve them first:" >&2
            git -C "${wt}" status --porcelain=v1 --untracked-files=no | sed 's/^/        /' >&2
            rc=1
            continue
        fi
        # --ff-only: if someone committed on the build branch it has diverged,
        # and quietly rewriting it would lose that work.
        local before; before="$(git -C "${wt}" rev-parse HEAD)"
        if git -C "${wt}" merge --ff-only "${target}" >/dev/null 2>&1; then
            local after; after="$(git -C "${wt}" rev-parse HEAD)"
            if [ "${before}" = "${after}" ]; then
                # Either already at target, or ahead of it. Say so: reporting a
                # move that did not happen is how a stale checkout gets built.
                if git -C "${wt}" merge-base --is-ancestor "${target}" HEAD 2>/dev/null &&
                   [ "$(git -C "${wt}" rev-parse "${target}")" != "${after}" ]; then
                    echo "  ${wt##*/}: ${br} is AHEAD of ${target}; left alone"
                else
                    echo "  ${wt##*/}: ${br} already at ${target}"
                fi
            else
                echo "  ${wt##*/}: ${br} fast-forwarded to $(git -C "${wt}" rev-parse --short HEAD)"
            fi
        else
            echo "  FAILED ${wt##*/}: ${br} has diverged from ${target}; not fast-forwarding" >&2
            rc=1
        fi
    done < <(git -C "${ROOT}" worktree list --porcelain | awk '/^worktree /{sub(/^worktree /, ""); print}')
    return ${rc}
}

case "${1:-}" in
    list)   shift; cmd_list "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    repair) shift; cmd_repair "$@" ;;
    sync)   cmd_sync ;;
    *) echo "usage: ${0##*/} {list|sync|remove <path> [--preserve <dir>] [--force]|repair <path> [ref]}" >&2; exit 1 ;;
esac
