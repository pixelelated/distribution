from pathlib import Path
import subprocess,tempfile,os,json,shutil,hashlib
import argparse
parser=argparse.ArgumentParser(description="Exercise optional hardware reporting with complete-script filesystem fixtures.")
parser.add_argument('--baseline', type=Path, help='Optional original script for the failing control and valid-output comparison.')
parser.add_argument('--output', type=Path, help='Retain original result channels and source digest in this directory.')
args=parser.parse_args()
P=args.output or Path(tempfile.mkdtemp(prefix='rocknix-info-test-'))
P.mkdir(parents=True,exist_ok=True)
ROOT=Path(__file__).resolve().parent.parent
file='projects/ROCKNIX/packages/rocknix/sources/scripts/rocknix-info'
old=args.baseline.read_text() if args.baseline else None;new=(ROOT/file).read_text()
results=[]
with tempfile.TemporaryDirectory(prefix='hardware-',dir=P) as td:
 t=Path(td)
 def write(name,value):
  p=t/name;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(value);return p
 def execute(source,arch='x86_64',label='new'):
  # Rewrite only OS filesystem roots into the disposable fixture. Keep the
  # complete script and real shell/awk/grep/arithmetic logic intact.
  code=source.replace('/etc/profile',str(t/'profile')).replace('/tmp/battery.percent',str(t/'battery.percent')).replace('/sys/',str(t/'sys')+'/').replace('/proc/cpuinfo',str(t/'proc/cpuinfo')).replace('/proc/meminfo',str(t/'proc/meminfo')).replace('/usr/lib/autostart/quirks',str(t/'quirks')).replace('/storage/games-internal',str(t/'storage')).replace('/storage/games-external',str(t/'storage'))
  env={**os.environ,'HW_ARCH':arch,'HW_DEVICE':'QA','HW_CPU':'QA CPU','OS_NAME':'pixelelated','OS_VERSION':'0.0.1-dev','BUILD_ID':'a0f60255ab','BUILD_BRANCH':'test','GPU_FREQ':str(t/'sys/gpu'),'DEVICE_GPU_CUR_FREQ':str(t/'sys/gpu/cur_freq'),'DEVICE_GPU_MAX_FREQ':str(t/'sys/gpu/clocks'),'DEVICE_TEMP_SENSOR':str(t/'sys/thermal/*/temp'),'DEVICE_GPU_TEMP_SENSOR':str(t/'sys/gpu/temp'),'DEVICE_HAS_FAN':'false'}
  r=subprocess.run(['bash'],input=code,text=True,env=env,capture_output=True)
  (P/(label+'.json')).write_text(json.dumps({'returncode':r.returncode,'stdout':r.stdout,'stderr':r.stderr},indent=2)+'\n');return r
 def check(name,condition):
  results.append({'case':name,'passed':bool(condition)});assert condition,name
 write('profile','');write('proc/cpuinfo','processor\t: 0\nmodel name\t: QA CPU\n');write('proc/meminfo','MemTotal: 1000000 kB\nMemAvailable: 500000 kB\n');(t/'storage').mkdir()
 write('sys/class/dmi/id/sys_vendor','QA\n');write('sys/class/dmi/id/product_name','VM\n');(t/'sys/class/net').mkdir(parents=True)
 a=execute(old,label='original-absent') if old else None;b=execute(new,label='fixed-absent')
 if a:check('original absent interfaces reproduce arithmetic error and nonzero status',a.returncode!=0 and 'arithmetic syntax error' in a.stderr)
 check('absent optional metrics succeed quietly',b.returncode==0 and not b.stderr)
 check('unknown CPU frequencies are explicit, GPU and temperature rows omitted','CPU CURRENT FREQUENCY: Not Available' in b.stdout and 'CPU MAXIMUM FREQUENCY: Not Available' in b.stdout and 'GPU CURRENT' not in b.stdout and 'TEMPERATURE:' not in b.stdout)
 base='sys/devices/system/cpu/cpufreq/policy0/'
 write(base+'scaling_cur_freq','1234000\n');write(base+'cpuinfo_max_freq','2400000\n');write(base+'scaling_max_freq','2400000\n');write(base+'related_cpus','0 1 2 3\n')
 write('sys/gpu/cur_freq','650000000\n');write('sys/gpu/max_freq','900000000\n');write('sys/gpu/clocks','SCLK: 0 900Mhz\n');write('sys/thermal/zone0/temp','43000\n');write('sys/thermal/zone1/temp','47000\n');write('sys/gpu/temp','55000\n')
 a=execute(old,label='original-valid') if old else None;b=execute(new,label='fixed-valid')
 # Ignore live IP/hostname/disk values only by selecting the hardware rows.
 rows=lambda r:[x for x in r.stdout.splitlines() if x.startswith(('CPU ','GPU ','THREADS','CURRENT FREQUENCY','MAXIMUM FREQUENCY'))]
 check('valid x86 hardware presentation unchanged',(not a or rows(a)==rows(b)) and b.returncode==0 and not b.stderr and all(x in b.stdout for x in ['CPU CURRENT FREQUENCY: 1234 MHz','CPU MAXIMUM FREQUENCY: 2400 MHz','GPU CURRENT FREQUENCY: 650 MHz','GPU MAXIMUM FREQUENCY: 900 MHz','CPU TEMPERATURE: 45°','GPU TEMPERATURE: 55°']))
 a=execute(old,arch='aarch64',label='original-arm-valid') if old else None;b=execute(new,arch='aarch64',label='fixed-arm-valid')
 check('valid ARM clusters/GPU/temperature presentation unchanged',(not a or rows(a)==rows(b)) and b.returncode==0 and not b.stderr and all(x in b.stdout for x in ['THREADS 0-3: 1234MHz','THREADS 0-3: 2400MHz','GPU CURRENT FREQUENCY: 650 MHz','GPU MAXIMUM FREQUENCY: 900 MHz','CPU TEMPERATURE: 45°','GPU TEMPERATURE: 55°']))
 for n,v in [('empty',''),('malformed','unavailable\n'),('expression','1+2\n'),('overflow','9'*30+'\n')]:
  write(base+'scaling_cur_freq',v);write('sys/gpu/cur_freq',v);b=execute(new,label='fixed-'+n)
  check(n+' optional frequencies are unavailable without errors',b.returncode==0 and not b.stderr and 'CPU CURRENT FREQUENCY: Not Available' in b.stdout and 'GPU CURRENT' not in b.stdout)
 write(base+'scaling_cur_freq','0001234000\n');write('sys/gpu/cur_freq','0\n');b=execute(new,label='fixed-leading-zero')
 check('leading zeros remain decimal; measured zero is retained','CPU CURRENT FREQUENCY: 1234 MHz' in b.stdout and 'GPU CURRENT FREQUENCY: 0 MHz' in b.stdout and b.returncode==0 and not b.stderr)
 for n in ['sys/thermal/zone0/temp','sys/thermal/zone1/temp','sys/gpu/temp']:write(n,'not-a-reading\n')
 b=execute(new,label='fixed-invalid-temperatures');check('invalid temperatures omitted without division by zero',b.returncode==0 and not b.stderr and 'TEMPERATURE:' not in b.stdout)
 q=write('quirks/platforms/QA/info.d/10-good','#!/bin/sh\necho "QA QUIRK: executed"\n');q.chmod(0o755)
 write('quirks/platforms/QA/info.d/20-not-executable','should not run\n');(t/'quirks/platforms/QA/info.d/30-directory').mkdir()
 b=execute(new,label='fixed-quirks');check('valid quirk executes; missing and non-executable entries skip',b.returncode==0 and not b.stderr and 'QA QUIRK: executed' in b.stdout)
 q=write('quirks/platforms/QA/info.d/05-failing','#!/bin/sh\nexit 23\n');q.chmod(0o755)
 b=execute(new,label='fixed-quirk-failure');check('real quirk failure survives later success',b.returncode==23 and 'QA QUIRK: executed' in b.stdout)
(P/'result.json').write_text(json.dumps({'source_sha256':hashlib.sha256(new.encode()).hexdigest(),'cases':results},indent=2)+'\n')
print('PASS',len(results),'full-script positive/negative controls',flush=True)

if not args.output:shutil.rmtree(P)
