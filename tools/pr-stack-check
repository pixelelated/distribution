#
# pr-stack-check - build the upstream series by content and prove it is whole.
#
#   tools/pr-stack-check [--map FILE] [--keep] [--base REF] [--from REF] [--repo DIR] [--roots "a b"] [--drafts DIR]
#
# Reads docs/pr-series/map.txt (one `## title` per PR, in order, then the
# paths `git checkout <from> -- <path>` takes; `#` comments), makes a throwaway
# worktree on --base (default upstream/next), and builds each PR on the base
# by itself, one commit by content from --from (default next): a path that
# exists on next is checked out, a path next deleted is removed. The series is
# not a stack (D-WORKFLOW-079, which replaced #322's stack): every pr/* branch
# is one commit on upstream/next. Then it fails unless
#
#   0. every PR title obeys upstream's CI rule (`package: text`, 72 chars);
#   1. every path the map names differs from the base somewhere (a dead line
#      in the map is a PR that claims what it does not carry);
#   2. no personal path (the push guard's PERSONAL_PATTERNS, read from
#      .githooks/pre-push) is named;
#   3. every upstream-bound file that differs between the base and next is
#      carried by a PR -- an uncovered file fails. Renames are off, so a
#      renamed file is its new path and its deleted old path, and both must be
#      carried. A file two PRs need rides whole in each and is printed as
#      `shared:` (D-WORKFLOW-079: identical content merges whichever lands
#      first);
#   4. every PR's files together on the base equal next on every
#      upstream-bound path -- the tree upstream holds once every PR has
#      merged (#322's rule, in the shape D-WORKFLOW-079 left it): zero files
#      differing under packages/, projects/, scripts/, config/,
#      distributions/, Makefile and tools/ minus the personal tools.
#
# It prints each PR's file list with counts. --keep leaves the worktree and
# its pr-stack/N branches for cutting the real pr/* branches from; without it
# the worktree goes (tools/fork-worktree remove for this checkout, which
# refuses build output; a plain git worktree remove for --repo; never a forced
# one) and so do the branches it made. It refuses to start over an existing
# worktree or pr-stack/N branch: a kept stack is somebody's. Exit 0 only on
# PASS; 1 on any failure; 2 on usage, an existing stack, or a base next does
# not contain (merge upstream first, or the diff is not the fork's).
#
# Why by content and not by commit: fork-workflow.md. Why a tool: #322's
# rule that the series must leave upstream with exactly the tree that was
# built and proven; a hand-made series has no such proof (blindspot 47's
# shape, seen from the other side).
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MAP="${ROOT}/docs/pr-series/map.txt"; BASE=upstream/next; FROM=next; KEEP=0
# --repo: the checkout the branches are built in (default: this one); --roots: the
# upstream-bound roots there (default: the distribution's; "." for another repo);
# --drafts: where the PR descriptions live, NN-*.md per map entry (D-WORKFLOW-078's scan).
REPO="${ROOT}"; ROOTS_ARG=""; DRAFTS="${ROOT}/docs/releases/pr"
while [ $# -gt 0 ]; do
  case "$1" in
    --map) MAP="$2"; shift 2 ;;
    --base) BASE="$2"; shift 2 ;;
    --repo) REPO="$(cd "$2" && pwd)"; shift 2 ;;
    --roots) ROOTS_ARG="$2"; shift 2 ;;
    --drafts) DRAFTS="$2"; shift 2 ;;
    --from) FROM="$2"; shift 2 ;;
    --keep) KEEP=1; shift ;;
    -h|--help) sed -n '5,46p' "$0"; exit 0 ;;
    *) echo "pr-stack-check: unknown argument $1" >&2; exit 2 ;;
  esac
done
cd "${ROOT}" || exit 2
[ -f "${MAP}" ] || { echo "pr-stack-check: no map at ${MAP}" >&2; exit 2; }
g() { git -C "${REPO}" "$@"; }
g rev-parse --verify -q "${BASE}" >/dev/null || { echo "pr-stack-check: no ref ${BASE} in ${REPO}" >&2; exit 2; }
g rev-parse --verify -q "${FROM}" >/dev/null || { echo "pr-stack-check: no ref ${FROM} in ${REPO}" >&2; exit 2; }
if ! g merge-base --is-ancestor "${BASE}" "${FROM}"; then
  echo "pr-stack-check: ${FROM} does not contain ${BASE}: merge it first, or the diff below is not only the fork's" >&2; exit 2
fi
FAIL=0; fail() { echo "FAIL: $*"; FAIL=1; }

# The upstream-bound roots, and the personal patterns the push guard refuses.
if [ -n "${ROOTS_ARG}" ]; then read -r -a ROOTS <<< "${ROOTS_ARG}"; elif [ "${REPO}" = "${ROOT}" ]; then ROOTS=(packages projects scripts config distributions Makefile tools); else ROOTS=(.); fi
mapfile -t PERSONAL < <(sed -n '/^PERSONAL_PATTERNS=(/,/^)/p' "${ROOT}/.githooks/pre-push" | grep -o "^\s*'[^']*'" | tr -d " '")
[ "${#PERSONAL[@]}" -gt 5 ] || { echo "pr-stack-check: could not read PERSONAL_PATTERNS from .githooks/pre-push" >&2; exit 2; }
is_personal() { local p; for p in "${PERSONAL[@]}"; do case "$1" in "${p}"*) return 0 ;; esac; done; return 1; }

# Every upstream-bound file that differs between the base and FROM.
mapfile -t DIFF < <(g diff --name-only --no-renames "${BASE}" "${FROM}" -- "${ROOTS[@]}" | while read -r f; do is_personal "$f" || echo "$f"; done)
[ "${#DIFF[@]}" -gt 0 ] || { echo "pr-stack-check: nothing differs between ${BASE} and ${FROM} on the upstream-bound roots"; exit 1; }

# Parse the map: titles and paths, in order.
declare -a TITLES; declare -A PATHS_OF; n=-1; CEIL_FILES=0; CEIL_INS=0
while IFS= read -r line; do
  case "$line" in
    '# ceiling:'*) CEIL_FILES="$(printf '%s' "$line" | grep -o 'files=[0-9]*' | cut -d= -f2)"; CEIL_INS="$(printf '%s' "$line" | grep -o 'insertions=[0-9]*' | cut -d= -f2)"; CEIL_FILES="${CEIL_FILES:-0}"; CEIL_INS="${CEIL_INS:-0}" ;;
    '## '*) n=$((n+1)); TITLES[$n]="${line#\#\# }"; PATHS_OF[$n]=""
       # upstream's CI title rule (validate-pull-request.yml): `package: text`, 72 chars at most
       if ! printf '%s' "${TITLES[$n]}" | grep -q -E '^[a-zA-Z0-9_*./-]+:[[:space:]].+$' || [ "${#TITLES[$n]}" -gt 72 ]; then
         fail "PR $((n+1))'s title breaks the CI rule (package: text, 72 chars at most): ${TITLES[$n]}"
       fi ;;
    '#'*|'') ;;
    *) [ "$n" -ge 0 ] || { echo "pr-stack-check: a path before the first ## title: $line" >&2; exit 2; }
       PATHS_OF[$n]+="${line}"$'\n' ;;
  esac
done < "${MAP}"
[ "$n" -ge 0 ] || { echo "pr-stack-check: the map names no PR" >&2; exit 2; }

# Which diff files each map path covers (a directory covers what is under it).
declare -A OWNER   # file -> PR index
declare -a FILES_OF
for i in $(seq 0 "$n"); do
  FILES_OF[$i]=""
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    is_personal "$p" && fail "PR $((i+1)) names a personal path: $p"
    hit=0
    for f in "${DIFF[@]}"; do
      if [ "$f" = "$p" ] || [ "${f#"$p"/}" != "$f" ]; then
        hit=1
        # A file two PRs need rides whole in each (D-WORKFLOW-079): identical content merges cleanly whichever lands first.
        if [ -n "${OWNER[$f]:-}" ] && [ "${OWNER[$f]}" != "$i" ]; then echo "   shared: $f (PR $((OWNER[$f]+1)) and PR $((i+1)))"; fi
        OWNER[$f]="$i"; FILES_OF[$i]+="${f}"$'\n'
      fi
    done
    [ "$hit" = 1 ] || fail "PR $((i+1)) names a path that does not differ from ${BASE}: $p"
  done <<< "${PATHS_OF[$i]}"
done
for f in "${DIFF[@]}"; do [ -n "${OWNER[$f]:-}" ] || fail "no PR carries $f"; done

# Build each PR on the base by itself, in a throwaway worktree: one commit per
# branch (D-WORKFLOW-079, #333: the ROCKNIX developers closed a series whose
# tenth branch carried ten commits). The worktree is reset to the base before
# every PR, so nothing of PR 1 is in PR 2.
# The sibling of the primary checkout: <primary>.worktrees/pr-stack-check (worktrees.md).
COMMON="$(g rev-parse --path-format=absolute --git-common-dir)" || { echo "pr-stack-check: cannot find ${REPO}'s git directory" >&2; exit 2; }
PRIMARY="$(dirname "${COMMON}")"
WT="${PRIMARY}.worktrees/pr-stack-check"
if [ -e "${WT}" ]; then echo "pr-stack-check: ${WT} exists; remove it with tools/fork-worktree remove first" >&2; exit 2; fi
for i in $(seq 0 "$n"); do
  if g rev-parse -q --verify "refs/heads/pr-stack/$((i+1))" >/dev/null; then
    echo "pr-stack-check: branch pr-stack/$((i+1)) exists (a kept stack?); delete it by name first" >&2; exit 2
  fi
done
g worktree add -q --detach "${WT}" "${BASE}" || { echo "pr-stack-check: could not add the worktree" >&2; exit 2; }
cleanup() {
  [ "${KEEP}" = 0 ] || return 0
  if [ "${REPO}" = "${ROOT}" ]; then "${ROOT}/tools/fork-worktree" remove "${WT}" >/dev/null 2>&1; else g worktree remove "${WT}" >/dev/null 2>&1; fi \
    || echo "pr-stack-check: could not remove ${WT}; it is left for tools/fork-worktree remove" >&2
  for i in $(seq 0 "$n"); do g branch -D "pr-stack/$((i+1))" >/dev/null 2>&1 || true; done
}
trap cleanup EXIT
BANNED='[Cc]laude|[Aa]nthropic|Generated with|Co-Authored-By|D-[A-Z]+-[0-9]+|tools/[a-z]'
PLURAL='\b([Ww]e|[Ww]e'"'"'re|[Ww]e'"'"'ve|[Ww]e'"'"'ll|[Oo]ur|[Oo]urs)\b'
for i in $(seq 0 "$n"); do
  echo "== PR $((i+1)): ${TITLES[$i]}"
  git -C "${WT}" checkout -q --detach "${BASE}" || { fail "PR $((i+1)): could not reset the worktree to ${BASE}"; continue; }
  count=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if g cat-file -e "${FROM}:${f}" 2>/dev/null; then
      git -C "${WT}" checkout -q "${FROM}" -- "$f" || fail "PR $((i+1)): could not check out $f"
    else
      git -C "${WT}" rm -q -f -- "$f" 2>/dev/null || fail "PR $((i+1)): $f is deleted on ${FROM} and could not be removed"
    fi
    count=$((count+1)); echo "   $f"
  done <<< "${FILES_OF[$i]}"
  if [ "$count" = 0 ]; then fail "PR $((i+1)) carries no file"; continue; fi
  git -C "${WT}" commit -q --allow-empty -m "${TITLES[$i]}" || fail "PR $((i+1)): commit failed"
  git -C "${WT}" branch -f "pr-stack/$((i+1))" HEAD
  # exactly one commit past the base, and the size a reviewer meets
  c="$(git -C "${WT}" rev-list --count "${BASE}..HEAD")"; [ "$c" = 1 ] || fail "PR $((i+1)) is $c commits past ${BASE}, not one"
  stat="$(git -C "${WT}" diff --shortstat "${BASE}" HEAD)"; files="$(printf '%s' "$stat" | grep -o '[0-9]* file' | cut -d' ' -f1)"; ins="$(printf '%s' "$stat" | grep -o '[0-9]* insertion' | cut -d' ' -f1)"
  echo "   ($count files named; ${files:-0} files, ${ins:-0} insertions past ${BASE})"
  [ "${CEIL_FILES}" -gt 0 ] && [ "${files:-0}" -gt "${CEIL_FILES}" ] && fail "PR $((i+1)) touches ${files} files, over the map's ceiling of ${CEIL_FILES}"
  [ "${CEIL_INS}" -gt 0 ] && [ "${ins:-0}" -gt "${CEIL_INS}" ] && fail "PR $((i+1)) adds ${ins} lines, over the map's ceiling of ${CEIL_INS}"
  # the description a reviewer reads (D-WORKFLOW-078, D-WORKFLOW-074): present, titled as the map, in the maintainer's voice
  d="$(ls "${DRAFTS}"/$(printf '%02d' $((i+1)))-*.md 2>/dev/null | head -1)"
  if [ -z "$d" ]; then fail "PR $((i+1)) has no description under ${DRAFTS} (NN-*.md)"; continue; fi
  t="$(sed -n 's/^Title: //p' "$d" | head -1)"; [ "$t" = "${TITLES[$i]}" ] || fail "PR $((i+1))'s description is titled '$t', the map says '${TITLES[$i]}'"
  body="$(sed '1{/^Title: /d}' "$d")"
  h="$(printf '%s\n' "$body" | grep -n -E "${BANNED}" | head -3)"; [ -z "$h" ] || fail "PR $((i+1))'s description names an assistant, a decision ID or a fork tool:"$'\n'"$h"
  h="$(printf '%s\n' "$body" | grep -n -E "${PLURAL}" | head -3)"; [ -z "$h" ] || fail "PR $((i+1))'s description is in the plural (the maintainer writes as I):"$'\n'"$h"
  h="$(printf '%s\n' "$body" | grep -n -E '^\*\*[^*]+\*\*|^#+ |^- ' | head -3)"; [ -z "$h" ] || fail "PR $((i+1))'s description carries a template (bold labels, headings or bullets):"$'\n'"$h"
done

# 4. Every PR's files together on the base, compared with FROM: the tree upstream
# holds once the whole series has merged. Built and diffed, not inferred from 3.
echo "== every PR on ${BASE} together, compared with ${FROM}"
if git -C "${WT}" checkout -q --detach "${BASE}"; then
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if g cat-file -e "${FROM}:${f}" 2>/dev/null; then git -C "${WT}" checkout -q "${FROM}" -- "$f" || fail "union: could not check out $f"
    else git -C "${WT}" rm -q -f -- "$f" 2>/dev/null || fail "union: could not remove $f"; fi
  done < <(printf '%s' "${FILES_OF[@]}" | sort -u)
  mapfile -t LEFT < <(git -C "${WT}" diff --name-only --no-renames "${FROM}" -- "${ROOTS[@]}" | while read -r f; do is_personal "$f" || echo "$f"; done)
  for f in "${LEFT[@]}"; do fail "every PR together still differs from ${FROM}: $f"; done
  [ "${#LEFT[@]}" -eq 0 ] && echo "   0 upstream-bound files differ"
  git -C "${WT}" checkout -q --detach "${BASE}" 2>/dev/null; git -C "${WT}" reset -q --hard 2>/dev/null
else
  fail "union: could not reset the worktree to ${BASE}"
fi

if [ "${FAIL}" = 0 ]; then
  echo "pr-stack-check: PASS -- $((n+1)) PRs carry all ${#DIFF[@]} upstream-bound files, each one commit on ${BASE} with a description in the maintainer's voice; every PR on ${BASE} together equals ${FROM}"
  [ "${KEEP}" = 1 ] && echo "kept: ${WT}; branches pr-stack/1..$((n+1)), each on ${BASE} by itself"
  exit 0
fi
echo "pr-stack-check: FAIL"; exit 1
