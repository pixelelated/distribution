        for key,value in [('SAVES_REMOTE',saves),('SETTINGS_REMOTE',backups),('CONTENT_REMOTE',content)]:
            text=re.sub('^'+key+'=.*$',key+'="'+value+'"',text,flags=re.M)
        write_remote('/storage/.config/cloud_sync.conf',text)
