        write_remote('/storage/roms/gb/QA508.srm','progress roundtrip\n');script('cloud_backup','--saves-only','--yes','--method=copy');assert (backend/'data/pixelelated/Saves/gb/QA508.srm').read_text()=='progress roundtrip\n'
