    def test_namespace_pinned_by_a_descriptor_requires_an_observed_view(self):
        fd = self.init/'fd/7'
        fd.symlink_to(self.executable)
        readlink = os.readlink

        def named(path, *args, **kwargs):
            if path == fd:
                return 'mnt:[999999999]'
            return readlink(path,*args,**kwargs)

        with patch.object(os,'readlink',side_effect=named):
            self.assert_incomplete(self.observe(self.manifest()),'unobserved_pinned_mount_namespace')


