    def test_foreign_working_parent_is_refused(self):
        run,leaf,_,_,_=self.terminal(nested=True)
        foreign=leaf.parent.parent
        st=Path.lstat

        def foreign_owner(path):
            current=st(path)
            if path != foreign:
                return current
            fields=list(current)
            fields[4]=os.geteuid()+1
            return os.stat_result(fields)

        with patch.object(Path,'lstat',foreign_owner):
            result=self.finish(run,expected='held')
        self.assertIn('retirement parent is shared, foreign or unverified',str(result))
        self.assertEqual(self.observations,0)
        self.assertTrue(leaf.is_file())

