    def test_parent_replaced_after_host_observation_holds_private_leaf(self):
        self.checkout.chmod(0o755)
        run,leaf,_,_,_=self.terminal(nested=True)
        working=leaf.parent.parent
        displaced=working.with_name('displaced-working')
        original=A['retirement_identity'](leaf.lstat())
        child=G['tree_identity'](leaf.parent.lstat())

        def replace_parent(manifest, key):
            report=self.host(manifest,key)
            working.rename(displaced)
            working.mkdir(mode=0o700)
            (displaced/leaf.parent.name).rename(leaf.parent)
            self.assertEqual(A['retirement_identity'](leaf.lstat()),original)
            self.assertEqual(G['tree_identity'](leaf.parent.lstat()),child)
            return report

        with patch.dict(R,read_host_use=replace_parent):
            outcome=self.finish(run,expected='held')
        self.assertIn('retirement directory identity changed',str(outcome))
        self.assertEqual(outcome['verified_unlinked_bytes'],0)
        self.assertTrue(leaf.is_file())

