    def test_seal_revalidates_actual_caller_and_returns_frozen_route(self):
        legacy,private,old_plan,old_caller=self.frozen_fixture()
        canonical,new_plan,new_receipt=self.canonical_fixture()
        old_receipt=self.base/'before-fence.json'
        old_row=legacy['prepare'](old_plan,old_receipt)
        fs=legacy['registry_for'](private)
        # Exercise a real frozen prepare paused after current() and before lock acquisition.
        reached,released=threading.Event(),threading.Event()
        observed=[]
        true_current=legacy['current']
        def pause_current(plan):
            state=true_current(plan)
            if threading.current_thread().name=='paused-legacy':
                reached.set()
                if not released.wait(10):
                    raise RuntimeError('fixture did not release the preparer')
            return state
        def prepare():
            try:
                legacy['prepare'](old_plan,self.base/'paused.json')
            except (ValueError,OSError,RuntimeError) as error:
                observed.append(str(error))
        with patch.dict(legacy['prepare'].__globals__,current=pause_current):
            thread=threading.Thread(target=prepare,name='paused-legacy')
            thread.start()
            try:
                self.assertTrue(reached.wait(10))
                legacy_original=json.loads((fs/'jobs.json').read_bytes())
                legacy_original['queued']={'spent':dict(device=private.stat().st_dev,
                    expires=time.time()-1,scope=dict(checkout=str(private),outputs=[],protected=[]))}
                dump(fs/'jobs.json',legacy_original)
                before=ref(fs/'jobs.json')['sha256']
                generation=old_row['registry_generation']
                queue_before=json.loads((self.registry/'jobs.json').read_bytes())['queued']
                self.assertTrue(queue_before)
                G['seal_legacy'](self.checkout,old_caller,before)
                self.assertEqual(json.loads((self.registry/'jobs.json').read_bytes())['queued'],queue_before)
                sealed=json.loads((fs/'jobs.json').read_bytes())
                self.assertEqual(sealed['schema'],2)
                self.assertEqual(sealed['queued'],legacy_original['queued'])
                self.assertGreater(sealed['generation'],generation)
                blocked=private/'.build-runs'/'blocked'
                blocked.mkdir(parents=True)
                with self.assertRaisesRegex(ValueError,'invalid registry'):
                    legacy['admit'](old_receipt,private,blocked,{})
                with self.assertRaisesRegex(ValueError,'invalid registry'):
                    legacy['prepare'](old_plan,self.base/'new-legacy.json')
            finally:
                released.set()
                thread.join(10)
        self.assertEqual(observed,['invalid registry'])
        self.assertFalse((self.base/'paused.json').exists())
        # Canonical prepare persists a lease and its matching admit still succeeds.
        fresh=self.base/'canonical-after-seal.json'
        canonical.prepare(new_plan,fresh)
        run=self.checkout/'.build-runs'/'canonical'
        run.mkdir(parents=True)
        row=canonical.admit(fresh,self.checkout,run,{})
        jobs=json.loads((self.registry/'jobs.json').read_bytes())
        self.assertNotIn(row['id'],jobs['queued'])
        self.assertEqual(jobs['jobs'][row['id']]['state'],'running')
        with self.assertRaisesRegex(ValueError,'active or queued'):
            G['restore_legacy'](self.checkout,old_caller,ref(fs/'jobs.json')['sha256'])
        canonical.finish(run,0,0,0)
        (run/'build.rc').write_text('0\n')
        (run/'build.status').write_text('state:       finished\n')
        for rid in jobs['queued']:
            self.assertIn(rid,queue_before)
        for entry in jobs['queued'].values():
            entry['expires']=time.time()-1
        retained_queue=jobs['queued']
        dump(self.registry/'jobs.json',jobs)
        accepted=self.base/'canonical-acceptance.json'
        dump(accepted,dict(run=str(run),expected_rc=0,disposition='qualified',outputs=row['outputs'],
                          evidence=[ref(run/'runner-result.json')]))
        with patch.object(canonical,'exited',lambda _:None):
            canonical.consume(run,accepted)
        G['restore_legacy'](self.checkout,old_caller,ref(fs/'jobs.json')['sha256'])
        restored=json.loads((fs/'jobs.json').read_bytes())
        self.assertEqual(restored['schema'],1)
        self.assertEqual(restored['queued'],legacy_original['queued'])
        self.assertEqual(json.loads((self.registry/'jobs.json').read_bytes())['queued'],retained_queue)
        self.assertGreater(restored['generation'],generation+1)
        with self.assertRaisesRegex(ValueError,'registry changed'):
            legacy['admit'](old_receipt,private,blocked,{})
        newest=self.base/'fresh-legacy.json'
        legacy['prepare'](old_plan,newest)
        self.assertEqual(legacy['admit'](newest,private,blocked,{})['state'],'running')

