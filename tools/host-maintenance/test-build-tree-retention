#!/usr/bin/python3 -IBS
"""Disposable controls for build-tree retirement. No real Docker or host scan."""
import base64
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import tempfile
import threading
import time
import unittest
from unittest.mock import patch

TOOLS = Path(__file__).resolve().parent
ENGINE = runpy.run_path(str(TOOLS/'build-tree-retention'))
G = ENGINE['sweep'].__globals__
A = G['ADMISSION']
R = G['READER']
SRC = TOOLS.parents[1]


def dump(path, value):
    path.write_text(json.dumps(value,sort_keys=True) + '\n')


def ref(path):
    return dict(path=str(path),sha256=G['sha'](path.read_bytes()))


def repo(p):
    p.mkdir(mode=0o700)
    subprocess.run(['/usr/bin/git','init','-q',str(p)],check=True)
    return p


class Controls(unittest.TestCase):
    def setUp(self):
        self.addCleanup(os.umask, os.umask(0o077))
        temp = tempfile.TemporaryDirectory(prefix='pix-tree-retire-')
        self.addCleanup(temp.cleanup)
        self.base=Path(temp.name).resolve()
        self.checkout=repo(self.base/'checkout')
        self.keepers=self.base/'kept'
        self.keepers.mkdir()
        self.refs=self.base/'refs'
        self.refs.mkdir()
        self.routes=self.base/'private-state'
        self.routes.mkdir()
        self.enterContext(patch.dict(os.environ,XDG_STATE_HOME=str(self.routes)))
        self.enterContext(patch.dict(A,registry_state_roots=lambda:[str(self.routes)]))
        self.registry=A['registry_for'](self.checkout)
        self.registry.mkdir(mode=0o700)
        (self.registry/'lock').touch()
        self.ledger=dict(schema=1,generation=1,jobs={},queued={})
        dump(self.registry/'jobs.json',self.ledger)
        self.enterContext(patch.dict(R,inventory=self.references,read_host_use=self.host))
        self.mounts=[]
        self.host_status='clear'
        self.host_extension=True
        self.observations=0
        self.root=self.checkout/'build.fixture'
        self.root.mkdir(mode=0o700)

    def references(self, plan, generated):
        self.assertTrue(generated)
        return dict(errors=[],references=[],container_mounts=self.mounts)

    def host(self, manifest, key):
        self.observations+=1
        ns=time.time_ns()
        status='clear' if self.host_status=='stale' else self.host_status
        count=int(status=='busy')
        matches=dict(argument=0,descriptor=count,executable=0,mapping=0,bind_mount=0)
        doc=dict(schema=1,status=status,scan_complete=True,manifest_sha256=manifest,
            started_at_ns=ns,finished_at_ns=ns,expires_at=ns//10**9+300,reason=None,
            tasks_scanned=2,mount_views_scanned=1,batches=[dict(selection_sha256=key,files=1,
                status=status,reason=None,matches=matches)])
        if self.host_extension:
            doc.update(tree_scope=G['POLICY'],tree_selections=[key])
        outcome=R['validate_host_use'](doc,R['HOST_USE_EXIT'][status],manifest,key,ns,ns)
        outcome['original_stdout_base64']=base64.b64encode(G['encoded'](doc)).decode()
        if self.host_status=='stale':
            outcome['observed_at_ns']-=G['HOST_AGE']+1
        return outcome

    def terminal(self, name='one', rc=0, keep_inside=False, root=None, nested=False, original_registry=None):
        root=root or self.root
        child=root/'build'/'generated'
        child.parent.mkdir(mode=0o700)
        child.mkdir(mode=0o700)
        leaf=child/'selected.o'
        leaf.write_bytes(b'ordinary generated fixture' * 4096)
        run=self.checkout/'.build-runs'/name
        run.parent.mkdir(mode=0o700,exist_ok=True)
        run.mkdir(mode=0o700)
        outputs=[dict(path=str(root),kind='build-cache',issue=493,release_when='fixture originals accepted')]
        original=dict(id=name,run=str(run),checkout=str(self.checkout),volume=str(self.checkout),
            volume_device=self.checkout.stat().st_dev,registry=str(original_registry or self.registry),state='running',
            pid_namespace=Path('/proc/self/ns/pid').stat().st_ino,runner_pid=2147483647,submission_owner=None,
            outputs=outputs,source=dict(head='a'*40,tracked_diff_sha256='b'*64),required_bytes=1024,
            retention_scope=dict(checkout=str(self.checkout),protected=[str(self.keepers)],outputs=[str(root)]))
        dump(run/'admission.json',original)
        result=dict(command_rc=rc,monitor_rc=0,runner_rc=rc)
        dump(run/'runner-result.json',result)
        (run/'build.rc').write_text(str(rc)+'\n')
        (run/'build.status').write_text('state:       finished\n')
        kept=self.keepers/(name+'-sources')
        kept.write_text('retained generation input and diagnostic')
        delivered=self.keepers/(name+'-deliverable')
        delivered.write_text('independent fixture result')
        source=self.keepers/(name+'-source.json')
        dump(source,dict(result='PASS',source=original['source'],evidence=[ref(kept)]))
        scope=dict(path=str(child if nested else root),host_manifest_sha256='e'*64,
            directories=[dict(path=str(p),identity=G['tree_identity'](p.lstat()))
                         for p in ([child] if nested else [root,root/'build',child])],
            files=[dict(path=str(leaf),identity=A['retirement_identity'](leaf.lstat()))])
        if nested:
            scope['host_scope']=dict(path=str(root),identity=G['tree_identity'](root.lstat()))
        claim=dict(roots=[scope],reference_roots=[str(self.refs)],reference_stores=[str(self.refs)],
                   registry_state_roots=[str(self.routes)])
        proof=self.keepers/(name+'-preserved.json')
        dump(proof,dict(result='PASS',admission_id=name,selection_sha256=G['sha'](G['encoded'](claim)),
                        evidence=[ref(delivered)]))
        operands=[ref(run/'runner-result.json'),ref(delivered)]
        if keep_inside:
            operands.append(ref(leaf))
        config=dict(schema=1,**claim,source_custody=ref(source),preserved_result=ref(proof))
        accepted=self.keepers/(name+'-acceptance.json')
        body=dict(run=str(run),expected_rc=rc,disposition='qualified' if rc==0 else 'failed-investigated',
                  outputs=outputs,evidence=operands,build_tree=config)
        dump(accepted,body)
        row=dict(original,state='consumed',original_result=result,outputs_held=True,
                 evidence_sha256=ref(accepted)['sha256'],retained_evidence=[str(run),str(accepted),str(delivered)])
        dump(run/'admission-consumed.json',row)
        if original_registry is None:
            self.ledger['jobs'][name]=row
            dump(self.registry/'jobs.json',self.ledger)
        return run,leaf,row,config,accepted

    def finish(self, run=None, expected='retired'):
        result=G['sweep'](self.checkout,run)
        self.assertEqual(result['status'],expected,result)
        return result

    def test_real_files_dirs_and_originals_retire_exactly_once(self):
        run,leaf,_,_,_=self.terminal()
