#!/usr/bin/env python3
"""Exercise the unprivileged report recipient with the fixed producer's wire format."""
import copy
import json
from pathlib import Path
import runpy
import tempfile
import unittest

READER = runpy.run_path(str(Path(__file__).with_name('retention-report')))
READ = READER['validate_host_use']
MANIFEST = '1' * 64
SELECTED = '2' * 64
BEFORE, AFTER = 100_000_000_000, 101_000_000_000


def report():
    matches = dict(argument=0, descriptor=0, executable=0, mapping=0, bind_mount=0)
    return dict(schema=1, status='clear', scan_complete=True, manifest_sha256=MANIFEST,
                started_at_ns=BEFORE, finished_at_ns=AFTER, expires_at=200, reason=None,
                tasks_scanned=2, mount_views_scanned=1, batches=[
                    dict(selection_sha256=SELECTED, files=1, status='clear', reason=None, matches=matches)])


class Consumption(unittest.TestCase):
    def test_results(self):
        doc = report()
        for status, rc in [('clear', 0), ('busy', 1), ('incomplete', 2)]:
            with self.subTest(status=status):
                doc['status'] = doc['batches'][0]['status'] = status
                if status == 'busy':
                    doc['batches'][0]['matches']['descriptor'] = 1
                if status == 'incomplete':
                    doc.update(scan_complete=False, reason='fd_incomplete')
                    doc['batches'][0].update(matches=None, reason='fd_incomplete')
                result = READ(doc, rc, MANIFEST, SELECTED, BEFORE, AFTER)
                self.assertEqual(result['status'], status)
                self.assertFalse(result['cleanup_authorized'])
                self.assertEqual(result['reclaimed_bytes'], 0)

    def test_unrelated_incomplete_batch(self):
        doc = report()
        doc['status'] = 'incomplete'
        doc['batches'].append(dict(selection_sha256='3' * 64, files=1, status='incomplete',
                                   matches=None, reason='selected_identity'))
        self.assertEqual(READ(doc, 2, MANIFEST, SELECTED, BEFORE, AFTER)['status'], 'clear')

    def test_producer_and_consumer_together(self):
        fixture_code = runpy.run_path(str(Path(__file__).with_name('test-host-in-use-report')))
        fixture = fixture_code['ReportTests']()
        fixture.setUp()
        self.addCleanup(fixture.doCleanups)
        manifest = fixture.manifest(fixture.file)
        snapshot = fixture_code['NOW'] * 10**9
        for expected_rc, expected_status in [(0, 'clear'), (1, 'busy'), (2, 'incomplete')]:
            if expected_status == 'busy':
                (fixture.init / 'fd' / '4').symlink_to(fixture.file)
            elif expected_status == 'incomplete':
                (fixture.init / 'maps').unlink()
            doc = fixture.observe(manifest)
            selected = doc['batches'][0]['selection_sha256']
            result = READ(json.loads(json.dumps(doc)), expected_rc, doc['manifest_sha256'],
                          selected, snapshot, snapshot)
            self.assertEqual(result['status'], expected_status)
            self.assertFalse(result['cleanup_authorized'])

    def test_invalid_receipts(self):
        for changes, rc in [
                ({'schema': True}, 0), ({'manifest_sha256': '0' * 64}, 0),
                ({'started_at_ns': BEFORE-1}, 0), ({'finished_at_ns': AFTER+1}, 0),
                ({'expires_at': 101}, 0), ({'scan_complete': False}, 0),
                ({'status': 'busy'}, 0), ({'reason': 'error'}, 0), ({'tasks_scanned': 0}, 0),
                ({'mount_views_scanned': 0}, 0), ({'batches': []}, 0)]:
            with self.subTest(changes=changes), self.assertRaises(ValueError):
                READ(dict(report(), **changes), rc, MANIFEST, SELECTED, BEFORE, AFTER)
        for mode in ['duplicate', 'wrong-selection', 'unreported-hit', 'bool-count', 'unknown-match']:
            doc = report()
            batch = doc['batches'][0]
            if mode == 'duplicate':
                doc['batches'].append(copy.deepcopy(batch))
            elif mode == 'wrong-selection':
                batch['selection_sha256'] = '3' * 64
            elif mode == 'unreported-hit':
                batch['matches']['mapping'] = 1
            elif mode == 'bool-count':
                batch['matches']['argument'] = False
            else:
                batch['matches']['extra'] = 0
            with self.subTest(mode=mode), self.assertRaises((ValueError, KeyError)):
                READ(doc, 0, MANIFEST, SELECTED, BEFORE, AFTER)

    def test_published_result_is_private_and_exclusive(self):
        with tempfile.TemporaryDirectory() as tmp:
            path = Path(tmp) / 'result'
            result = READ(report(), 0, MANIFEST, SELECTED, BEFORE, AFTER)
            self.assertEqual(READER['publish_host_use'](path, result), 0)
            self.assertEqual(path.stat().st_mode & 0o777, 0o600)
            with self.assertRaises(FileExistsError):
                READER['publish_host_use'](path, dict(result, status='busy'))
            self.assertEqual(json.loads(path.read_bytes()), result)


if __name__ == '__main__':
    unittest.main()
