    def test_overlapping_claims_and_hardlinks_cannot_multiply_bytes(self):
        run, leaf, row, config, proof = self.terminal()
        second_name = 'second'
        second = run.with_name(second_name)
        second.mkdir()
        original = json.loads((run / 'admission.json').read_text())
        original.update(id=second_name, run=str(second))
        TREE_TESTS['dump'](second / 'admission.json', original)
        copied = json.loads(proof.read_text())
        copied['run'] = str(second)
        second_proof = proof.with_name('second.json')
        TREE_TESTS['dump'](second_proof, copied)
        another = dict(row, id=second_name, run=str(second), retained_evidence=[str(second_proof)],
                       evidence_sha256=TREE_TESTS['ref'](second_proof)['sha256'])
        self.ledger['jobs'][second_name] = another
        TREE_TESTS['dump'](second / 'admission-consumed.json', another)
        self.sync()
        with patch.dict(CYCLE_GLOBALS, available_on=lambda *_: 1024):
            r = self.review()
            leaf.with_name('other-name.o').hardlink_to(leaf)
            linked = self.review()
        blocks = leaf.stat().st_blocks * 512
        self.assertEqual([x['observed_final_link_bytes'] for x in r['candidates']], [blocks, blocks])
        self.assertEqual(sum(x['unique_observed_bytes'] for x in r['candidates']), blocks)
        self.assertEqual(sum(x['unique_observed_bytes'] for x in linked['candidates']), 0)
        self.assertEqual(linked['measured_reclaimed_bytes'], 0)

    def test_foreign_reservation_missing_scope_and_unbound_request_hold(self):
        _, leaf, _, _, _ = self.terminal()
        protected = self.base / 'future'
        self.pending(protected)
        active = dict(self.ledger['jobs']['one'], id='live', state='running', required_bytes=5120)
