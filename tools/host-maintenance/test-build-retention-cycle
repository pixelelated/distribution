"""Isolated build lifecycle and generated user-unit controls. No live user manager."""
import json
import os
from pathlib import Path
import runpy
import shlex
import shutil
import stat
import subprocess
import tempfile
import time
import unittest
from unittest.mock import patch


HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
CYCLE = 'build-retention-cycle'
NAME = 'pixelelated-build-tree-retention'
PYTHON = '/usr/bin/python3'
HELPER = runpy.run_path(str(HERE / 'admission-test-fixture.py'))

# Replace the deletion engine only, never the installed cycle or the
# watch-build/admission entrypoints. Capture actual argv, caller environment
# and lock state so the fixture can distinguish delivery from custody.
ENGINE = '''#!/usr/bin/python3
import fcntl, json, os, sys
from contextlib import contextmanager
from pathlib import Path

def registry_routes(root):
    base = Path.home()
    alternate = base / 'filesystem-registry'
    return base / 'canonical-registry', [alternate] if alternate.exists() else [], []

@contextmanager
def locked_registry(root):
    with (root / 'lock').open('rb') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        yield json.loads((root / 'jobs.json').read_text())

if __name__ == '__main__':
    base = Path.home()
    argv = sys.argv[1:]
    assert argv[0] == 'sweep' and argv[1] == '--checkout'
    fixture = json.loads((base / 'scenario.json').read_text())
    assert os.environ['XDG_STATE_HOME'] == fixture['state_home']
    event = {'argv': argv, 'engine': str(Path(__file__).resolve()),
             'schema': 1, 'status': fixture['status']}
    primary, alternate, _ = registry_routes(Path(argv[2]))
    for route in [primary, *alternate]:
        if route.is_dir():
            with locked_registry(route):
                pass
    if '--run' in argv:
        assert len(argv) == 5 and argv[3] == '--run'
        run = Path(argv[4])
        assert run.parent.parent == Path(argv[2])
        original = json.loads((run / 'admission.json').read_text())
        with (Path(original['registry']) / 'lock').open('rb') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            row = json.loads((Path(original['registry']) / 'jobs.json').read_text())['jobs'][original['id']]
            assert row == json.loads((run / 'admission-consumed.json').read_text())
        with (run.parent / 'active.lock').open('rb') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        result = json.loads((run / 'runner-result.json').read_text())
        event.update(registry_state=row['state'], original_result=result)
    elif fixture.get('abandoned'):
        run = Path(fixture['abandoned'])
        assert not (run / 'admission-consumed.json').exists()
        event['abandoned'] = str(run)
    print(json.dumps(event), flush=True)
    sys.exit(fixture['status'])
'''


class CycleTests(unittest.TestCase):
    def setUp(self):
        tmp = tempfile.TemporaryDirectory(prefix='pix493-cycle-')
        self.addCleanup(tmp.cleanup)
        self.base = Path(tmp.name)
        self.home = self.base / 'home'
        self.home.mkdir(mode=0o700)
        self.config = self.home / 'config'
        self.state = self.home / 'build-state'
        self.env = {'PATH': '/usr/bin:/bin', 'HOME': str(self.home), 'LC_ALL': 'C',
                    'XDG_CONFIG_HOME': str(self.config), 'XDG_STATE_HOME': str(self.state)}
        self.canonical = self.base / 'canonical repo'
        folder = self.canonical / 'tools/host-maintenance'
        folder.mkdir(parents=True)
        self.engine = folder / 'build-tree-retention'
        self.engine.write_text(ENGINE)
        self.engine.chmod(0o755)
        self.cycle = folder / CYCLE
        shutil.copy2(HERE / CYCLE, self.cycle)
        self.scenario(0)
        self.install_cmd = [PYTHON, '-I', '-B', str(self.cycle), 'install',
                            '--checkout', str(self.canonical)]
        installation = self.call(self.install_cmd)
        self.assertEqual(installation.returncode, 0, installation.stderr)
        self.installed = json.loads(installation.stdout)
        self.settings = Path(self.installed['settings'])
        self.service = Path(self.installed['service'])
        self.timer = Path(self.installed['timer'])
        line = next(line for line in self.service.read_text().splitlines() if line.startswith('ExecStart='))
        self.service_argv = shlex.split(line.removeprefix('ExecStart='))

    def call(self, argv, cwd=None, env=None):
        return subprocess.run(argv, cwd=cwd or self.base, env=env or self.env,
                              capture_output=True, text=True, timeout=15)

    def scenario(self, status, **extra):
        data = {'status': status, 'state_home': str(self.state), **extra}
        (self.home / 'scenario.json').write_text(json.dumps(data))

    def new_build(self, command_status):
        checkout = self.base / 'frozen build'
        (checkout / 'tools').mkdir(parents=True)
        (checkout / 'scripts').mkdir()
        for name in ('watch-build', 'watch-job'):
            shutil.copy2(ROOT / 'tools' / name, checkout / 'tools' / name)
        shutil.copy2(ROOT / 'Makefile', checkout / 'Makefile')
        admission_tool, _, receipt = HELPER['prepare_fixture'](checkout, ROOT)
        shutil.copy2(HERE / CYCLE, checkout / 'tools/host-maintenance' / CYCLE)
        wrong_engine = checkout / 'tools/host-maintenance/build-tree-retention'
        wrong_engine.write_text('#!/bin/sh\nexit 99\n')
        wrong_engine.chmod(0o755)
        command = [str(checkout / 'tools/watch-build'), '--interval', '1', '--admission',
                   str(receipt), '--', '/bin/sh', '-c', f'exit {command_status}']
        result = self.call(command, cwd=checkout)
        self.assertEqual(result.returncode, command_status, result.stderr)
        run = next(item for item in (checkout / '.build-runs').iterdir() if item.is_dir())
        trigger = run / 'build-tree-retention-after-consume.log'
        self.assertFalse(trigger.exists(), 'terminal status alone cannot trigger retirement')
        proof = checkout / 'acceptance.json'
        disposition = 'qualified' if command_status == 0 else 'failed-investigated'
        admission_tool.write(proof, {
            'run': str(run), 'disposition': disposition, 'expected_rc': command_status,
            'outputs': admission_tool.read(run / 'admission.json')['outputs'],
            'evidence': [{'path': str(run / 'build.log'),
                          'sha256': admission_tool.digest(run / 'build.log')}],
        })
        consume = [PYTHON, '-I', '-B', str(checkout / 'tools/host-maintenance/build-admission'),
                   'consume', '--run', str(run), '--evidence', str(proof)]
        return run, trigger, proof, consume

    def targeted_result(self, trigger, wanted):
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            raw = trigger.read_text() if trigger.exists() else ''
            if 'sweep exit' in raw:
                rows = raw.splitlines()
                self.assertEqual(len(rows), 2, raw)
                self.assertIn(f'sweep exit {wanted}', rows[1])
                return json.loads(rows[0])
            time.sleep(0.025)
        self.fail('no targeted sweep terminal result: ' + raw)

    def add_registry(self, name, jobs, queue=None):
        folder = self.home / name
        folder.mkdir()
        (folder / 'lock').touch()
        (folder / 'jobs.json').write_text(json.dumps({'jobs': jobs, 'queued': queue or {}}))

    def cycle_result(self, result, expected):
        self.assertEqual(result.returncode, expected, result.stderr)
        records = [json.loads(line) for line in result.stdout.splitlines()]
        return records[:-1], records[-1]

    def test_install_idempotent_partial_and_timer_invocation(self):
        self.assertFalse(self.installed['activated'])
        self.assertIn('OnCalendar=*:0/15\n', self.timer.read_text())
        self.assertIn('Persistent=true\n', self.timer.read_text())
        self.assertIn('TimeoutStartSec=235s\n', self.service.read_text())
        self.assertIn('SuccessExitStatus=1\n', self.service.read_text())
        originals = {path: path.read_bytes() for path in (self.settings, self.service, self.timer)}
        for path in originals:
            self.assertEqual(stat.S_IMODE(path.stat().st_mode), 0o600)
        self.assertEqual(self.call(self.install_cmd).returncode, 0)
        self.assertEqual({path: path.read_bytes() for path in originals}, originals)

        prior_inode = self.service.stat().st_ino
        self.timer.unlink()
        self.assertEqual(self.call(self.install_cmd).returncode, 0)
        self.assertEqual(self.service.stat().st_ino, prior_inode)
        self.assertEqual({path: path.read_bytes() for path in originals}, originals)

        env = dict(self.env, XDG_CONFIG_HOME='/ignored/new-config', XDG_STATE_HOME='/ignored/new-state')
        records, summary = self.cycle_result(self.call(self.service_argv, env=env), 0)
        self.assertEqual(records[0]['argv'], ['sweep', '--checkout', str(self.canonical)])
        self.assertEqual(summary['known_checkouts'], 1)

    def test_install_conflicts_leave_missing_unit_uncreated(self):
        self.timer.unlink()
        self.service.write_bytes(b'different')
        self.assertEqual(self.call(self.install_cmd).returncode, 2)
        self.assertFalse(self.timer.exists())
        self.assertEqual(self.service.read_bytes(), b'different')
        self.service.unlink()
        self.service.symlink_to(self.settings)
        self.assertEqual(self.call(self.install_cmd).returncode, 2)
        self.assertFalse(self.timer.exists())
        self.assertTrue(self.service.is_symlink())

    def test_cycle_preserves_hold_and_integration_status(self):
        for exit_code in (1, 2):
            self.scenario(exit_code)
            records, summary = self.cycle_result(self.call(self.service_argv), exit_code)
            self.assertEqual(records[0]['status'], exit_code)
            self.assertEqual(summary['attempted'][0]['status'], exit_code)

    def test_periodic_reaches_abandoned_work_without_enrollment(self):
        run = self.base / 'legacy/.build-runs/interrupted'
        run.mkdir(parents=True)
        (run / 'prior-original.log').write_bytes(b'interrupted original\n')
        self.scenario(1, abandoned=str(run))
        self.add_registry('filesystem-registry', {'interrupted': {
            'checkout': str(run.parent.parent), 'volume_device': run.stat().st_dev}})
        records, summary = self.cycle_result(self.call(self.service_argv), 1)
        self.assertEqual(summary['known_checkouts'], 2)
        self.assertEqual(records[-1]['abandoned'], str(run))
        self.assertEqual(records[-1]['argv'][2], str(run.parent.parent))
        self.assertEqual((run / 'prior-original.log').read_bytes(), b'interrupted original\n')
        self.assertFalse((run / 'admission-consumed.json').exists())

    def test_two_registry_rotation_same_volume_and_canonical_engine(self):
        private = [self.base / f'owned producer {index}' for index in range(6)]
        for directory in private:
            directory.mkdir()
        foreign = self.base / 'different device row'
        foreign.mkdir()
        device = self.canonical.stat().st_dev
        row = lambda checkout, dev=device: {'checkout': str(checkout), 'volume_device': dev}
        self.add_registry('canonical-registry',
                          {'one': row(private[0]), 'two': row(private[1]), 'foreign': row(foreign, device + 1)},
                          {'queued': {'scope': {'checkout': str(private[2])}, 'device': device}})
        self.add_registry('filesystem-registry', {str(i): row(p) for i, p in enumerate(private[1:]) if p != private[2]})
        expected = sorted(map(str, [self.canonical, *private]))
        first, summary = self.cycle_result(self.call(self.service_argv), 1)
        self.assertEqual(summary['known_checkouts'], 7)
        self.assertEqual(summary['deferred_count'], 3)
        self.assertIn('Unregistered checkouts', summary['inventory_scope'])
        self.assertEqual([row['argv'][2] for row in first], expected[:4])
        later, _ = self.cycle_result(self.call(self.service_argv), 1)
        self.assertEqual([row['argv'][2] for row in later], expected[4:] + expected[:1])
        self.assertEqual({row['engine'] for row in first + later}, {str(self.engine)})

    def test_terminal_success_and_maintenance_failure_are_independent(self):
        run, trigger, proof, consume = self.new_build(0)
        self.scenario(2)
        raw = proof.read_bytes()
        bad = dict(json.loads(raw), expected_rc=14)
        proof.write_text(json.dumps(bad))
        self.assertEqual(self.call(consume).returncode, 2)
        self.assertFalse(trigger.exists(), 'refused consumption cannot trigger maintenance')
        proof.write_bytes(raw)
        before = (run / 'runner-result.json').read_bytes()
        result = self.call(consume)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(len(result.stdout.splitlines()), 1, result.stdout)
        event = self.targeted_result(trigger, 2)
        self.assertEqual(event['engine'], str(self.engine))
        self.assertEqual(event['registry_state'], 'consumed')
        self.assertEqual(event['original_result'], json.loads(before))
        self.assertEqual((run / 'runner-result.json').read_bytes(), before)
        log = trigger.read_bytes()
        replay = self.call(consume)
        self.assertEqual(replay.returncode, 0, replay.stderr)
        self.assertEqual(trigger.read_bytes(), log)

    def test_consumed_build_failure_stays_failed(self):
        run, trigger, _, consume = self.new_build(37)
        self.scenario(1)
        result = self.call(consume)
        self.assertEqual(result.returncode, 0, result.stderr)
        event = self.targeted_result(trigger, 1)
        self.assertEqual(event['engine'], str(self.engine))
        self.assertEqual(event['original_result']['runner_rc'], 37)
        self.assertEqual((run / 'build.rc').read_text(), '37\n')

    def test_missing_canonical_engine_preserves_consumption(self):
        run, trigger, _, consume = self.new_build(0)
        self.engine.rename(self.engine.with_suffix('.unavailable'))
        result = self.call(consume)
        self.assertEqual(result.returncode, 0, result.stderr)
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            if trigger.exists() and 'FileNotFoundError' not in trigger.read_text():
                if 'build-retention-cycle:' in trigger.read_text():
                    break
            time.sleep(0.025)
        else:
            self.fail('missing engine error was not retained')
        self.assertIn('build-tree-retention', trigger.read_text())
        self.assertTrue((run / 'admission-consumed.json').is_file())

    def test_engine_timeout_uses_finite_process_bound(self):
        cycle = runpy.run_path(str(self.cycle))
        with patch.object(subprocess, 'run', side_effect=subprocess.TimeoutExpired('fixture', 205)) as call:
            with self.assertRaises(subprocess.TimeoutExpired):
                cycle['sweep'](self.canonical, self.state, self.canonical)
        self.assertEqual(call.call_args.kwargs['timeout'], 205)


if __name__ == '__main__':
    unittest.main(verbosity=2)
