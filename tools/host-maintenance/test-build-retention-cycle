        TREE_TESTS['dump'](doc, dict(schema=1, volume=list(selected), observed_epoch=time.time(), entries=[entry]))
        TREE_TESTS['dump'](index, dict(schema=1, sha256=TREE_TESTS['ref'](doc)['sha256']))
