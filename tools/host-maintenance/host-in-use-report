#!/usr/bin/python3 -IBS
"""Redacted in-use snapshot of administrator-enrolled generated build files (#493)."""

from collections import Counter, defaultdict
from contextlib import contextmanager
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import stat
import sys
import time

MANIFEST = Path('/etc/pixelelated/host-in-use.json')
PROC = Path('/proc')
MAX_BATCHES = 16
MAX_FILES = 512
MAX_TASKS = 32768
MAX_FDS = 16384
DEADLINE_SECONDS = 105
MIB = 1024 * 1024
EXIT_STATUS = {'clear': 0, 'busy': 1, 'incomplete': 2}
IDENTITY = ('device', 'inode', 'size', 'mtime_ns', 'ctime_ns', 'allocated_bytes',
            'uid', 'links', 'mode')
MATCH_FIELDS = ('argument', 'descriptor', 'executable', 'mapping', 'bind_mount')
NAMESPACES = ('pid', 'mnt', 'user')
PROJECTED_FS = {b'overlay', b'aufs', b'ecryptfs', b'shiftfs', b'virtiofs', b'9p',
                b'fuse', b'fuseblk', b'nfs', b'nfs4', b'cifs', b'smb3'}
OPEN_FLAGS = os.O_NOFOLLOW | os.O_CLOEXEC


class Incomplete(Exception):
    """A fixed refusal code, suitable for the redacted result."""


def require(condition, code):
    if not condition:
        raise Incomplete(code)


@contextmanager
def refusal(code):
    try:
        yield
    except (OSError, ValueError, TypeError, KeyError, RecursionError, OverflowError):
        raise Incomplete(code) from None


def digest(data):
    return hashlib.sha256(data).hexdigest()


def bounded_read(stream, limit, code):
    data = stream.read(limit + 1)
    require(len(data) <= limit, code)
    return data


def read(path, limit, code):
    with refusal(code), path.open('rb') as stream:
        return bounded_read(stream, limit, code)


def canonical(name, absolute=True):
    require(isinstance(name, str) and len(name) <= 4096 and name.isprintable(), 'manifest_schema')
    path = Path(name)
    require(path.is_absolute() == absolute and str(path) == name and
            path.anchor != '//' and '..' not in path.parts and name not in ('/', '.'), 'manifest_schema')
    return path


@contextmanager
def open_exact(path, final_flags, trusted_owner=None):
    """Walk literal components. Never follow a symlink or read a selected payload."""
    def trusted(fd, kind):
        info = os.fstat(fd)
        require(kind(info.st_mode) and info.st_uid == trusted_owner and not info.st_mode & 0o022,
                'manifest_trust')

    fd = os.open('/', os.O_PATH | os.O_DIRECTORY | OPEN_FLAGS)
    try:
        for component in path.parts[1:-1]:
            if trusted_owner is not None:
                trusted(fd, stat.S_ISDIR)
            next_fd = os.open(component, os.O_PATH | os.O_DIRECTORY | OPEN_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        if trusted_owner is not None:
            trusted(fd, stat.S_ISDIR)
        leaf = os.open(path.name, final_flags | OPEN_FLAGS, dir_fd=fd)
        try:
            if trusted_owner is not None:
                trusted(leaf, stat.S_ISREG)
            yield leaf
        finally:
            os.close(leaf)
    finally:
        os.close(fd)


def file_identity(s):
    return dict(zip(IDENTITY, (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns,
                              s.st_blocks * 512, s.st_uid, s.st_nlink, s.st_mode)))


def load_trusted_manifest(path=MANIFEST, owner=0):
    with refusal('manifest_trust'), open_exact(path, os.O_RDONLY | os.O_NONBLOCK, owner) as leaf:
        with os.fdopen(os.dup(leaf), 'rb') as stream:
            before = file_identity(os.fstat(leaf))
            raw = bounded_read(stream, MIB, 'manifest_limit')
            require(file_identity(os.fstat(leaf)) == before, 'manifest_changed')
            return raw, before


def unique_fields(pairs):
    result = dict(pairs)
    require(len(result) == len(pairs), 'manifest_schema')
    return result


def schema(obj, keys):
    require(isinstance(obj, dict) and obj.keys() == set(keys), 'manifest_schema')


def integer(value, minimum=0):
    return type(value) is int and minimum <= value < 2**64


def read_enrollment(raw):
    with refusal('manifest_schema'):
        enrollment = json.loads(raw, object_pairs_hook=unique_fields)
        schema(enrollment, ('schema', 'enrolled_at', 'expires_at', 'host', 'batches'))
        start, end = enrollment['enrolled_at'], enrollment['expires_at']
        require(type(enrollment['schema']) is int and enrollment['schema'] == 1 and
                integer(start, 1) and integer(end, start + 1), 'manifest_schema')
        host = enrollment['host']
        schema(host, ('boot_id', *NAMESPACES, 'independent_mount_sha256'))
        require(re.fullmatch(r'[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}', host['boot_id']) and
                all(integer(host[name], 1) for name in NAMESPACES), 'manifest_schema')
        approved = host['independent_mount_sha256']
        require(isinstance(approved, list) and len(approved) <= 256 and
                len(set(approved)) == len(approved) and
                all(re.fullmatch(r'[0-9a-f]{64}', key) for key in approved), 'manifest_schema')
        batches = enrollment['batches']
        require(isinstance(batches, list) and 0 < len(batches) <= MAX_BATCHES, 'manifest_schema')
        seen = set()
        total = 0
        for batch in batches:
            schema(batch, ('build_roots', 'files'))
            roots, files = batch['build_roots'], batch['files']
            require(isinstance(roots, list) and 0 < len(roots) <= 16 and
                    isinstance(files, list) and 0 < len(files) <= MAX_FILES, 'manifest_schema')
            roots = [canonical(name) for name in roots]
            require(len(set(roots)) == len(roots) and
                    all(p.name.startswith('build.') for p in roots), 'manifest_schema')
            names = set()
            total += len(files)
            require(total <= MAX_FILES, 'manifest_limit')
            for row in files:
                schema(row, ('path', 'identity', 'aliases'))
                path, identity, aliases = canonical(row['path']), row['identity'], row['aliases']
                schema(identity, IDENTITY)
                require(path not in names and any(root in path.parents for root in roots) and
                        all(integer(value) for value in identity.values()) and
                        stat.S_ISREG(identity['mode']) and identity['links'] > 0, 'manifest_schema')
                require(isinstance(aliases, list) and len(aliases) <= 8, 'manifest_schema')
                for alias in aliases:
                    canonical(alias, absolute=Path(alias).is_absolute())
                require(len(set(aliases)) == len(aliases), 'manifest_schema')
                names.add(path)
            batch['build_roots'].sort()
            batch['files'].sort(key=lambda row: row['path'])
            for row in batch['files']:
                row['aliases'].sort()
            key = digest(json.dumps(batch, sort_keys=True, separators=(',', ':'),
                                    ensure_ascii=True).encode('ascii'))
            require(key not in seen, 'manifest_schema')
            seen.add(key)
            batch['selection_sha256'] = key
        return enrollment


def unescape_mount(value):
    return os.fsdecode(re.sub(rb'\\([0-7]{3})', lambda m: bytes([int(m[1], 8)]), value))


def mounts(data):
    result = []
    seen = set()
    with refusal('mountinfo_incomplete'):
        for line in data.splitlines():
            before, sep, after = line.partition(b' - ')
            fields = before.split()
            kind, _, options = after.split()
            require(sep and len(fields) >= 6, 'mountinfo_incomplete')
            mount_id = int(fields[0])
            require(mount_id > 0 and mount_id not in seen and int(fields[1]) > 0, 'mountinfo_incomplete')
            seen.add(mount_id)
            major, minor = (int(n) for n in fields[2].split(b':'))
            root, point = (Path(unescape_mount(value)) for value in fields[3:5])
            require(root.is_absolute() and point.is_absolute() and '..' not in root.parts and
                    '..' not in point.parts, 'mountinfo_incomplete')
            result.append((os.makedev(major, minor), root, point, kind,
                           frozenset(fields[5].split(b',') + options.split(b',')), line))
    require(result, 'mountinfo_incomplete')
    return result


def host_mounts(proc, host, require_ptrace):
    with refusal('host_namespace'):
        for name in NAMESPACES:
            ids = [(proc / task / 'ns' / name).stat().st_ino for task in ('self', '1')]
            require(ids == [host[name]] * 2, 'host_namespace')
    boot_id = read(proc / 'sys/kernel/random/boot_id', 128, 'host_boot')
    require(boot_id.strip() == host['boot_id'].encode('ascii'), 'host_boot')
    if require_ptrace:
        status = read(proc / 'self/status', 65536, 'host_capability')
        caps = re.findall(rb'^CapEff:\s*([0-9a-f]+)$', status, re.MULTILINE)
        require(len(caps) == 1 and int(caps[0], 16) & (1 << 19), 'host_capability')
    raw = read(proc / 'self/mountinfo', 4 * MIB, 'host_procfs')
    table = mounts(raw)
    rows = [m for m in table if m[2] == Path('/proc')]
    with refusal('host_procfs'):
        require(len(rows) == 1 and rows[0][0] == proc.stat().st_dev and
                rows[0][1] == Path('/') and rows[0][3] == b'proc', 'host_procfs')
    require(not any(o.startswith(b'subset=') or o.startswith(b'pidns=') or
                    (o.startswith(b'hidepid=') and o not in (b'hidepid=0', b'hidepid=off'))
                    for o in rows[0][4]), 'host_procfs')
    for _, _, point, _, _, _ in table:
        if Path('/proc') in point.parents:
            head = point.parts[2]
            require(head not in ('self', 'thread-self') and not head.isdecimal(), 'host_procfs')
    return table


def mount_key(path, device, table):
    rows = [m for m in table if m[2] == path or m[2] in path.parents]
    require(rows, 'selected_mount')
    depth = max(len(row[2].parts) for row in rows)
    rows = [row for row in rows if len(row[2].parts) == depth]
    require(len(rows) == 1 and rows[0][0] == device and rows[0][3] == b'ext4', 'selected_mount')
    _, root, point, _, _, _ = rows[0]
    return device, root / path.relative_to(point)


def validate_selection(batch, table):
    observed = []
    for row in batch['files']:
        path = Path(row['path'])
        with refusal('selected_identity'), open_exact(path, os.O_PATH) as leaf:
            live = file_identity(os.fstat(leaf))
            require(live == row['identity'], 'selected_identity')
        inode = (live['device'], live['inode'])
        require(stat.S_ISREG(live['mode']), 'selected_identity')
        observed.append((inode, mount_key(path, inode[0], table)))
    return observed


def numbers(path, limit, code, strict=False):
    result = set()
    with refusal(code), os.scandir(path) as entries:
        for entry in entries:
            if entry.name.isascii() and entry.name.isdecimal():
                number = int(entry.name)
                require(str(number) == entry.name, code)
                result.add(number)
                require(len(result) <= limit, code)
            else:
                require(not strict, code)
    return result


def task_state(path):
    raw = read(path / 'stat', 65536, 'task_identity')
    pid, sep, tail = raw.rpartition(b')')
    fields = tail.split()
    require(sep and pid.split(b' (', 1)[0] == os.fsencode(path.name) and
            len(fields) >= 20 and fields[19].isdigit(), 'task_identity')
    data = read(path / 'status', 65536, 'task_identity')
    kinds = re.findall(rb'^Kthread:\s*([01])$', data, re.MULTILINE)
    require(len(kinds) == 1, 'task_identity')
    inactive = kinds[0] == b'1' or fields[0] in (b'Z', b'X', b'x')
    if inactive:
        return int(fields[19]), True, ()
    with refusal('task_namespace'):
        return int(fields[19]), False, tuple((path / 'ns' / name).stat().st_ino for name in NAMESPACES)


def inventory(proc, own_pid):
    tasks = {}
    pids = numbers(proc, MAX_TASKS, 'task_inventory')
    require(1 in pids, 'task_inventory')
    for pid in sorted(pids - {own_pid}):
        group = proc / str(pid) / 'task'
        tids = numbers(group, MAX_TASKS, 'task_inventory', strict=True)
        require(pid in tids and len(tasks) + len(tids) <= MAX_TASKS, 'task_inventory')
        for tid in sorted(tids):
            path = group / str(tid)
            tasks[path] = task_state(path)
    return tasks


def maps_hits(raw, inodes, match_name):
    hits = set()
    previous_end = 0
    with refusal('maps_incomplete'):
        for line in raw.splitlines():
            fields = line.split(None, 5)
            require(len(fields) >= 5, 'maps_incomplete')
            begin, end = (int(n, 16) for n in fields[0].split(b'-'))
            require(previous_end <= begin < end and re.fullmatch(rb'[r-][w-][x-][ps]', fields[1]) and
                    int(fields[2], 16) >= 0, 'maps_incomplete')
            previous_end = end
            major, minor = (int(n, 16) for n in fields[3].split(b':'))
            inode = int(fields[4])
            require(inode >= 0, 'maps_incomplete')
            hits.update(inodes.get((os.makedev(major, minor), inode), ()))
            if len(fields) == 6:
                hits.update(match_name(fields[5]))
    return hits


class References:
    def __init__(self, batches, independent_mounts):
        self.inodes = defaultdict(set)
        self.mount_keys = defaultdict(set)
        self.names = defaultdict(set)
        for index, (batch, selected) in batches.items():
            for row, (inode, mount) in zip(batch['files'], selected):
                self.inodes[inode].add(index)
                self.mount_keys[mount].add(index)
                for name in (row['path'], *row['aliases']):
                    self.names[os.fsencode(name)].add(index)
        names = b'|'.join(re.escape(n) for n in sorted(self.names, key=len, reverse=True))
        self.pattern = re.compile(rb"""(?:^|(?<=[=,:"'\s]))(""" + names + rb""")(?=$|[\s,:"'])""")
        self.views = {}
        self.independent_mounts = frozenset(independent_mounts)

    def match_name(self, value):
        return {index for match in self.pattern.finditer(value) for index in self.names[match[1]]}

    def match_path(self, value):
        return self.names.get(value.removesuffix(b' (deleted)'), set())

    def view(self, task, ns):
        raw = read(task / 'mountinfo', 4 * MIB, 'mountinfo_incomplete')
        key = (ns, digest(raw))
        if key not in self.views:
            require(len(self.views) < MAX_TASKS, 'mountinfo_incomplete')
            hits = set()
            for device, root, _, kind, _, record in mounts(raw):
                if kind in PROJECTED_FS or kind.startswith(b'fuse.'):
                    key_hash = digest(str(ns).encode('ascii') + b'\n' + record)
                    require(key_hash in self.independent_mounts, 'mount_projection')
                hits.update(self.mount_keys.get((device, root), ()))
            self.views[key] = hits
        return key, self.views[key]

    def link(self, path, code):
        with refusal(code):
            before = path.stat()
            value = os.fsencode(os.readlink(path))
            info = path.stat()
        inode = info.st_dev, info.st_ino
        require(inode == (before.st_dev, before.st_ino), 'link_changed')
        return self.match_path(value) | self.inodes.get(inode, set())

    def inspect(self, task, before):
        ns = before[2][1]
        view_key, mounted = self.view(task, ns)
        hits = {'bind_mount': mounted, 'executable': self.link(task / 'exe', 'task_links')}
        for name in ('cwd', 'root'):
            self.link(task / name, 'task_links')
        cmdline = read(task / 'cmdline', 4 * MIB, 'cmdline_incomplete')
        hits['argument'] = {i for arg in cmdline.split(b'\0') for i in self.match_name(arg)}
        fds = numbers(task / 'fd', MAX_FDS, 'fd_incomplete', strict=True)
        hits['descriptor'] = set()
        for fd in fds:
            hits['descriptor'].update(self.link(task / 'fd' / str(fd), 'fd_incomplete'))
        require(fds == numbers(task / 'fd', MAX_FDS, 'fd_incomplete', strict=True), 'fd_changed')
        ranges = read(task / 'maps', 16 * MIB, 'maps_incomplete')
        # A live userspace task with an executable must have an mm.
        require(ranges and ranges.endswith(b'\n'), 'maps_incomplete')
        hits['mapping'] = maps_hits(ranges, self.inodes, self.match_path)
        require(read(task / 'maps', 16 * MIB, 'maps_incomplete') == ranges, 'maps_changed')
        require(task_state(task) == before, 'task_changed')
        require(self.view(task, ns)[0] == view_key, 'mountinfo_changed')
        return hits


def check_window(enrollment, start, now):
    require(enrollment['enrolled_at'] * 10**9 <= start <= now <
            enrollment['expires_at'] * 10**9, 'manifest_stale')


def scan(report, enrollment, proc, own_pid, require_ptrace):
    table = host_mounts(proc, enrollment['host'], require_ptrace)
    valid = {}
    for i, batch in enumerate(enrollment['batches']):
        try:
            valid[i] = (batch, validate_selection(batch, table))
        except Incomplete as e:
            report['batches'][i]['reason'] = str(e)
    require(valid, 'no_valid_batches')
    refs = References(valid, enrollment['host']['independent_mount_sha256'])
    tasks = inventory(proc, own_pid)
    matches = defaultdict(Counter)
    for task, state in tasks.items():
        if state[1]:
            continue
        for kind, indexes in refs.inspect(task, state).items():
            for i in indexes:
                matches[i][kind] += 1
        report['tasks_scanned'] += 1
    report['mount_views_scanned'] = len(refs.views)
    require(report['tasks_scanned'] > 0, 'task_inventory')
    require(inventory(proc, own_pid) == tasks, 'task_inventory_changed')
    require(host_mounts(proc, enrollment['host'], require_ptrace) == table, 'host_mounts_changed')
    for i, (batch, selected) in valid.items():
        row = report['batches'][i]
        try:
            require(validate_selection(batch, table) == selected, 'selected_identity')
        except Incomplete as e:
            row['reason'] = str(e)
            continue
        row['matches'] = {field: matches[i][field] for field in MATCH_FIELDS}
        row['status'] = 'busy' if any(row['matches'].values()) else 'clear'


def produce(load=load_trusted_manifest, proc=PROC, own_pid=None, require_ptrace=True, clock=time.time_ns):
    start = clock()
    report = dict(schema=1, status='incomplete', scan_complete=False, manifest_sha256=None,
                  started_at_ns=start, finished_at_ns=start, expires_at=None, reason=None,
                  tasks_scanned=0, mount_views_scanned=0, batches=[])
    try:
        raw, sealed_identity = load()
        report['manifest_sha256'] = digest(raw)
        enrollment = read_enrollment(raw)
        report['expires_at'] = enrollment['expires_at']
        for batch in enrollment['batches']:
            report['batches'].append(dict(selection_sha256=batch['selection_sha256'],
                                          files=len(batch['files']), status='incomplete',
                                          reason=None, matches=None))
        check_window(enrollment, start, clock())
        scan(report, enrollment, proc, os.getpid() if own_pid is None else own_pid, require_ptrace)
        require(load() == (raw, sealed_identity), 'manifest_changed')
        report['finished_at_ns'] = clock()
        check_window(enrollment, start, report['finished_at_ns'])
        report['scan_complete'] = True
        report['status'] = max((r['status'] for r in report['batches']), key=EXIT_STATUS.__getitem__)
    except Incomplete as e:
        report['reason'] = str(e)
        report['finished_at_ns'] = clock()
        for row in report['batches']:
            row.update(status='incomplete', reason=row['reason'] or report['reason'], matches=None)
    return report


def deadline(_signum, _frame):
    raise Incomplete('deadline')


def main():
    if (len(sys.argv) != 1 or not (sys.flags.isolated and sys.flags.dont_write_bytecode and sys.flags.no_site)
            or os.getuid() != 0 or os.geteuid() != 0):
        return EXIT_STATUS['incomplete']
    # A caller saving a report must open their file outside the privileged process.
    if not (os.isatty(1) or stat.S_ISFIFO(os.fstat(1).st_mode)):
        return EXIT_STATUS['incomplete']
    signal.signal(signal.SIGALRM, deadline)
    signal.setitimer(signal.ITIMER_REAL, DEADLINE_SECONDS)
    try:
        report = produce()
        data = (json.dumps(report, sort_keys=True, separators=(',', ':')) + '\n').encode('ascii')
        require(os.write(1, data) == len(data), 'output_incomplete')
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
    return EXIT_STATUS[report['status']]


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (Incomplete, OSError, MemoryError):
        sys.exit(EXIT_STATUS['incomplete'])
