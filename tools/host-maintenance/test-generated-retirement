    def test_prepared_queue_blocks_then_retry_after_expiry(self):
        self.prepare()
        self.m.prepare(self.plan_path, self.root / 'queued.json')
        self.assert_held('registered owner')
        queued = self.m.read(self.root / 'queued.json')
        with self.m.registry(self.registry) as jobs:
            self.assertIn(queued['id'], jobs['queued'])
            jobs['queued'][queued['id']]['expires'] = time.time() - 1
        result = self.consume()
        self.assertEqual(result['status'], 'retired', result.get('last_hold'))
        self.assertIn('registered owner', result['first_hold'])

