    def test_interruption_after_unlink_and_safe_partial_retry(self):
        self.prepare(count=3)
        expected = [p.stat().st_blocks * 512 for p in self.paths]
        real_unlink = os.unlink
        attempts = []

        class Interrupted(BaseException):
            pass

        def unlink(path, **kwargs):
            real_unlink(path, **kwargs)
            if path == 'cmake_pch.hxx.gch':
                attempts.append(path)
                if len(attempts) == 2:
                    raise Interrupted()

        with patch.object(self.m.os, 'unlink', side_effect=unlink):
            with self.assertRaises(Interrupted):
                self.consume()
        journal = self.m.read(self.run / 'retirement.json')
        self.assertEqual([journal['files_progress'][str(p)]['state'] for p in self.paths],
                         ['retired', 'intent', 'pending'])
        self.assertFalse(self.paths[0].exists())
        self.assertFalse(self.paths[1].exists())
        self.assertTrue(self.paths[2].exists())
        result = self.consume()
        self.assertEqual(result['status'], 'partial')
        self.assertEqual(result['deleted_bytes'], expected[0] + expected[2])
        self.assertEqual(result['unconfirmed_bytes'], expected[1])
        self.assertEqual(result['held_bytes'], 0)
        self.assertEqual(self.consume(), result)
        self.assertEqual(self.samples, 2)

    def test_restart_after_durable_success_before_summary(self):
        self.prepare()
        persist = self.m.durable
        before = self.paths[0].stat().st_blocks * 512

        class Interrupted(BaseException):
            pass

        armed = True

        def stop_after_progress(path, contents):
            nonlocal armed
            persist(path, contents)
            if armed and path.name == 'retirement.json' and contents['files_progress'][str(self.paths[0])]['state'] == 'retired':
                armed = False
                raise Interrupted()

        with patch.object(self.m, 'durable', side_effect=stop_after_progress), self.assertRaises(Interrupted):
            self.consume()
        self.assertEqual(self.consume()['deleted_bytes'], before)
        self.assertEqual(self.samples, 1)


