# The image step's bootloader installer, sourced by scripts/image:280
# for the three loaders the devices use; any other BOOTLOADER is refused.

echo "install: building ROCKNIX bootloader for ${DEVICE} (${BOOTLOADER}) ..."

# scripts/image sources this file and runs without set -e, so a failure
# here must exit: a non-zero return would be ignored and the image built
# without its loader files (#1090).

# Ensure the bootloader directory exists
mkdir -p "${INSTALL}/usr/share/bootloader" || exit 1

# Handle different bootloader types
case "${BOOTLOADER}" in
  syslinux)
    echo "install: installing syslinux bootloader files"
    if [ ! -d "${INSTALL}/usr/share/syslinux" ]; then
      echo "install: error - syslinux files not found in ${INSTALL}/usr/share/syslinux (syslinux:target was not installed)" >&2
      exit 1
    fi
    echo "install: copying syslinux files to bootloader location"
    cp -av "${INSTALL}/usr/share/syslinux"/* "${INSTALL}/usr/share/bootloader/" || exit 1
    ;;
    
  u-boot)
    echo "install: u-boot bootloader should be handled by device-specific bootloader scripts"
    echo "install: skipping generic bootloader installation for u-boot"
    ;;
    
  qcom-abl|arm-efi)
    # Nothing to copy here: the device's own packages stage these loaders
    # under /usr/share/bootloader (rocknix-abl's rocknix_abl/; for arm-efi,
    # the kernel's device trees and the grub package's EFI/BOOT), scripts/mkimage generates the boot
    # configuration, and projects/ROCKNIX/bootloader/mkimage's mkimage_abl()
    # copies rocknix_abl onto the boot partition at image time. release then
    # carries the staged files into the release directory.
    echo "install: ${BOOTLOADER} is written into the boot partition at image time"
    echo "install: skipping generic bootloader installation for ${BOOTLOADER}"
    ;;
    
  *)
    # The devices set syslinux, u-boot or qcom-abl (projects/ROCKNIX/devices/*/options);
    # any other value has no branch here, so refuse it rather than copy
    # nothing and report success (#658, PL-06).
    echo "install: error - unknown BOOTLOADER '${BOOTLOADER}': this script handles syslinux, u-boot and qcom-abl|arm-efi" >&2
    exit 1
    ;;
esac

echo "install: ROCKNIX bootloader installation completed for ${BOOTLOADER}"
