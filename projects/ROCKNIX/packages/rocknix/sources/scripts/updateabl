#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2024-present ROCKNIX (https://github.com/ROCKNIX)
#
# This script will update the ABL on the internal eMMC/UFS.

. $SYSTEM_ROOT/etc/os-release

case "$HW_DEVICE" in
  SM4450|SM6115|SM8250|SM8550|SM8650|SM8750)
    ;;
  *)
    echo "This script is not compatible with this device!"
    exit 1
    ;;
esac

# ---- Paths ----
ELF="$SYSTEM_ROOT/usr/share/bootloader/rocknix_abl/abl_signed-${HW_DEVICE}.elf"
TMP_ABL_A="/tmp/current_abl_a.bin"
TMP_ABL_B="/tmp/current_abl_b.bin"

# ---- Sanity checks ----
if [ ! -f "${ELF}" ]; then
  echo "Error: ABL update not found"
  exit 1
fi

$SYSTEM_ROOT/usr/sbin/partprobe

# The slots, found by their labels. UPDATEABL_ABL_A and UPDATEABL_ABL_B name
# them instead, for a test against two loop files, and a path given that way
# may be a regular file (#703).
ABL_A="${UPDATEABL_ABL_A:-$($SYSTEM_ROOT/usr/sbin/blkid -t PARTLABEL=abl_a -o device)}"
ABL_B="${UPDATEABL_ABL_B:-$($SYSTEM_ROOT/usr/sbin/blkid -t PARTLABEL=abl_b -o device)}"
slot_ok() { [ -b "${1}" ] || { [ -n "${2}" ] && [ -f "${1}" ]; }; }
if ! slot_ok "${ABL_A}" "${UPDATEABL_ABL_A}" || ! slot_ok "${ABL_B}" "${UPDATEABL_ABL_B}"; then
  echo "Error: ABL partitions not found"
  exit 1
fi

# ---- Get sector size ----
SS="$($SYSTEM_ROOT/usr/sbin/blockdev --getss "${ABL_A}")"
[ -z "${SS}" ] && echo "Error: failed to get sector size" && exit 1


# ---- Determine how many sectors to read ----
ELF_SIZE=$($SYSTEM_ROOT/usr/bin/stat -c%s "${ELF}")
COUNT=$(( (ELF_SIZE + SS - 1) / SS ))

# ---- Read current ABLs ----
echo "Reading ${COUNT} sectors from ABL_A..."
dd if="${ABL_A}" of="${TMP_ABL_A}" bs="${SS}" count="${COUNT}" status=none

echo "Reading ${COUNT} sectors from ABL_B..."
dd if="${ABL_B}" of="${TMP_ABL_B}" bs="${SS}" count="${COUNT}" status=none

# ---- Calculate checksums ----
SUM_A="$($SYSTEM_ROOT/usr/bin/sha256sum "${TMP_ABL_A}" | awk '{print $1}')"
SUM_B="$($SYSTEM_ROOT/usr/bin/sha256sum "${TMP_ABL_B}" | awk '{print $1}')"
SUM_UPDATE="$($SYSTEM_ROOT/usr/bin/sha256sum "${ELF}" | awk '{print $1}')"

echo "Checksum abl_a: ${SUM_A:0:7}"
echo "Checksum abl_b: ${SUM_B:0:7}"
echo "Checksum update: ${SUM_UPDATE:0:7}"

# ---- Compare ----
if [ "${SUM_A}" = "${SUM_UPDATE}" ] && [ "${SUM_B}" = "${SUM_UPDATE}" ]; then
    echo "ABL_A and ABL_B match update version — skipping flash."
    exit 0
fi

echo "Checksums differ — flashing ABL partitions..."

# ---- Flash ----
# One slot at a time, each read back against the update before the next is
# touched: a write that failed or landed short on abl_a was followed by the
# same write to abl_b, so both slots could be bad under the success line
# (#703). The read-back takes the ELF's own length, so it holds for an ELF
# that is not a whole number of sectors; it reads through the page cache, so
# it proves the write, not the flash.
write_slot() {
  dd if="${ELF}" of="${1}" bs="${SS}" conv=fsync,notrunc status=none || return 1
  [ "$(dd if="${1}" bs="${SS}" count="${COUNT}" status=none | head -c "${ELF_SIZE}" | $SYSTEM_ROOT/usr/bin/sha256sum | awk '{print $1}')" = "${SUM_UPDATE}" ]
}

if ! write_slot "${ABL_A}"; then
  echo "Error: abl_a did not take the update; abl_b was not touched"
  exit 1
fi
if ! write_slot "${ABL_B}"; then
  echo "Error: abl_b did not take the update; abl_a holds it"
  exit 1
fi

sync

echo "ABL update completed successfully..."
