# Source minimal predefined functions and variables
# to ensure as much performance as possible.
. /etc/profile.d/001-functions

VOLUME=$(get_setting "audio.volume")
MAX_VOLUME=100
MIN_VOLUME=0
STEP=5

case ${1} in
  "+"|"up")
    VOLUME=$(( ${VOLUME} + ${STEP} ))
  ;;
  "-"|"down")
    VOLUME=$(( ${VOLUME} - ${STEP} ))
  ;;
  "restore")
    true
  ;;
  *)
    VOLUME=${1}
  ;;
esac

# An unset or unreadable volume is the default 50, before it is compared:
# empty, it made the test below an arithmetic error that read as false, and
# 50 came only from a third branch, with an error line per call (#753).
# bash, for (( )) (the shebang said sh).
[[ "${VOLUME}" =~ ^-?[0-9]+$ ]] || VOLUME=50

if (( ${VOLUME} < ${MIN_VOLUME} ))
then
  VOLUME=${MIN_VOLUME}
elif (( ${VOLUME} > ${MAX_VOLUME} ))
then
  VOLUME=${MAX_VOLUME}
fi

pactl -- set-sink-volume @DEFAULT_SINK@ ${VOLUME}%
set_setting "audio.volume" ${VOLUME}