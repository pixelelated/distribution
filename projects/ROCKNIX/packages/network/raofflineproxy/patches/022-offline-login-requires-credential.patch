diff --git a/linux/tests/test_linux_offline_login.py b/linux/tests/test_linux_offline_login.py
new file mode 100644
index 0000000..0eaf4ba
--- /dev/null
+++ b/linux/tests/test_linux_offline_login.py
@@ -0,0 +1,174 @@
+"""ROCKNIX (fork, pixelelated#666 PL-01, bug #1157): the offline login answers
+only the configured account's credential.
+
+Every value below is a short synthetic word assembled when the case runs, so
+the file at rest carries nothing a secret scanner would match.
+"""
+
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+from linux.raofflineproxy import cache_keys
+from linux.raofflineproxy import proxy_service
+from linux.raofflineproxy import storage
+
+ACCOUNT = "t19player"
+OTHER = "t19other"
+
+
+def _word(*parts: str) -> str:
+    return "".join(parts)
+
+
+TOKEN = _word("syn", "tok", "one")
+OTHER_TOKEN = _word("syn", "tok", "two")
+PASSWORD = _word("syn", "pw", "one")
+LOOPBACK = {"Host": "127.0.0.1:8080"}
+
+
+def _login_body(user: str, token: str) -> str:
+    return json.dumps({"Success": True, "User": user, "Token": token, "Score": 7})
+
+
+class OfflineLoginTests(unittest.TestCase):
+    def setUp(self) -> None:
+        # Each case starts as a fresh process would: nothing said yet.
+        proxy_service._UNRECORDED_HASH_SAID = False
+        self._dir = tempfile.TemporaryDirectory()
+        root = Path(self._dir.name)
+        system_cfg = root / "system.cfg"
+        system_cfg.write_text(
+            "global.retroachievements.username=" + ACCOUNT + "\n"
+            + "global.retroachievements." + "token=" + TOKEN + "\n"
+        )
+        self.store = storage.Storage(database_path=root / "test.sqlite3")
+        self.runtime = object.__new__(proxy_service.ProxyRuntimeServer)
+        self.runtime.storage = self.store
+        self.runtime.config_data = {
+            "rocknix_system_cfg": str(system_cfg),
+            "retroarch_cfg": str(root / "absent-retroarch.cfg"),
+        }
+        self.runtime.activity = proxy_service.GameActivityTracker()
+        self.runtime.is_online = lambda: False
+        self.upstream = ("error", 0, "", b"", "", None)
+        self.runtime.forward_to_upstream_result = lambda *args, **kwargs: self.upstream
+        self.store.upsert_cache(cache_keys.login(ACCOUNT), _login_body(ACCOUNT, TOKEN))
+        self.store.upsert_cache(cache_keys.login(OTHER), _login_body(OTHER, OTHER_TOKEN))
+
+    def tearDown(self) -> None:
+        self.store.close()
+        self._dir.cleanup()
+
+    def _login(self, query: str, headers: dict | None = None) -> tuple[int, dict, bytes]:
+        response = self.runtime.process_proxy_request(
+            "GET", "/dorequest.php?r=login2&" + query, "",
+            dict(LOOPBACK if headers is None else headers),
+        )
+        head, _, body = response.partition(b"\r\n\r\n")
+        status = int(head.split(b" ", 2)[1])
+        try:
+            payload = json.loads(body.decode("utf-8"))
+        except ValueError:
+            payload = {}
+        return status, payload, head
+
+    def assertRefused(self, status: int, payload: dict, head: bytes) -> None:
+        self.assertNotEqual(status, 200)
+        self.assertIs(payload.get("Success"), False)
+        self.assertNotIn("Token", payload)
+        self.assertNotIn(b"X-RA-Offline", head)
+
+    def assertAnswered(self, status: int, payload: dict, head: bytes, token: str) -> None:
+        self.assertEqual(status, 200)
+        self.assertIs(payload.get("Success"), True)
+        self.assertEqual(payload.get("Token"), token)
+        self.assertIn(b"X-RA-Offline", head)
+
+    def _record_password_online(self, password: str, accepted: bool = True) -> None:
+        body = _login_body(ACCOUNT, TOKEN) if accepted else json.dumps(
+            {"Success": False, "Error": "Invalid User/Password combination."}
+        )
+        status = 200 if accepted else 401
+        self.upstream = ("success" if accepted else "http_error", status, "OK",
+                         body.encode("utf-8"), "application/json", body)
+        self._login("u=" + ACCOUNT + "&p=" + password)
+        self.upstream = ("error", 0, "", b"", "", None)
+
+    def test_no_credential_is_refused(self) -> None:
+        self.assertRefused(*self._login("u=" + ACCOUNT))
+
+    def test_wrong_token_is_refused(self) -> None:
+        self.assertRefused(*self._login("u=" + ACCOUNT + "&t=" + OTHER_TOKEN))
+
+    def test_cached_token_is_answered(self) -> None:
+        self.assertAnswered(*self._login("u=" + ACCOUNT + "&t=" + TOKEN), TOKEN)
+
+    def test_password_with_no_recorded_hash_is_answered(self) -> None:
+        # Until an online login records the hash (pixelelated#1157): the
+        # upgrade path, where RetroArch signs in with the password and the
+        # store's row predates the column.
+        self.assertAnswered(*self._login("u=" + ACCOUNT + "&p=" + PASSWORD), TOKEN)
+
+    def test_unrecorded_hash_is_said_once(self) -> None:
+        with self.assertLogs("raofflineproxy", level="INFO") as logs:
+            self._login("u=" + ACCOUNT + "&p=" + PASSWORD)
+            self._login("u=" + ACCOUNT + "&p=" + PASSWORD)
+        said = [m for m in logs.output if "no password hash recorded" in m]
+        self.assertEqual(len(said), 1, logs.output)
+
+    def test_password_with_no_recorded_hash_is_refused_otherwise(self) -> None:
+        self.assertRefused(*self._login("u=" + OTHER + "&p=" + PASSWORD))
+        self.assertRefused(*self._login(
+            "u=" + ACCOUNT + "&p=" + PASSWORD, {"Host": "rebind.example:8080"}
+        ))
+        self.assertRefused(*self._login(
+            "u=" + ACCOUNT + "&p=" + PASSWORD,
+            {"Host": "127.0.0.1:8080", "Origin": "http://rebind.example"},
+        ))
+
+    def test_password_recorded_online_is_answered(self) -> None:
+        self._record_password_online(PASSWORD)
+        self.assertAnswered(*self._login("u=" + ACCOUNT + "&p=" + PASSWORD), TOKEN)
+
+    def test_wrong_password_after_recording_is_refused(self) -> None:
+        self._record_password_online(PASSWORD)
+        self.assertRefused(*self._login("u=" + ACCOUNT + "&p=" + _word("syn", "pw", "bad")))
+
+    def test_failed_online_login_records_nothing(self) -> None:
+        self._record_password_online(PASSWORD, accepted=False)
+        self.assertIsNone(self.store.get_credential_hash(cache_keys.login(ACCOUNT)))
+
+    def test_recorded_hash_is_not_the_password(self) -> None:
+        self._record_password_online(PASSWORD)
+        dump = "\n".join(self.store._connection.iterdump())
+        self.assertNotIn(PASSWORD, dump)
+
+    def test_another_account_is_refused_even_with_its_token(self) -> None:
+        self.assertRefused(*self._login("u=" + OTHER + "&t=" + OTHER_TOKEN))
+
+    def test_foreign_host_is_refused(self) -> None:
+        self.assertRefused(*self._login(
+            "u=" + ACCOUNT + "&t=" + TOKEN, {"Host": "rebind.example:8080"}
+        ))
+
+    def test_missing_host_is_refused(self) -> None:
+        self.assertRefused(*self._login("u=" + ACCOUNT + "&t=" + TOKEN, {}))
+
+    def test_any_origin_is_refused(self) -> None:
+        self.assertRefused(*self._login(
+            "u=" + ACCOUNT + "&t=" + TOKEN,
+            {"Host": "127.0.0.1:8080", "Origin": "http://127.0.0.1:8080"},
+        ))
+
+    def test_loopback_names_are_accepted(self) -> None:
+        for host in ("127.0.0.1", "127.0.0.1:8080", "localhost:8080", "[::1]:8080"):
+            with self.subTest(host=host):
+                self.assertAnswered(*self._login(
+                    "u=" + ACCOUNT + "&t=" + TOKEN, {"Host": host}
+                ), TOKEN)
+
+
+if __name__ == "__main__":
+    unittest.main()
