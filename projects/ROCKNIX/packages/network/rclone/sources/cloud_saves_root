# cloud_saves_root - which card the saves folder is on, and whether that
# changed since saves were last synced.
#
# On a device with two microSD cards the second one is bound over
# /storage/roms by the automount script, which first unmounts whatever is
# there. For a moment at every boot -- and the interface starts in that
# same moment -- /storage/roms is the internal card. A saves transfer that
# begins then writes a whole tree onto the wrong card, and a stale copy on
# whichever card is mounted later reads as this device's newest save.
# Seen on an RG SP on 2026-09-08: 101 files on the internal card written
# by boot restores, with both cards in the device the whole time (fork
# #83, D-CLOUD-054).
#
# So the filesystem under SAVESPATH is remembered when saves are synced,
# a transfer waits a little for the usual card to come back before it
# refuses, and it refuses to record a run during which the card changed.
#
#   cloud_saves_root identity            print the identity of the filesystem under SAVESPATH
#   cloud_saves_root check [--wait N]    exit 0 and print the identity when it matches the
#                                        record (or there is none), waiting up to N seconds
#                                        for a mismatch to clear; exit 1 with the reason on
#                                        stdout when it does not
#   cloud_saves_root record [IDENTITY] [--no-write]
#                                        remember the current identity after a successful
#                                        sync; with IDENTITY (the one check printed before
#                                        the transfer), refuse with exit 1 when the folder
#                                        is on a different card now. --no-write compares
#                                        and records nothing: what a transfer that failed
#                                        asks, so a card change still names itself
#                                        without a failed run becoming the record. A
#                                        record that cannot be written is exit 1 too.
#   cloud_saves_root accept              the owner says the current card is right: remember it
#
# The identity is the filesystem UUID of the card SAVESPATH resolves to, from
# blkid; where there is none, the device number, which is this boot's and so
# is compared within a run but never recorded (PL-18). The record lives under
# /storage/.cache, which is always the internal card, so it is the same
# file whichever card /storage/roms is on -- that is the point.

RECORD="/storage/.cache/cloud_sync/saves-root"
CONF="/storage/.config/cloud_sync.conf"

# The value a sourced cloud_sync.conf gives a key, read without sourcing it
# (#1301): the last assignment wins, as it does for source; a double-quoted,
# single-quoted or plain value, each with a trailing comment allowed --
# conf_valid's grammar. Prints nothing when the key is absent. The same
# function in cloud_saves_root and cloud_capture.
conf_value() {
    awk -v k="$1" '
        index($0, k "=") == 1 {
            v = substr($0, length(k) + 2); q = substr(v, 1, 1)
            if (q == "\"" || q == "\047") { v = substr(v, 2); i = index(v, q); if (i) v = substr(v, 1, i - 1) }
            else sub(/[ \t].*$/, "", v)
            last = v; seen = 1
        }
        END { if (seen) print last }' "${CONF}" 2>/dev/null
}

# The saves folder: the one the calling script sourced, when it hands it over
# (CLOUD_SAVESPATH: cloud_backup and cloud_restore do), else the conf's
# SAVESPATH as the twins would read it; BACKUPPATH only when SAVESPATH is
# absent (a conf cloud_sync_helper has not migrated yet); else the default.
saves_path() {
    local p
    if [ -n "${CLOUD_SAVESPATH:-}" ]; then
        p="${CLOUD_SAVESPATH}"
    elif grep -q '^SAVESPATH=' "${CONF}" 2>/dev/null; then
        p=$(conf_value SAVESPATH)
    else
        p=$(conf_value BACKUPPATH)
    fi
    echo "${p:-/storage/roms}"
}

# The card is the filesystem the saves folder resolves to: stat's device
# number, found by its major and minor in mountinfo (the third field; the
# source device two fields after the "-"). Never a path prefix, which read a
# symlinked folder as the card the link sits on (PL-18). The bind of the
# second card over /storage/roms is what stat sees, so it needs no ordering.
# uuid:<UUID> when that device has one, else dev:<N>. Nothing at all when the
# folder cannot be read: no identity is never a pass and never a record.
identity() {
    local real d maj min src uuid=""
    real=$(readlink -f "$(saves_path)" 2>/dev/null)
    [ -n "${real}" ] || return 0
    d=$(stat -c %d "${real}" 2>/dev/null)
    case "${d}" in ''|*[!0-9]*) return 0 ;; esac
    maj=$(( ((d >> 8) & 0xfff) | ((d >> 32) & ~0xfff) ))
    min=$(( (d & 0xff) | ((d >> 12) & ~0xff) ))
    src=$(awk -v mm="${maj}:${min}" '$3 == mm { for (i = 7; i < NF; i++) if ($i == "-") { print $(i + 2); exit } }' \
        /proc/self/mountinfo 2>/dev/null)
    case "${src}" in
        /dev/*) uuid=$(blkid -o value -s UUID "${src}" 2>/dev/null) ;;
    esac
    if [ -n "${uuid}" ]; then
        echo "uuid:${uuid}"
    else
        echo "dev:${d}"
    fi
}

# The record, whole or not at all: written beside itself and renamed over,
# so a kill mid-write leaves the previous record and never an empty file
# (which check would then have to refuse -- D-CLOUD-078, #105).
#
# And it says whether it landed (#308 gpt F-CS-20): the callers exited 0
# whatever happened here, so a full or read-only /storage/.cache left the
# guard with no record while every run reported it made one.
write_record() {
    mkdir -p "$(dirname "${RECORD}")" 2>/dev/null
    if { printf '%s\n' "$1" > "${RECORD}.tmp.$$"; } 2>/dev/null \
        && mv -f "${RECORD}.tmp.$$" "${RECORD}" 2>/dev/null; then
        return 0
    fi
    rm -f "${RECORD}.tmp.$$" 2>/dev/null
    return 1
}

# Re-read the identity once a second until it equals $1 or $2 seconds pass;
# print what it is at the end.
wait_for() {
    local want="$1" deadline now
    deadline=$(( $(date +%s) + ${2} ))
    now=$(identity)
    while [ "${now}" != "${want}" ] && [ "$(date +%s)" -lt "${deadline}" ]; do
        sleep 1
        now=$(identity)
    done
    echo "${now}"
}

case "${1:-}" in
    identity)
        identity
    ;;
    check)
        shift
        WAIT=0
        while [ $# -gt 0 ]; do
            case "$1" in
                --wait)
                    # A number of seconds, or a refusal (PL-17): with no
                    # value, shift 2 shifted nothing and this loop never ended.
                    case "${2:-}" in
                        ''|*[!0-9]*)
                            echo "usage: cloud_saves_root identity|check [--wait N]|record [IDENTITY]|accept" >&2
                            exit 64 ;;
                    esac
                    WAIT="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        now=$(identity)
        if [ -z "${now}" ]; then
            # The folder could not be read, so there is no card to compare
            # (PL-18): a refusal, never a pass on an identity of nothing.
            echo ">>> why COULDN'T TELL WHICH CARD YOUR SAVES ARE ON"
            logger -t cloud_saves_root "refused: no identity for the saves folder $(saves_path)" 2>/dev/null
            exit 1
        fi
        if [ -e "${RECORD}" ] && [ ! -s "${RECORD}" ]; then
            # An empty record is read as no record (#1304). Refusing on it
            # stopped every sync for good: the twins refuse here and record
            # only after a completed transfer, so no run could rewrite it.
            # The next completed run writes the card.
            logger -t cloud_saves_root "the record at ${RECORD} exists and is empty; reading it as no record" 2>/dev/null
        fi
        if [ -s "${RECORD}" ]; then
            last=$(head -1 "${RECORD}")
            if [ "${now}" != "${last}" ] && [ "${WAIT}" -gt 0 ] 2>/dev/null; then
                # At boot the second card is bound over the saves folder a
                # moment after the interface starts; give it that moment.
                echo "The saves folder is not on its usual card yet; waiting up to ${WAIT}s for it." >&2
                now=$(wait_for "${last}" "${WAIT}")
            fi
            if [ "${now}" != "${last}" ]; then
                # The why line first, for the caller to relay (D-UI-028);
                # then the reason and what to do, in the player's words. How
                # to accept the new card deliberately is a command, so it goes
                # to the log, not the screen -- no menu row offers it yet.
                echo ">>> why YOUR SAVES ARE ON A DIFFERENT CARD"
                echo "Your saves are on a different card than the last time they were synced."
                echo "Nothing was transferred. If your second card is missing, put it back and try again."
                logger -t cloud_saves_root "refused: saves root ${now}, recorded ${last}; to accept the current card deliberately run: cloud_setup --accept-saves-root" 2>/dev/null
                exit 1
            fi
        fi
        echo "${now}"
        exit 0
    ;;
    record)
        now=$(identity)
        WANT="" NO_WRITE=0
        shift
        for _a in "$@"; do
            case "${_a}" in
                --no-write) NO_WRITE=1 ;;
                *) WANT="${_a}" ;;
            esac
        done
        if [ -z "${now}" ]; then
            echo ">>> why COULDN'T TELL WHICH CARD YOUR SAVES ARE ON"
            logger -t cloud_saves_root "refused to record: no identity for the saves folder $(saves_path)" 2>/dev/null
            exit 1
        fi
        if [ -n "${WANT}" ] && [ "${now}" != "${WANT}" ]; then
            echo ">>> why YOUR SAVES CHANGED CARDS PART-WAY THROUGH"
            echo "Your saves changed cards part-way through, so some files may have gone to the other card."
            echo "Nothing was recorded. Try the transfer again once both cards are back in place."
            logger -t cloud_saves_root "refused to record: saves root $(saves_path) started on ${WANT} and is on ${now} now" 2>/dev/null
            exit 1
        fi
        [ "${NO_WRITE}" -eq 1 ] && exit 0
        case "${now}" in
            uuid:*) ;;
            *)
                # dev:<N> is this boot's device number, not the card: it was
                # compared above, within the run, and is not kept (PL-18).
                logger -t cloud_saves_root "the saves folder's filesystem has no UUID (${now}); nothing recorded" 2>/dev/null
                exit 0
            ;;
        esac
        if ! write_record "${now}"; then
            echo ">>> why COULDN'T RECORD WHICH CARD YOUR SAVES ARE ON"
            echo "Your saves moved, but this device couldn't note which card they're on."
            echo "If its storage is full, free some space and try again."
            logger -t cloud_saves_root "could not write ${RECORD}" 2>/dev/null
            exit 1
        fi
        exit 0
    ;;
    accept)
        now=$(identity)
        if [ -z "${now}" ]; then
            echo ">>> why COULDN'T TELL WHICH CARD YOUR SAVES ARE ON"
            exit 1
        fi
        case "${now}" in
            uuid:*) write_record "${now}" ;;
            # No UUID: nothing of this boot is kept (PL-18), so accepting
            # the card is clearing the record it no longer matches.
            *) rm -f "${RECORD}" 2>/dev/null && [ ! -e "${RECORD}" ] ;;
        esac
        if [ $? -ne 0 ]; then
            echo "Couldn't save which card your saves are on. If this device's storage is full, free some space and try again."
            exit 1
        fi
        echo "Saves folder accepted: ${now}"
        exit 0
    ;;
    *)
        echo "usage: cloud_saves_root identity|check [--wait N]|record [IDENTITY]|accept" >&2
        exit 2
    ;;
esac
