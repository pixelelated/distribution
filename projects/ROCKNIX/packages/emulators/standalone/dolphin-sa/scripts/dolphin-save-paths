"""Prepare Dolphin's known save links without converting retained real data."""
import argparse
import ctypes
import fcntl
import os
from pathlib import Path
import re
import shutil
import signal
import stat
import sys
import tempfile

REGIONS = ("EUR", "JAP", "USA")
MAX_COPY_FILES = 4096
MAX_COPY_BYTES = 64 * 1024 * 1024


# The first line is a fixed ownership discriminator consumed by runemu, not UI.
ERROR_OWNER = "DOLPHIN DID NOT START"
