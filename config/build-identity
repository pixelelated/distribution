# Called once by image assembly. Export the frozen identity to package installs.
pixelelated_build_identity() {
  local number='(0|[1-9][0-9]*)' qualifier="${BUILD_QUALIFIER-dev}" actual_hash tree_state
  [[ "${OS_VERSION}" =~ ^${number}\.${number}\.${number}$ ]] || {
    echo "build identity: OS_VERSION must be MAJOR.MINOR.PATCH" >&2; return 1;
  }
  # Two public forms; dev stays an unqualified engineering identity (#532).
  if [[ -n "$qualifier" && "$qualifier" != dev && ! "$qualifier" =~ ^rc\.[1-9][0-9]*$ ]]; then
    echo "build identity: qualifier must be dev, rc.N (N >= 1), or empty for a release" >&2
    return 1
  fi
  actual_hash=$(git rev-parse HEAD) || return 1
  [[ "$actual_hash" =~ ^[0-9a-f]{40}$ ]] || return 1
  if [[ -n "${CUSTOM_GIT_HASH:-}" && "$CUSTOM_GIT_HASH" != "$actual_hash" ]]; then
    echo "build identity: CUSTOM_GIT_HASH must match the checked-out commit" >&2; return 1
  fi
  if [[ -n "${CUSTOM_VERSION:-}${CUSTOM_IMAGE_NAME:-}" ]]; then
    echo "build identity: use OS_VERSION and BUILD_QUALIFIER, not custom version/image names" >&2; return 1
  fi
  BUILD_TIMESTAMP="${BUILD_TIMESTAMP:-$(date -u +%Y%m%dT%H%M%SZ)}"
  [[ "$BUILD_TIMESTAMP" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || {
    echo "build identity: timestamp must be YYYYMMDDTHHMMSSZ (UTC)" >&2; return 1;
  }
  local iso="${BUILD_TIMESTAMP:0:4}-${BUILD_TIMESTAMP:4:2}-${BUILD_TIMESTAMP:6:2}T${BUILD_TIMESTAMP:9:2}:${BUILD_TIMESTAMP:11:2}:${BUILD_TIMESTAMP:13:2}Z"
  [[ "$(date -u -d "$iso" +%Y%m%dT%H%M%SZ 2>/dev/null)" == "$BUILD_TIMESTAMP" ]] || {
    echo "build identity: invalid UTC date" >&2; return 1;
  }
  GIT_HASH="$actual_hash"
  RELEASE_VERSION="${OS_VERSION}${qualifier:+-$qualifier}"
  BUILD_VERSION="${RELEASE_VERSION}+${BUILD_TIMESTAMP}.g${GIT_HASH:0:12}"
  # Local edits may be useful for development, but never look like a clean cut.
  # A status that cannot be read is not a clean tree: refuse, as for rev-parse.
  tree_state=$(git status --porcelain=v1 --untracked-files=normal) || {
    echo "build identity: git status failed, so the tree's state is unknown" >&2; return 1;
  }
  BUILD_DIRTY=no
  if [[ -n "${tree_state}" ]]; then
    BUILD_DIRTY=yes
    BUILD_VERSION+=.dirty
  fi
  BUILD_DATE="$iso"
  OS_BUILD="${qualifier:-stable}"
  export GIT_HASH RELEASE_VERSION BUILD_VERSION BUILD_TIMESTAMP BUILD_DATE BUILD_DIRTY OS_BUILD
}
