+++ b/linux/tests/test_linux_refresh_resilience.py
@@ -0,0 +1,58 @@
+import unittest
+from unittest import mock
+
+from linux.raofflineproxy import proxy_service, rom_cache
+
+
+class RefreshResilienceTests(unittest.TestCase):
+    def setUp(self):
+        self.server = mock.Mock()
+        self.server.config_data = {}
+        self.server.activity.idle_delay_seconds.return_value = 0
+        self.server.is_online.return_value = True
+        self.worker = proxy_service.PeriodicRefresh(self.server)
+        self.worker.stop_event = mock.Mock()
+        self.worker.stop_event.wait.side_effect = [False, False, True]
+        for name in ("cache_unlocks", "cache_session"):
+            patcher = mock.patch.object(proxy_service, name)
+            patcher.start()
+            self.addCleanup(patcher.stop)
+        patcher = mock.patch.object(proxy_service.rate_limit, "paused_until", return_value=None)
+        self.paused = patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def run_games(self, outcomes):
+        with mock.patch.object(proxy_service, "refresh_game_patch", side_effect=outcomes) as refresh:
+            result = self.worker.refresh_games(list(range(1, len(outcomes)+1)), {"user": "fixture"}, "test")
+            return result, [c.args[0] for c in refresh.call_args_list]
+
+    def test_auth_failure_ends_pass_without_trying_other_games(self):
+        count, calls = self.run_games([rom_cache.CacheGameAuthError("rejected"), None, None])
+        self.assertEqual((count, calls), (0, [1]))
+
+    def test_three_consecutive_failures_end_pass(self):
+        count, calls = self.run_games([OSError("offline")]*4)
+        self.assertEqual((count, calls), (0, [1, 2, 3]))
+
+    def test_success_resets_failure_streak(self):
+        count, calls = self.run_games([OSError("offline"), OSError("offline"), None, OSError("offline"), OSError("offline"), None])
+        self.assertEqual(count, 2)
+        self.assertEqual(calls, [1, 2, 3, 4, 5, 6])
+
+    def test_rate_limit_ends_pass_after_failed_game(self):
+        self.paused.return_value = 123
+        self.assertEqual(self.run_games([OSError("slow down"), None]), (0, [1]))
+
+    def test_active_gameplay_defers_refresh(self):
+        self.server.activity.idle_delay_seconds.return_value = 10
+        self.assertEqual(self.run_games([None]), (0, []))
+
+    def test_next_interval_survives_pass_level_exception(self):
+        with mock.patch.object(proxy_service, "resolve_credentials", side_effect=[OSError("fixture failure"), None]) as resolve:
+            self.worker.run()
+        self.assertEqual(resolve.call_count, 2)
+        self.assertEqual(self.worker.stop_event.wait.call_count, 3)
+
+
+if __name__ == "__main__":
+    unittest.main()
