--- /dev/null
+++ b/linux/tests/test_linux_bounded_dns.py
@@ -0,0 +1,106 @@
+import socket
+import threading
+import time
+import unittest
+from unittest import mock
+
+from linux.raofflineproxy import network, proxy_service
+
+
+class BoundedDnsTests(unittest.TestCase):
+    def setUp(self):
+        self.host = "dns-fixture.invalid"
+        self.answer = [(socket.AF_INET, socket.SOCK_STREAM, socket.IPPROTO_TCP, "", ("192.0.2.1", 0))]
+        if hasattr(network, "_remembered"):
+            network._remembered.clear()
+            self.addCleanup(network._remembered.clear)
+
+    def test_head_does_not_attempt_connection_after_dns_failure(self):
+        def old_connection(*args, **kwargs):
+            socket.getaddrinfo(self.host, 443)
+            raise AssertionError("DNS unexpectedly succeeded")
+
+        # Hook the platform resolver; on fixed code the bounded worker also
+        # reaches it through the remembering wrapper.
+        owner = network if hasattr(network, "_resolver_getaddrinfo") else socket
+        name = "_resolver_getaddrinfo" if owner is network else "getaddrinfo"
+        with mock.patch.object(owner, name, side_effect=OSError("fixture DNS failure")), mock.patch.object(network.urllib.request, "urlopen", side_effect=old_connection) as connect:
+            ok, reason = network._head_upstream("https://dns-fixture.invalid/", None)
+        self.assertFalse(ok)
+        self.assertIn("fixture DNS failure", reason)
+        connect.assert_not_called()
+
+    def test_timeout_returns_before_resolver_finishes_and_worker_can_exit(self):
+        entered = threading.Event()
+        release = threading.Event()
+        workers = []
+
+        def slow(*args):
+            workers.append(threading.current_thread())
+            entered.set()
+            if not release.wait(2):
+                raise OSError("fixture release missing")
+            return self.answer
+
+        with mock.patch.object(network, "_resolver_getaddrinfo", side_effect=slow):
+            try:
+                ok, reason = network.resolve_host_bounded(self.host, seconds=0.02)
+                self.assertTrue(entered.is_set())
+                self.assertFalse(ok)
+                self.assertIn("took longer", reason)
+                self.assertTrue(workers[0].is_alive())
+                self.assertTrue(workers[0].daemon)
+            finally:
+                release.set()
+                for worker in workers:
+                    worker.join(2)
+            self.assertTrue(all(not worker.is_alive() for worker in workers))
+
+    def test_connection_reuses_answer_without_second_platform_lookup(self):
+        with mock.patch.object(network, "_resolver_getaddrinfo", return_value=self.answer) as resolver:
+            self.assertEqual(network.resolve_host_bounded(self.host), (True, ""))
+            result = socket.getaddrinfo(self.host.upper(), 443, socket.AF_INET, socket.SOCK_STREAM, socket.IPPROTO_TCP)
+        self.assertEqual(result, [(socket.AF_INET, socket.SOCK_STREAM, socket.IPPROTO_TCP, "", ("192.0.2.1", 443))])
+        resolver.assert_called_once()
+
+    def test_next_bounded_probe_asks_platform_again(self):
+        with mock.patch.object(network, "_resolver_getaddrinfo", return_value=self.answer) as resolver:
+            self.assertTrue(network.resolve_host_bounded(self.host)[0])
+            self.assertTrue(network.resolve_host_bounded(self.host)[0])
+        self.assertEqual(resolver.call_count, 2)
+
+    def test_expired_answer_falls_back_to_platform(self):
+        with mock.patch.object(network, "_resolver_getaddrinfo", return_value=self.answer) as resolver:
+            self.assertTrue(network.resolve_host_bounded(self.host)[0])
+            with mock.patch.object(network.time, "monotonic", return_value=time.monotonic() + network.REMEMBER_SECONDS + 1):
+                socket.getaddrinfo(self.host, 443)
+        self.assertEqual(resolver.call_count, 2)
+
+    def test_other_host_or_unavailable_family_uses_platform(self):
+        with mock.patch.object(network, "_resolver_getaddrinfo", return_value=self.answer) as resolver:
+            self.assertTrue(network.resolve_host_bounded(self.host)[0])
+            socket.getaddrinfo("other-fixture.invalid", 443)
+            socket.getaddrinfo(self.host, 443, socket.AF_INET6)
+        self.assertEqual(resolver.call_count, 3)
+
+    def test_ipv6_port_reuse_preserves_flow_and_scope(self):
+        answer = [(socket.AF_INET6, socket.SOCK_STREAM, socket.IPPROTO_TCP, "", ("2001:db8::1", 0, 12, 7))]
+        with mock.patch.object(network, "_resolver_getaddrinfo", return_value=answer) as resolver:
+            self.assertTrue(network.resolve_host_bounded(self.host)[0])
+            result = socket.getaddrinfo(self.host, 8443, socket.AF_INET6, socket.SOCK_STREAM, socket.IPPROTO_TCP)
+        self.assertEqual(result[0][-1], ("2001:db8::1", 8443, 12, 7))
+        resolver.assert_called_once()
+
+    def test_service_forwarder_returns_network_error_without_connecting(self):
+        server = object.__new__(proxy_service.ProxyRuntimeServer)
+        server.config_data = {"upstream_host": "https://dns-fixture.invalid"}
+        with mock.patch.object(proxy_service, "resolve_host_bounded", return_value=(False, "fixture DNS failure")), mock.patch.object(network.urllib.request, "urlopen") as connect, mock.patch.object(proxy_service, "mark_retroachievements_unreachable") as unreachable:
+            result = server.forward_to_upstream_result("GET", "/dorequest.php?r=patch&g=42", "", {})
+        self.assertEqual(result[0], "network_error")
+        self.assertEqual(result[1], 503)
+        connect.assert_not_called()
+        unreachable.assert_called_once()
+
+
+if __name__ == "__main__":
+    unittest.main()
