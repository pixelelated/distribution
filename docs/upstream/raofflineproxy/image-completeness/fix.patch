+++ b/linux/tests/test_linux_image_completeness.py
@@ -0,0 +1,92 @@
+import struct
+import tempfile
+import unittest
+import zlib
+from pathlib import Path
+from unittest import mock
+
+from linux.raofflineproxy import image_cache
+
+
+def chunk(kind, payload):
+    return struct.pack(">I", len(payload)) + kind + payload + struct.pack(">I", zlib.crc32(kind + payload) & 0xffffffff)
+
+
+def png(idat=None):
+    image = zlib.compress(b"\x00\xff\x00\x00") if idat is None else idat
+    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", 1, 1, 8, 2, 0, 0, 0)) + chunk(b"IDAT", image) + chunk(b"IEND", b"")
+
+
+class ImageCompletenessTests(unittest.TestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.root = Path(temp.name)
+        for name, path in (("STATIC_DIR", self.root / "static"), ("GAMES_DIR", self.root / "games")):
+            patcher = mock.patch.object(image_cache, name, path)
+            patcher.start()
+            self.addCleanup(patcher.stop)
+        self.target = image_cache.sharded_static_path("Badge/42.png")
+
+    def download(self, body):
+        with mock.patch.object(image_cache, "_fetch_image", return_value=body):
+            image_cache.download_static_image("https://fixture.invalid/Badge/42.png", "/Badge/42.png", "fixture")
+
+    def test_incomplete_or_corrupt_png_is_not_published_and_can_be_retried(self):
+        good = png()
+        broken_crc = good[:-1] + bytes([good[-1] ^ 1])
+        for bad in (b"not a png", good[:-12], broken_crc, png(b"not zlib")):
+            with self.subTest(body=bad[:12]):
+                self.download(bad)
+                self.assertFalse(self.target.exists())
+                self.assertEqual(list(self.root.rglob("*.tmp")), [])
+        self.download(good)
+        self.assertEqual(self.target.read_bytes(), good)
+
+    def test_complete_png_with_trailing_bytes_is_kept(self):
+        good = png() + b"allowed trailer"
+        self.download(good)
+        self.assertEqual(self.target.read_bytes(), good)
+
+    def test_existing_image_is_not_refetched_or_replaced(self):
+        good = png()
+        self.download(good)
+        with mock.patch.object(image_cache, "_fetch_image", side_effect=AssertionError("unexpected network")) as fetch:
+            image_cache.download_static_image("https://fixture.invalid/Badge/42.png", "/Badge/42.png", "fixture")
+        fetch.assert_not_called()
+        self.assertEqual(self.target.read_bytes(), good)
+
+    def test_short_urllib_body_is_rejected_before_publication(self):
+        response = mock.MagicMock()
+        response.__enter__.return_value = response
+        response.getheader.return_value = "100"
+        response.read.return_value = b"short"
+        with mock.patch.object(image_cache.urllib.request, "urlopen", return_value=response):
+            with self.assertRaises(ValueError):
+                image_cache._fetch_with_urllib("https://fixture.invalid/Badge/42.png", "fixture")
+
+    def test_short_reused_connection_body_is_rejected_and_connection_dropped(self):
+        response = mock.Mock(status=200, will_close=False)
+        response.getheader.return_value = "100"
+        response.read.return_value = b"short"
+        connection = mock.Mock()
+        connection.getresponse.return_value = response
+        with mock.patch.object(image_cache, "_thread_connection", return_value=connection), mock.patch.object(image_cache, "_drop_thread_connection") as drop:
+            with self.assertRaises(ValueError):
+                image_cache._fetch_image("https://fixture.invalid/Badge/42.png", "fixture")
+        drop.assert_called_with("fixture.invalid")
+
+    def test_matching_or_absent_length_passes_body_unchanged(self):
+        good = png()
+        for declared in (str(len(good)), None):
+            with self.subTest(declared=declared):
+                response = mock.MagicMock()
+                response.__enter__.return_value = response
+                response.getheader.return_value = declared
+                response.read.return_value = good
+                with mock.patch.object(image_cache.urllib.request, "urlopen", return_value=response):
+                    self.assertEqual(image_cache._fetch_with_urllib("https://fixture.invalid/Badge/42.png", "fixture"), good)
+
+
+if __name__ == "__main__":
+    unittest.main()
