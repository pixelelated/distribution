+import unittest
+from unittest import mock
+
+from linux.raofflineproxy import proxy_service
+
+
+class ClientErrorResponseTests(unittest.TestCase):
+    def setUp(self):
+        self.server = object.__new__(proxy_service.ProxyRuntimeServer)
+        self.server.storage = mock.Mock()
+        self.offline = mock.Mock(return_value=b"cached offline response")
+        self.server.handle_offline_request = self.offline
+
+    def response(self, result, path="/dorequest.php?r=patch&g=42"):
+        with mock.patch.object(self.server, "forward_to_upstream_result", return_value=result):
+            return self.server.handle_online_request("GET", path, "", "patch", {})
+
+    def test_client_error_status_reason_type_and_body_are_preserved(self):
+        body = b'{"Success":false,"Error":"Unknown game"}'
+        for status, reason in ((400, "Bad Request"), (404, "Not Found"), (429, "Too Many Requests")):
+            with self.subTest(status=status):
+                response = self.response(("http_error", status, reason, body, "application/json", body.decode()))
+                headers, actual = response.split(b"\r\n\r\n", 1)
+                self.assertEqual(headers.splitlines()[0], f"HTTP/1.1 {status} {reason}".encode())
+                self.assertIn(b"Content-Type: application/json", headers)
+                self.assertEqual(actual, body)
+        self.server.storage.upsert_cache.assert_not_called()
+        self.offline.assert_not_called()
+
+    def test_auth_server_and_non_api_errors_keep_unavailable_response(self):
+        for status, path in ((401, "/dorequest.php"), (403, "/dorequest.php"), (500, "/dorequest.php"), (502, "/dorequest.php"), (404, "/other")):
+            with self.subTest(status=status, path=path):
+                response = self.response(("http_error", status, "Error", b"upstream body", "text/plain", None), path)
+                self.assertTrue(response.startswith(b"HTTP/1.1 503 "))
+                self.assertNotIn(b"upstream body", response)
+        self.offline.assert_not_called()
+
+    def test_network_failure_still_uses_offline_cache(self):
+        self.assertEqual(self.response(("network_error",)), b"cached offline response")
+        self.offline.assert_called_once_with("/dorequest.php?r=patch&g=42", "", "patch")
+
+
+if __name__ == "__main__":
+    unittest.main()
