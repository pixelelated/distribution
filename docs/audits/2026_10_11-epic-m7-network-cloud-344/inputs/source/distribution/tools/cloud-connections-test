#!/usr/bin/env python3
"""Credential-free regression tests using the actual connection module/rclone."""
import importlib.util
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
import importlib.machinery
from unittest import mock

ROOT = Path(__file__).resolve().parents[1]
SOURCE = ROOT / 'projects/ROCKNIX/packages/network/rclone/sources'
sys.path.insert(0, str(SOURCE))
import cloud_connections as c

class Connections(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name)
        c.CONFIG = self.root / 'rclone.conf'
        c.ACTIVE = self.root / 'active-connection'
        c.LOCK = self.root / 'cloud.lock'
        c.SYSTEM = self.root / 'system.cfg'
        self.data = self.root / 'files'
        self.data.mkdir()
        self.settings = [('remote', str(self.data))]
        c.CONFIG.write_text('[zulu]\ntype = alias\nremote = %s\n' % self.data)
        self.original = c.CONFIG.read_bytes()

    def test_encrypted_config_stays_encrypted_through_management(self):
        import pexpect
        password = 'qa-only-fixture-password'
        child = pexpect.spawn(c.RCLONE, ['--config', str(c.CONFIG), 'config'], encoding='utf-8', timeout=5)
        try:
            child.expect('e/n/d/r/c/s/q>'); child.sendline('s')
            child.expect('a/q>'); child.sendline('a')
            child.expect('Enter NEW configuration password:'); child.sendline(password)
            child.expect('Confirm NEW configuration password:'); child.sendline(password)
            child.expect('c/u/q>'); child.sendline('q')
            child.expect('e/n/d/r/c/s/q>'); child.sendline('q')
            child.expect(pexpect.EOF)
        finally:
            child.close(force=True)
        self.assertIn(b'RCLONE_ENCRYPT_V0:', c.CONFIG.read_bytes())
        with mock.patch.dict(os.environ, {'RCLONE_CONFIG_PASS': password}):
            self.assertEqual(c.active(), 'zulu')
            c.save('alpha', 'alias', self.settings)
            c.save('zulu', 'alias', self.settings, replace=True)
            c.select('alpha'); c.remove('alpha')
            self.assertEqual(c.active(), '')
            self.assertEqual(c.read_config()[1]['zulu']['remote'], str(self.data))
        self.assertIn(b'RCLONE_ENCRYPT_V0:', c.CONFIG.read_bytes())
        self.assertNotIn(str(self.data).encode(), c.CONFIG.read_bytes())

    def test_add_keeps_legacy_selection(self):
        c.save('alpha', 'alias', self.settings)
        self.assertEqual(c.active(), 'zulu')
        self.assertEqual(c.ACTIVE.stat().st_mode & 0o777, 0o600)
        self.assertEqual(c.CONFIG.stat().st_mode & 0o777, 0o600)
        self.assertEqual(c.read_config()[1]['zulu']['remote'], str(self.data))

    def test_failed_first_publication_restores_absence(self):
        c.CONFIG.unlink()
        def failed_record(commit):
            commit()
            raise OSError('record failed')
        with self.assertRaises(OSError): c.save('alpha', 'alias', self.settings, publish=failed_record)
        self.assertFalse(c.CONFIG.exists())
        self.assertFalse(c.ACTIVE.exists())

    def test_duplicate_keeps_old_bytes(self):
        with self.assertRaises(c.Refused): c.save('zulu', 'alias', self.settings)
        self.assertEqual(c.CONFIG.read_bytes(), self.original)
        self.assertFalse(c.ACTIVE.exists())

    def test_failed_renewal_keeps_old_bytes(self):
        with self.assertRaises(c.Refused): c.save('zulu', 'alias', [('remote', str(self.root/'absent'))], replace=True)
        self.assertEqual(c.CONFIG.read_bytes(), self.original)
        self.assertEqual(list(self.root.glob('.connection-*')), [])

    def test_cancelled_attempt_does_not_install(self):
        def cancelled(commit): raise c.Refused('cancelled')
        with self.assertRaises(c.Refused): c.save('alpha', 'alias', self.settings, publish=cancelled)
        self.assertEqual(c.CONFIG.read_bytes(), self.original)

    def test_success_record_failure_rolls_back(self):
        def failed_record(commit):
            commit()
            raise OSError('record failed')
        with self.assertRaises(OSError): c.save('zulu', 'alias', self.settings, replace=True, publish=failed_record)
        self.assertEqual(c.CONFIG.read_bytes(), self.original)
        self.assertFalse(c.ACTIVE.exists())

    def test_remove_write_failure_restores_selection(self):
        atomic = c.atomic
        def failed_config(path, data):
            if path == c.CONFIG:
                raise OSError('synthetic write failure')
            atomic(path, data)
        for selected in (None, b'zulu\n'):
            if selected is None:
                c.ACTIVE.unlink(missing_ok=True)
            else:
                c.ACTIVE.write_bytes(selected)
            with mock.patch.object(c, 'atomic', side_effect=failed_config):
                with self.assertRaises(OSError): c.remove('zulu')
            self.assertEqual(c.CONFIG.read_bytes(), self.original)
            self.assertEqual(c.ACTIVE.read_bytes() if c.ACTIVE.exists() else None, selected)

    def test_external_write_refuses_commit(self):
        def changed(commit):
            c.CONFIG.write_bytes(self.original + b'other = preserved\n')
            commit()
        with self.assertRaises(c.Refused): c.save('alpha', 'alias', self.settings, publish=changed)
        self.assertEqual(c.CONFIG.read_bytes(), self.original + b'other = preserved\n')

    def test_selection_and_removal_never_move_files(self):
        marker = self.data / 'save.srm'; marker.write_bytes(b'fixture-save')
        c.save('alpha', 'alias', self.settings)
        c.select('alpha')
        self.assertEqual(c.active(), 'alpha')
        c.remove('alpha')
        self.assertEqual(c.active(), '')
        self.assertIn('zulu', c.read_config()[1])
        self.assertEqual(marker.read_bytes(), b'fixture-save')

    def test_missing_selection_never_falls_back(self):
        c.ACTIVE.write_text('missing\n')
        with self.assertRaises(c.Refused): c.active()
        c.select('zulu')
        self.assertEqual(c.active(), 'zulu')

    def test_automatic_sync_requires_deliberate_disable(self):
        c.SYSTEM.write_text('cloudsaves.startup=1\ncloudsaves.gameexit=0\n')
        for action in (lambda: c.select('zulu'), lambda: c.remove('zulu'), lambda: c.save('zulu','alias',self.settings,replace=True)):
            with self.assertRaises(c.Refused): action()
        self.assertEqual(c.CONFIG.read_bytes(), self.original)

    def test_busy_transfer_refuses_management(self):
        with c.locked():
            for action in (lambda: c.select('zulu'), lambda: c.remove('zulu'), lambda: c.save('alpha','alias',self.settings)):
                with self.assertRaises(c.Refused): action()
        self.assertEqual(c.CONFIG.read_bytes(), self.original)

    def test_dependency_refuses_removal(self):
        c.CONFIG.write_bytes(self.original + b'\n[wrapped]\ntype = alias\nremote = zulu:folder\n')
        before = c.CONFIG.read_bytes()
        with self.assertRaises(c.Refused): c.remove('zulu')
        self.assertEqual(c.CONFIG.read_bytes(), before)

    def test_first_connection_and_manual_empty_selection(self):
        c.CONFIG.unlink()
        c.save('first','alias',self.settings)
        self.assertEqual(c.active(), 'first')
        c.remove('first')
        c.save('second','alias',self.settings)
        self.assertEqual(c.active(), '')

    def test_blank_edit_preserves_existing_values(self):
        before = dict(c.read_config()[1]['zulu'])
        c.save('zulu', 'alias', [], replace=True)
        self.assertEqual(dict(c.read_config()[1]['zulu']), before)

    def test_object_store_defaults_only_apply_to_new_connections(self):
        loader = importlib.machinery.SourceFileLoader('qa_cloud_remote', str(SOURCE/'cloud_remote'))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        cli = importlib.util.module_from_spec(spec); loader.exec_module(cli)
        with mock.patch.object(cli, 'load_providers', return_value=[{'Name':'s3'}]), mock.patch.object(c, 'save') as save, mock.patch('builtins.print'):
            cli.cmd_create('bucket', 's3', [], replace=True)
            self.assertEqual(save.call_args.args[2], [])
            cli.cmd_create('bucket2', 's3', [], replace=False)
            self.assertIn(('directory_markers', 'true'), save.call_args.args[2])

    def test_verified_update_keeps_other_connections(self):
        c.save('alpha','alias',self.settings)
        elsewhere = self.root/'elsewhere'; elsewhere.mkdir()
        c.save('zulu','alias',[('remote',str(elsewhere))],replace=True)
        config = c.read_config()[1]
        self.assertEqual(config['alpha']['remote'], str(self.data))
        self.assertEqual(config['zulu']['remote'], str(elsewhere))
        self.assertEqual(c.active(), 'zulu')

class OAuthOwnership(unittest.TestCase):
    def setUp(self):
        Connections.setUp(self)
        loader = importlib.machinery.SourceFileLoader('qa_cloud_oauth', str(SOURCE/'cloud_oauth'))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        self.oauth = importlib.util.module_from_spec(spec)
        loader.exec_module(self.oauth)
        self.oauth.STATE_DIR = str(self.root/'oauth-state')
        self.oauth.LOG_FILE = str(self.root/'oauth.log')
        self.oauth.reset_state(attempt='serve-old', session='session-old', status='waiting')
        self.session = self.oauth.Session('alias', 'zulu', 60)
        self.session.attempt = 'serve-old'; self.session.gen = 'session-old'
        self.session.replace = True; self.session.token = '{"access_token":"synthetic-only"}'

    def test_superseded_session_cannot_replace_credentials(self):
        self.oauth.write_state(session='session-new')
        ok, _ = self.session._create_remote()
        self.assertFalse(ok)
        self.assertEqual(c.CONFIG.read_bytes(), self.original)
        self.assertEqual(self.oauth.read_state()['session'], 'session-new')

    def test_cancel_during_verification_prevents_commit(self):
        original_run = c.run
        def cancel_during_listing(args):
            result = original_run(args)
            if 'lsd' in args: self.oauth.write_state(status='idle')
            return result
        with mock.patch.object(c, 'run', side_effect=cancel_during_listing):
            ok, _ = self.session._create_remote()
        self.assertFalse(ok)
        self.assertEqual(c.CONFIG.read_bytes(), self.original)
        self.assertEqual(self.oauth.read_state()['status'], 'idle')

    def test_success_publishes_matching_connection_and_state(self):
        ok, name = self.session._create_remote()
        self.assertTrue(ok, name)
        self.assertEqual(name, 'zulu')
        self.assertEqual(self.oauth.read_state()['status'], 'signed-in')
        self.assertEqual(self.oauth.read_state()['remote'], 'zulu')
        self.assertEqual(c.read_config()[1]['zulu']['token'], self.session.token)

if __name__ == '__main__': unittest.main(verbosity=2)
