  354      def start(self):
  355          # A previous attempt still holding 53682 would make this one fail with
  356          # "address already in use", which reads as a provider problem.
  357          subprocess.run(["pkill", "-f", "rclone authorize"],
  358                         capture_output=True)
  359          time.sleep(1)
