 2308          def _gate(self, pin):
 2309              """True when the request may proceed; renders the refusal if not."""
 2310              if holder.pin_exhausted():
 2311                  self.send_error(403, "Too many wrong PINs. Start again on "
 2312                                       "the handheld.")
 2313                  return False
 2314              if holder.authorised(pin):
 2315                  return True
 2316              # No PIN at all is somebody typing the bare address, which is the
 2317              # documented fallback -- ask, do not refuse. A wrong one is either
 2318              # a typo or a guess, and both are answered the same way so neither
 2319              # learns anything the other does not.
 2320              if not pin:
 2321                  self._render_pin()
 2322              elif holder.pin_failed():
 2323                  self.send_error(403, "Too many wrong PINs. Start again on "
 2324                                       "the handheld.")
 2325              else:
 2326                  self._render_pin('<div class=err>That PIN did not match.</div>',
 2327                                   supplied="")
 2328              return False
