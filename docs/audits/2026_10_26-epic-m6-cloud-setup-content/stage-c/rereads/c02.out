 1399          mkdir -p "$(dirname "${SELECTION}")" 2>/dev/null
 1400          # An empty selection is a real answer ("none"), distinct from never
 1401          # having chosen; the file exists either way. Which is exactly why it
 1402          # is written whole or not at all: a kill mid-write left an empty
 1403          # file, and an empty file is a different valid choice -- every later
 1404          # --selected then said no systems were selected (D-CLOUD-078, #105).
 1405          { [ ${#local_names[@]} -eq 0 ] || printf '%s\n' "${local_names[@]}"; } > "${SELECTION}.tmp.$$" 2>/dev/null
 1406          mv -f "${SELECTION}.tmp.$$" "${SELECTION}" 2>/dev/null || rm -f "${SELECTION}.tmp.$$"
 1407          echo "OK $(selected_systems | wc -l) selected"
 1408          exit 0
 1409      ;;
 1410      --selected)
 1411          mapfile -t DIRS < <(selected_systems)
 1412          # BIOS is not a system and is no longer a pick (maintainer, 2026-09-06):
 1413          # it comes with the tier whenever the cloud has it. The tier's own
 1414          # switch already says ROMS AND BIOS; nothing runs without them. A
 1415          # "bios" line in the selection -- the placeholder the interface wrote
 1416          # so that BIOS alone was not refused -- is the same thing: remote_for
 1417          # sends it to BIOS/, one unit, never to a system folder under ROMs/.
 1418          if [ "${MEDIA_MODE}" != only ] && exists_remote "${ROOT}BIOS" && ! printf '%s\n' "${DIRS[@]}" | grep -qx bios; then
 1419              DIRS+=("bios")
 1420          fi
== projects/ROCKNIX/packages/network/rclone/sources/cloud_content_restore:430-450
  430  # never report absence there, and every caller that branched on it took the
  431  # "exists" path unconditionally.
  432  #
  433  # A listing can report absence. Two questions, because a directory can be real
  434  # without holding files: does it contain anything, or does its parent list it
  435  # (which is what an --s3-directory-markers marker object produces)?
  436  exists_remote() {
  437      [ -n "$(rclone lsf "$1" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null | head -1)" ] && return 0
  438      local parent name
  439      parent="${1%/}"; name="${parent##*/}"; parent="${parent%/*}"
  440      [ -n "${name}" ] || return 1
  441      rclone lsf --dirs-only "${parent}/" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null | grep -qx "${name}/"
  442  }
  443  
  444  # Is this remote path missing, rather than unreadable? rclone answers "not
  445  # found" (exit 3) when the server's reply is the one it maps to that, and a
  446  # plain error (exit 1) when the words differ: an FTP server that answers a
  447  # missing folder with 501 "No such directory." where the standard reply is
  448  # 550 makes every "is it there yet?" branch read as "the cloud is broken"
  449  # (#142, from the #133 matrix). The parent settles it, whatever the words:
  450  # walk up until a level lists. A level that lists and lacks the next name is
