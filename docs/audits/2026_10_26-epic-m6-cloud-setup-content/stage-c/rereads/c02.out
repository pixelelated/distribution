== projects/ROCKNIX/packages/network/rclone/sources/cloud_content_restore:1265-1300
 1265          # whether one side has what the other has. Fields 7 and 8 are what a
 1266          # copy in that direction would send; fields 5 and 6 count the same
 1267          # set. The game list is in the totals and never in the comparison
 1268          # (below). They arrived 2026-09-08; the first six keep their position
 1269          # and type, so a page built against six still reads this line.
 1270          SUP=$(supported_systems)
 1271          TMP=$(mktemp -d /tmp/cloud-scan.XXXXXX); trap 'rm -rf "${TMP}"' EXIT
 1272          rclone lsf -R --files-only --format "sp" --separator "|" "${ROOT}ROMs/" "${RCLONE_LIST_OPTS[@]}" > "${TMP}/cloud.raw" 2>/dev/null
 1273          scan_rc=$?
 1274          if [ "${scan_rc}" -ne 0 ] && [ -s "${TMP}/cloud.raw" ]; then
 1275              echo "Couldn't finish reading your cloud. Try again." >&2
 1276              exit 5
 1277          fi
 1278          cloud_content_filter < "${TMP}/cloud.raw" > "${TMP}/cloud"
 1279          # A code other than 3 from a folder that is simply not there yet
 1280          # (a server whose "missing" rclone does not map to "not found",
 1281          # #142) is an empty cloud, not one that could not be read.
 1282          if [ "${scan_rc}" -ne 0 ] && [ "${scan_rc}" -ne 3 ] && absent_not_broken "${ROOT}ROMs/"; then
 1283              log_message "scan: ROMs is not there yet (rclone exit ${scan_rc}; its nearest listable parent lacks it)"
 1284              scan_rc=3
 1285          fi
 1286          # BIOS is the ROMs tier's, never game content's: under --media-only it
 1287          # is not listed, so the union does not carry a line the page would
 1288          # skip and the log would puzzle over (3608 cloud BIOS files "not on
 1289          # this device" under game content alone, RG35XX SP, 2026-09-06).
 1290          if [ "${MEDIA_MODE}" != only ]; then
 1291              rclone lsf -R --files-only --format "sp" --separator "|" "${ROOT}BIOS/" "${RCLONE_LIST_OPTS[@]}" > "${TMP}/bios.raw" 2>/dev/null
 1292              bios_rc=$?
 1293              if [ "${bios_rc}" -ne 0 ] && [ -s "${TMP}/bios.raw" ]; then
 1294                  echo "Couldn't finish reading your cloud. Try again." >&2
 1295                  exit 5
 1296              fi
 1297              grep -v '^[0-9]*|README\.txt$' "${TMP}/bios.raw" | sed 's/|/|bios\//' >> "${TMP}/cloud"
 1298              if [ "${bios_rc}" -ne 0 ] && [ "${bios_rc}" -ne 3 ] && absent_not_broken "${ROOT}BIOS/"; then
 1299                  log_message "scan: BIOS is not there yet (rclone exit ${bios_rc}; its nearest listable parent lacks it)"
 1300                  bios_rc=3
