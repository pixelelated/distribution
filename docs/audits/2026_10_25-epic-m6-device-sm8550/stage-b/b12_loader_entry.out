post_install() {
  BLS_PATH="${INSTALL}/usr/share/bootloader/loader/entries"

  mkdir -p "${BLS_PATH}"
  cat << EOF > "${BLS_PATH}/${DISTRONAME,,}.conf"
title      ${DISTRONAME}
version    ${OS_VERSION}
linux      /${KERNEL_NAME}
options    boot=LABEL=${DISTRO_BOOTLABEL} disk=LABEL=${DISTRO_DISKLABEL} ${EXTRA_CMDLINE}
EOF
}
8ebaf8daad:distributions/ROCKNIX/options:17:  DISTRONAME="pixelelated"
8ebaf8daad:distributions/ROCKNIX/options:202:  DISTRO_BOOTLABEL="ROCKNIX"
