8ebaf8daad:projects/ROCKNIX/packages/linux-firmware/kernel-firmware/package.mk:39:  if find_file_path config/kernel-firmware.dat; then
makeinstall_target() {
  FW_TARGET_DIR=${INSTALL}/$(get_full_firmware_dir)

  if find_file_path config/kernel-firmware.dat; then
    FW_LISTS="${FOUND_PATH}"
      eval "(cd ${PKG_FW_SOURCE} && find "${fwline}" >/dev/null)" || die "ERROR: Firmware pattern does not exist: ${fwline}"
    done <"${fwlist}"
