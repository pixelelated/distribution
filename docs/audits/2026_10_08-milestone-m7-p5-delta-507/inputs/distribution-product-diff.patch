-    IFS=/ read -r -a parts <<< "${p}"
-    for part in "${parts[@]}"; do
-        case "${part}" in
-            ""|.) ;;
-            ..) return 1 ;;
-            *) out="${out:+${out}/}${part}" ;;
-        esac
-    done
-    printf '%s%s' "${lead}" "${out}"
