## R10 FRIBIDI at 230-244; the build names at 303-330 through the mask; HFS_DEV_LOGIN's readers
# FriBidi is only used to reorder right-to-left scripts (Arabic, Hebrew) at render time.
# It is optional on purpose: when it is missing, Font.cpp falls back on tryFastBidi(), which
# is what every build used before RTL support was added. pkg-config is a Unix mechanism and
# the Windows dependency package does not ship FriBidi, so this must never be REQUIRED.
find_package(PkgConfig QUIET)
if(PKG_CONFIG_FOUND)
	pkg_check_modules(FRIBIDI QUIET fribidi)
endif()

if(FRIBIDI_FOUND)
	MESSAGE("-- FriBidi found, using it for right-to-left text reordering")
	add_definitions(-DHAVE_FRIBIDI)
else()
	MESSAGE("-- FriBidi not found, falling back on the built-in right-to-left reordering")
endif()
if(DEFINED ENV{SCREENSCRAPER_SOFTNAME})
    add_definitions(-DSCREENSCRAPER_SOFTNAME="$ENV{SCREENSCRAPER_SOFTNAME}")
endif()

if(DEFINED ENV{SCREENSCRAPER_DEV_LOGIN})
    add_definitions(-DSCREENSCRAPER_DEV_LOGIN=***"$ENV{SCREENSCRAPER_DEV_LOGIN}")
endif()

# Enable runtime developer credentials for builds without a compiled pair.
# Those builds show DEVELOPER ID and DEVELOPER PASSWORD under SCRAPER > ACCOUNTS.
# Set from the package recipe (-DSCREENSCRAPER_RUNTIME_DEV_LOGIN=*** or environment.
# A compiled-in SCREENSCRAPER_DEV_LOGIN takes precedence and hides the rows;
# normal distribution builds supply that pair at build time (#566).
if(SCREENSCRAPER_RUNTIME_DEV_LOGIN OR DEFINED ENV{SCREENSCRAPER_RUNTIME_DEV_LOGIN})
    add_definitions(-DSCREENSCRAPER_RUNTIME_DEV_LOGIN=***
endif()

if(DEFINED ENV{GAMESDB_APIKEY})
    add_definitions(-DGAMESDB_APIKEY=***"$ENV{GAMESDB_APIKEY}")
endif()

if(DEFINED ENV{CHEEVOS_DEV_LOGIN})
    add_definitions(-DCHEEVOS_DEV_LOGIN=***"$ENV{CHEEVOS_DEV_LOGIN}")
endif()

if(DEFINED ENV{HFS_DEV_LOGIN})
    add_definitions(-DHFS_DEV_LOGIN=***"$ENV{HFS_DEV_LOGIN}")
endif()
