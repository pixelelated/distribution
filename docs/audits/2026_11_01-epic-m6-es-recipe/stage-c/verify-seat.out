== G-5: get_env's selection
get_env:8: # container. The four scraper and achievement credentials EmulationStation
get_env:9: # compiles in are the exception -- they are the reason a build needs a secret
get_env:10: # at all -- so they pass by name; everything else that looks like one is
get_env:11: # dropped. Names, not values, are matched, so a variable holding a secret under
get_env:12: # an innocent name still leaks: keep such things out of the shell that runs
get_env:13: # make, or in ~/.ROCKNIX/options where only the build sees them.
get_env:14: KEEP='^(SCREENSCRAPER_DEV_LOGIN|GAMESDB_APIKEY|CHEEVOS_DEV_LOGIN|HFS_DEV_LOGIN)$'
get_env:15: DROP='(^|_)(KEY|KEYS|TOKEN|TOKENS|SECRET|SECRETS|PASSWORD|PASSWD|CREDENTIAL|CREDENTIALS|AUTH|APIKEY|API_KEY|PRIVATE)($|_)|^(AWS|GH|GITHUB|NPM|OPENAI|ANTHROPIC)_'
get_env:16: for var in $(compgen -e); do
get_env:17:   [[ "$var" == PATH ]] && continue
get_env:18:   if [[ ! "$var" =~ $KEEP ]] && [[ "$var" =~ $DROP ]]; then
get_env:19:     continue
get_env:20:   fi
get_env:21:   echo "$var=${!var}"
get_env:22: done
