== G-8: the serial check's read
serial_number_check:8: if [ -z "${DEVICE_SERIAL_NUMBER_PATH}" ]; then
serial_number_check:9:   log $0 "SERIAL NUMBER CHECK: This device has no unique serial number to check, skipping and continue to Emulation Station"
serial_number_check:10:   exit 0
serial_number_check:11: else
serial_number_check:12:   DEVICE_SERIAL_NUMBER="$(cat ${DEVICE_SERIAL_NUMBER_PATH})"
serial_number_check:13:   log $0 "SERIAL NUMBER CHECK: DEVICE SERIAL NUMBER: ${DEVICE_SERIAL_NUMBER}"
serial_number_check:14: fi
serial_number_check:15: 
serial_number_check:16: STORED_SERIAL_NUMBER=$(get_setting "device.serial.number")
serial_number_check:17: if [ ! -n "${STORED_SERIAL_NUMBER}" ]; then
serial_number_check:18:   set_setting "device.serial.number" "${DEVICE_SERIAL_NUMBER}"
serial_number_check:19:   echo 1 > "/storage/serial_number_check_status"
serial_number_check:20:   log $0 "SERIAL NUMBER CHECK: No storted serial number found, saving SOC serial number to system.cfg and show warning."
serial_number_check:21: elif [ ! "${STORED_SERIAL_NUMBER}" == "${DEVICE_SERIAL_NUMBER}" ]; then
serial_number_check:22:   set_setting "device.serial.number" "${DEVICE_SERIAL_NUMBER}"
serial_number_check:23:   echo 1 > "/storage/serial_number_check_status"
serial_number_check:24:   log $0 "SERIAL NUMBER CHECK: Device and stored serial numbers do not match, show warning."
