== the ARMSX2 feature
es_features.cfg:1392:       <feature name="vulkan driver">
es_features.cfg:1393:         <choice name="armsx2 turnip (default)" value="armsx2"/>
es_features.cfg:1394:         <choice name="system mesa" value="system"/>
es_features.cfg:1395:       </feature>
== the launcher's driver choice
start_armsx2.sh:47: VKDRIVER=$(get_setting vulkan_driver "${PLATFORM}" "${GAME}")
start_armsx2.sh:213: #Vulkan driver: Adreno 6xx/7xx builds ship ARMSX2's own Turnip. Point the
start_armsx2.sh:214: #loader at it for this process only, unless the system driver was chosen.
start_armsx2.sh:215: ARMSX2_ICD="/usr/share/armsx2-sa/turnip/freedreno_icd.aarch64.json"
start_armsx2.sh:216: if [ -f "${ARMSX2_ICD}" ] && [ "${VKDRIVER}" != "system" ]; then
start_armsx2.sh:217:   export VK_DRIVER_FILES="${ARMSX2_ICD}"
start_armsx2.sh:218: fi
== armsx2-sa's Turnip predicate
armsx2-sa/package.mk:25: # Ship ARMSX2's own Turnip build on the Adreno 6xx/7xx families. SM8750
armsx2-sa/package.mk:26: # (Adreno 8xx) keeps the system driver.
armsx2-sa/package.mk:27: case ${DEVICE} in
armsx2-sa/package.mk:28:   SM4450|SM6115|SM8250|SM8550|SM8650)
armsx2-sa/package.mk:29:     PKG_DEPENDS_TARGET+=" armsx2-turnip"
armsx2-sa/package.mk:30:     ;;
armsx2-sa/package.mk:31: esac
