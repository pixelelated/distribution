== post-update links into /storage
post-update:31: ### a fresh one in userconfig-setup, and the interface reads this path first.
post-update:32: for es_cfg in es_features.cfg es_systems.cfg es_savestates.cfg
post-update:33: do
post-update:34:   mv /storage/.config/emulationstation/${es_cfg} /storage/.config/emulationstation/last_${es_cfg} >/dev/null 2>&1
post-update:35:   ln -s /usr/config/emulationstation/${es_cfg} /storage/.config/emulationstation/${es_cfg}  >/dev/null 2>&1
post-update:36: done
