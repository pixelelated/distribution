#!/bin/bash
# T36 (#683): the window's guest needs no network -- no G-row touches the cloud. The user
# netdev is fully restricted (restrict=on), keeping only the loopback SSH forward QEMU adds.
args=()
for a in "$@"; do
  case "$a" in user,id=net0,*) a="user,id=net0,restrict=on,${a#user,id=net0,}" ;; esac
  args+=("$a")
done
exec /usr/bin/qemu-system-x86_64 "${args[@]}"
