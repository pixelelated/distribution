diff --git a/projects/ROCKNIX/packages/graphics/mesa/patches/001-rtasm-release-executable-heap-on-unload.patch b/projects/ROCKNIX/packages/graphics/mesa/patches/001-rtasm-release-executable-heap-on-unload.patch
new file mode 100644
index 0000000000..51176f6c4f
--- /dev/null
+++ b/projects/ROCKNIX/packages/graphics/mesa/patches/001-rtasm-release-executable-heap-on-unload.patch
@@ -0,0 +1,69 @@
+Subject: [PATCH] rtasm: release the executable heap when the driver unloads
+
+The POSIX executable allocator retains a 10 MiB mmap after its suballocations
+are freed. When an application closes and reloads the DRI driver (for example,
+EmulationStation around each game), the static pointers are lost and a new
+heap is mapped each time. Register cleanup with atexit, as other Mesa global
+resources do; on our glibc target it also runs when the owning DSO unloads.
+
+Publish the heap only after both allocations succeed, and unwind allocation
+or callback-registration failure so a later call can retry. The arena stays
+shared and locked during normal operation; no per-shader mmap is introduced.
+
+Downstream: rasteratops/distribution#310. Mesa 26.2.2; current upstream still
+has the same unpaired mmap. See docs/qa-logs/2026-10-03-launch-memory/.
+
+--- a/src/gallium/auxiliary/rtasm/rtasm_execmem.c
++++ b/src/gallium/auxiliary/rtasm/rtasm_execmem.c
+@@ -67,18 +67,44 @@
+ static unsigned char *exec_mem = NULL;
+ 
+ 
++static void
++destroy_heap(void)
++{
++   u_mmDestroy(exec_heap);
++   exec_heap = NULL;
++   munmap(exec_mem, EXEC_HEAP_SIZE);
++   exec_mem = NULL;
++}
++
++
+ static int
+ init_heap(void)
+ {
+-   if (!exec_heap)
+-      exec_heap = u_mmInit( 0, EXEC_HEAP_SIZE );
++   if (exec_heap)
++      return 1;
+ 
+-   if (!exec_mem)
+-      exec_mem = (unsigned char *) mmap(NULL, EXEC_HEAP_SIZE,
+-         PROT_EXEC | PROT_READ | PROT_WRITE,
+-         MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
++   exec_mem = (unsigned char *) mmap(NULL, EXEC_HEAP_SIZE,
++      PROT_EXEC | PROT_READ | PROT_WRITE,
++      MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
++   if (exec_mem == MAP_FAILED)
++      return 0;
+ 
+-   return (exec_mem != MAP_FAILED);
++   exec_heap = u_mmInit(0, EXEC_HEAP_SIZE);
++   if (!exec_heap) {
++      munmap(exec_mem, EXEC_HEAP_SIZE);
++      exec_mem = NULL;
++      return 0;
++   }
++
++   /* The DRI driver can be unloaded before the process exits. Return the
++    * executable arena as well as its bookkeeping when that happens.
++    */
++   if (atexit(destroy_heap) != 0) {
++      destroy_heap();
++      return 0;
++   }
++
++   return 1;
+ }
+ 
+ 
diff --git a/projects/ROCKNIX/packages/graphics/mesa/patches/002-virgl-release-empty-screen-cache.patch b/projects/ROCKNIX/packages/graphics/mesa/patches/002-virgl-release-empty-screen-cache.patch
new file mode 100644
index 0000000000..9c729f3824
--- /dev/null
+++ b/projects/ROCKNIX/packages/graphics/mesa/patches/002-virgl-release-empty-screen-cache.patch
@@ -0,0 +1,46 @@
+Subject: [PATCH] virgl: release an empty screen cache after probe or teardown
+
+The process-global fd table survives a failed virgl probe and the last screen
+release. If the driver is unloaded, its pointer is lost. A software-rendered
+application that repeatedly reloads Mesa then leaks the empty table each time.
+Destroy an empty table under the existing screen mutex, on both paths. Live
+screen entries and their sharing/refcounts are unchanged.
+
+Downstream: rasteratops/distribution#310. LeakSanitizer names 592 bytes per
+failed software-profile probe at virgl_drm_screen_create in Mesa 26.2.2.
+
+--- a/src/gallium/winsys/virgl/drm/virgl_drm_winsys.c
++++ b/src/gallium/winsys/virgl/drm/virgl_drm_winsys.c
+@@ -1305,6 +1305,16 @@
+ static struct hash_table *fd_tab = NULL;
+ static simple_mtx_t virgl_screen_mutex = SIMPLE_MTX_INITIALIZER;
+ 
++/* Called with virgl_screen_mutex held. No screen owns an empty cache. */
++static void
++virgl_drm_release_empty_screen_cache(void)
++{
++   if (fd_tab && fd_tab->entries == 0) {
++      _mesa_hash_table_destroy(fd_tab, NULL);
++      fd_tab = NULL;
++   }
++}
++
+ static void
+ virgl_drm_screen_destroy(struct pipe_screen *pscreen)
+ {
+@@ -1317,6 +1327,7 @@
+    if (destroy) {
+       fd = virgl_drm_winsys(screen->vws)->fd;
+       _mesa_hash_table_remove_key(fd_tab, intptr_to_pointer(fd));
++      virgl_drm_release_empty_screen_cache();
+    }
+    simple_mtx_unlock(&virgl_screen_mutex);
+ 
+@@ -1405,6 +1416,7 @@
+    }
+ 
+ unlock:
++   virgl_drm_release_empty_screen_cache();
+    simple_mtx_unlock(&virgl_screen_mutex);
+    return pscreen;
+ }
