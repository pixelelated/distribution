index 0000000000..6efaf26e4f
--- /dev/null
+++ b/projects/ROCKNIX/packages/network/rclone/sources/cloud_content_transfer
@@ -0,0 +1,158 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)
+
+# Shared by the two content scripts. D-CLOUD-127 applies to content too:
+# SDK retries must not outlive inactivity, but a progressing ROM library
+# has no total-duration limit (#401). Keep the five-counter interpretation
+# aligned with cloud_backup/cloud_restore; a retry's rising total is not
+# progress. These helpers are sourced, never run as a separate command.
+
+child_running() {
+    local _pid _comm state
+    { read -r _pid _comm state _ < "/proc/$1/stat"; } 2>/dev/null || return 1
+    [ "${state}" != "Z" ]
+}
+
+# The furthest rclone's stats block in the tail of a trace has got: bytes
+# transferred, checks done, files transferred, files deleted, entries
+# listed -- five integers on one line. The listed count is the Checks line's
+# "Listed N" (#308, the seats' claude F-CS-13): a first backup against a
+# folder of tens of thousands of files lists for longer than the ceiling
+# before its first check completes, and a count that only read checks
+# ended that run as a stall. The bytes line is the Transferred: with a unit in
+# it; the one without is the file count. A block's last line is glued to
+# the next block's Transferred: (the rule's "Progress output" section),
+# which the sed unglues. Rates, ETAs, percentages and the elapsed time are
+# not progress and are not read.
+progress_mark() {
+    tail -c 8192 "$1" 2>/dev/null | tr '\r' '\n' | sed 's/Transferred:/\nTransferred:/g' | awk '
+        function unit(u) {
+            if (u ~ /^K/) return 1024
+            if (u ~ /^M/) return 1048576
+            if (u ~ /^G/) return 1073741824
+            if (u ~ /^T/) return 1099511627776
+            return 1
+        }
+        /^Transferred:/ {
+            s = $0; sub(/^Transferred:[ \t]*/, "", s); sub(/ \/.*$/, "", s)
+            n = split(s, w, " ")
+            if (n >= 2) { b = w[1] * unit(w[2]); if (b > bytes) bytes = b }
+            else if (n == 1 && w[1] ~ /^[0-9]+$/ && w[1] + 0 > files) files = w[1] + 0
+        }
+        /^Checks:/  { s = $0; sub(/^Checks:[ \t]*/, "", s);  sub(/[^0-9].*$/, "", s); if (s + 0 > checks)  checks  = s + 0
+                      if ($0 ~ /Listed [0-9]/) { l = $0; sub(/^.*Listed /, "", l); sub(/[^0-9].*$/, "", l); if (l + 0 > listed) listed = l + 0 } }
+        /^Deleted:/ { s = $0; sub(/^Deleted:[ \t]*/, "", s); sub(/[^0-9].*$/, "", s); if (s + 0 > deleted) deleted = s + 0 }
+        END { printf "%.0f %.0f %.0f %.0f %.0f\n", bytes, checks, files, deleted, listed }'
+}
+
+# Did any count in <mark> exceed <high water>? Prints the new high water --
+# each field the larger of the two, so a count that falls back (a phase
+# that starts over) never lets an old level read as new progress -- and
+# returns 0 when something grew.
+advance_mark() {
+    local a=($1) b=(${2:-0 0 0 0 0}) i grew=1
+    for i in 0 1 2 3 4; do
+        if [ "${a[$i]:-0}" -gt "${b[$i]:-0}" ] 2>/dev/null; then
+            b[$i]="${a[$i]}"
+            grew=0
+        fi
+    done
+    echo "${b[*]}"
+    return "${grew}"
+}
+
+idle_timeout_seconds() {
+    local v="" prev="" a
+    for a in "$@"; do
+        case "${a}" in
+            --timeout=*) v="${a#--timeout=}" ;;
+            *) [ "${prev}" = "--timeout" ] && v="${a}" ;;
+        esac
+        prev="${a}"
+    done
+    case "${v}" in
+        *h) [[ "${v%h}" =~ ^[0-9]+$ ]] && echo $(( ${v%h} * 3600 )) ;;
+        *m) [[ "${v%m}" =~ ^[0-9]+$ ]] && echo $(( ${v%m} * 60 )) ;;
+        *s) [[ "${v%s}" =~ ^[0-9]+$ ]] && echo "${v%s}" ;;
+        *)  [[ "${v}" =~ ^[0-9]+$ ]] && echo "${v}" ;;
+    esac
+}
+
+# A subshell keeps cleanup traps local: cloud_content_restore also owns
+# the scan's temporary directory. stdout remains the original stats stream;
+# stderr still reaches the caller, including dry-run deletion notices.
+bounded_content_rclone() (
+    local dir="" pid="" tee_pid="" rc=1 ended=0
+    local high="0 0 0 0 0" mark new since now idle ceiling=36 n
+    local -a args=("$@")
+    local has_progress=0 a
+    for a in "$@"; do
+        case "${a}" in --progress|-P) has_progress=1 ;; esac
+    done
+    [ "${has_progress}" -eq 1 ] || args+=(--progress)
+    idle=$(idle_timeout_seconds "$@")
+    [[ "${idle}" =~ ^[0-9]+$ ]] && [ "${idle}" -gt 0 ] && ceiling=$((idle + 6))
+
+    stop_child() {
+        [ -n "$1" ] || return 0
+        if child_running "$1"; then
+            kill -TERM "$1" 2>/dev/null
+            local n=0
+            while [ "${n}" -lt 30 ] && child_running "$1"; do sleep 0.1; n=$((n + 1)); done
+            child_running "$1" && kill -KILL "$1" 2>/dev/null
+        fi
+        wait "$1" 2>/dev/null || true
+    }
+    cleanup() {
+        stop_child "${pid}"
+        stop_child "${tee_pid}"
+        [ -z "${dir}" ] || rm -rf -- "${dir}"
+    }
+    trap cleanup EXIT
+    trap 'exit 130' INT
+    trap 'exit 143' TERM
+    # Failure to create the guard is a failure of this call, never an
+    # unbounded transfer silently accepted as guarded.
+    if ! dir=$(mktemp -d "${CEILING_DIR_ROOT:-/var/run}/cloud-content.XXXXXX")         || ! mkfifo "${dir}/fifo"; then
+        log_message "cannot create content transfer inactivity guard"
+        exit 1
+    fi
+    : > "${dir}/trace" || exit 1
+    tee "${dir}/trace" < "${dir}/fifo" &
+    tee_pid=$!
+    command rclone "${args[@]}" > "${dir}/fifo" &
+    pid=$!
+    since=${SECONDS}
+    while child_running "${pid}"; do
+        sleep 0.25
+        now=${SECONDS}
+        [ "${now}" -gt "${since}" ] || continue
+        mark=$(progress_mark "${dir}/trace")
+        if new=$(advance_mark "${mark}" "${high}"); then
+            high="${new}"
+            since=${SECONDS}
+        elif [ $((now - since)) -ge "${ceiling}" ]; then
+            ended=1
+            stop_child "${pid}"
+            break
+        fi
+    done
+    if [ "${ended}" -eq 1 ]; then
+        rc=124
+        log_message "rclone $1 made no progress for ${ceiling}s; reporting 124"
+    else
+        wait "${pid}"; rc=$?
+    fi
+    pid=""
+    # Drain the final stats before the caller prints the outcome. A
+    # terminated test shim can leave a writer behind; do not wait forever.
+    n=0
+    while [ "${n}" -lt 30 ] && child_running "${tee_pid}"; do sleep 0.1; n=$((n + 1)); done
+    stop_child "${tee_pid}"
+    tee_pid=""
+    if [ -s "${dir}/trace" ] && [ -n "$(tail -c1 "${dir}/trace")" ]; then
+        printf '\n'
+    fi
+    exit "${rc}"
+)
