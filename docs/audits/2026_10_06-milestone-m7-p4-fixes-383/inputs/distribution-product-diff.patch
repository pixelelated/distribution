index 0000000000..26bccfd511
--- /dev/null
+++ b/projects/ROCKNIX/packages/graphics/SDL2/patches/0010-release-display-modes-on-display-removal.patch
@@ -0,0 +1,25 @@
+Subject: [PATCH] video: free mode storage when removing a display
+
+Wayland removes its displays during VideoQuit, before the generic cleanup
+loop. SDL_DelVideoDisplay drops the display count but does not release its
+mode array, so every video reinitialization leaks that allocation. Use the
+same mode/desktop cleanup as the normal quit path before removing the display.
+
+Downstream: rasteratops/distribution#310. Actual Wayland launch cycles under
+LeakSanitizer retain 768 bytes per cycle at SDL_AddDisplayMode before this fix.
+SDL 2.32.10 is the latest SDL2 release checked for this build; the SDL2 branch
+still has the same missing cleanup.
+
+--- a/src/video/SDL_video.c
++++ b/src/video/SDL_video.c
+@@ -693,6 +693,10 @@
+     }
+ 
+     SDL_SendDisplayEvent(&_this->displays[index], SDL_DISPLAYEVENT_DISCONNECTED, 0);
++
++    SDL_ResetDisplayModes(index);
++    SDL_free(_this->displays[index].desktop_mode.driverdata);
++    _this->displays[index].desktop_mode.driverdata = NULL;
+ 
+     SDL_free(_this->displays[index].driverdata);
+     _this->displays[index].driverdata = NULL;
