+function prepare_settings_temp() {
+  # The rename must not widen a private live file or recovery record (#421).
+  # Set the temporary's mode while it is empty, including an old temporary
+  # left by an interrupted writer. Callers hold the settings lock where used.
+  local tmp="${1}" source bits mode=0777 found=0
+  shift
+  [ ! -L "${tmp}" ] && { [ ! -e "${tmp}" ] || [ -f "${tmp}" ]; } || return 1
+  for source in "$@"; do
+    [ "${source}" != "${tmp}" ] || return 1
+    [ -e "${source}" ] || continue
+    bits=$(stat -L -c %a "${source}") || return 1
+    [[ "${bits}" =~ ^[0-7]{1,4}$ ]] || return 1
+    mode=$((mode & 8#${bits}))
+    found=1
+  done
+  [ "${found}" = 1 ] || mode=0600
+  # Never relax the caller's umask either.
+  bits=$(umask); [[ "${bits}" =~ ^[0-7]{1,4}$ ]] || return 1
+  printf -v bits '%o' "$((mode & ~8#${bits} & 0777))"
+  ( umask 077; : > "${tmp}" ) && chmod "${bits}" "${tmp}"
+}
