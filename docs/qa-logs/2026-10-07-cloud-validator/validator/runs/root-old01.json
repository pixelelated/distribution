    "absolute-relative-root-distinction/shim/rclone": {
      "sha256": "dda1f1aa99822733d44830b251d64e4d64fbacfdf30d78033d97cfb4d1102095",
      "bytes": 1013,
      "text": "#!/bin/bash\nprintf '%s\\n' \"$*\" >> /ctl/argv\nif [ -f /ctl/faults ]; then\n while IFS=$'\\t' read -r pattern code; do\n  [[ \"$*\" =~ $pattern ]] && { printf '%s\\n' \"$*\" >> /ctl/fault-fired; echo 'injected provider failure' >&2; exit \"$code\"; }\n done < /ctl/faults\nfi\nif [ -e /ctl/bucket ]; then\n if [ \"$1 $2\" = 'backend features' ]; then\n  printf '{\"Hashes\":[\"md5\"],\"Features\":{\"BucketBased\":true}}\\n'; exit 0\n fi\n # Bucket prefixes can return successful empty lsd for a missing prefix.\n if [ \"$1\" = lsd ]; then exit 0; fi\nfi\nmapped=()\nfor arg in \"$@\"; do\n case \"$arg\" in\n  qa:/*) mapped+=(\":local:/cloud/absolute/${arg#qa:/}\") ;;\n  qa:*) mapped+=(\":local:/cloud/relative/${arg#qa:}\") ;;\n  *) mapped+=(\"$arg\") ;;\n esac\ndone\nif [ \"$1\" = lsf ] && [ \"$2\" = qa:/ ] && { [ -e /ctl/absolute-unreadable ] || [ -e /ctl/root-seeded ]; }; then exit 5; fi\n/rclone.real \"${mapped[@]}\"; rc=$?\nif [ \"$1\" = copyto ] && [ \"$rc\" = 0 ] && [ -e /ctl/fail-seed-readback ]; then touch /ctl/root-seeded; fi\nexit \"$rc\"\nexec /rclone.real \"$@\"\n"
    },
