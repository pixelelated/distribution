        "-c",
        "import copy,hashlib,importlib.util,json,pathlib\nr=pathlib.Path('docs/audits/2026_11_02-epic-m6-patches-unshipped');spec=importlib.util.spec_from_file_location('retire',r/'tools/retirement.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\noriginal=m.load;bad=copy.deepcopy(original('stage-f/retirement-controls-v2.json'));bad['known_children'][0]['joined']=False\nf=r/'stage-f/fixtures/unaccounted-child.json';f.write_text(json.dumps(bad,indent=2)+'\\n')\nm.load=lambda name:bad if name=='stage-f/retirement-controls-v2.json' else original(name)\ntry:m.completed('stage-f/retirement-controls-v2-run.json')\nexcept AssertionError as e:assert 'unaccounted F control child' in str(e);refusal=str(e)\nelse:raise AssertionError('missing child termination not refused')\nm.load=original;positive=m.completed('stage-f/retirement-controls-v2-run.json');assert all(c['joined'] and c['exit']==0 for c in positive['accounted_known_children'])\nplan=(r/'stage-h/retirement-plan.json').read_bytes();value=json.loads(plan);assert len(value['roots'])==889 and plan.endswith(b'\\n')\ncorrection=json.loads((r/'stage-h/planner-correction.json').read_text());assert hashlib.sha256(plan).hexdigest()==correction['stored_plan_sha256']\n# Demonstrate exact malformed suffix refusal and byte-preserving corrected JSON.\nbad_bytes=pathlib.Path(correction['original_raw_path']).read_bytes()\ntry:json.loads(bad_bytes)\nexcept json.JSONDecodeError as e:parse_failure=str(e)\nelse:raise AssertionError('original literal suffix unexpectedly parsed')\nassert json.loads(bad_bytes[:-2])==value\n(r/'stage-f/late-record-controls.json').write_text(json.dumps({'fixture_sha256':hashlib.sha256(f.read_bytes()).hexdigest(),'program_sha256':hashlib.sha256((r/'tools/retirement.py').read_bytes()).hexdigest(),'unaccounted_child_refusal':refusal,'actual_child_positive':positive,'original_plan_parse_failure':parse_failure,'corrected_json_roundtrip':True,'plan_sha256':hashlib.sha256(plan).hexdigest(),'unchanged_root_records':889},indent=2)+'\\n')\nprint('PASS narrow new child-completion refusal/positive and exact planner storage refusal/correction; guard functions retain their tested identities')\n"
