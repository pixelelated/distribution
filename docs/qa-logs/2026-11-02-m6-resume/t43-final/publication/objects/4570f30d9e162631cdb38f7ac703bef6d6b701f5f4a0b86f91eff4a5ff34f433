        rel=str(Path(e.path).relative_to(P))
        assert not stat.S_ISLNK(st.st_mode),rel
        if stat.S_ISDIR(st.st_mode): visit(Path(e.path))
        else:
            assert stat.S_ISREG(st.st_mode),rel
            assert rel not in ['MANIFEST.json']+future,rel
            members[rel]=ident(Path(e.path))
