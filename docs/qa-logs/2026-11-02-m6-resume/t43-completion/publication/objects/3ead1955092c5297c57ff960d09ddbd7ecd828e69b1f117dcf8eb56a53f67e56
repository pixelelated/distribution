from pathlib import Path
import subprocess,json,hashlib,datetime
P=Path('/workspace/tmp/m6-t43/completion-publication')
base='8282cbcade3be32b437f7391be7e216d9a6b1074'
tip=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
names=subprocess.check_output(['git','diff','--name-only','-z',base,tip]).split(b'\0')
names=[n.decode() for n in names if n]
assert len(names)==61
items=[];chunks=[]
for name in names:
    b=subprocess.check_output(['git','show',tip+':'+name])
    chunks.append(b);items.append({'path':name,'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()})
payload=b'\n'.join(chunks)
manifest={'base':base,'tip':tip,'scope':'Every one of the 61 changed completion-record paths in the immutable accepted-final to completion-commit diff. All 3078 existing accepted audit files are independently unchanged by postcommit-scope; no A-H producer/control replay.','excluded_paths':[],'files':items,'count':len(items),'total_bytes':sum(i['bytes'] for i in items),'stdin_bytes':len(payload),'stdin_sha256':hashlib.sha256(payload).hexdigest()}
mp=P/'completion-exact-scan-manifest.json'
with mp.open('x') as f:json.dump(manifest,f,indent=2);f.write('\n')
started=datetime.datetime.now(datetime.timezone.utc).isoformat()
r=subprocess.run(['tools/forbidden-terms-check','--stdin'],input=payload,capture_output=True)
ended=datetime.datetime.now(datetime.timezone.utc).isoformat()
for suffix,b in [('stdout',r.stdout),('stderr',r.stderr)]:
    with (P/('completion-exact-scan.'+suffix)).open('xb') as f:f.write(b)
result={'argv':['tools/forbidden-terms-check','--stdin'],'started':started,'finished':ended,'exit':r.returncode,'stdin_sha256':manifest['stdin_sha256'],'stdin_bytes':len(payload),'manifest_sha256':hashlib.sha256(mp.read_bytes()).hexdigest(),'stdout_sha256':hashlib.sha256(r.stdout).hexdigest(),'stderr_sha256':hashlib.sha256(r.stderr).hexdigest(),'tool_sha256':hashlib.sha256(Path('tools/forbidden-terms-check').read_bytes()).hexdigest(),'note':'Original accepted final-record-scan.py refused a completion packet outside its fixed E-H directory; postcommit-scan rc1 is preserved. This is a separate normal stdin scan of exact completion diff bytes; accepted helper is unchanged.'}
with (P/'completion-exact-scan-result.json').open('x') as f:json.dump(result,f,indent=2);f.write('\n')
print(json.dumps({'exit':r.returncode,'paths':len(items),'repository_bytes':manifest['total_bytes'],'tip':tip,'manifest_sha256':result['manifest_sha256']}))
print(r.stdout.decode(),end='')
raise SystemExit(r.returncode)
