"import base64,datetime,hashlib,json,pathlib,re,subprocess\nR=pathlib.Path.cwd();C=R/'docs/audits/2026_11_03\u002depic\u002dm6\u002drecords/completion';E=pathlib.Path(__file__).resolve().parent;out=E/'final\u002dtrackers';out.mkdir(exist_ok=False);rows=[];commands=[]\ndef sha(b):return hashlib.sha256(b).hexdigest()\nfor n in [1417,693,1416,1415]:\n argv=['gh','api','repos/pixelelated/distribution/issues/'+str(n)];start=datetime.datetime.now(datetime.timezone.utc).isoformat();r=subprocess.run(argv,capture_output=True);end=datetime.datetime.now(datetime.timezone.utc).isoformat();commands.append({'argv':argv,'cwd':str(R),'start':start,'end':end,'rc':r.returncode,'stdout_base64':base64.b64encode(r.stdout).decode(),'stderr_base64':base64.b64encode(r.stderr).decode(),'stdout_sha256':sha(r.stdout),'stderr_sha256':sha(r.stderr)});(out/'commands.json').write_text(json.dumps(commands,indent=2)+'\\n');assert r.returncode==0;x=json.loads(r.stdout);prior=json.loads((C/('tracker\u002d'+str(n)+'.json')).read_text());assert all(x[k]==prior[k] for k in ['number','body','state','state_reason','closed_at']);ticks=re.findall(r'^\\s*\u002d \\[([ xX])\\]',x['body'],re.M);rows.append({'number':n,'state':x['state'],'state_reason':x['state_reason'],'closed_at':x['closed_at'],'body_sha256':sha(x['body'].encode()),'checked':ticks.count('x'),'unchecked':ticks.count(' ')});(out/('tracker\u002d'+str(n)+'.json')).write_bytes(r.stdout)\nresult={'verified_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'exact_committed_bodies_and_states':True,'issues':rows,'tracker_writes':False};(out/'summary.json').write_text(json.dumps(result,indent=2)+'\\n');print(json.dumps(result));print('PASS current final tracker bodies/states/times/criteria equal committed completion evidence')\n"
