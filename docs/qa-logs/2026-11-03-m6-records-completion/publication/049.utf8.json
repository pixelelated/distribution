est/'results.json').write_text(json.dumps(results,indent=2)+'\\n');assert r.returncode==0,name\nprint('PASS '+str(len(results))+' current completion gates; explicit current04/05/plan/source/marker/tracker/checker inputs; no accepted controls replayed')\n"
