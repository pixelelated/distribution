"import base64,datetime,hashlib,json,os,pathlib,stat\nE=pathlib.Path(__file__).resolve().parent;R=pathlib.Path.cwd();A=R/'docs/audits/2026_11_03\u002depic\u002dm6\u002drecords';C=A/'completion';tip='df8058e4353c54b73d4eea4d356ce18df901aabf';base='17a064e6110306dd2b692cfd1b13d4f518d8def5'\ndef sha(b):return hashlib.sha256(b).hexdigest()\ndef load(p):return json.loads((E/p).read_text())\ndef stream(p):\n x=load(p);b=base64.b64decode(x['base64'],validate=True);assert len(b)==x['bytes'] and sha(b)==x['sha256'];return b\nfor p in ['commit','push','remote','clean','tip','hooks\u002dpath','final\u002dscan\u002dcommand','final\u002dtracker\u002dcommand']:assert load(p+'/receipt.json')['rc']==0\nassert stream('remote/stdout.json')==(tip+'\\trefs/heads/feature/m6\u002drecords\u002d693\\n').encode();assert stream('clean/stdout.json')==b'';assert stream('tip/stdout.json').decode().splitlines()[:2]==[tip,base]\nscan=load('final\u002dscan/manifest.json');assert scan['tip']==tip and scan['count']==226 and scan['frozen_count']==976 and scan['rc']==0\ntracker=load('final\u002dtrackers/summary.json');assert tracker['exact_committed_bodies_and_states']\nmarker=json.loads((A/'audit\u002dcompletion.json').read_text());assert marker['schema']==1 and marker['issue']==1417\nexcluded=['publication\u002dmanifest.json','manifest\u002dcommand','checkpoint.md','checkpoint\u002dpost.json','read\u002dcheckpoint.py','checkpoint\u002dreadback.json','checkpoint\u002dreadback\u002dcommand','herdr\u002dmessage.txt','herdr\u002ddelivery'];rows=[]\ndef walk(fd,prefix=''):\n for name in sorted(os.listdir(fd)):\n  if not prefix and name in excluded:continue\n  rel=prefix+name;s=os.stat(name,dir_fd=fd,follow_symlinks=False)\n  if stat.S_ISDIR(s.st_mode):\n   child=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fd)\n   try:walk(child,rel+'/')\n   finally:os.close(child)\n  else:\n   assert stat.S_ISREG(s.st_mode) and not s.st_mode&0o111,rel\n   f=os.open(name,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=fd)\n   with os.fdopen(f,'rb') as inp:b=inp.read();now=os.fstat(inp.fileno())\n   assert (now.st_dev,now.st_ino,now.st_size)==(s.st_dev,s.st_ino,len(b));rows.append({'path':rel,'kind':'ordinary non\u002dexecutable file','bytes':len(b),'sha256':sha(b)})\nfd=os.open(E,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)\ntry:walk(fd)\nfinally:os.close(fd)\nresult={'verified_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'root':str(E),'completion_tip':tip,'accepted_final_fixed_at':base,'marker_sha256':sha((A/'audit\u002dcompletion.json').read_bytes()),'completed_at':marker['completed_at'],'closed_at':'2026\u002d11\u002d03T14:07:02Z','files':rows,'count':len(rows),'logical_bytes':sum(x['bytes'] for x in rows),'file_manifest_sha256':sha(json.dumps(rows,sort_keys=True,separators=(',',':')).encode()),'final_scan':{k:v for k,v in scan.items() if k!='files'},'tracker':tracker,'self_exclusions':excluded,'scope':'Only this newly owned publication root; no old scratch/proof/publication root read. The manifest/active command and later checkpoint/delivery records are not self inputs. Later exact readbacks retain separate hashes.'}\np=E/'publication\u002dmanifest.json';assert not p.exists();p.write_text(json.dumps(result,indent=2)+'\\n');print(json.dumps({k:v for k,v in result.items() if k not in ['files','final_scan','tracker']}));print('publication_manifest_file_sha256='+sha(p.read_bytes()));print('PASS exact published completion tip, clean state, tracker and confined publication evidence')\n"
