# Existing main-menu order: BACK, QUIT, SYSTEM SETTINGS, UPDATES & DOWNLOADS.
key ret
wait-for-change 30 1
settle
shot main-menu-identity
key up
wait-for-change 30 1
key up
wait-for-change 30 1
key up
wait-for-change 30 1
key x
wait-for-change 30 1
settle
shot system-settings
key x
wait-for-change 30 1
settle
shot information
# Information and System Settings each own one Back transition.
# Return to the retained SYSTEM SETTINGS selection in Main Menu, then UPDATES.
key z
wait-for-change 30 1
key z
wait-for-change 30 1
key up
wait-for-change 30 1
key x
wait-for-change 30 1
settle
shot updates
# The manual-updates row is last; reach it by wrapping through BACK.
key up
wait-for-change 30 1
key up
wait-for-change 30 1
key x
wait-for-change 30 1
settle
shot manual-update-message
dismiss-dialogs
