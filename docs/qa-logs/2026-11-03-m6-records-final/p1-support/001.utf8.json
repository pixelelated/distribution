"#!/usr/bin/env python3\n\"\"\"Immutable T46 D record/receipt reader. No lane code imported or executed.\"\"\"\nimport collections,hashlib,json,os,pathlib,re,stat,subprocess\nROOT=pathlib.Path(__file__).parent\nREPO='/workspace/repos/pixelelated/distribution.worktrees/m6\u002drenovation\u002dplan\u002d346'\nD='a0d4c4fda7a0c16c04d57edf921ffeb741eff19b'\nSEED='8710a6210a40de0110244d03a886161ee06faf29'\nSOURCE='d707c82ab8c48b674acc1f95a9571f0cb24d226a'\nV2='647a8831739ffa28995e1955e68225ca0226c926'\nA='docs/audits/2026_11_03\u002depic\u002dm6\u002drecords/'\nPUB='/tmp/m6\u002dt46\u002deh\u002dpublication\u002dkmr8zpxj'\nOBS={};COMMANDS=[]\ndef sha(b):return hashlib.sha256(b).hexdigest()\ndef git(*args,input=None):\n    argv=['git','\u002dC',REPO,*args];COMMANDS.append({'argv':argv,'stdin_sha256':sha(input) if input else None})\n    env=os.environ.copy();env.update(GIT_OPTIONAL_LOCKS='0',GIT_LITERAL_PATHSPECS='1')\n    return subprocess.check_output(argv,input=input,env=env)\ndef blob(p,ref=D):\n    x=git('show',ref+':'+p);OBS[ref+':'+p]={'bytes':len(x),'sha256':sha(x)};return x\ndef b(p,ref=D):return blob(A+p,ref)\ndef j(p,ref=D):return json.loads(b(p,ref))\ndef pubdir(parts=()):\n    fd=os.open('/',os.O_RDONLY|os.O_DIRECTORY)\n    try:\n        for p in PUB.strip('/').split('/')+list(parts):\n            assert p not in ('','.','..')\n            new=os.open(p,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fd);os.close(fd);fd=new\n        return fd\n    except:os.close(fd);raise\ndef confined(rel):\n    parts=rel.split('/');assert all(p not in ('','.','..') for p in parts)\n    fd=pubdir(parts[:\u002d1])\n    try:\n        f=os.open(parts[\u002d1],os.O_RDONLY|os.O_NONBLOCK|os.O_NOFOLLOW,dir_fd=fd)\n        try:\n            info=os.fstat(f);assert stat.S_ISREG(info.st_mode) and not (info.st_mode & 0o111) and info.st_size<40000000\n            chunks=[]\n            while True:\n                d=os.read(f,65536)\n                if not d:break\n                chunks