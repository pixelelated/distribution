"\"\"\"Seal only this lane's ordinary publication receipts; never follow links.\"\"\"\nimport base64,datetime,hashlib,json,os,pathlib,stat\nE=pathlib.Path(__file__).resolve().parent\nTIP=\"17a064e6110306dd2b692cfd1b13d4f518d8def5\"\nS1=\"45d455adccb0b2fc418f6442c4ca16a983430617\"\ndef sha(b):return hashlib.sha256(b).hexdigest()\ndef load(p):return json.loads((E/p).read_text())\ndef stream(p):\n x=load(p);b=base64.b64decode(x['base64'],validate=True);assert len(b)==x['bytes'] and sha(b)==x['sha256'];return b\nfor name in ['final\u002dcommit','final\u002dpush','remote\u002dreadback','clean\u002dreadback','tip\u002dreadback','final\u002dtip\u002dscope','final\u002dscan\u002dcommand','final\u002dtracker\u002dcommand']:\n assert load(name+'/receipt.json')['rc']==0\nassert stream('remote\u002dreadback/stdout.json')==(TIP+'\\trefs/heads/feature/m6\u002drecords\u002d693\\n').encode()\nassert stream('clean\u002dreadback/stdout.json')==b''\nassert stream('tip\u002dreadback/stdout.json').decode().splitlines()[:2]==[TIP,S1]\ns=load('final\u002dscan/manifest.json');assert s['tip']==TIP and s['rc']==0 and s['count']==676 and s['frozen_count']==305\ntrack=load('final\u002dtrackers/summary.json');assert track['slice_693_unchecked']==18 and all(x['state']=='open' and x['unchecked']==0 for x in track['issues'])\nexclude=['publication\u002dmanifest.json','manifest\u002dcommand','final\u002dcheckpoint.md','checkpoint\u002dpost.json','checkpoint\u002dreadback.json','checkpoint\u002dreadback\u002dcommand','read\u002dcheckpoint.py','herdr\u002dmessage.txt','herdr\u002ddelivery']\nrows=[]\ndef walk(fd,prefix=''):\n for name in sorted(os.listdir(fd)):\n  rel=prefix+name\n  if not prefix and name in exclude:continue\n  st=os.stat(name,dir_fd=fd,follow_symlinks=False)\n  assert not stat.S_ISLNK(st.st_mode),rel\n  if stat.S_ISDIR(st.st_mode):\n   child=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fd)\n   try:walk(child,rel+'/')\n   finally:os.close(child)\n  else:\n   assert stat.S_ISREG(st.st_mode) and not st.st_mode&0o111,rel\n   f=os.open(name,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=fd)\n   with os.fdopen(f,'rb') as src:b=src.read();now=os.fstat(src.fileno())\n   assert (now.st_dev,now.st_ino,now.st_size)==(st.st_dev,st.st_ino,len(b)),rel\n   rows.append({'path':rel,'kind':'ordinary non\u002dexecutable file','permissions':oct(st.st_mode&0o777),'bytes':len(b),'sha256':sha(b)})\nfd=os.open(E,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)\ntry:walk(fd)\nfinally:os.close(fd)\nresult={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'root':str(E),'fixed_at':TIP,'source_fix':S1,'reviewed_at':'d707c82ab8c48b674acc1f95a9571f0cb24d226a','execution_seed':'8710a6210a40de0110244d03a886161ee06faf29','files':rows,'count':len(rows),'bytes':sum(x['bytes'] for x in rows),'file_manifest_sha256':sha(json.dumps(rows,sort_keys=True,separators=(',',':')).encode()),'exact_final_scan':{k:v for k,v in s.items() if k!='files'},'trackers':track,'self_exclusions':exclude,'exclusion_meaning':'Manifest/active recorder and later checkpoint/delivery records are not their own inputs. Those later exact readbacks retain separate hashes. No repository bytes are changed.'}\np=E/'publication\u002dmanifest.json';assert not p.exists();p.write_text(json.dumps(result,indent=2)+'\\n')\nprint(json.dumps({k:v for k,v in result.items() if k not in ['files','exact_final_scan','trackers']}))\nprint('manifest_file_sha256='+sha(p.read_bytes()))\nprint('PASS published exact tip, clean status, final source/frozen scan, open checked trackers and confined ordinary receipt manifest')\n"
