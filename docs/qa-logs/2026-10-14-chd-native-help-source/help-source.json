    "//-------------------------------------------------",
    "//  progress - generic progress callback",
    "//-------------------------------------------------",
    "",
    "template <typename Format, typename... Params>",
    "static void progress(bool forceit, Format &&fmt, Params &&...args)",
    "{",
    "\t// skip if it hasn't been long enough",
    "\tclock_t curtime = clock();",
    "\tif (!forceit && lastprogress != 0 && curtime - lastprogress < CLOCKS_PER_SEC / 2)",
    "\t\treturn;",
    "\tlastprogress = curtime;",
    "",
    "\t// standard vfprintf stuff here",
    "\tutil::stream_format(std::cerr, std::forward<Format>(fmt), std::forward<Params>(args)...);",
    "\tstd::cerr << std::flush;",
    "}",
    "",
    "",
    "//-------------------------------------------------",
    "//  print_help - print help for all the commands",
    "//-------------------------------------------------",
    "",
    "static int print_help(const std::string &argv0, const char *error = nullptr)",
    "{",
    "\t// print the error message first",
    "\tif (error)",
    "\t\tutil::stream_format(std::cerr, \"Error: %s\\n\\n\", error);",
    "",
    "\t// print a summary of each command",
    "\tutil::stream_format(std::cout, \"Usage:\\n\");",
    "\tfor (auto & desc : s_commands)",
    "\t{",
    "\t\tutil::stream_format(std::cout, \"   %s %s%s\\n\", argv0, desc.name, desc.description);",
    "\t}",
    "\tutil::stream_format(std::cout, \"\\nFor help with any command, run:\\n\");",
    "\tutil::stream_format(std::cout, \"   %s %s <command>\\n\", argv0, COMMAND_HELP);",
    "\treturn 1;",
    "}"
  ],
