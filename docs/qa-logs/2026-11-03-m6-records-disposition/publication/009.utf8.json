"import datetime,hashlib,json,os,pathlib,subprocess,sys\nroot=pathlib.Path(__file__).resolve().parent;name=sys.argv[1];argv=sys.argv[2:];out=root/name;out.mkdir(exist_ok=False);start=datetime.datetime.now(datetime.timezone.utc).isoformat();p=subprocess.run(argv,capture_output=True);end=datetime.datetime.now(datetime.timezone.utc).isoformat()\ndef sha(b):return hashlib.sha256(b).hexdigest()\n(out/'stdout').write_bytes(p.stdout);(out/'stderr').write_bytes(p.stderr);(out/'receipt.json').write_text(json.dumps({'argv':argv,'cwd':str(pathlib.Path.cwd()),'start':start,'end':end,'rc':p.returncode,'stdout_sha256':sha(p.stdout),'stderr_sha256':sha(p.stderr),'cpus':sorted(os.sched_getaffinity(0)),'recorder_sha256':sha(pathlib.Path(__file__).read_bytes())},indent=2)+'\\n');sys.stdout.buffer.write(p.stdout);sys.stderr.buffer.write(p.stderr);print('EXTERNAL_RECEIPT',out/'receipt.json','rc='+str(p.returncode));sys.exit(p.returncode)\n"
