"import json,subprocess,hashlib,os\nfrom pathlib import Path\np=Path('/tmp/m6\u002dt46\u002dstream\u002dproof\u002dt5\u002d20261103');repo=Path('/workspace/tmp/m6\u002dt46\u002dstream\u002dproof\u002dt5\u002d20261103/repo');D='a0d4c4fda7a0c16c04d57edf921ffeb741eff19b';C='a5693d4a2801e47d2464f53216013d855272cdea';A='docs/audits/2026_11_03\u002depic\u002dm6\u002drecords/'\nassert set(os.sched_getaffinity(0))==set(range(8,24));receipts=[];result={}\ndef sha(b):return hashlib.sha256(b).hexdigest()\ndef git(*a):\n q=subprocess.run(['git',*a],cwd=repo,capture_output=True);receipts.append({'argv':q.args,'rc':q.returncode,'stdout_bytes':len(q.stdout),'stdout_sha256':sha(q.stdout),'stderr_sha256':sha(q.stderr)});assert q.returncode==0,q.stderr;return q.stdout\nfor rel in ['tools/confinement.py','tools/current\u002dgates.py','tools/record\u002dscan.py']:\n print('FROZEN SOURCE',rel,'\\n',git('show',D+':'+A+rel).decode())\nfor rel in ['stage\u002dd/pre\u002dissue\u002dlint/receipt.json','stage\u002dd/gates/audit\u002dissue\u002dlint/receipt.json','stage\u002dd/gates/audit\u002dcheckboxes/receipt.json','stage\u002dd/gates/bug\u002dcheckboxes/receipt.json','stage\u002dd/gates/confinement\u002dcurrent/receipt.json']:\n raw=git('show',D+':'+A+rel);d=json.loads(raw);print('INTERFACE RECEIPT',rel,json.dumps(d));result[rel]={'receipt_sha256':sha(raw),**d}\nmanifest=json.loads((p/'transport\u002dmanifest.json').read_bytes());print('TRANSPORT KEYS',list(manifest) if isinstance(manifest,dict) else 'list');print('TRANSPORT FIRST',json.dumps(manifest[0] if isinstance(manifest,list) else {k:v[:1] if isinstance(v,list) else v for k,v in manifest.items()},indent=2))\nrecords=manifest if isinstance(manifest,list) else next(v for v in manifest.values() if isinstance(v,list))\nassert len(records)==29;frozen={r['path']:r for r in json.loads((p/'frozen\u002dD\u002dmetadata.json').read_bytes())}\nresult['transport']={'entries':29,'entry_keys':list(records[0])}\nfor rec in records:\n for key in ['path','stored_path','original_path','wrapper','transport_path']:\n  if key in rec:\n   name=rec[key]; path=name if name.startswith(A) else A+name\n   assert path in frozen,(key,path)\nresult['transport']['named_paths_inside_frozen']=True\nprint('LINT ISSUE CHECK SOURCE')\nlines=git('show',D+':tools/lint\u002daudit\u002dartifacts').decode().splitlines()\nfor i in range(472,488):print(str(i+1)+': '+lines[i])\nprint('BOX CHECK INTERFACE')\nlines=git('show',D+':tools/box\u002dcheck').decode().splitlines()\nfor i,line in enumerate(lines):\n if '\u002d\u002dissue' in line or 'argparse' in line or 'sys.argv' in line:print(str(i+1)+': '+line)\n# Object\u002donly equality for all named README contexts; no further source body reads.\npins=['d707c82ab8c48b674acc1f95a9571f0cb24d226a','8710a6210a40de0110244d03a886161ee06faf29',D,'f92bc2f372c0c0ed32018975e903ac83b33bf3a5','4eb5dfab8e745914a55e7de3e5a43c5b91ebc608',C]\nreadback={pin:git('ls\u002dtree','\u002dl',pin,'\u002d\u002d','docs/audits/README.md').decode().strip() for pin in pins};assert len(set(readback.values()))==1;result['README_six_pin_metadata_equal']=readback\n(p/'proof\u002d07.json').write_text(json.dumps(result,indent=2)+'\\n');(p/'command\u002d07.json').write_text(json.dumps(receipts,indent=2)+'\\n')\nprint('RESULT SUMMARY',json.dumps({'transport':result['transport'],'readme_six_pin_equality':True},indent=2))\n"
