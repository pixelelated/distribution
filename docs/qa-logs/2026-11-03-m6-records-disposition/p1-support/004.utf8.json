"#!/usr/bin/env python3\n\"\"\"Immutable T46 D record/receipt reader. No lane code imported or executed.\"\"\"\nimport collections,hashlib,json,os,pathlib,re,stat,subprocess\nROOT=pathlib.Path(__file__).parent\nREPO='/workspace/repos/pixelelated/distribution.worktrees/m6\u002drenovation\u002dplan\u002d346'\nD='a0d4c4fda7a0c16c04d57edf921ffeb741eff19b'\nSEED='8710a6210a40de0110244d03a886161ee06faf29'\nSOURCE='d707c82ab8c48b674acc1f95a9571f0cb24d226a'\nV2='647a8831739ffa28995e1955e68225ca0226c926'\nA='docs/audits/2026_11_03\u002depic\u002dm6\u002drecords/'\nPUB='/tmp/m6\u002dt46\u002dd\u002dpublication\u002dpqw4z0xj'\nOBS={};COMMANDS=[]\ndef sha(b):return hashlib.sha256(b).hexdigest()\ndef git(*args,input=None):\n    argv=['git','\u002dC',REPO,*args];COMMANDS.append({'argv':argv,'stdin_sha256':sha(input) if input else None})\n    env=os.environ.copy();env.update(GIT_OPTIONAL_LOCKS='0',GIT_LITERAL_PATHSPECS='1')\n    return subprocess.check_output(argv,input=input,env=env)\ndef blob(p,ref=D):\n    x=git('show',ref+':'+p);OBS[ref+':'+p]={'bytes':len(x),'sha256':sha(x)};return x\ndef b(p,ref=D):return blob(A+p,ref)\ndef j(p,ref=D):return json.loads(b(p,ref))\ndef pubdir(parts=()):\n    fd=os.open('/',os.O_RDONLY|os.O_DIRECTORY)\n    try:\n        for p in PUB.strip('/').split('/')+list(parts):\n            assert p not in ('','.','..')\n            new=os.open(p,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fd);os.close(fd);fd=new\n        return fd\n    except:os.close(fd);raise\ndef confined(rel):\n    parts=rel.split('/');assert all(p not in ('','.','..') for p in parts)\n    fd=pubdir(parts[:\u002d1])\n    try:\n        f=os.open(parts[\u002d1],os.O_RDONLY|os.O_NONBLOCK|os.O_NOFOLLOW,dir_fd=fd)\n        try:\n            info=os.fstat(f);assert stat.S_ISREG(info.st_mode) and info.st_size<40000000\n            chunks=[]\n            while True:\n                d=os.read(f,65536)\n                if not d:break\n                chunks.append(d)\n            data=b''.join(chunks);assert len(data)==info.st_size\n        finally:os.close(f)\n    finally:os.close(fd)\n    OBS[PUB+'/'+rel]={'bytes':len(data),'sha256':sha(data),'confined_nofollow_regular':True};return data\ndef pubnames():\n    fd=pubdir()\n    try:return sorted(os.listdir(fd))\n    finally:os.close(fd)\ndef save(p,x):(ROOT/p).write_text(json.dumps(x,indent=2,ensure_ascii=False)+'\\n')\ndef journal():\n    p=ROOT/'observed\u002dhashes.json';old=json.loads(p.read_text()) if p.exists() else {};old.update(OBS);save(p.name,old)\n    with (ROOT/'commands.jsonl').open('a') as f:\n        for c in COMMANDS:f.write(json.dumps(c)+'\\n')\ndef batch(paths,ref=D):\n    args=['git','\u002dC',REPO,'cat\u002dfile','\u002d\u002dbatch'];COMMANDS.append({'argv':args,'ref':ref,'paths':paths})\n    p=subprocess.Popen(args,stdin=subprocess.PIPE,stdout=subprocess.PIPE)\n    data,_=p.communicate(''.join(ref+':'+x+'\\n' for x in paths).encode());assert p.returncode==0\n    pos=0;out={}\n    for path in paths:\n        end=data.index(b'\\n',pos);head=data[pos:end].split();assert head[1]==b'blob';size=int(head[2]);out[path]=data[end+1:end+1+size];assert data[end+1+size:end+2+size]==b'\\n';pos=end+2+size;OBS[ref+':'+path]={'bytes':size,'sha256':sha(out[path])}\n    assert pos==len(data);return out\n\ndef tree_meta(ref,paths):\n    out={}\n    for row in git('ls\u002dtree','\u002dr','\u002dl','\u002dz',ref,'\u002d\u002d',*paths).split(b'\\0'):\n        if row:\n            meta,p=row.split(b'\\t',1);mode,kind,oid,size=meta.decode().split();out[p.decode()]={'mode':mode,'type':kind,'oid':oid,'bytes':None if size=='\u002d' else int(size)}\n    return out\n\ndef reconcile():\n    checks=[];facts={};qual=[]\n    def ck(label,ok,detail=None):checks.append({'check':label,'pass':bool(ok),'detail':detail})\n    mfraw=confined('final\u002dmanifest.json');mf=json.loads(mfraw)\n    ck('pinned final manifest',sha(mfraw)=='46ecf1d456f71be015600ed5aec2bdceea51bb1b1946dc6ebda3126ad8870b8f')\n    cp=confined('checkpoint\u002dbody.md');ck('pinned checkpoint body',sha(cp)=='82902258632b93462380a9c96a9d4060b975513907e2ee30b2356aa9a589760a')\n    live=json.loads((ROOT/'live\u002dissues.json').read_text());checkpoint=next(x for x in live['comments693'] if x['id']==6604179796)\n    ck('live checkpoint exact body',checkpoint['body'].encode()==cp)\n    changes=[p.decode() for p in git('diff','\u002d\u002dname\u002donly','\u002dz',SEED,D).split(b'\\0') if p]\n    exact={'.github/sessions/saved\u002dsession\u002dstate\u002dfeature\u002dm6\u002drecords\u002d693.md','docs/work\u002dlogs/2026_11\u002dwork_logs/2026_11_03\u002dwork_log.md','docs/work\u002dlogs/INDEX.md'}\n    ck('314 allowed changed records',len(changes)==314 and all(p.startswith(A) or p in exact for p in changes))\n    ck('one single\u002dparent D commit',git('rev\u002dlist',SEED+'..'+D).decode().splitlines()==[D] and git('show','\u002ds','\u002d\u002dformat=%P',D).decode().strip()==SEED)\n    ck('D tree pin',git('show','\u002ds','\u002d\u002dformat=%T',D).decode().strip()==mf['tree']=='05c9988bbee9a9341fedc26eb33bcba698b781bd')\n    meta=tree_meta(D,changes);raw=batch(changes)\n    ck('changed records all ordinary 100644 blobs',set(meta)==set(changes) and all(v['mode']=='100644' and v['type']=='blob' for v in meta.values()))\n    audit={p:v for p,v in raw.items() if p.startswith(A)};facts['audit_files']=len(audit)\n    ck('311 audit artifacts plus 3 allowed records',len(audit)==311 and set(raw)\u002dset(audit)==exact)\n    ck('final manifest exact keys',len(mf['files'])==314 and {x['path'] for x in mf['files']}==set(changes))\n    ck('final manifest exact bytes/SHA',all(len(raw[x['path']])==x['bytes'] and sha(raw[x['path']])==x['sha256'] for x in mf['files']))\n    ck('final scope count/bytes',mf['files_count']==314 and mf['logical_bytes']==sum(map(len,raw.values()))==22391067)\n    ck('manifest list digest',sha(json.dumps(mf['files'],sort_keys=True,separators=(',',':')).encode())==mf['file_manifest_sha256'])\n    scan_input=hashlib.sha256()\n    for x in mf['files']:scan_input.update((x['path']+'\\n').encode()+raw[x['path']]+b'\\n')\n    ck('final scan exact retained stdin digest',scan_input.hexdigest()==mf['stdin_sha256'])\n    facts['final_scope']={k:v for k,v in mf.items() if k not in ['files','forbidden_check']}\n    def J(p):return json.loads(raw[A+p])\n    enc=J('stage\u002dd/publication\u002dencoding/manifest.json');original=dict(raw);transport=[]\n    ck('29 unique transports',len(enc['rows'])==len({x['path'] for x in enc['rows']})==29)\n    for x in enc['rows']:\n        p=x['path'];stored=raw[p]\n        decoded=json.loads(stored).encode() if x['format']=='json\u002dutf8\u002dstring' else json.loads(raw[x['original_archive']]).encode()\n        ok=sha(stored)==x['stored_sha256'] and sha(decoded)==x['original_sha256'] and len(decoded)==x['original_bytes']\n        if x['format']!='json\u002dutf8\u002dstring':ok=ok and json.loads(decoded)==json.loads(stored)\n        ck('transport exact original '+p.removeprefix(A),ok);original[p]=decoded\n        transport.append({'path':p,'format':x['format'],'stored_sha256':sha(stored),'original_sha256':sha(decoded),'original_bytes':len(decoded)})\n    facts['transport_formats']=dict(collections.Counter(x['format'] for x in enc['rows']));save('transport\u002didentities.json',transport)\n    # In\u002dmemory decoding never prints or writes recovered source\u002dline/path text.\n    recorder=sha(raw[A+'tools/record.py']);receipts={};input_results=[]\n    for p in sorted(audit):\n        if not p.endswith('/receipt.json'):continue\n        r=json.loads(original[p]);base=p.rsplit('/',1)[0];receipts[p]=r\n        ck('receipt stream hashes '+p.removeprefix(A),all(sha(original[base+'/'+s])==r[s+'_sha256'] for s in ['stdout','stderr']))\n        ck('receipt command/clock/CPU/recorder '+p.removeprefix(A),bool(r.get('argv')) and r['start']<=r['end'] and isinstance(r['rc'],int) and r.get('cpus')==list(range(8,24)) and r['recorder_sha256']==recorder)\n        for name,expect in r.get('inputs',{}).items():\n            marker='/docs/audits/2026_11_03\u002depic\u002dm6\u002drecords/'\n            loc=A+name.split(marker,1)[1] if marker in name else None\n            observed=original.get(loc) if loc else None\n            row={'receipt':p.removeprefix(A),'input_name_sha256':sha(name.encode()),'expected':expect,'binding':'outside\u002daudit\u002dnot\u002dread','path':loc}\n            if observed is not None:\n                row.update(binding='original\u002dretained\u002daudit\u002dbytes',actual_sha256=sha(observed),actual_bytes=len(observed),matches=sha(observed)==expect['sha256'] and len(observed)==expect['bytes'])\n            input_results.append(row)\n    facts['audit_receipt_bindings']={p.removeprefix(A):v for p,v in receipts.items()};facts['audit_receipts']=len(receipts);facts['audit_exit_histogram']=dict(collections.Counter(str(x['rc']) for x in receipts.values()))\n    internal=[x for x in input_results if x['binding']=='original\u002dretained\u002daudit\u002dbytes'];ck('retained audit input identities',all(x['matches'] for x in internal),[x for x in internal if not x['matches']])\n    facts['explicit_inputs']={'bound_internal':len(internal),'outside_audit_not_read':sum(x['binding']=='outside\u002daudit\u002dnot\u002dread' for x in input_results)};save('receipt\u002dinputs.json',input_results)\n    # External ordinary publication files only; confined handles for each read.\n    pub={n:confined(n) for n in ['record.py','final\u002dscan.py','handback.json','checkpoint\u002dbody.md','checkpoint\u002dreadback.json','checkpoint\u002dreadback.stdout','checkpoint\u002dreadback.stderr','final\u002dforbidden.stdout','final\u002dforbidden.stderr']}\n    pubruns=['stage','staged\u002ddiff\u002dcheck','commit','stage\u002dv2','staged\u002ddiff\u002dcheck\u002dv2','commit\u002dv2','committed\u002dstate','confinement\u002dpublished\u002dcandidate','final\u002drecord\u002dscan','push','remote\u002dreadback','final\u002dclean','checkpoint\u002dreadback','herdr\u002dhandback']\n    prec={}\n    for n in pubruns:\n        for leaf in ['receipt.json','stdout','stderr']:pub[n+'/'+leaf]=confined(n+'/'+leaf)\n        r=json.loads(pub[n+'/receipt.json']);prec[n]=r\n        ck('external receipt '+n,all(sha(pub[n+'/'+s])==r[s+'_sha256'] for s in ['stdout','stderr']) and r['recorder_sha256']==sha(pub['record.py']) and r['start']<=r['end'] and r['cpus']==list(range(8,24)))\n    h=json.loads(pub['handback.json']);ck('checkpoint handback JSON equals retained',json.loads(re.search(r'```json\\n(.*?)\\n```',cp.decode(),re.S)[1])==h)\n    ck('handback publication equals manifest',{k:v for k,v in mf.items() if k!='files'}==h['publication'])\n    ck('handback selected receipts equal actual',all(prec[n]==r for n,r in h['receipts'].items()))\n    for name in ['commit\u002dv2','push','remote\u002dreadback','final\u002dclean','final\u002drecord\u002dscan','confinement\u002dpublished\u002dcandidate']:ck('publication actual exit '+name,prec[name]['rc']==0)\n    ck('original publication failures retained',prec['staged\u002ddiff\u002dcheck']['rc']==2 and prec['commit']['rc']==1)\n    ck('remote exact D',pub['remote\u002dreadback/stdout'].decode().strip()==D+'\\trefs/heads/feature/m6\u002drecords\u002d693')\n    ck('status empty',pub['final\u002dclean/stdout']==b'')\n    ck('forbidden inner streams/exit',mf['forbidden_check']['rc']==0 and all(sha(pub['final\u002dforbidden.'+s])==mf['forbidden_check'][s+'_sha256'] for s in ['stdout','stderr']))\n    ck('final scan stdout bound to pinned manifest',json.loads(pub['final\u002drecord\u002dscan/stdout'].decode().splitlines()[0])=={k:v for k,v in mf.items() if k!='files'})\n    inner=json.loads(pub['checkpoint\u002dreadback.json']);ck('actual inner tracker readback streams and exit',inner['rc']==0 and inner['id']==6604179796 and inner['body_sha256']==sha(cp) and inner==json.loads(pub['checkpoint\u002dreadback/stdout']) and all(inner[s+'_sha256']==sha(pub['checkpoint\u002dreadback.'+s]) for s in ['stdout','stderr']) and json.loads(pub['checkpoint\u002dreadback.stdout'])['body'].encode()==cp);facts['inner_checkpoint_readback']=inner\n    pc=json.loads(pub['confinement\u002dpublished\u002dcandidate/stdout'].decode().splitlines()[0]);ck('published confinement receipt exact seed tip and paths',pc['seed']==SEED and pc['tip']==D and not pc['refusals'] and len(pc['commits'])==2 and pc['commits'][0]['commit']==D and set(pc['commits'][0]['paths'])==set(pc['commits'][1]['working_paths'])==set(changes))\n    facts['publication_programs_current_observation']={n:sha(confined(n)) for n in ['record.py','final\u002dscan.py','verify\u002dcheckpoint.py']}\n    facts['publication_exit_histogram']=dict(collections.Counter(str(x['rc']) for x in prec.values()));facts['publication_receipts']=len(prec);facts['publication_receipt_exits']={n:r['rc'] for n,r in prec.items()};facts['publication_bindings']=prec\n    s=J('stage\u002da/summary.json');g=J('stage\u002da/groups.json');t=J('stage\u002db/table.json');ranges=J('stage\u002db/ranges.json');obs=J('stage\u002db/observations.json');direct=J('stage\u002db/route\u002dinputs.json');heads=J('stage\u002db/heading\u002dmetadata.json')\n    ck('source and seed remain separate',s['source_commit']==SOURCE and t['seed']==SEED and git('show','\u002ds','\u002d\u002dformat=%T',SOURCE).decode().strip()==s['source_tree']=='b3ce6c6ea70d9d40ff2b74fff691a0a11f70e437')\n    ck('table source/group identity',t['source_summary']==s and t['groups']==g)\n    ck('ten group sums',len(g)==10 and sum(x['paths'] for x in g.values())==s['paths']==127469 and sum(x['logical_bytes'] for x in g.values())==s['logical_bytes']==2190843187)\n    modes=collections.Counter()\n    for x in g.values():modes.update(x['modes'])\n    ck('group modes sum',dict(modes)==s['modes']=={'100644':98024,'100755':29445})\n    ck('recorded unique blob totals',s['unique_blobs']==38355 and s['unique_blob_logical_bytes']==1084128032)\n    cm={ref:tree