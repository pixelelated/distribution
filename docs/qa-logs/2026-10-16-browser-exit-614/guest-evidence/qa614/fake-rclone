#!/usr/bin/python3
import os,sys,json,time,http.server
from pathlib import Path
ROOT=Path('/storage/qa614')
if len(sys.argv)<2 or sys.argv[1]!='authorize':os.execv(str(ROOT/'rclone-original'),sys.argv)
PAGE='''<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"></head><body style="font:20px sans-serif;background:#fff;color:#123"><h1>Browser exit test</h1><p>Synthetic local page. No account is used.</p><input id="field" type="text" placeholder="Test keyboard"><div id="consent" style="border:2px solid #234;padding:10px">Consent-style overlay <button onclick="document.getElementById('consent').remove()">Dismiss</button></div><p id="events">Waiting for input</p><script>
function log(kind,e){let v={kind:kind,key:e?.key||'',trusted:e?.isTrusted||false,active:document.activeElement?.id||'',length:document.querySelector('#field').value.length,at:Date.now()};document.querySelector('#events').textContent=JSON.stringify(v);fetch('/event',{method:'POST',body:JSON.stringify(v),keepalive:true}).catch(()=>{});}
window.addEventListener('keydown',e=>log('keydown-capture',e),true);window.addEventListener('keydown',e=>log('keydown-bubble',e));window.addEventListener('focus',e=>log('focus',e));window.addEventListener('blur',e=>log('blur',e));document.querySelector('#field').addEventListener('input',e=>log('input',e));window.addEventListener('load',()=>{document.querySelector('#field').focus();log('loaded')});
</script></body></html>'''.encode()
class H(http.server.BaseHTTPRequestHandler):
 def log_message(self,*a):pass
 def do_GET(self):
  if self.path.startswith('/auth'):
   self.send_response(302);self.send_header('Location','http://127.0.0.1:53682/page');self.end_headers();return
  self.send_response(200);self.send_header('Content-Type','text/html');self.send_header('Content-Length',str(len(PAGE)));self.end_headers();self.wfile.write(PAGE)
 def do_HEAD(self):self.do_GET()
 def do_POST(self):
  n=int(self.headers.get('Content-Length','0'));assert 0<=n<=4096
  row=json.loads(self.rfile.read(n));row['host_monotonic']=time.monotonic()
  with (ROOT/'page-events.jsonl').open('a') as f:f.write(json.dumps(row)+'\n')
  self.send_response(204);self.end_headers()
server=http.server.HTTPServer(('127.0.0.1',53682),H)
print('http://127.0.0.1:53682/auth?state=synthetic-qa614',flush=True)
server.serve_forever()
