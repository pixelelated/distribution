[{"sha":"9516f454b87f3d28e82ba500f090afc87f8586df","node_id":"C_kwDOAAqEwNoAKDk1MTZmNDU0Yjg3ZjNkMjhlODJiYTUwMGYwOTBhZmM4N2Y4NTg2ZGY","commit":{"author":{"name":"LibretroAdmin","email":"LibretroAdmin@users.noreply.github.com","date":"2026-09-09T08:56:27Z"},"committer":{"name":"libretroadmin","email":"libretroadmin@users.noreply.github.com","date":"2026-09-09T08:55:28Z"},"message":"The reference Zstandard library goes; the built-in codec is the one\n\nWith every platform build on HAVE_RZSTD, HAVE_ZSTD had no user: the\nconfigure option, the deps/zstd tree it built, griffin's inclusion\nof it, the Makefile.common objects, the UWP and Android include\npaths, and the other branch of every site that could take either\nbackend - the input replays, the RVZ hashing, the .zst archive and\nzip-member readers, the CHD hunk decoder - are gone, and each site\nis the one path. Every gate that read 'either backend' reads\nHAVE_RZSTD.","tree":{"sha":"38155fdf27fb2e0551f28173e902b9c73dfc1a70","url":"https://api.github.com/repos/libretro/RetroArch/git/trees/38155fdf27fb2e0551f28173e902b9c73dfc1a70"},"url":"https://api.github.com/repos/libretro/RetroArch/git/commits/9516f454b87f3d28e82ba500f090afc87f8586df","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/libretro/RetroArch/commits/9516f454b87f3d28e82ba500f090afc87f8586df","html_url":"https://github.com/libretro/RetroArch/commit/9516f454b87f3d28e82ba500f090afc87f8586df","comments_url":"https://api.github.com/repos/libretro/RetroArch/commits/9516f454b87f3d28e82ba500f090afc87f8586df/comments","author":{"login":"LibretroAdmin","id":105389611,"node_id":"U_kgDOBkgeKw","avatar_url":"https://avatars.githubusercontent.com/u/105389611?v=4","gravatar_id":"","url":"https://api.github.com/users/LibretroAdmin","html_url":"https://github.com/LibretroAdmin","followers_url":"https://api.github.com/users/LibretroAdmin/followers","following_url":"https://api.github.com/users/LibretroAdmin/following{/other_user}","gists_url":"https://api.github.com/users/LibretroAdmin/gists{/gist_id}","starred_url":"https://api.github.com/users/LibretroAdmin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LibretroAdmin/subscriptions","organizations_url":"https://api.github.com/users/LibretroAdmin/orgs","repos_url":"https://api.github.com/users/LibretroAdmin/repos","events_url":"https://api.github.com/users/LibretroAdmin/events{/privacy}","received_events_url":"https://api.github.com/users/LibretroAdmin/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"LibretroAdmin","id":105389611,"node_id":"U_kgDOBkgeKw","avatar_url":"https://avatars.githubusercontent.com/u/105389611?v=4","gravatar_id":"","url":"https://api.github.com/users/LibretroAdmin","html_url":"https://github.com/LibretroAdmin","followers_url":"https://api.github.com/users/LibretroAdmin/followers","following_url":"https://api.github.com/users/LibretroAdmin/following{/other_user}","gists_url":"https://api.github.com/users/LibretroAdmin/gists{/gist_id}","starred_url":"https://api.github.com/users/LibretroAdmin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LibretroAdmin/subscriptions","organizations_url":"https://api.github.com/users/LibretroAdmin/orgs","repos_url":"https://api.github.com/users/LibretroAdmin/repos","events_url":"https://api.github.com/users/LibretroAdmin/events{/privacy}","received_events_url":"https://api.github.com/users/LibretroAdmin/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ef6e003b2be62bc7ca81b48e67cbc779eb960148","url":"https://api.github.com/repos/libretro/RetroArch/commits/ef6e003b2be62bc7ca81b48e67cbc779eb960148","html_url":"https://github.com/libretro/RetroArch/commit/ef6e003b2be62bc7ca81b48e67cbc779eb960148"}]},{"sha":"2b4a480517ec6fe40ef666fb49adf123def38cd2","node_id":"C_kwDOAAqEwNoAKDJiNGE0ODA1MTdlYzZmZTQwZWY2NjZmYjQ5YWRmMTIzZGVmMzhjZDI","commit":{"author":{"name":"libretroadmin","email":"libretroadmin@users.noreply.github.com","date":"2026-07-26T18:45:07Z"},"committer":{"name":"libretroadmin","email":"libretroadmin@users.noreply.github.com","date":"2026-07-26T18:43:19Z"},"message":"zstd: pair every HAVE_ZSTD gate that means \"Zstandard exists\"\n\nThe flag was doing two jobs.  In some places it means \"the reference\nlibrary is available\", and in others it means \"this build supports\nZstandard at all\".  Moving four platforms to HAVE_RZSTD turned off the\nsecond meaning along with the first, and each of these was left alone:\n\n  archive_file.c    file_archive_get_zstd_file_backend returned NULL,\n                    so a .zst archive could not be opened at all\n  archive_file.c    the .zst extension was not dispatched\n  archive_file.c    the any-compression-backend guard excluded it\n  task_decompress.c .zst was not excluded from re-compression\n  config.features.h SUPPORTS_ZSTD was false\n  retroarch.c       the capability string omitted zstd\n  menu_displaylist  the menu did not list Zstandard\n  cheevos_rvz.c     three outer gates, so RVZ groups compressed with\n                    Zstandard were not handled\n\nAll now test for either flag.  Only one is ever active, and the places\nthat genuinely mean the reference library - griffin's deps/zstd\nincludes, the <zstd.h> include in bsvmovie, libchdr - are untouched.\n\nVerified by asking what a build believes rather than whether it\ncompiles: with only HAVE_RZSTD, SUPPORTS_ZSTD is true and every path\nabove is present; with only HAVE_ZSTD, the same; with neither, all off,\nwhich is the intended third state.  Every touched file compiles with\nzero errors in all three configurations.\n\nThis should have been one pass over what the flag gated before any of it\nmoved, rather than found a caller at a time.","tree":{"sha":"de3f8ec8e5e92b464f3e255b6372a3b51b09af14","url":"https://api.github.com/repos/libretro/RetroArch/git/trees/de3f8ec8e5e92b464f3e255b6372a3b51b09af14"},"url":"https://api.github.com/repos/libretro/RetroArch/git/commits/2b4a480517ec6fe40ef666fb49adf123def38cd2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/libretro/RetroArch/commits/2b4a480517ec6fe40ef666fb49adf123def38cd2","html_url":"https://github.com/libretro/RetroArch/commit/2b4a480517ec6fe40ef666fb49adf123def38cd2","comments_url":"https://api.github.com/repos/libretro/RetroArch/commits/2b4a480517ec6fe40ef666fb49adf123def38cd2/comments","author":{"login":"LibretroAdmin","id":105389611,"node_id":"U_kgDOBkgeKw","avatar_url":"https://avatars.githubusercontent.com/u/105389611?v=4","gravatar_id":"","url":"https://api.github.com/users/LibretroAdmin","html_url":"https://github.com/LibretroAdmin","followers_url":"https://api.github.com/users/LibretroAdmin/followers","following_url":"https://api.github.com/users/LibretroAdmin/following{/other_user}","gists_url":"https://api.github.com/users/LibretroAdmin/gists{/gist_id}","starred_url":"https://api.github.com/users/LibretroAdmin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LibretroAdmin/subscriptions","organizations_url":"https://api.github.com/users/LibretroAdmin/orgs","repos_url":"https://api.github.com/users/LibretroAdmin/repos","events_url":"https://api.github.com/users/LibretroAdmin/events{/privacy}","received_events_url":"https://api.github.com/users/LibretroAdmin/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"LibretroAdmin","id":105389611,"node_id":"U_kgDOBkgeKw","avatar_url":"https://avatars.githubusercontent.com/u/105389611?v=4","gravatar_id":"","url":"https://api.github.com/users/LibretroAdmin","html_url":"https://github.com/LibretroAdmin","followers_url":"https://api.github.com/users/LibretroAdmin/followers","following_url":"https://api.github.com/users/LibretroAdmin/following{/other_user}","gists_url":"https://api.github.com/users/LibretroAdmin/gists{/gist_id}","starred_url":"https://api.github.com/users/LibretroAdmin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LibretroAdmin/subscriptions","organizations_url":"https://api.github.com/users/LibretroAdmin/orgs","repos_url":"https://api.github.com/users/LibretroAdmin/repos","events_url":"https://api.github.com/users/LibretroAdmin/events{/privacy}","received_events_url":"https://api.github.com/users/LibretroAdmin/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2e8514e739071e4396e2d1e243272364e9b687ef","url":"https://api.github.com/repos/libretro/RetroArch/commits/2e8514e739071e4396e2d1e243272364e9b687ef","html_url":"https://github.com/libretro/RetroArch/commit/2e8514e739071e4396e2d1e243272364e9b687ef"}]},{"sha":"e66cee3d93a34c9953699010a2046244a6253567","node_id":"C_kwDOAAqEwNoAKGU2NmNlZTNkOTNhMzRjOTk1MzY5OTAxMGEyMDQ2MjQ0YTYyNTM1Njc","commit":{"author":{"name":"libretroadmin","email":"libretroadmin@users.noreply.github.com","date":"2026-07-26T18:23:14Z"},"committer":{"name":"libretroadmin","email":"libretroadmin@users.noreply.github.com","date":"2026-07-26T18:21:41Z"},"message":"zstd: gate the built-in codec behind HAVE_RZSTD, and build it\n\nThe UWP build failed to link: rzstd_decode and rzstd_frame_content_size\nunresolved.  Two callers were moved to the built-in codec without the\ncodec being added to any build system, so griffin compiled calls to a\nfile it never included.  That is the whole of the failure, and it would\nhave hit every platform building through griffin.\n\nThe codec is now wired in three places - a HAVE_RZSTD parameter in qb, a\nrule in Makefile.common that compiles encodings/encoding_rzstd.o and\ndefines HAVE_RZSTD, and an include in griffin guarded the same way.  It\ndefaults to off, so nothing changes for a platform until it opts in.\n\nBoth migrated callers now compile against either backend.  HAVE_RZSTD\nselects the built-in codec; without it they use the reference library\nexactly as before.  Once every platform has moved, HAVE_ZSTD and\ndeps/zstd can go together.\n\nTwo things the wiring got wrong at first, both caught by testing the\nrule rather than reading it:\n\nThe archive backend is needed whenever there is any decoder, so it was\ngated on the two flags concatenated - which is \"00\" when both are off,\nand not empty, so it was built with no decoder at all.  It filters for\n1 now.\n\nAnd one of the three content-size calls in the archive backend was left\nungated, which the reference-only build found as an implicit\ndeclaration.  There were three, not two.\n\nDiagnostics are unchanged from before any of this work: five in the\narchive backend and two in cheevos, both configurations, all\npre-existing.  A reference-produced archive still decodes byte for byte\neither way, and rzstd's own three thousand round trips still pass.","tree":{"sha":"31d43dc641a549051e88a488bbf3e77ecbc43327","url":"https://api.github.com/repos/libretro/RetroArch/git/trees/31d43dc641a549051e88a488bbf3e77ecbc43327"},"url":"https://api.github.com/repos/libretro/RetroArch/git/commits/e66cee3d93a34c9953699010a2046244a6253567","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/libretro/RetroArch/commits/e66cee3d93a34c9953699010a2046244a6253567","html_url":"https://github.com/libretro/RetroArch/commit/e66cee3d93a34c9953699010a2046244a6253567","comments_url":"https://api.github.com/repos/libretro/RetroArch/commits/e66cee3d93a34c9953699010a2046244a6253567/comments","author":{"login":"LibretroAdmin","id":105389611,"node_id":"U_kgDOBkgeKw","avatar_url":"https://avatars.githubusercontent.com/u/105389611?v=4","gravatar_id":"","url":"https://api.github.com/users/LibretroAdmin","html_url":"https://github.com/LibretroAdmin","followers_url":"https://api.github.com/users/LibretroAdmin/followers","following_url":"https://api.github.com/users/LibretroAdmin/following{/other_user}","gists_url":"https://api.github.com/users/LibretroAdmin/gists{/gist_id}","starred_url":"https://api.github.com/users/LibretroAdmin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LibretroAdmin/subscriptions","organizations_url":"https://api.github.com/users/LibretroAdmin/orgs","repos_url":"https://api.github.com/users/LibretroAdmin/repos","events_url":"https://api.github.com/users/LibretroAdmin/events{/privacy}","received_events_url":"https://api.github.com/users/LibretroAdmin/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"LibretroAdmin","id":105389611,"node_id":"U_kgDOBkgeKw","avatar_url":"https://avatars.githubusercontent.com/u/105389611?v=4","gravatar_id":"","url":"https://api.github.com/users/LibretroAdmin","html_url":"https://github.com/LibretroAdmin","followers_url":"https://api.github.com/users/LibretroAdmin/followers","following_url":"https://api.github.com/users/LibretroAdmin/following{/other_user}","gists_url":"https://api.github.com/users/LibretroAdmin/gists{/gist_id}","starred_url":"https://api.github.com/users/LibretroAdmin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LibretroAdmin/subscriptions","organizations_url":"https://api.github.com/users/LibretroAdmin/orgs","repos_url":"https://api.github.com/users/LibretroAdmin/repos","events_url":"https://api.github.com/users/LibretroAdmin/events{/privacy}","received_events_url":"https://api.github.com/users/LibretroAdmin/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ce64fb57cd3885a6a73ebabc6d196675f7c49249","url":"https://api.github.com/repos/libretro/RetroArch/commits/ce64fb57cd3885a6a73ebabc6d196675f7c49249","html_url":"https://github.com/libretro/RetroArch/commit/ce64fb57cd3885a6a73ebabc6d196675f7c49249"}]},{"sha":"e1c3e4dfe1ba21d3566a36e0ee565eb6a350c4ab","node_id":"C_kwDOAAqEwNoAKGUxYzNlNGRmZTFiYTIxZDM1NjZhMzZlMGVlNTY1ZWI2YTM1MGM0YWI","commit":{"author":{"name":"libretroadmin","email":"libretroadmin@users.noreply.github.com","date":"2026-07-26T18:15:50Z"},"committer":{"name":"libretroadmin","email":"libretroadmin@users.noreply.github.com","date":"2026-07-26T18:16:28Z"},"message":"cheevos_rvz: decode through rzstd\n\nThe second of the four callers of <zstd.h> to move.  It wants a one-shot\ndecode, a frame's declared content size, and a name for a failure;\nrzstd has all three.\n\nError reporting keeps its shape but says less, because there is less to\nsay.  rzstd gives one name to every failure on purpose: it separates\ntruncated input from corrupt input from an unsupported feature\ninternally, and a caller can do nothing different about any of them.\nThe log line still identifies which stage failed, which is the part that\nlocates a problem.\n\nOne behavioural difference was worth checking before trusting this.\nrzstd_decode refuses a frame followed by trailing bytes, and RVZ passes\nlengths taken from the container's own size fields rather than measuring\nthe frames.  Tested: the reference refuses the same thing, so the two\nagree and a container whose sizes were loose would already have been\nfailing.\n\nDiagnostics are unchanged at two, both pre-existing.\n\nOf the four callers, formats/libchdr/libchdr_zstd.c goes away with\nlibchdr and input/bsv/bsvmovie.c is the only one that compresses -\nwhere rzstd now produces smaller output than the reference, faster.","tree":{"sha":"7d3fe73e64a3f327f97f353b72f3a74ae903211b","url":"https://api.github.com/repos/libretro/RetroArch/git/trees/7d3fe73e64a3f327f97f353b72f3a74ae903211b"},"url":"https://api.github.com/repos/libretro/RetroArch/git/commits/e1c3e4dfe1ba21d3566a36e0ee565eb6a350c4ab","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/libretro/RetroArch/commits/e1c3e4dfe1ba21d3566a36e0ee565eb6a350c4ab","html_url":"https://github.com/libretro/RetroArch/commit/e1c3e4dfe1ba21d3566a36e0ee565eb6a350c4ab","comments_url":"https://api.github.com/repos/libretro/RetroArch/commits/e1c3e4dfe1ba21d3566a36e0ee565eb6a350c4ab/comments","author":{"login":"LibretroAdmin","id":105389611,"node_id":"U_kgDOBkgeKw","avatar_url":"https://avatars.githubusercontent.com/u/105389611?v=4","gravatar_id":"","url":"https://api.github.com/users/LibretroAdmin","html_url":"https://github.com/LibretroAdmin","followers_url":"https://api.github.com/users/LibretroAdmin/followers","following_url":"https://api.github.com/users/LibretroAdmin/following{/other_user}","gists_url":"https://api.github.com/users/LibretroAdmin/gists{/gist_id}","starred_url":"https://api.github.com/users/LibretroAdmin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LibretroAdmin/subscriptions","organizations_url":"https://api.github.com/users/LibretroAdmin/orgs","repos_url":"https://api.github.com/users/LibretroAdmin/repos","events_url":"https://api.github.com/users/LibretroAdmin/events{/privacy}","received_events_url":"https://api.github.com/users/LibretroAdmin/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"LibretroAdmin","id":105389611,"node_id":"U_kgDOBkgeKw","avatar_url":"https://avatars.githubusercontent.com/u/105389611?v=4","gravatar_id":"","url":"https://api.github.com/users/LibretroAdmin","html_url":"https://github.com/LibretroAdmin","followers_url":"https://api.github.com/users/LibretroAdmin/followers","following_url":"https://api.github.com/users/LibretroAdmin/following{/other_user}","gists_url":"https://api.github.com/users/LibretroAdmin/gists{/gist_id}","starred_url":"https://api.github.com/users/LibretroAdmin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LibretroAdmin/subscriptions","organizations_url":"https://api.github.com/users/LibretroAdmin/orgs","repos_url":"https://api.github.com/users/LibretroAdmin/repos","events_url":"https://api.github.com/users/LibretroAdmin/events{/privacy}","received_events_url":"https://api.github.com/users/LibretroAdmin/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"06195e3364d6d89052f3457adcec6a23c08f3417","url":"https://api.github.com/repos/libretro/RetroArch/commits/06195e3364d6d89052f3457adcec6a23c08f3417","html_url":"https://github.com/libretro/RetroArch/commit/06195e3364d6d89052f3457adcec6a23c08f3417"}]},{"sha":"f6704afb34931a6c191efa2de54c1fd627ba2803","node_id":"C_kwDOAAqEwNoAKGY2NzA0YWZiMzQ5MzFhNmMxOTFlZmEyZGU1NGMxZmQ2MjdiYTI4MDM","commit":{"author":{"name":"LibretroAdmin","email":"LibretroAdmin@users.noreply.github.com","date":"2026-07-17T20:50:58Z"},"committer":{"name":"libretroadmin","email":"libretroadmin@users.noreply.github.com","date":"2026-07-17T20:49:51Z"},"message":"cheevos/rvz: fix host-dependent junk data on big-endian hosts\n\nThe lagged Fibonacci generator stored its output words with an\nunconditional SWAP32. The RVZ junk byte stream is defined as the\nbig-endian serialization of the tweaked words (Dolphin's reference\nimplementation assumes a little-endian host, where an unconditional\nswap and a big-endian store are the same thing). On big-endian hosts\nthe unconditional swap instead produces per-word byte-reversed junk,\nso reconstructed disc data - and therefore cheevos hashes - for RVZ\nimages with junk regions would be wrong.\n\nStore via swap_if_little32 (host -> big-endian) instead. Verified\nempirically with the LFG extracted into a harness and executed on both\nx86-64 and qemu-ppc: output is bit-identical on little-endian before\nand after, and the fixed big-endian build now matches the\nlittle-endian reference (the old code diverged).","tree":{"sha":"90002767ff6460b6dbca9ab098ddeaa419d75f13","url":"https://api.github.com/repos/libretro/RetroArch/git/trees/90002767ff6460b6dbca9ab098ddeaa419d75f13"},"url":"https://api.github.com/repos/libretro/RetroArch/git/commits/f6704afb34931a6c191efa2de54c1fd627ba2803","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/libretro/RetroArch/commits/f6704afb34931a6c191efa2de54c1fd627ba2803","html_url":"https://github.com/libretro/RetroArch/commit/f6704afb34931a6c191efa2de54c1fd627ba2803","comments_url":"https://api.github.com/repos/libretro/RetroArch/commits/f6704afb34931a6c191efa2de54c1fd627ba2803/comments","author":{"login":"LibretroAdmin","id":105389611,"node_id":"U_kgDOBkgeKw","avatar_url":"https://avatars.githubusercontent.com/u/105389611?v=4","gravatar_id":"","url":"https://api.github.com/users/LibretroAdmin","html_url":"https://github.com/LibretroAdmin","followers_url":"https://api.github.com/users/LibretroAdmin/followers","following_url":"https://api.github.com/users/LibretroAdmin/following{/other_user}","gists_url":"https://api.github.com/users/LibretroAdmin/gists{/gist_id}","starred_url":"https://api.github.com/users/LibretroAdmin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LibretroAdmin/subscriptions","organizations_url":"https://api.github.com/users/LibretroAdmin/orgs","repos_url":"https://api.github.com/users/LibretroAdmin/repos","events_url":"https://api.github.com/users/LibretroAdmin/events{/privacy}","received_events_url":"https://api.github.com/users/LibretroAdmin/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"LibretroAdmin","id":105389611,"node_id":"U_kgDOBkgeKw","avatar_url":"https://avatars.githubusercontent.com/u/105389611?v=4","gravatar_id":"","url":"https://api.github.com/users/LibretroAdmin","html_url":"https://github.com/LibretroAdmin","followers_url":"https://api.github.com/users/LibretroAdmin/followers","following_url":"https://api.github.com/users/LibretroAdmin/following{/other_user}","gists_url":"