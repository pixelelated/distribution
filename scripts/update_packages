#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2023 JELOS (https://github.com/JustEnoughLinuxOS)

# Based on work by ToKe79 and Shanti Gilbert

OPTIONS="distributions/ROCKNIX/options"
PACKAGES=("projects/ROCKNIX/packages/virtual/emulators/package.mk" \
          "projects/ROCKNIX/packages/virtual/es-themes/package.mk" \
          "projects/ROCKNIX/packages/virtual/gamesupport/package.mk" )
BLOCKLIST="config/blocklist"

update_packages() {
  for p in $PACKAGES_ALL
  do
    PKG_PATH="./projects/ROCKNIX/packages"
    echo "Operating on ${p}"
    f=$(find ${PKG_PATH} -type d -name "${p}")
    if [ "$(grep ${p} ${BLOCKLIST})" ]
    then
      echo "Skipping ${p}"
      continue
    fi
    f="${f}/package.mk"
    echo "${p}: ${f}"
    if [ ! "${p}" ] && [ ! "${f}" ]
    then
      echo "Package not found, skipping."
      continue
    fi
    source config/options "${p}"
    source "${f}"
    PKG_SITE=$(echo ${PKG_URL} | sed 's/\/archive.*//g')
    [ -n "${PKG_GIT_BRANCH}" ] && PKG_GIT_CLONE_BRANCH="${PKG_GIT_BRANCH}"
    [ -n "${PKG_GIT_CLONE_BRANCH}" ] && GIT_HEAD="heads/${PKG_GIT_CLONE_BRANCH}" || GIT_HEAD="HEAD"
     UPS_VERSION=`git ls-remote ${PKG_SITE} | grep ${GIT_HEAD}$ | awk '{ print substr($1,1,40) }'`
    if [ "${UPS_VERSION}" == "${PKG_VERSION}" ]; then
      echo "${PKG_NAME} is up to date (${UPS_VERSION})"
    else
      if [ "${UPS_VERSION}" ]; then
        echo "${PKG_NAME} updated from ${PKG_VERSION} to ${UPS_VERSION}"
        sed -i "s/PKG_VERSION=\"${PKG_VERSION}/PKG_VERSION=\"${UPS_VERSION}/" $f
      else
        echo "Could not find version, not updating ${PKG_NAME}."
        continue
      fi
    fi

    if [[ ! "${PKG_URL}" =~ git$ ]]
    then
     # An archive recipe keeps a PKG_SHA256, or its fetch fails (D-WORKFLOW-193).
     # When the version moved, the new archive's checksum replaces the old one,
     # from one verified fetch into a temporary file; a recipe with no checksum
     # line or more than one (a per-device case) is left as it is and named.
     if [ "${UPS_VERSION}" ] && [ "${UPS_VERSION}" != "${PKG_VERSION}" ]; then
       if [ "$(grep -c '^ *PKG_SHA256=' "${f}")" != "1" ]; then
         echo "${PKG_NAME}: not one PKG_SHA256 line in ${f}; set its checksum by hand"
       else
         source "${f}"
         TMP_ARCHIVE=$(mktemp)
         if wget -q -O "${TMP_ARCHIVE}" "${PKG_URL}"; then
           SHA=$(sha256sum "${TMP_ARCHIVE}" | cut -d" " -f1)
           sed -i "s/^\( *\)PKG_SHA256=\"[^\"]*\"/\1PKG_SHA256=\"${SHA}\"/" "${f}"
           echo "${PKG_NAME}: PKG_SHA256 ${SHA} (fetched once, trusted on first use)"
         else
           echo "${PKG_NAME}: could not fetch ${PKG_URL}; its PKG_SHA256 is the old version's"
         fi
         rm -f "${TMP_ARCHIVE}"
       fi
     fi
   else
     sed "/^PKG_SHA256=/d" -i ${f}
   fi
  done
}


source "${OPTIONS}"

if [ ! "${1}" ]
then
  for package in "${PACKAGES[@]}"
  do
    source "${package}"
    PACKAGES_ALL=" ${PKG_DEPENDS_TARGET}"
    update_packages
  done
else
  PACKAGES_ALL="$*"
  update_packages
fi
