#!/usr/bin/env bash
# Forward the environment into the build container -- minus anything that looks
# like a secret.
#
# The whole exported environment used to go through. On a developer's machine
# that is also their shell: API keys and access tokens for unrelated tools
# landed in a world-readable .env in the worktree and inside every build
# container. The four scraper and achievement credentials EmulationStation
# compiles in are the exception -- they are the reason a build needs a secret
# at all -- so they pass by name; everything else that looks like one is
# dropped. Names, not values, are matched, so a variable holding a secret under
# an innocent name still leaks: keep such things out of the shell that runs
# make, or in ~/.ROCKNIX/options where only the build sees them.
#
# DROP is matched against the name in upper case, so github_token is caught as
# GITHUB_TOKEN is: a secret word as a component of the name, or a name that
# ends in one with no underscore before it (SSHPASS, DOCKERHUBTOKEN). A value
# that spans lines is dropped whatever its name: docker's --env-file reads
# each line as its own entry, and a second line holding a bare name imports
# the host's value of that name. A notice names what was dropped for that
# reason, never its value. A write that fails stops the script, so a
# truncated .env never starts a container.
KEEP='^(SCREENSCRAPER_DEV_LOGIN|GAMESDB_APIKEY|CHEEVOS_DEV_LOGIN|HFS_DEV_LOGIN)$'
DROP='(^|_)(KEY|KEYS|TOKEN|TOKENS|SECRET|SECRETS|PASS|PASSWORD|PASSWD|PASSPHRASE|PSK|COOKIE|COOKIES|CREDENTIAL|CREDENTIALS|AUTH|APIKEY|API_KEY|PRIVATE)($|_)|(PASS|PASSWD|PASSWORD|TOKEN|SECRET|APIKEY)$|^(AWS|GH|GITHUB|NPM|OPENAI|ANTHROPIC)_'
for var in $(compgen -e); do
  [[ "$var" == PATH ]] && continue
  if [[ ! "$var" =~ $KEEP ]] && [[ "${var^^}" =~ $DROP ]]; then
    continue
  fi
  if [[ "${!var}" == *$'\n'* || "${!var}" == *$'\r'* ]]; then
    echo "get_env: not forwarding ${var}: its value spans lines" >&2
    continue
  fi
  echo "$var=${!var}" || exit 1
done
