#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2024-present ROCKNIX (https://github.com/ROCKNIX)

###
### Simple script to build ROCKNX
###

# Fork build monitoring: nested calls reuse the outer run (#394).
if [[ "${RASTERATOPS_WATCH_EXEC:-}" != "$0" ]]; then
  exec ./tools/watch-build --entry -- "$0" "$@"
fi
unset RASTERATOPS_WATCH_EXEC

set -e

scripts/checkdeps

if [ -z "${ARCH}" ]; then
  echo "Please export ARCH before building."
  exit 1
fi

. config/options ""
. projects/${PROJECT}/devices/${DEVICE}/options

echo "Building ${DISTRO} for ${DEVICE}"

# Collect packages to clean
PKG_CLEAN=""

if [ "${ENABLE_32BIT}" == "true" ]; then
  PKG_CLEAN+=" ${CLEAN_EMU_32BIT}"
fi

if [ "${WINDOWMANAGER}" == "weston" ]; then
  PKG_CLEAN+=" ${CLEAN_WESTON}"
fi

# Handle DEVICE_ROOT logic
if [ -n "${DEVICE_ROOT}" ]; then
  if [ "${DEVICE_ROOT}" != "${DEVICE}" ]; then
    # Remove existing build directory if present
    if [ -d "build.${DISTRONAME}-${DEVICE}.${ARCH}" ]; then
      echo "Removing stale build root."
      rm -rf build.${DISTRONAME}-${DEVICE}.${ARCH}
    fi

    # Ensure DEVICE_ROOT is built before DEVICE
    if [ ! -d "build.${DISTRONAME}-${DEVICE_ROOT}.${ARCH}" ]; then
      echo "ERROR: Can't find build root build.${DISTRONAME}-${DEVICE_ROOT}.${ARCH}"
      echo "You need to build ${DEVICE_ROOT} before ${DEVICE}"
      exit 1
    fi

    # Link build directory to DEVICE_ROOT
    if [ ! -L "build.${DISTRONAME}-${DEVICE}.${ARCH}" ]; then
      ln -sf build.${DISTRONAME}-${DEVICE_ROOT}.${ARCH} build.${DISTRONAME}-${DEVICE}.${ARCH}
    fi

    # Link sources if necessary
    if [ -d "sources-${DEVICE_ROOT}" ] && [ ! -L "sources-${DEVICE}" ]; then
      ln -sf sources-${DEVICE_ROOT} sources-${DEVICE}
    fi
  fi
  PKG_CLEAN+=" ${CLEAN_DEVICE_ROOT}"
fi

# Add standard packages to clean
PKG_CLEAN+=" ${CLEAN_NETWORK} ${CLEAN_OS_BASE} ${CLEAN_PACKAGES}"

if [ -z "${DIRTY}" ]; then
  # Clean packages to ensure build date and version are updated
  for package in ${PKG_CLEAN}; do
    echo "Clean: ${package}"
    ./scripts/clean "${package}" 2>/dev/null || echo "Clean: ${package} failed; it keeps its earlier build" >&2
  done
  # DEVICE_ROOT is set only where a device shares another's root (Makefile)
  rm -rf build.${DISTRONAME}-${DEVICE_ROOT:-${DEVICE}}.${ARCH}/{.stamps/initramfs,initramfs}
fi

# Prune old releases. The outputs of a frozen BUILD_TIMESTAMP stay, so that
# scripts/image finds them and refuses to replace that identity (#833).
echo "Prune old releases: ${DISTRONAME}-${DEVICE}.${ARCH}-*"
for old in ./release/${DISTRONAME}-${DEVICE}.${ARCH}-* ./target/${DISTRONAME}-${DEVICE}.${ARCH}-*; do
  [ -e "${old}" ] || continue
  if [ -n "${BUILD_TIMESTAMP}" ] && [[ "${old}" == *"+${BUILD_TIMESTAMP}."* ]]; then
    echo "Keeping ${old}: it carries this build's BUILD_TIMESTAMP"
    continue
  fi
  rm -rf "${old}"
done

# Remove image root
rm -rf ./build.${DISTRONAME}-${DEVICE}.${ARCH}/image

case "${ARCH}" in
  arm)
    if [ "${BASE_ONLY}" == "true" ] || [ "${ENABLE_32BIT}" != "true" ]; then
      exit 0
    fi
    export PKG_BUILD_PERF=no
    scripts/build_compat arm || { echo "Build failed..exiting." >&2; exit 1; }
    scripts/install arm || { echo "Build failed..exiting." >&2; exit 1; }
    ;;
  *)
    make image || { echo "Build failed..exiting." >&2; exit 1; }
    ;;
esac
